# Copy this file to .env and replace every placeholder with values for your environment.
# Do not commit .env. SQL Server must be reachable from the Docker host.
WEB_CONNECTION_STRING=Server=host.docker.internal,1433;Database=MyShop;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True
API_CONNECTION_STRING=Server=host.docker.internal,1433;Database=MyShop;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True

# Use the same JWT values for Web and API. Provide a strong key (at least 32 random bytes).
JWT_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ISSUER=REPLACE_WITH_YOUR_JWT_ISSUER
JWT_AUDIENCE=REPLACE_WITH_YOUR_JWT_AUDIENCE

# Optional host ports
WEB_PORT=8080
API_PORT=8081

# Optional semicolon-separated ASP.NET Core host allow-list. Include every public tenant hostname.
ALLOWED_HOSTS=localhost;127.0.0.1;web;api;koochino.shop;www.koochino.shop;api.koochino.shop
