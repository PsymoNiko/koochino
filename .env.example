# Copy this file to .env and replace the placeholders with values for your environment.
# Do not commit .env. Set a strong password that satisfies SQL Server's complexity requirements.
DB_SA_PASSWORD=ReplaceWithStrongPassword1!
DB_PORT=1433

# Use the same JWT values for Web and API. Provide a strong key (at least 32 random bytes).
JWT_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ISSUER=REPLACE_WITH_YOUR_JWT_ISSUER
JWT_AUDIENCE=REPLACE_WITH_YOUR_JWT_AUDIENCE

# Optional host ports
WEB_PORT=8080
API_PORT=8081

# Optional semicolon-separated ASP.NET Core host allow-list. Include every public tenant hostname.
ALLOWED_HOSTS=localhost;127.0.0.1;web;api;koochino.shop;www.koochino.shop;api.koochino.shop
