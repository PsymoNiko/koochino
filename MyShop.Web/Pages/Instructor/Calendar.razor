@page "/instructor/calendar"
@layout InstructorLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@using MyShop.Web.Components
@attribute [Authorize(Roles = "Instructor")]

<div dir="rtl" lang="fa">
@if (loadingProfile) { <p class="empty-text">در حال بارگذاری...</p> }
else if (instructor == null) { <p>پروفایل مربی یافت نشد.</p> }
else
{
    @if (!string.IsNullOrEmpty(message))
    {
        <div style="padding:12px;border-radius:8px;background:#fee2e2;margin-bottom:12px;">@message</div>
    }
    <AcademyCalendarView Events="events" Loading="loading" Viewer="Instructor" RangeChanged="LoadRange" />
}
</div>

@code {
    [Inject] IAcademyCalendarService CalendarSvc { get; set; }
    [Inject] IAcademyInstructorService Instructors { get; set; }
    [Inject] AuthenticationStateProvider Auth { get; set; }
    AcademyInstructorDto instructor;
    List<AcademyCalendarEventDto> events = new();
    bool loadingProfile = true;
    bool loading = true;
    string message = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(idClaim, out var userId))
            instructor = await Instructors.GetByUserIdAsync(userId);
        loadingProfile = false;
    }

    private async Task LoadRange(AcademyCalendarRange range)
    {
        if (instructor == null) return;
        loading = true;
        message = "";
        try
        {
            events = await CalendarSvc.GetAsync(range.From, range.To, instructorId: instructor.Id) ?? new();
        }
        catch
        {
            message = "تقویم در دسترس نیست.";
            events = new();
        }
        loading = false;
    }
}
