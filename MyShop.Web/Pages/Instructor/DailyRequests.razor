@page "/instructor/daily-requests"
@layout InstructorLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@attribute [Authorize(Roles = "Instructor")]

<div dir="rtl" lang="fa">
@if (!string.IsNullOrEmpty(message))
{
    <div class="alert-box @(ok ? "alert-ok" : "alert-err")">@message</div>
}
@if (loading) { <p class="empty-text">در حال بارگذاری...</p> }
else if (instructor == null) { <p class="empty-text">پروفایل مربی یافت نشد.</p> }
else if (!items.Any()) { <p class="empty-text">درخواست حضور روزانه برای دوره‌های شما نیست.</p> }
else
{
    <p class="empty-text">هر روز جداگانه تأیید می‌شود. تأیید یک روز، روزهای دیگر را تأیید نمی‌کند.</p>
    <div class="academy-cards">
        @foreach (var x in items)
        {
            <article class="academy-card">
                <div class="academy-card-top">
                    <div class="academy-card-id">
                        <strong>@x.StudentName</strong>
                        <span class="academy-card-meta">@(x.CourseTitle ?? "دوره") · @PersianDateHelper.ToPersianDateString(x.SessionDate) · @x.Hour.ToString("00"):@x.Minute.ToString("00")</span>
                    </div>
                    <span class="status-badge @StatusClass(x.Status)">@StatusFa(x.Status)</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(x.StudentNote))
                {
                    <div class="academy-card-row"><span>یادداشت دانش‌آموز</span><strong>@x.StudentNote</strong></div>
                }
                @if (x.Status is AcademyConstants.RequestStatus.Pending or AcademyConstants.RequestStatus.Waitlisted)
                {
                    <label style="display:block;margin:8px 0 6px;font-size:.85rem;color:#64748b;">دلیل (برای رد الزامی)</label>
                    <textarea @bind="notes[x.Id]" rows="2" style="width:100%;padding:8px;border-radius:8px;border:1px solid #cbd5e1;"></textarea>
                    <button class="btn-card ok" @onclick="() => Review(x.Id, AcademyConstants.RequestStatus.Approved)">تأیید این روز</button>
                    @if (x.Status == AcademyConstants.RequestStatus.Pending)
                    {
                        <button class="btn-card" style="background:#6366f1;" @onclick="() => Review(x.Id, AcademyConstants.RequestStatus.Waitlisted)">لیست انتظار</button>
                    }
                    <button class="btn-card ghost" @onclick="() => Review(x.Id, AcademyConstants.RequestStatus.Rejected)">رد</button>
                }
                else if (!string.IsNullOrWhiteSpace(x.ReviewerNote))
                {
                    <div class="academy-card-row"><span>دلیل بررسی</span><strong>@x.ReviewerNote</strong></div>
                }
            </article>
        }
    </div>
}
</div>
@code {
    [Inject] IAcademyCourseScheduleRequestService DailySvc { get; set; }
    [Inject] IAcademyInstructorService Instructors { get; set; }
    [Inject] AuthenticationStateProvider Auth { get; set; }
    AcademyInstructorDto instructor;
    List<AcademyCourseScheduleRequestDto> items = new();
    Dictionary<int, string> notes = new();
    bool loading = true, ok;
    string message = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(idClaim, out var userId))
            instructor = await Instructors.GetByUserIdAsync(userId);
        await Reload();
        loading = false;
    }

    private async Task Reload()
    {
        if (instructor == null) return;
        try { items = await DailySvc.ListForInstructorAsync(instructor.Id) ?? new(); }
        catch { items = new(); message = "اسکریپت sql/Academy_Phase22_DailyScheduleRequestReview.sql را اجرا کنید."; ok = false; }
        foreach (var x in items)
        {
            if (!notes.ContainsKey(x.Id)) notes[x.Id] = "";
        }
    }

    private async Task Review(int id, string status)
    {
        notes.TryGetValue(id, out var note);
        var r = await DailySvc.ReviewAsync(new ReviewAcademyCourseScheduleRequestDto
        {
            Id = id,
            Status = status,
            ReviewerNote = note
        }, actingInstructorId: instructor.Id);
        ok = r.Ok;
        message = r.Ok ? "وضعیت این روز به‌روز شد." : (r.Error ?? "خطا");
        await Reload();
    }

    private static string StatusFa(string s) => s switch
    {
        AcademyConstants.RequestStatus.Pending => "در انتظار",
        AcademyConstants.RequestStatus.Waitlisted => "لیست انتظار",
        AcademyConstants.RequestStatus.Approved => "تأیید شده",
        AcademyConstants.RequestStatus.Rejected => "رد شده",
        AcademyConstants.RequestStatus.Cancelled => "لغو شده",
        _ => s
    };
    private static string StatusClass(string s) => s switch
    {
        AcademyConstants.RequestStatus.Approved => "status-ok",
        AcademyConstants.RequestStatus.Waitlisted => "status-info",
        AcademyConstants.RequestStatus.Rejected or AcademyConstants.RequestStatus.Cancelled => "status-bad",
        _ => "status-wait"
    };
}
