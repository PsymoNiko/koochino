@page "/instructor/evaluations"
@layout InstructorLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@attribute [Authorize(Roles = "Instructor")]

<div dir="rtl" lang="fa">
@if (loading) { <p class="empty-text">در حال بارگذاری...</p> }
else if (instructor == null) { <p class="empty-text">پروفایل مربی یافت نشد.</p> }
else if (!string.IsNullOrEmpty(message))
{
    <div class="alert-box alert-err">@message</div>
}
else
{
    <div class="stats-grid" style="margin-bottom:24px;">
        @foreach (var x in summaries)
        {
            <div class="stat-card">
                <span class="label">@x.Title</span>
                <span class="value">@x.AvgInstructorRating.ToString("0.0")</span>
                <span class="label">دوره @x.AvgCourseRating.ToString("0.0") · @x.RatingCount نظر</span>
            </div>
        }
    </div>
    @if (!comments.Any()) { <p class="empty-text">نظر منتشرشده‌ای نیست.</p> }
    else
    {
        <div class="academy-cards">
            @foreach (var x in comments)
            {
                <article class="academy-card">
                    <div class="academy-card-top">
                        <div class="academy-card-id">
                            <strong>@x.CourseTitle</strong>
                            <span class="academy-card-meta">دوره @x.CourseRating · مربی @x.InstructorRating</span>
                        </div>
                    </div>
                    <p style="margin:0;color:#334155;">@(x.Comment ?? "—")</p>
                </article>
            }
        </div>
    }
}
</div>

@code {
    [Inject] IAcademyEvaluationService EvalSvc { get; set; }
    [Inject] IAcademyInstructorService Instructors { get; set; }
    [Inject] AuthenticationStateProvider Auth { get; set; }
    AcademyInstructorDto instructor;
    List<AcademyEvaluationCourseSummaryDto> summaries = new();
    List<AcademyEvaluationDto> comments = new();
    bool loading = true;
    string message = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(idClaim, out var userId))
            instructor = await Instructors.GetByUserIdAsync(userId);
        if (instructor != null)
        {
            try
            {
                summaries = await EvalSvc.GetCourseSummaryAsync(instructor.Id) ?? new();
                comments = await EvalSvc.GetAllAsync(instructorId: instructor.Id, publishedOnly: true) ?? new();
            }
            catch { message = "ارزیابی در دسترس نیست."; }
        }
        loading = false;
    }
}
