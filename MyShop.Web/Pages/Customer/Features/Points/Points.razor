    }

    .mission-claim-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 12px;
    }

    .mission-claim-icon {
        font-size: 32px;
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        border-radius: 12px;
    }

    .mission-claim-info {
        flex: 1;
    }

    .mission-claim-info h4 {
        font-size: 18px;
        font-weight: 600;
        color: #1f2937;
