@page "/customer/points"
@layout CustomerLayout

@using MyShop.Application.Interfaces
@using MyShop.Application.Interfaces.Loyalty
@using MyShop.Core.Models
@using MyShop.Core.Models.Dto
@using MyShop.Core.Models.Loyalty
@using MyShop.Core.Helpers
@using MyShop.Core.Interfaces
@using System.Security.Claims
@using Microsoft.JSInterop
@inject IPointService PointService
@inject IUserService UserService
@inject ILoyaltyRoadmapService Loyalty
@inject ICurrentTenant Tenant
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<div class="container-content points-container" dir="rtl" lang="fa">
    <div class="points-header">
        <h2>🏆 امتیازهای من</h2>
        @if (vipTier != null)
        {
            <span class="vip-badge" title="@vipTier.Name">سطح @vipTier.Name</span>
        }
        <a class="wallet-link" href="/customer/wallet">کیف پول</a>
    </div>

    @if (loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else
    {
        <div class="points-summary-cards">
            <div class="points-card total">
                <div class="card-icon">⭐</div>
                <div class="card-content">
                    <h3>@summary.TotalPoints</h3>
                    <p>کل امتیازها</p>
                </div>
            </div>
            <div class="points-card available">
                <div class="card-icon">✅</div>
                <div class="card-content">
                    <h3>@summary.AvailablePoints</h3>
                    <p>امتیازهای قابل استفاده</p>
                </div>
            </div>
            <div class="points-card pending">
                <div class="card-icon">⏳</div>
                <div class="card-content">
                    <h3>@summary.PendingPoints</h3>
                    <p>در انتظار تایید</p>
                </div>
            </div>
        </div>

        @if (availableMissions != null && availableMissions.Count > 0)
        {
            <div class="available-missions-section">
                <h3>🎯 ماموریت‌های قابل دریافت</h3>
                <div class="missions-list">
                    @foreach (var mission in availableMissions)
                    {
                        <div class="mission-claim-card">
                            <div class="mission-claim-header">
                                <div class="mission-claim-icon">@GetMissionIcon(mission.MissionType)</div>
                                <div class="mission-claim-info">
                                    <h4>@mission.Title</h4>
                                    <p>@mission.Description</p>
                                </div>
                                <div class="mission-claim-points">
                                    <span class="points-value">+@mission.Points</span>
                                    <span class="points-label">امتیاز</span>
                                </div>
                            </div>
                            <div class="mission-claim-message">
                                <span class="eligibility-icon">✅</span>
                                <span>@eligibilityMessages[mission.Id]</span>
                            </div>
                            <button class="mission-claim-btn" 
                                    @onclick="@(() => ClaimPoints(mission))" 
                                    disabled="@claiming">
                                @if (claiming && claimingMissionId == mission.Id)
                                {
                                    <span class="spinner-small"></span>
                                    <span>در حال ثبت...</span>
                                }
                                else
                                {
                                    <span>دریافت @mission.Points امتیاز</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(isSuccess ? "alert-success" : "alert-danger")">
                @message
            </div>
        }

        <div class="points-transactions">
            <h3>آخرین تراکنش‌های امتیاز</h3>
            @if (transactions == null || transactions.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">📭</div>
                    <p>هنوز امتیازی دریافت نکرده‌اید</p>
                </div>
            }
            else
            {
                <div class="transactions-list">
                    @foreach (var transaction in transactions)
                    {
                        <div class="transaction-item @transaction.Status.ToLower()">
                            <div class="transaction-icon">
                                @GetMissionIcon(transaction.MissionType)
                            </div>
                            <div class="transaction-content">
                                <div class="transaction-header">
                                    <span class="transaction-reason">@transaction.Reason</span>
                                    <span class="transaction-points @GetStatusClass(transaction.Status)">
                                        @(transaction.Points > 0 ? "+" : "")@transaction.Points امتیاز
                                    </span>
                                </div>
                                <div class="transaction-details">
                                    <span class="transaction-type">@GetMissionTypeText(transaction.MissionType)</span>
                                    <span class="transaction-date">@PersianDateHelper.ToPersianDateTimeString(transaction.CreatedAt)</span>
                                </div>
                                <div class="transaction-status">
                                    <span class="status-badge @transaction.Status.ToLower()">@transaction.StatusText</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private UserPointsSummaryDto summary = new();
    private List<PointTransactionDto> transactions = new();
    private List<PointMission> availableMissions = new();
    private Dictionary<int, string> eligibilityMessages = new();
    private bool loading = true;
    private bool claiming = false;
    private int? claimingMissionId = null;
    private int userId;
    private string message = "";
    private bool isSuccess = true;
    private VipTier vipTier;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var user = state.User;

            if (!user.Identity?.IsAuthenticated ?? true || !user.IsInRole("Customer"))
            {
                loading = false;
                return;
            }

            var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
            if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out userId))
            {
                loading = false;
                return;
            }

            await LoadData();
        }
        catch
        {
            loading = false;
        }
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            summary = await PointService.GetUserPointsSummaryAsync(userId);
            transactions = await PointService.GetUserTransactionsAsync(userId, 10);
            try { vipTier = await Loyalty.ResolveVipTierAsync(userId, Tenant.SiteId); } catch { vipTier = null; }
            
            // بارگذاری ماموریت‌های قابل دریافت
            await LoadAvailableMissions();
        }
        catch
        {
            summary = new UserPointsSummaryDto();
            transactions = new List<PointTransactionDto>();
            availableMissions = new List<PointMission>();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadAvailableMissions()
    {
        try
        {
            var allMissions = await PointService.GetMissionsAsync(activeOnly: true, siteId: Tenant?.HasSite == true ? Tenant.SiteId : null);
            availableMissions = new List<PointMission>();
            eligibilityMessages = new Dictionary<int, string>();

            foreach (var mission in allMissions)
            {
                if (!string.IsNullOrWhiteSpace(mission.ValidationSP))
                {
                    var result = await PointService.CheckMissionEligibilityAsync(userId, mission.Id);
                    if (result.IsEligible)
                    {
                        availableMissions.Add(mission);
                        eligibilityMessages[mission.Id] = result.Message;
                    }
                }
            }
        }
        catch
        {
            availableMissions = new List<PointMission>();
        }
    }

    private async Task ClaimPoints(PointMission mission)
    {
        if (claiming) return;

        claiming = true;
        claimingMissionId = mission.Id;
        message = "";

        try
        {
            if (!await UserService.IsPhoneVerifiedAsync(userId))
            {
                isSuccess = false;
                message = "شماره تلفن فعال نیست. ابتدا باید تلفن همراه خود را فعال کنید.";
                return;
            }

            // دوباره چک کردن شرایط (برای اطمینان)
            var eligibility = await PointService.CheckMissionEligibilityAsync(userId, mission.Id);
            
            if (!eligibility.IsEligible)
            {
                isSuccess = false;
                message = eligibility.Message;
                claiming = false;
                claimingMissionId = null;
                return;
            }

            // ایجاد تراکنش
            var result = await PointService.CreateTransactionAsync(
                userId,
                mission.MissionType,
                mission.Points,
                mission.Title,
                mission.Id
            );

            isSuccess = result.Success;
            message = result.Message;

            if (result.Success)
            {
                // بارگذاری مجدد داده‌ها
                await LoadData();
                
                // نمایش پیام موفقیت
                await Task.Delay(2000);
                message = "";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            message = UserFacingErrorHelper.Format(ex, "خطا در دریافت امتیاز:");
        }
        finally
        {
            claiming = false;
            claimingMissionId = null;
        }
    }

    private string GetMissionIcon(string missionType)
    {
        return missionType switch
        {
            "PurchaseRating" => "⭐",
            "StoreComment" => "💬",
            "PurchaseAmount" => "💰",
            "Custom" => "🎯",
            _ => "🎁"
        };
    }

    private string GetMissionTypeText(string missionType)
    {
        return missionType switch
        {
            "PurchaseRating" => "امتیاز به خرید",
            "StoreComment" => "نظر در فروشگاه",
            "PurchaseAmount" => "خرید مبلغ مشخص",
            "Custom" => "ماموریت سفارشی",
            _ => missionType
        };
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Approved" => "approved",
            "Pending" => "pending",
            "Rejected" => "rejected",
            _ => ""
        };
    }
}

<style>
