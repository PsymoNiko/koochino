@page "/customer/orders/dispute/{OrderId:int}"
@layout CustomerLayout
@using MyShop.Core.Helpers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MyShop.Application.Interfaces
@using MyShop.Application.Interfaces.Tickets
@using MyShop.Core.Models
@using MyShop.Core.Models.Tickets
@using MyShop.Web.Services
@using System.Security.Claims
@attribute [Authorize(Roles = "Customer")]

<div class="dispute-page" dir="rtl" lang="fa">
    <div class="page-header">
        <h1>درخواست بررسی سفارش</h1>
        <p class="subtitle">متن توضیح و تصویر رسید را ارسال کنید تا ادمین بررسی کند</p>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(ok ? "ok" : "err")">@message</div>
    }

    @if (loading)
    {
        <p>در حال بارگذاری...</p>
    }
    else if (order == null)
    {
        <div class="empty">سفارش یافت نشد یا دسترسی ندارید.</div>
        <a href="/customer/orders" class="btn-secondary">بازگشت به سفارش‌ها</a>
    }
    else if (existingTicketId.HasValue)
    {
        <div class="order-box">
            <div><span>شماره سفارش</span><strong>@(order.OrderNumber ?? $"#{order.Id}")</strong></div>
            <div><span>فروشگاه</span><strong>@(order.StoreName ?? "—")</strong></div>
        </div>
        <div class="alert ok">برای این سفارش قبلاً درخواست بررسی ثبت شده است.</div>
        <div class="form-actions">
            <a href="/customer/tickets/view/@existingTicketId" class="btn-primary">مشاهده تیکت</a>
            <a href="/customer/orders" class="btn-secondary">بازگشت</a>
        </div>
    }
    else
    {
        <div class="order-box">
            <div><span>شماره سفارش</span><strong>@(order.OrderNumber ?? $"#{order.Id}")</strong></div>
            <div><span>فروشگاه</span><strong>@(order.StoreName ?? "—")</strong></div>
            <div><span>مبلغ نهایی</span><strong>@NumberFormatHelper.Format(order.FinalAmount) تومان</strong></div>
            <div><span>وضعیت</span><strong class="rejected">رد شده</strong></div>
        </div>

        <div class="form-card">
            <div class="form-group">
                <label>توضیح اعتراض *</label>
                <textarea class="form-control" rows="5" @bind="disputeText" placeholder="دلیل اعتراض خود را بنویسید (مثلاً رسید پرداخت صحیح است، مبلغ اشتباه رد شده و ...)"></textarea>
            </div>
            <div class="form-group">
                <label>فایل رسید / مدرک (اختیاری — حداکثر ۳ فایل، هر کدام تا ۲ مگابایت)</label>
                <InputFile OnChange="OnFilesSelected" multiple accept=".jpg,.jpeg,.png,.gif,.webp,.pdf" class="form-control" />
                @if (selectedFiles.Count > 0)
                {
                    <ul class="file-list">
                        @foreach (var f in selectedFiles)
                        {
                            <li>@f.Name</li>
                        }
                    </ul>
                }
            </div>
            <div class="form-actions">
                <button type="button" class="btn-primary" disabled="@saving" @onclick="Submit">
                    @(saving ? "در حال ارسال..." : "ارسال درخواست بررسی")
                </button>
                <a href="/customer/orders" class="btn-secondary">انصراف</a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int OrderId { get; set; }
    [Inject] private IOrderService OrderService { get; set; }
    [Inject] private ITicketService TicketService { get; set; }
    [Inject] private IUserService UserService { get; set; }
    [Inject] private TicketAttachmentUploadService UploadService { get; set; }
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; }
    [Inject] private NavigationManager Nav { get; set; }

    private Order order;
    private int? existingTicketId;
    private string disputeText = "";
    private List<IBrowserFile> selectedFiles = new();
    private bool loading = true;
    private bool saving;
    private bool ok;
    private string message = "";
    private int userId;
    private string contactName;
    private string contactEmail;
    private string contactPhone;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var uid = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(uid) || !int.TryParse(uid, out userId))
        {
            Nav.NavigateTo("/Account/Login", true);
            return;
        }

        try
        {
            var profile = await UserService.GetProfileAsync(userId);
            if (profile != null)
            {
                contactName = $"{profile.FirstName} {profile.LastName}".Trim();
                contactEmail = profile.Email;
                contactPhone = profile.PhoneNumber;
            }

            order = await OrderService.GetByIdAsync(OrderId);
            if (order == null || order.UserId != userId || order.Status != 2)
            {
                order = null;
                return;
            }

            var open = await TicketService.GetOpenByOrderIdAsync(OrderId);
            if (open != null)
                existingTicketId = open.Id;
        }
        finally
        {
            loading = false;
        }
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        selectedFiles = e.GetMultipleFiles(3).ToList();
        message = "";
    }

    private async Task Submit()
    {
        message = "";
        ok = false;
        if (string.IsNullOrWhiteSpace(disputeText))
        {
            message = "متن درخواست بررسی را وارد کنید.";
            return;
        }

        saving = true;
        try
        {
            var result = await TicketService.CreateOrderDisputeAsync(new CreateTicketDto
            {
                UserId = userId,
                OrderId = OrderId,
                Resolution = disputeText,
                ContactName = contactName,
                ContactEmail = contactEmail,
                ContactPhone = contactPhone,
                Priority = "زیاد"
            });

            if (!result.Success)
            {
                message = result.Message;
                if (result.TicketId > 0)
                {
                    ok = true;
                    Nav.NavigateTo($"/customer/tickets/view/{result.TicketId}");
                }
                return;
            }

            foreach (var file in selectedFiles)
            {
                var (success, url, fileName, fileSize, msg) = await UploadService.UploadAsync(result.TicketId, file);
                if (!success)
                {
                    message = $"درخواست ثبت شد ولی آپلود «{file.Name}» ناموفق بود: {msg}";
                    ok = true;
                    Nav.NavigateTo($"/customer/tickets/view/{result.TicketId}");
                    return;
                }
                await TicketService.AddAttachmentAsync(result.TicketId, null, url, fileName, fileSize, userId);
            }

            ok = true;
            message = result.Message;
            Nav.NavigateTo($"/customer/tickets/view/{result.TicketId}");
        }
        catch (Exception ex)
        {
            message = UserFacingErrorHelper.Format(ex, "خطا:");
        }
        finally
        {
            saving = false;
        }
    }
}

<style>
    .dispute-page { padding: 12px 16px; max-width: 640px; margin: 0 auto; }
    .page-header { margin-bottom: 16px; }
    .page-header h1 { margin: 0 0 4px; font-size: 1.25rem; }
    .subtitle { margin: 0; color: #6b7280; font-size: 0.875rem; }
    .alert { padding: 12px; border-radius: 8px; margin-bottom: 16px; }
    .alert.ok { background: #d1fae5; color: #065f46; }
    .alert.err { background: #fee2e2; color: #b91c1c; }
    .empty { color: #6b7280; margin-bottom: 12px; }
    .order-box {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 14px 16px;
        margin-bottom: 16px; display: grid; gap: 8px;
    }
    .order-box > div { display: flex; justify-content: space-between; font-size: 0.9rem; }
    .order-box span { color: #6b7280; }
    .rejected { color: #b91c1c; }
    .form-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; }
    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; margin-bottom: 6px; font-weight: 600; font-size: 0.9rem; }
    .form-control { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 0.95rem; }
    .file-list { margin: 8px 0 0; padding-right: 18px; color: #4b5563; font-size: 0.85rem; }
    .form-actions { display: flex; gap: 12px; margin-top: 18px; flex-wrap: wrap; }
    .btn-primary { background: #059669; color: #fff; border: none; padding: 10px 18px; border-radius: 8px; cursor: pointer; font-weight: 600; text-decoration: none; display: inline-block; }
    .btn-primary:disabled { opacity: 0.6; }
    .btn-secondary { background: #f3f4f6; color: #374151; text-decoration: none; padding: 10px 18px; border-radius: 8px; display: inline-block; }
</style>
