@page "/customer/wallet"
@attribute [Authorize(Roles = "Customer")]
@layout CustomerLayout
@using MyShop.Core.Helpers
@using MyShop.Application.Interfaces.Loyalty
@using MyShop.Core.Models.Loyalty
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject ILoyaltyRoadmapService Loyalty
@inject AuthenticationStateProvider Auth

<div class="container-content" dir="rtl" style="padding:20px;max-width:720px;margin:0 auto;">
    <h2>کیف پول من</h2>
    @if (!string.IsNullOrEmpty(err)) { <p style="color:#b91c1c">@err</p> }
    else
    {
        <p>موجودی: <strong>@balance.ToString("N0")</strong> ریال</p>
        <div class="m-cards">
            @foreach (var t in txs)
            {
                <article class="m-card">
                    <div class="m-card-head">
                        <h4 class="m-card-title">@t.Amount.ToString("N0") ریال</h4>
                        <span class="m-card-sub">@t.TxType</span>
                    </div>
                    <div class="m-card-rows">
                        <div class="m-row"><span class="k">دلیل</span><span class="v">@(t.Reason ?? "—")</span></div>
                        <div class="m-row"><span class="k">زمان</span><span class="v">@PersianDateHelper.ToPersianDateTimeString(t.CreatedAt)</span></div>
                    </div>
                </article>
            }
        </div>
        <p><a href="/customer/points">← امتیازها و VIP</a></p>
    }
</div>
@code {
    decimal balance; List<WalletTransaction> txs = new(); string err;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var st = await Auth.GetAuthenticationStateAsync();
            if (!int.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid) || uid <= 0)
            { err = "ورود لازم است."; return; }
            balance = await Loyalty.GetWalletBalanceAsync(uid);
            txs = await Loyalty.ListWalletTxAsync(uid) ?? new();
        }
        catch (Exception ex) { err = UserFacingErrorHelper.Format(ex, "کیف پول در دسترس نیست."); }
    }
}
