@page "/customer/lucky-league"
@layout CustomerLayout

@using System.Globalization
@using System.Security.Claims
@using Microsoft.JSInterop
@using MyShop.Application.Interfaces
@using MyShop.Application.Interfaces.Lucky
@using MyShop.Core.Models.Lucky
@using MyShop.Core.Helpers
@implements IAsyncDisposable
@inject ILuckyLeagueService LuckyService
@inject IPointService PointService
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject NavigationManager Nav

<script src="/js/lucky-orbit.js"></script>

<div class="container-content lucky-container" dir="rtl" lang="fa">
    @if (loading)
    {
        <div class="lucky-loading"><div class="loading-spinner"></div><span>در حال بارگذاری...</span></div>
    }
    else if (!string.IsNullOrEmpty(fatalError))
    {
        <div class="lucky-alert err">@fatalError</div>
    }
    else
    {
        <div class="lucky-points-bar">
            <span class="lp-label">امتیاز شما</span>
            <span class="lp-value">@availablePoints.ToString("N0", CultureInfo.InvariantCulture)</span>
        </div>

        <div class="lucky-leagues-head"><h2>لیگ‌ها</h2></div>
        <div class="lucky-leagues-row">
            @foreach (var l in leagues)
            {
                <div class="league-card @(l.Id == selectedLeagueId && l.IsUnlocked ? "active" : "") @(l.IsUnlocked ? "" : "locked")"
                     @onclick="() => SelectLeague(l)">
                    @if (!l.IsUnlocked)
                    {
                        <span class="league-lock-badge">@LockIcon</span>
                    }
                    <svg class="league-medal theme-@l.ThemeKey" viewBox="0 0 140 130">@BuildChestSvg("lg-" + l.ThemeKey)</svg>
                    <span class="league-name">@LuckyLeagueTheme.GetDisplayName(l.ThemeKey, l.Name)</span>
                    <span class="league-caption">
                        @if (l.IsUnlocked)
                        {
                            @(l.PointsPerBox.ToString("N0", CultureInfo.InvariantCulture) + " امتیاز/جعبه")
                        }
                        else
                        {
                            @("از " + l.MinPoints.ToString("N0", CultureInfo.InvariantCulture) + " امتیاز")
                        }
                    </span>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(actionMsg))
        {
            <div class="lucky-alert @(actionOk ? "ok" : "err")">@actionMsg</div>
        }

        @if (selectedLeague != null)
        {
            @if (!selectedLeague.IsUnlocked)
            {
                <div class="lucky-alert warn">این لیگ هنوز برای شما باز نشده. با خرید بیشتر امتیاز جمع کن!</div>
            }
            else
            {
                <div class="lucky-sub-bar">
                    <span class="chance-info">شانس ذخیره‌شده: <b>@selectedLeague.ChanceBalance</b></span>
                    <button class="convert-btn" @onclick="ConvertToChance" disabled="@converting">
                        تبدیل @selectedLeague.PointsPerBox.ToString("N0", CultureInfo.InvariantCulture) امتیاز به 1 شانس
                    </button>
                </div>

                @if (boxes.Count > 0)
                {
                    var openedCount = boxes.Count(b => b.IsOpened);
                    <div class="lucky-progress">@openedCount از @boxes.Count جعبه باز شده — با انگشت بچرخونش</div>

                    <div class="orbit-stage theme-@selectedLeague.ThemeKey" @ref="orbitStageRef">
                        <div class="orbit-track-ellipse" style="@GetTrackStyle()"></div>
                        <div class="orbit-squash" style="@GetSquashStyle()">
                            <div class="orbit-ring">
                                @for (var i = 0; i < boxes.Count; i++)
                                {
                                    var b = boxes[i];
                                    var idx = i;
                                    <div class="orbit-item" style="@GetOrbitItemStyle(idx, boxes.Count)">
                                        <div class="orbit-counter" style="@GetOrbitCounterStyle(idx, boxes.Count)">
                                            <div class="orbit-spin">
                                                @if (b.IsOpened)
                                                {
                                                    <div class="result-chip @(b.IsLosing ? "blank" : "win")">
                                                        @if (b.IsLosing)
                                                        {
                                                            @BlankIcon
                                                        }
                                                        else if (b.PrizeType == "Points")
                                                        {
                                                            @StarIcon
                                                        }
                                                        else if (b.PrizeType == "DiscountCode")
                                                        {
                                                            @TagIcon
                                                        }
                                                        else if (b.PrizeType == "ExtraChance")
                                                        {
                                                            @RefreshIcon
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <svg class="chest-svg" viewBox="0 0 140 130">@BuildChestSvg("ob-" + idx)</svg>
                                                }
                                                <div class="chest-tap" @onclick="() => OpenBox(b)"></div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        }
    }
</div>

@if (showReveal && revealResult != null)
{
    <div class="lucky-modal-backdrop" @onclick="CloseReveal">
        <div class="lucky-modal" @onclick:stopPropagation="true">
            <div class="reveal-icon-wrap @(revealResult.IsLosing ? "blank" : "win")">
                @if (revealResult.IsLosing)
                {
                    @BlankIcon
                }
                else if (revealResult.PrizeType == "Points")
                {
                    @StarIcon
                }
                else if (revealResult.PrizeType == "DiscountCode")
                {
                    @TagIcon
                }
                else if (revealResult.PrizeType == "ExtraChance")
                {
                    @RefreshIcon
                }
            </div>
            @if (revealResult.IsLosing)
            {
                <h3>پوچ</h3>
            }
            else if (revealResult.PrizeType == "Points")
            {
                <h3>+@revealResult.PointsCredited امتیاز گرفتی!</h3>
            }
            else if (revealResult.PrizeType == "DiscountCode")
            {
                <h3>کد تخفیف بردی!</h3>
                @if (!string.IsNullOrEmpty(revealResult.CouponCode))
                {
                    <div class="reveal-code">@revealResult.CouponCode</div>
                }
            }
            else if (revealResult.PrizeType == "ExtraChance")
            {
                <h3>یک شانس مجدد گرفتی!</h3>
            }
            <p class="reveal-msg">@revealResult.Message</p>
            <button class="btn-close-reveal" @onclick="CloseReveal">باشه</button>
        </div>
    </div>
}

@code {
    private int userId;
    private bool loading = true;
    private string fatalError = "";
    private string actionMsg = "";
    private bool actionOk;

    private List<LuckyLeagueViewDto> leagues = new();
    private int selectedLeagueId;
    private LuckyLeagueViewDto selectedLeague;
    private List<LuckyBox> boxes = new();
    private int availablePoints;

    private int openingBoxId;
    private bool converting;

    private bool showReveal;
    private LuckyBoxOpenResultDto revealResult;

    private ElementReference orbitStageRef;
    private bool orbitStageRegistered;
    private bool orbitNeedsInit;

    // ===== هندسه بیضی (باید با مقادیر داخل <style> در پایین فایل هماهنگ باشد) =====
    private const double OrbitRx = 158;
    private const double OrbitRy = 112;

    private static string GetOrbitItemStyle(int index, int total)
    {
        var angle = total > 0 ? index * (360.0 / total) : 0;
        return string.Format(CultureInfo.InvariantCulture,
            "transform: rotate({0:0.###}deg) translate({1:0.##}px, 0);", angle, OrbitRx);
    }

    private static string GetOrbitCounterStyle(int index, int total)
    {
        var angle = total > 0 ? index * (360.0 / total) : 0;
        var unsquash = OrbitRx / OrbitRy;
        return string.Format(CultureInfo.InvariantCulture,
            "transform: rotate({0:0.###}deg) scaleY({1:0.####});", -angle, unsquash);
    }

    private static string GetSquashStyle()
        => string.Format(CultureInfo.InvariantCulture, "transform: scaleY({0:0.####});", OrbitRy / OrbitRx);

    private static string GetTrackStyle()
        => string.Format(CultureInfo.InvariantCulture,
            "width:{0:0.##}px; height:{1:0.##}px; transform: translate(-50%,-50%);", OrbitRx * 2, OrbitRy * 2);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;
        if (!user.Identity?.IsAuthenticated ?? true || !user.IsInRole("Customer"))
        {
            fatalError = "دسترسی مجاز نیست.";
            loading = false;
            return;
        }

        var claim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (claim == null || !int.TryParse(claim.Value, out userId))
        {
            fatalError = "خطا در دریافت اطلاعات کاربر.";
            loading = false;
            return;
        }

        await ReloadLeagues();

        var firstUnlocked = leagues.FirstOrDefault(l => l.IsUnlocked) ?? leagues.FirstOrDefault();
        if (firstUnlocked != null)
            await SelectLeague(firstUnlocked);

        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (orbitNeedsInit && boxes.Count > 0)
        {
            orbitNeedsInit = false;
            orbitStageRegistered = true;
            try { await JS.InvokeVoidAsync("luckyOrbit.init", orbitStageRef, boxes.Count); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    }

    private async Task ReloadLeagues()
    {
        try
        {
            leagues = await LuckyService.GetEligibleLeaguesAsync(userId);
            var summary = await PointService.GetUserPointsSummaryAsync(userId);
            availablePoints = summary.AvailablePoints;
            if (selectedLeagueId > 0)
                selectedLeague = leagues.FirstOrDefault(l => l.Id == selectedLeagueId);
        }
        catch (Exception ex)
        {
            fatalError = UserFacingErrorHelper.Format(ex, "خطا در بارگذاری لیگ‌ها:");
        }
    }

    private async Task SelectLeague(LuckyLeagueViewDto l)
    {
        if (!l.IsUnlocked) return;

        selectedLeagueId = l.Id;
        selectedLeague = l;
        boxes = new();
        actionMsg = "";
        await DisposeOrbitAsync();

        try
        {
            boxes = await LuckyService.GetOrStartRoundAsync(userId, l.Id);
            if (boxes.Count > 0) orbitNeedsInit = true;
        }
        catch (Exception ex)
        {
            actionOk = false;
            actionMsg = UserFacingErrorHelper.Format(ex, "خطا در بارگذاری جعبه‌ها:");
        }
    }

    private async Task OpenBox(LuckyBox box)
    {
        if (box.IsOpened || openingBoxId != 0 || selectedLeague == null) return;

        openingBoxId = box.Id;
        actionMsg = "";
        StateHasChanged();

        try
        {
            var roundId = boxes.Count > 0 ? boxes[0].RoundId : 0;
            var paymentMethod = selectedLeague.ChanceBalance > 0 ? "Chance" : "Points";

            var result = await LuckyService.OpenBoxAsync(userId, selectedLeagueId, roundId, box.Id, paymentMethod);

            if (!result.Success)
            {
                actionOk = false;
                actionMsg = result.Message;
            }
            else
            {
                box.IsOpened = true;
                box.IsLosing = result.IsLosing;
                box.PrizeType = result.PrizeType;
                box.PrizeTitle = result.PrizeTitle;
                box.ResultPointsCredited = result.PointsCredited;
                box.ResultCouponCode = result.CouponCode;

                revealResult = result;
                showReveal = true;

                await ReloadLeagues();

                if (result.RoundCompleted)
                {
                    await DisposeOrbitAsync();
                    boxes = await LuckyService.GetOrStartRoundAsync(userId, selectedLeagueId);
                    if (boxes.Count > 0) orbitNeedsInit = true;
                }
            }
        }
        catch (Exception ex)
        {
            actionOk = false;
            actionMsg = UserFacingErrorHelper.Format(ex, "خطا در باز کردن جعبه:");
        }
        finally
        {
            openingBoxId = 0;
        }
    }

    private void CloseReveal()
    {
        showReveal = false;
        revealResult = null;
    }

    private async Task ConvertToChance()
    {
        if (selectedLeague == null || converting) return;
        converting = true;
        try
        {
            var (success, message, _) = await LuckyService.ConvertPointsToChanceAsync(userId, selectedLeagueId);
            actionOk = success;
            actionMsg = message;
            if (success) await ReloadLeagues();
        }
        finally
        {
            converting = false;
        }
    }

    private async Task DisposeOrbitAsync()
    {
        if (!orbitStageRegistered) return;
        orbitStageRegistered = false;
        try { await JS.InvokeVoidAsync("luckyOrbit.dispose", orbitStageRef); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeOrbitAsync();
    }

    // ===== آیکون‌ها (SVG درون‌خطی — بدون ایموجی) =====
    private static readonly MarkupString LockIcon = new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"10\" rx=\"2\"/><path d=\"M8 10V7a4 4 0 0 1 8 0v3\"/></svg>");
    private static readonly MarkupString BlankIcon = new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg>");
    private static readonly MarkupString StarIcon = new("<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.7 7-6.3-3.9-6.3 3.9 1.7-7-5.4-4.7 7.1-.6z\"/></svg>");
    private static readonly MarkupString TagIcon = new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 12V5a2 2 0 0 1 2-2h7l9 9-9 9-9-9z\"/><circle cx=\"7.5\" cy=\"7.5\" r=\"1.4\" fill=\"currentColor\" stroke=\"none\"/></svg>");
    private static readonly MarkupString RefreshIcon = new("<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3\"/><path d=\"M18 3v5h-5M6 21v-5h5\"/></svg>");

    // ===== جعبه گنج سه‌بعدی — درب باز، تخته‌چوب، قفل فلزی (مکانیسم چرخش تغییر نمی‌کند) =====
    private static MarkupString BuildChestSvg(string uid)
    {
        var svg =
            "<defs>" +
            $"<radialGradient id=\"bg-{uid}\" cx=\"28%\" cy=\"18%\" r=\"92%\"><stop offset=\"0\" class=\"stop-body-hi\"/><stop offset=\"0.5\" class=\"stop-body-light\"/><stop offset=\"1\" class=\"stop-body-dark\"/></radialGradient>" +
            $"<radialGradient id=\"ld-{uid}\" cx=\"36%\" cy=\"14%\" r=\"95%\"><stop offset=\"0\" class=\"stop-lid-hi\"/><stop offset=\"0.45\" class=\"stop-lid-light\"/><stop offset=\"1\" class=\"stop-lid-dark\"/></radialGradient>" +
            $"<linearGradient id=\"mt-{uid}\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" class=\"stop-metal-light\"/><stop offset=\"0.38\" class=\"stop-metal-mid\"/><stop offset=\"1\" class=\"stop-metal-dark\"/></linearGradient>" +
            $"<linearGradient id=\"mtv-{uid}\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" class=\"stop-metal-light\"/><stop offset=\"0.5\" class=\"stop-metal-mid\"/><stop offset=\"1\" class=\"stop-metal-dark\"/></linearGradient>" +
            $"<linearGradient id=\"side-{uid}\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0\" class=\"stop-body-dark\"/><stop offset=\"1\" class=\"stop-body-deep\"/></linearGradient>" +
            $"<radialGradient id=\"int-{uid}\" cx=\"50%\" cy=\"20%\" r=\"80%\"><stop offset=\"0\" class=\"stop-interior-mid\"/><stop offset=\"1\" class=\"stop-interior-dark\"/></radialGradient>" +
            $"<linearGradient id=\"shine-{uid}\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"rgba(255,255,255,.62)\"/><stop offset=\"1\" stop-color=\"rgba(255,255,255,0)\"/></linearGradient>" +
            $"<filter id=\"glow-{uid}\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\"><feGaussianBlur stdDeviation=\"1.8\" result=\"b\"/><feMerge><feMergeNode in=\"b\"/><feMergeNode in=\"SourceGraphic\"/></feMerge></filter>" +
            "</defs>" +
            "<ellipse class=\"chest-shadow\" cx=\"70\" cy=\"126\" rx=\"48\" ry=\"8.5\"></ellipse>" +
            "<ellipse class=\"chest-shadow-soft\" cx=\"70\" cy=\"126\" rx=\"36\" ry=\"5\"></ellipse>" +
            $"<path class=\"chest-side\" d=\"M108 56 L128 62 L128 108 L108 102 Z\" fill=\"url(#side-{uid})\"></path>" +
            "<path class=\"chest-side-edge\" d=\"M108 56 L128 62\"></path>" +
            "<rect class=\"chest-foot\" x=\"22\" y=\"110\" width=\"16\" height=\"10\" rx=\"2.5\"></rect>" +
            "<rect class=\"chest-foot\" x=\"62\" y=\"110\" width=\"16\" height=\"10\" rx=\"2.5\"></rect>" +
            "<rect class=\"chest-foot\" x=\"102\" y=\"110\" width=\"16\" height=\"10\" rx=\"2.5\"></rect>" +
            $"<rect class=\"chest-outline\" x=\"14\" y=\"58\" width=\"94\" height=\"52\" rx=\"7\" fill=\"url(#bg-{uid})\"></rect>" +
            "<rect class=\"chest-plank-a\" x=\"18\" y=\"62\" width=\"86\" height=\"7\" rx=\"1\"></rect>" +
            "<rect class=\"chest-plank-b\" x=\"18\" y=\"69\" width=\"86\" height=\"7\" rx=\"1\"></rect>" +
            "<rect class=\"chest-plank-a\" x=\"18\" y=\"76\" width=\"86\" height=\"7\" rx=\"1\"></rect>" +
            "<rect class=\"chest-plank-b\" x=\"18\" y=\"83\" width=\"86\" height=\"7\" rx=\"1\"></rect>" +
            "<rect class=\"chest-plank-a\" x=\"18\" y=\"90\" width=\"86\" height=\"7\" rx=\"1\"></rect>" +
            "<rect class=\"chest-plank-b\" x=\"18\" y=\"97\" width=\"86\" height=\"7\" rx=\"1\"></rect>" +
            "<rect class=\"chest-body-shade\" x=\"14\" y=\"96\" width=\"94\" height=\"14\" rx=\"6\"></rect>" +
            $"<path class=\"chest-interior\" d=\"M24 44 L116 44 L110 58 L30 58 Z\" fill=\"url(#int-{uid})\"></path>" +
            "<rect class=\"chest-interior-rim\" x=\"30\" y=\"54\" width=\"80\" height=\"4\" rx=\"1\"></rect>" +
            $"<path class=\"chest-outline chest-lid\" d=\"M8 54 C8 4 70 -4 132 6 C134 44 132 52 126 54 C70 50 14 54 8 54 Z\" fill=\"url(#ld-{uid})\"></path>" +
            "<ellipse class=\"chest-sheen\" cx=\"44\" cy=\"20\" rx=\"32\" ry=\"12\" transform=\"rotate(-14 44 20)\"></ellipse>" +
            "<ellipse class=\"chest-sheen chest-sheen-soft\" cx=\"98\" cy=\"30\" rx=\"16\" ry=\"6\" transform=\"rotate(-8 98 30)\"></ellipse>" +
            $"<rect class=\"chest-outline\" x=\"8\" y=\"50\" width=\"124\" height=\"10\" rx=\"3\" fill=\"url(#mt-{uid})\"></rect>" +
            $"<rect class=\"chest-band-hi\" x=\"10\" y=\"51\" width=\"120\" height=\"3\" rx=\"1.5\" fill=\"url(#shine-{uid})\"></rect>" +
            $"<rect class=\"chest-strap chest-outline-thin\" x=\"24\" y=\"12\" width=\"14\" height=\"98\" rx=\"3.5\" fill=\"url(#mtv-{uid})\"></rect>" +
            $"<rect class=\"chest-strap chest-outline-thin\" x=\"102\" y=\"12\" width=\"14\" height=\"98\" rx=\"3.5\" fill=\"url(#mtv-{uid})\"></rect>" +
            $"<circle class=\"chest-stud\" cx=\"31\" cy=\"22\" r=\"3.1\" fill=\"url(#mt-{uid})\"></circle>" +
            $"<circle class=\"chest-stud\" cx=\"31\" cy=\"38\" r=\"3.1\" fill=\"url(#mt-{uid})\"></circle>" +
            $"<circle class=\"chest-stud\" cx=\"31\" cy=\"54\" r=\"3.1\" fill=\"url(#mt-{uid})\"></circle>" +
            $"<circle class=\"chest-stud\" cx=\"31\" cy=\"70\" r=\"3.1\" fill=\"url(#mt-{uid})\"></circle>" +
            $"<circle class=\"chest-stud\" cx=\"31\" cy=\"86\" r=\"3.1\" fill=\"url(#mt-{uid})\"></circle>" +
            $"<circle class=\"chest-stud\" cx=\"31\" cy=\"102\" r=\"3.1\" fill=\"url(#mt-{uid})\"></circle>" +
            $"<circle class=\"chest-stud\" cx=\"109\" cy=\"22\" r=\"3.1\" fill=\"url(#mt-{uid})\"></circle>" +
            $"<circle class=\"chest-stud\" cx=\"109\" cy=\"38\" r=\"3.1\" fill=\"url(#mt-{uid})\"></circle>" +
            $"<circle class=\"chest-stud\" cx=\"109\" cy=\"54\" r=\"3.1\" fill=\"url(#mt-{uid})\"></circle>" +
            $"<circle class=\"chest-stud\" cx=\"109\" cy=\"70\" r=\"3.1\" fill=\"url(#mt-{uid})\"></circle>" +
            $"<circle class=\"chest-stud\" cx=\"109\" cy=\"86\" r=\"3.1\" fill=\"url(#mt-{uid})\"></circle>" +
            $"<circle class=\"chest-stud\" cx=\"109\" cy=\"102\" r=\"3.1\" fill=\"url(#mt-{uid})\"></circle>" +
            $"<path class=\"chest-latch chest-outline-thin\" d=\"M50 56 L90 56 L70 80 Q70 83 67 80 Z\" fill=\"url(#mt-{uid})\" filter=\"url(#glow-{uid})\"></path>" +
            "<ellipse class=\"chest-sheen chest-sheen-soft\" cx=\"58\" cy=\"60\" rx=\"10\" ry=\"3\"></ellipse>" +
            "<circle class=\"chest-keyhole\" cx=\"70\" cy=\"65\" r=\"2.8\"></circle>" +
            "<path class=\"chest-keyhole\" d=\"M68.5 66.5 L71.5 66.5 L70.6 73 L69.4 73 Z\"></path>" +
            $"<path class=\"chest-handle chest-outline-thin\" d=\"M8 68 Q2 68 2 80 Q2 92 8 92\" fill=\"none\" stroke=\"url(#mt-{uid})\" stroke-width=\"5.5\" stroke-linecap=\"round\"></path>" +
            "<path class=\"chest-sparkle\" d=\"M118 14l2.8 8.2 8.2 2.8-8.2 2.8-2.8 8.2-2.8-8.2-8.2-2.8 8.2-2.8z\"></path>" +
            "<path class=\"chest-sparkle chest-sparkle-sm\" d=\"M12 20l1.8 5.2 5.2 1.8-5.2 1.8-1.8 5.2-1.8-5.2-5.2-1.8 5.2-1.8z\"></path>";
        return new MarkupString(svg);
    }
}

<style>
    .lucky-container {
        --c-green-50:#eafbf1; --c-green-600:#0e9448; --c-green-700:#0a7a3b;
        --c-purple-50:#f4effe; --c-purple-500:#7c3aed; --c-purple-600:#6d28d9;
        --c-amber-500:#f59e0b; --c-amber-600:#d97706; --c-blue-500:#2563eb;
        --c-ink-900:#14181a; --c-ink-500:#6b7478; --c-ink-300:#a4acaf; --c-ink-100:#e7eaec; --c-ink-50:#f4f6f7;
        --bg-app:#f4f6f5; --bg-surface:#fff; --bg-surface-sunken:#f4f6f7;
        --text-primary:#14181a; --text-secondary:#6b7478; --text-tertiary:#a4acaf;
        --border-subtle:#e7eaec; --brand-primary:#0e9448; --brand-primary-strong:#0a7a3b;
        --r-sm:10px; --r-md:16px; --r-lg:22px; --r-pill:999px;
        --shadow-card:0 1px 2px rgba(20,24,26,.04), 0 8px 24px -12px rgba(20,24,26,.12);
        --shadow-float:0 12px 32px -8px rgba(20,24,26,.22);
        --sp-3:12px; --sp-4:16px;

        direction: rtl; text-align: right;
        font-family: var(--font-body, 'Vazirmatn', 'Vazir', 'IRANSans', 'Segoe UI', Tahoma, sans-serif);
        max-width: 480px; margin: 0 auto; padding: var(--sp-4);
