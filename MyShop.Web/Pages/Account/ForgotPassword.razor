@page "/Account/forgot-password"
@layout AuthLayout

@using MyShop.Web.Services
@inject IPasswordResetService PasswordReset
@inject NavigationManager Nav

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!string.IsNullOrEmpty(infoMessage))
{
    <div class="alert alert-success">@infoMessage</div>
}

@if (step == 1)
{
    <p class="auth-step-hint">شماره موبایلی که با آن ثبت‌نام کرده‌اید را وارد کنید.</p>

    <div class="soft-field @(string.IsNullOrWhiteSpace(phoneNumber) ? "" : "filled")">
        <div class="field-container">
            <input id="fp-phone" class="login-input" type="tel" inputmode="numeric" autocomplete="tel"
                   placeholder=" " @bind="phoneNumber" @bind:event="oninput"
                   @onkeypress="OnPhoneKey" dir="ltr" />
            <label for="fp-phone">شماره موبایل</label>
            <div class="field-accent"></div>
        </div>
    </div>

    <button type="button" class="comfort-button" @onclick="SendCode" disabled="@loading">
        @if (loading) { <span class="spinner-small"></span> }
        else { <span>ارسال کد پیامکی</span> }
    </button>

    <div class="comfort-signup">
        <button type="button" class="comfort-link" @onclick="GoLogin">بازگشت به ورود</button>
    </div>
}
else if (step == 2)
{
    <button type="button" class="back-button" @onclick="BackToPhoneStep">← تغییر شماره</button>

    <p class="auth-step-hint">کد پیامک‌شده را وارد کنید. اعتبار کد ۵ دقیقه است.</p>

    <div class="soft-field @(string.IsNullOrWhiteSpace(otpCode) ? "" : "filled")">
        <div class="field-container">
            <input id="fp-otp" class="login-input" type="text" inputmode="numeric" autocomplete="one-time-code"
                   maxlength="6" placeholder=" " @bind="otpCode" @bind:event="oninput" dir="ltr" />
            <label for="fp-otp">کد پیامکی</label>
            <div class="field-accent"></div>
        </div>
    </div>

    <div class="soft-field has-toggle @(string.IsNullOrWhiteSpace(newPassword) ? "" : "filled")">
        <div class="field-container">
            <input id="fp-pass" class="login-input" type="@(showPass ? "text" : "password")"
                   autocomplete="new-password" placeholder=" "
                   @bind="newPassword" @bind:event="oninput" />
            <label for="fp-pass">رمز عبور جدید</label>
            <button type="button" class="gentle-toggle" @onclick="() => showPass = !showPass" aria-label="نمایش رمز">
                @(showPass ? "مخفی" : "نمایش")
            </button>
            <div class="field-accent"></div>
        </div>
    </div>

    <div class="soft-field has-toggle @(string.IsNullOrWhiteSpace(confirmPassword) ? "" : "filled")">
        <div class="field-container">
            <input id="fp-pass2" class="login-input" type="@(showPass2 ? "text" : "password")"
                   autocomplete="new-password" placeholder=" "
                   @bind="confirmPassword" @bind:event="oninput"
                   @onkeypress="OnResetKey" />
            <label for="fp-pass2">تکرار رمز عبور جدید</label>
            <button type="button" class="gentle-toggle" @onclick="() => showPass2 = !showPass2" aria-label="نمایش تکرار رمز">
                @(showPass2 ? "مخفی" : "نمایش")
            </button>
            <div class="field-accent"></div>
        </div>
    </div>

    <button type="button" class="comfort-button" @onclick="ResetPassword" disabled="@loading">
        @if (loading) { <span class="spinner-small"></span> }
        else { <span>تغییر رمز عبور</span> }
    </button>

    <div class="comfort-signup">
        <ResendTimer @ref="resendTimer" Seconds="300" AutoStart="true" ButtonText="ارسال مجدد کد" ButtonClass="comfort-link"
                     Disabled="@loading" OnClick="ResendCode" />
    </div>
}
else
{
    <p class="auth-step-hint">رمز عبور شما با موفقیت تغییر کرد.</p>
    <button type="button" class="comfort-button" @onclick="GoLogin">ورود با رمز جدید</button>
}

@code {
    [SupplyParameterFromQuery(Name = "role")]
    public string Role { get; set; }

    [SupplyParameterFromQuery(Name = "phone")]
    public string PhoneQuery { get; set; }

    private bool isStore => string.Equals(Role, "store", StringComparison.OrdinalIgnoreCase)
                         || string.Equals(Role, "StoreOwner", StringComparison.OrdinalIgnoreCase);
    private int roleId => isStore ? 2 : 3;
    private string LoginUrl => isStore ? "/Account/login-store" : "/Account/login-customer";

    private string _phoneNumber = "";
    private string phoneNumber { get => _phoneNumber; set => _phoneNumber = NumberFormatHelper.ToIranMobile(value ?? ""); }
    private string otpCode = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string errorMessage = "";
    private string infoMessage = "";
    private bool loading;
    private bool showPass;
    private bool showPass2;
    private int step = 1;
    private ResendTimer resendTimer;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(PhoneQuery))
            phoneNumber = PhoneQuery;
        if (string.IsNullOrWhiteSpace(Role))
            Role = "customer";
    }

    private async Task SendCode()
    {
        errorMessage = "";
        infoMessage = "";
        if (string.IsNullOrWhiteSpace(phoneNumber))
        {
            errorMessage = "لطفاً شماره موبایل را وارد کنید.";
            return;
        }

        loading = true;
        try
        {
            var (ok, message) = await PasswordReset.SendResetCodeAsync(phoneNumber, roleId);
            if (!ok)
            {
                errorMessage = message;
                return;
            }
            infoMessage = message;
            step = 2;
            otpCode = "";
            newPassword = "";
            confirmPassword = "";
            resendTimer?.Start(300);
        }
        finally { loading = false; }
    }

    private async Task ResendCode() => await SendCode();

    private void BackToPhoneStep()
    {
        step = 1;
        errorMessage = "";
        infoMessage = "";
        otpCode = "";
        newPassword = "";
        confirmPassword = "";
    }

    private async Task ResetPassword()
    {
        errorMessage = "";
        infoMessage = "";

        if (string.IsNullOrWhiteSpace(otpCode))
        {
            errorMessage = "کد پیامکی را وارد کنید.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newPassword) || newPassword.Length < 8)
        {
            errorMessage = "رمز عبور باید حداقل ۸ کاراکتر باشد.";
            return;
        }
        if (newPassword != confirmPassword)
        {
            errorMessage = "رمز عبور و تکرار آن یکسان نیست.";
            return;
        }

        loading = true;
        try
        {
            var (ok, message) = await PasswordReset.ResetPasswordAsync(phoneNumber, roleId, otpCode, newPassword);
            if (!ok)
            {
                errorMessage = message;
                return;
            }
            infoMessage = message;
            step = 3;
        }
        finally { loading = false; }
    }

    private async Task OnPhoneKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendCode();
    }

    private async Task OnResetKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ResetPassword();
    }

    private void GoLogin() => Nav.NavigateTo(LoginUrl);
}
