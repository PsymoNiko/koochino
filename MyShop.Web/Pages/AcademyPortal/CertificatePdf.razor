@page "/academy/certificate-pdf/{Id:int}"
@layout EmptyLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Instructor,Student")]

<p dir="rtl" style="font-family:Tahoma,sans-serif;padding:24px;">در حال آماده‌سازی گواهی...</p>

@code {
    [Parameter] public int Id { get; set; }
    [Inject] NavigationManager Nav { get; set; }

    protected override void OnInitialized()
    {
        Nav.NavigateTo($"/academy/certificate-file/{Id}", forceLoad: true);
    }
}
