@page "/academy/certificates"
@layout StudentLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@attribute [Authorize(Roles = "Student")]

<div dir="rtl" lang="fa">
@if (loading) { <p class="empty-text">در حال بارگذاری...</p> }
else if (student == null) { <p class="empty-text">پروفایل دانش‌آموز یافت نشد.</p> }
else if (!string.IsNullOrEmpty(message))
{
    <div class="alert-box alert-err">@message</div>
}
else if (!items.Any())
{
    <p class="empty-text">گواهی صادرشده‌ای ندارید. پس از تکمیل دوره، مربی یا ادمین گواهی را صادر می‌کند.</p>
}
else
{
    <div class="academy-cards">
        @foreach (var x in items)
        {
            <article class="academy-card">
                <div class="academy-card-top">
                    <div class="academy-card-id">
                        <strong>@x.CourseTitle</strong>
                        <span class="academy-card-meta">@x.CertificateNo · @x.IssuedAt.ToString("yyyy/MM/dd")</span>
                    </div>
                    <span class="status-badge @(x.IsIssued ? "status-ok" : "status-bad")">@(x.IsIssued ? "صادر شده" : "باطل شده")</span>
                </div>
                @if (x.IsIssued)
                {
                    <a class="btn-card" href="/academy/certificate-file/@x.Id">دانلود PDF</a>
                }
            </article>
        }
    </div>
}
</div>

@code {
    [Inject] IAcademyCertificateService CertSvc { get; set; }
    [Inject] IAcademyStudentService Students { get; set; }
    [Inject] AuthenticationStateProvider Auth { get; set; }
    AcademyStudentDto student;
    List<AcademyCertificateDto> items = new();
    bool loading = true;
    string message = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(idClaim, out var userId))
            student = await Students.GetByUserIdAsync(userId);
        if (student != null)
        {
            try { items = await CertSvc.GetAllAsync(studentId: student.Id) ?? new(); }
            catch { message = "گواهی در دسترس نیست."; }
        }
        loading = false;
    }
}
