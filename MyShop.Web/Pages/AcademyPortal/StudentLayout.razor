@using System.Collections.Generic
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@attribute [Authorize(Roles = "Student")]
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IAcademyStudentService Students
@inject IAcademyPointsService Points

@if (blocked)
{
    <div class="academy-blocked" dir="rtl" lang="fa">
        <p>@blockMessage</p>
        <a href="/Account/logout">خروج</a>
    </div>
}
else if (ready)
{
    <div class="mobile-app-layout academy-student-layout" dir="rtl" lang="fa">
        <div class="app-header">
            <div class="app-header-content">
                <button class="menu-btn" @onclick="ToggleDrawer" type="button">
                    <span style="font-size: 24px;">☰</span>
                </button>
                <div class="header-title">
                    <h1>@GetPageTitle()</h1>
                </div>
                <div class="header-actions">
                    <button class="profile-btn" @onclick="@(() => GoTo("/academy/profile"))" type="button">
                        <span style="font-size: 24px;">👤</span>
                    </button>
                </div>
            </div>
            <div class="account-balance-bar">
                <div class="balance-item">
                    <span class="balance-label">🏆 امتیاز آموزشگاه:</span>
                    <span class="balance-amount">@userPoints</span>
                </div>
            </div>
        </div>

        <div class="app-content">
            @Body
        </div>

        @if (!mustChange)
        {
            <div class="bottom-nav">
                <div class="bottom-nav-row">
                    <button class="nav-item @(IsActive("/academy") && !HasSubPath() ? "active" : "")"
                            @onclick="@(() => GoTo("/academy"))" type="button">
                        <span class="nav-icon">🏠</span>
                        <span class="nav-label">پیشخوان</span>
                    </button>
                    <button class="nav-item @(IsActive("/academy/enrollments") ? "active" : "")"
                            @onclick="@(() => GoTo("/academy/enrollments"))" type="button">
                        <span class="nav-icon">📋</span>
                        <span class="nav-label">ثبت‌نام‌ها</span>
                    </button>
                    <button class="nav-item nav-item-cta @(IsActive("/academy/courses") ? "active" : "")"
                            @onclick="@(() => GoTo("/academy/courses"))" type="button" aria-label="دوره‌ها">
                        <span class="nav-cta-circle">＋</span>
                        <span class="nav-label">دوره‌ها</span>
                    </button>
                    <button class="nav-item @(IsActive("/academy/payments") ? "active" : "")"
                            @onclick="@(() => GoTo("/academy/payments"))" type="button">
                        <span class="nav-icon">💳</span>
                        <span class="nav-label">شهریه</span>
                    </button>
                    <button class="nav-item @(IsActive("/academy/profile") ? "active" : "")"
                            @onclick="@(() => GoTo("/academy/profile"))" type="button">
                        <span class="nav-icon">👤</span>
                        <span class="nav-label">پروفایل</span>
                    </button>
                </div>
            </div>
        }

        @if (drawerOpen)
        {
            <div class="drawer-overlay" @onclick="ToggleDrawer"></div>
        }
        <div class="customer-drawer @(drawerOpen ? "drawer-open" : "")">
            <div class="drawer-header">
                <div class="drawer-profile">
                    <div class="drawer-avatar">
                        <img src="/img/pro.jpg" alt="پروفایل" />
                    </div>
                    <div class="drawer-user-info">
                        <h3>@currentUserName</h3>
                        <p>دانش‌آموز</p>
                    </div>
                </div>
                <button class="drawer-close" @onclick="ToggleDrawer" type="button">✕</button>
            </div>
            <nav class="drawer-menu drawer-menu-centered">
                @if (!mustChange)
                {
                    <div class="drawer-menu-group">
                        <button class="drawer-menu-item @(IsActive("/academy") && !HasSubPath() ? "active" : "")"
                                @onclick="@(() => GoTo("/academy"))" type="button">
                            <span class="menu-icon">📊</span>
                            <span>پیشخوان</span>
                        </button>
                    </div>

                    <div class="drawer-menu-group">
                        <button class="drawer-group-title @(IsGroupOpen("learn") ? "open" : "")"
                                @onclick="@(() => ToggleGroup("learn"))" type="button">
                            <span class="menu-icon">🎓</span>
                            <span>دوره و ثبت‌نام</span>
                            <span class="group-chevron">▼</span>
                        </button>
                        @if (IsGroupOpen("learn"))
                        {
                            <div class="drawer-submenu">
                                <button class="drawer-submenu-item @(IsActive("/academy/courses") ? "active" : "")" @onclick="@(() => GoTo("/academy/courses"))" type="button"><span class="menu-icon">📚</span><span>دوره‌ها</span></button>
                                <button class="drawer-submenu-item @(IsActive("/academy/learn") ? "active" : "")" @onclick="@(() => GoTo("/academy/learn"))" type="button"><span class="menu-icon">📖</span><span>درس و آزمون</span></button>
                                <button class="drawer-submenu-item @(IsActive("/academy/enrollments") ? "active" : "")" @onclick="@(() => GoTo("/academy/enrollments"))" type="button"><span class="menu-icon">📋</span><span>ثبت‌نام‌های من</span></button>
                                <button class="drawer-submenu-item @(IsActive("/academy/sessions") ? "active" : "")" @onclick="@(() => GoTo("/academy/sessions"))" type="button"><span class="menu-icon">🕐</span><span>جلسات باز</span></button>
                                <button class="drawer-submenu-item @(IsActive("/academy/daily") && !IsActive("/academy/daily-requests") ? "active" : "")" @onclick="@(() => GoTo("/academy/daily"))" type="button"><span class="menu-icon">📆</span><span>روزهای Daily</span></button>
                                <button class="drawer-submenu-item @(IsActive("/academy/requests") ? "active" : "")" @onclick="@(() => GoTo("/academy/requests"))" type="button"><span class="menu-icon">📨</span><span>درخواست‌های من</span></button>
                            </div>
                        }
                    </div>

                    <div class="drawer-menu-group">
                        <button class="drawer-group-title @(IsGroupOpen("attend") ? "open" : "")"
                                @onclick="@(() => ToggleGroup("attend"))" type="button">
                            <span class="menu-icon">✅</span>
                            <span>حضور و برنامه</span>
                            <span class="group-chevron">▼</span>
                        </button>
                        @if (IsGroupOpen("attend"))
                        {
                            <div class="drawer-submenu">
                                <button class="drawer-submenu-item @(IsActive("/academy/attendance") ? "active" : "")" @onclick="@(() => GoTo("/academy/attendance"))" type="button"><span class="menu-icon">📝</span><span>حضورغیاب</span></button>
                                <button class="drawer-submenu-item @(IsActive("/academy/calendar") ? "active" : "")" @onclick="@(() => GoTo("/academy/calendar"))" type="button"><span class="menu-icon">📅</span><span>تقویم</span></button>
                            </div>
                        }
                    </div>

                    <div class="drawer-menu-group">
                        <button class="drawer-group-title @(IsGroupOpen("finance") ? "open" : "")"
                                @onclick="@(() => ToggleGroup("finance"))" type="button">
                            <span class="menu-icon">💳</span>
                            <span>شهریه و امتیاز</span>
                            <span class="group-chevron">▼</span>
                        </button>
                        @if (IsGroupOpen("finance"))
                        {
                            <div class="drawer-submenu">
                                <button class="drawer-submenu-item @(IsActive("/academy/payments") ? "active" : "")" @onclick="@(() => GoTo("/academy/payments"))" type="button"><span class="menu-icon">💰</span><span>شهریه</span></button>
                                <button class="drawer-submenu-item @(IsActive("/academy/points") ? "active" : "")" @onclick="@(() => GoTo("/academy/points"))" type="button"><span class="menu-icon">🏆</span><span>امتیاز آموزشگاه</span></button>
                                <button class="drawer-submenu-item @(IsActive("/academy/missions") ? "active" : "")" @onclick="@(() => GoTo("/academy/missions"))" type="button"><span class="menu-icon">🎯</span><span>ماموریت امتیاز</span></button>
                            </div>
                        }
                    </div>

                    <div class="drawer-menu-group">
                        <button class="drawer-group-title @(IsGroupOpen("progress") ? "open" : "")"
                                @onclick="@(() => ToggleGroup("progress"))" type="button">
                            <span class="menu-icon">⭐</span>
                            <span>پیشرفت</span>
                            <span class="group-chevron">▼</span>
                        </button>
                        @if (IsGroupOpen("progress"))
                        {
                            <div class="drawer-submenu">
                                <button class="drawer-submenu-item @(IsActive("/academy/certificates") ? "active" : "")" @onclick="@(() => GoTo("/academy/certificates"))" type="button"><span class="menu-icon">📜</span><span>گواهی</span></button>
                                <button class="drawer-submenu-item @(IsActive("/academy/evaluations") ? "active" : "")" @onclick="@(() => GoTo("/academy/evaluations"))" type="button"><span class="menu-icon">⭐</span><span>ارزیابی</span></button>
                                <button class="drawer-submenu-item @(IsActive("/academy/reports") ? "active" : "")" @onclick="@(() => GoTo("/academy/reports"))" type="button"><span class="menu-icon">📈</span><span>گزارش من</span></button>
                            </div>
                        }
                    </div>

                    <div class="drawer-menu-group">
                        <button class="drawer-group-title @(IsGroupOpen("mosque") ? "open" : "")"
                                @onclick="@(() => ToggleGroup("mosque"))" type="button">
                            <span class="menu-icon">🕌</span>
                            <span>مسجد</span>
                            <span class="group-chevron">▼</span>
                        </button>
                        @if (IsGroupOpen("mosque"))
                        {
                            <div class="drawer-submenu">
                                <button class="drawer-submenu-item" @onclick="@(() => GoTo("/mission"))" type="button"><span class="menu-icon">📜</span><span>ماموریت مسجد</span></button>
                                <button class="drawer-submenu-item" @onclick="@(() => GoTo("/hall"))" type="button"><span class="menu-icon">🏛️</span><span>سالن و Daily</span></button>
                                <button class="drawer-submenu-item" @onclick="@(() => GoTo("/education"))" type="button"><span class="menu-icon">🎓</span><span>آموزش عمومی</span></button>
                                <button class="drawer-submenu-item" @onclick="@(() => GoTo("/charity"))" type="button"><span class="menu-icon">💚</span><span>خیریه</span></button>
                                <button class="drawer-submenu-item" @onclick="@(() => GoTo("/library"))" type="button"><span class="menu-icon">📚</span><span>کتابخانه</span></button>
                            </div>
                        }
                    </div>

                    <div class="drawer-menu-group">
                        <button class="drawer-group-title @(IsGroupOpen("tickets") ? "open" : "")"
                                @onclick="@(() => ToggleGroup("tickets"))" type="button">
                            <span class="menu-icon">🎫</span>
                            <span>پشتیبانی</span>
                            <span class="group-chevron">▼</span>
                        </button>
                        @if (IsGroupOpen("tickets"))
                        {
                            <div class="drawer-submenu">
                                <button class="drawer-submenu-item @(IsActive("/academy/tickets/create") ? "active" : "")" @onclick="@(() => GoTo("/academy/tickets/create"))" type="button"><span class="menu-icon">✏️</span><span>ثبت تیکت</span></button>
                                <button class="drawer-submenu-item @(IsActive("/academy/tickets") && !IsActive("/academy/tickets/create") ? "active" : "")" @onclick="@(() => GoTo("/academy/tickets"))" type="button"><span class="menu-icon">📋</span><span>مشاهده تیکت‌ها</span></button>
                            </div>
                        }
                    </div>
                }

                <div class="drawer-menu-group">
                    <button class="drawer-menu-item @(IsActive("/academy/profile") ? "active" : "")"
                            @onclick="@(() => GoTo("/academy/profile"))" type="button">
                        <span class="menu-icon">🔐</span>
                        <span>تغییر رمز</span>
                    </button>
                </div>
                <div class="drawer-divider"></div>
                <button class="drawer-menu-item drawer-menu-item-logout" @onclick="@(() => GoTo("/Account/logout"))" type="button">
                    <span class="menu-icon">🚪</span>
                    <span>خروج</span>
                </button>
            </nav>
        </div>
    </div>
}

<style>
    .academy-blocked { max-width: 520px; margin: 48px auto; padding: 24px; background: #fff; border-radius: 12px; font-family: Tahoma, sans-serif; direction: rtl; text-align: right; }
    .mobile-app-layout {
        --app-primary: #0f766e; --app-primary-dark: #115e59; --app-secondary: #14b8a6;
        --app-bg: #f5f5f5; --app-surface: #ffffff; --app-text: #1f2937;
        --app-text-secondary: #6b7280; --app-border: #e5e7eb; --app-shadow: 0 2px 8px rgba(0,0,0,.1);
        min-height: 100vh; min-height: 100dvh; background: var(--app-bg);
        font-family: Vazir, Vazirmatn, Tahoma, sans-serif;
        padding-bottom: 64px; padding-left: env(safe-area-inset-left, 0px); padding-right: env(safe-area-inset-right, 0px);
        direction: rtl; text-align: right;
    }
    @@media (display-mode: standalone), (display-mode: minimal-ui) {
        .mobile-app-layout { padding-bottom: calc(64px + env(safe-area-inset-bottom, 0px)); }
    }
    .app-header { position: sticky; top: 0; z-index: 100; background: var(--app-surface); box-shadow: var(--app-shadow); border-bottom: 1px solid var(--app-border); padding-top: env(safe-area-inset-top, 0px); }
    .app-header-content { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; gap: 12px; }
    .header-title h1 { margin: 0; font-size: 20px; font-weight: 700; color: var(--app-text); flex: 1; text-align: center; }
    .header-actions { display: flex; align-items: center; gap: 8px; }
    .menu-btn, .profile-btn { min-width: 44px; min-height: 44px; background: none; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; }
    .account-balance-bar { background: linear-gradient(135deg, var(--app-primary), var(--app-secondary)); color: #fff; padding: 8px 16px; display: flex; align-items: center; font-size: 14px; }
    .balance-item { display: flex; align-items: center; gap: 8px; }
    .balance-amount { font-weight: 700; font-size: 16px; }
    .academy-student-layout, .academy-student-layout * { box-sizing: border-box; }
    .academy-student-layout { overflow-x: hidden; width: 100%; max-width: 100vw; }
    .app-content { padding: 16px; min-height: calc(100vh - 140px - 70px); max-width: 1200px; margin: 0 auto; width: 100%; direction: rtl; text-align: right; overflow-x: hidden; }
    .app-content img { max-width: 100%; height: auto; }
    .app-content table, .app-content .table, .app-content .table__box { display: none !important; }
    .app-content h1, .app-content h2, .app-content h3, .app-content p, .app-content label { text-align: right; }
    .app-content input, .app-content textarea, .app-content select { text-align: right; direction: rtl; }
    .bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; background: var(--app-surface); border-top: 1px solid var(--app-border); box-shadow: 0 -2px 8px rgba(0,0,0,.1); z-index: 200; }
    .bottom-nav-row { display: flex; justify-content: space-around; align-items: center; min-height: 56px; padding: 4px 0 8px; }
    .nav-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px; background: none; border: none; padding: 4px; cursor: pointer; min-height: 48px; color: var(--app-text-secondary); }
    .nav-item.active { color: var(--app-primary); }
    .nav-item-cta { position: relative; margin-top: -18px; }
    .nav-cta-circle { width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, var(--app-primary), var(--app-secondary)); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28px; font-weight: 700; box-shadow: 0 4px 14px rgba(15,118,110,.45); margin-bottom: 2px; }
    .nav-item-cta .nav-label { color: var(--app-primary); font-weight: 700; font-size: 11px; }
    .nav-icon { font-size: 24px; line-height: 1; }
    .nav-label { font-size: 11px; font-weight: 500; }
    .drawer-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 999; }
    .customer-drawer { position: fixed; top: 0; right: -320px; width: 320px; max-width: 85vw; height: 100vh; background: var(--app-surface); z-index: 1000; transition: right .3s ease; overflow-y: auto; direction: rtl; }
    .customer-drawer.drawer-open { right: 0; }
    .drawer-header { position: relative; padding: 16px; }
    .drawer-close { position: absolute; top: 16px; left: 16px; background: rgba(255,255,255,.2); border: none; color: #fff; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; }
    .drawer-profile { display: flex; align-items: center; gap: 16px; padding: 16px; background: linear-gradient(135deg, var(--app-primary), var(--app-secondary)); color: #fff; border-radius: 12px; }
    .drawer-avatar { width: 64px; height: 64px; border-radius: 50%; overflow: hidden; background: rgba(255,255,255,.2); }
    .drawer-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .drawer-user-info h3 { margin: 0 0 4px; font-size: 18px; color: #fff; }
    .drawer-user-info p { margin: 0; font-size: 14px; opacity: .9; }
    .drawer-menu { padding: 8px 0; }
    .drawer-menu-item, .drawer-group-title { display: flex; align-items: center; gap: 16px; padding: 14px 20px; color: var(--app-text); border: none; background: none; width: 100%; text-align: right; font-size: 16px; cursor: pointer; }
    .drawer-menu-item.active { background: rgba(15,118,110,.15); color: var(--app-primary); border-right: 3px solid var(--app-primary); font-weight: 600; }
    .drawer-menu-item-logout { color: #ef4444 !important; }
    .menu-icon { font-size: 20px; width: 24px; text-align: center; }
    .drawer-divider { height: 1px; background: var(--app-border); margin: 8px 20px; }
    .drawer-group-title .group-chevron { margin-right: auto; font-size: 12px; }
    .drawer-group-title.open .group-chevron { transform: rotate(180deg); }
    .drawer-submenu { padding: 0 0 8px; background: rgba(0,0,0,.02); }
    .drawer-submenu-item { display: flex; align-items: center; gap: 10px; width: 100%; padding: 10px 20px 10px 44px; border: none; background: none; color: #64748b; font-size: 14px; text-align: right; cursor: pointer; direction: rtl; }
    .drawer-submenu-item.active { background: rgba(15,118,110,.15); color: var(--app-primary); font-weight: 600; border-right: 3px solid var(--app-primary); }
    .academy-cards { display: flex; flex-direction: column; gap: 14px; width: 100%; min-width: 0; }
    .academy-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 16px; padding: 14px; box-shadow: 0 2px 10px rgba(0,0,0,.06); text-align: right; width: 100%; min-width: 0; overflow: hidden; }
    .academy-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #f3f4f6; }
    .academy-card-id { display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1; }
    .academy-card-id strong { font-size: .95rem; color: #111827; word-break: break-word; overflow-wrap: anywhere; }
    .academy-card-meta { font-size: .8rem; color: #6b7280; line-height: 1.45; overflow-wrap: anywhere; }
    .academy-card-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 8px; font-size: .9rem; }
    .academy-card-row span { color: #6b7280; flex-shrink: 0; }
    .academy-card-row strong { color: #0f766e; min-width: 0; flex: 1; text-align: left; word-break: break-word; overflow-wrap: anywhere; }
    .academy-card .btn-card, .btn-card { display: flex; align-items: center; justify-content: center; width: 100%; margin-top: 6px; padding: 10px 12px; min-height: 44px; font-size: .9rem; font-weight: 600; border-radius: 10px; border: none; background: #0f766e; color: #fff; text-decoration: none; cursor: pointer; }
    .academy-card .btn-card.ghost, .btn-card.ghost { background: #fff; color: #dc2626; border: 1px solid #dc2626; }
    .academy-seg { display: flex; gap: 8px; margin-bottom: 14px; width: 100%; }
    .academy-seg button { flex: 1; min-width: 0; min-height: 44px; border-radius: 10px; border: 1px solid #0f766e; background: #fff; color: #0f766e; font-weight: 600; font-size: .85rem; cursor: pointer; }
    .academy-seg button.is-on { background: #0f766e; color: #fff; }
    .academy-filter { width: 100%; margin-bottom: 12px; }
    .academy-filter select { width: 100%; min-height: 44px; padding: 10px 12px; border-radius: 10px; border: 1px solid #cbd5e1; background: #fff; }
    .status-badge { padding: 4px 10px; border-radius: 20px; font-size: 12px; white-space: nowrap; flex-shrink: 0; }
    .status-ok { background: #d1fae5; color: #065f46; }
    .status-wait { background: #fef3c7; color: #92400e; }
    .status-bad { background: #fee2e2; color: #991b1b; }
    .status-info { background: #e0e7ff; color: #3730a3; }
    .empty-text { color: #6b7280; margin: 0 0 12px; }
    .section-link { color: #0f766e; font-weight: 500; font-size: 14px; }
    .stats-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-bottom: 16px; }
    .stat-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 12px; text-align: right; min-width: 0; }
    .stat-card .label { display: block; color: #6b7280; font-size: 12px; }
    .stat-card .value { font-size: 1.15rem; font-weight: 700; color: #0f766e; overflow-wrap: anywhere; }
    .quick-links-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .quick-link-card { display: flex; align-items: center; justify-content: center; padding: 16px; background: #ecfdf5; color: #115e59; border-radius: 12px; text-decoration: none; font-weight: 600; font-size: 14px; text-align: center; border: 1px solid #99f6e4; min-height: 48px; }
    .dash-h { margin: 18px 0 8px; font-size: 15px; color: #334155; }
    .alert-box { padding: 12px; border-radius: 10px; margin-bottom: 12px; }
    .alert-ok { background: #ecfdf5; }
    .alert-err { background: #fee2e2; }
    @@media (min-width: 992px) {
        .mobile-app-layout { padding-bottom: 0; }
        .bottom-nav { display: none; }
        .header-title h1 { text-align: right; }
        .app-content { padding: 24px; }
        .stats-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .quick-links-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @@media (max-width: 767px) {
        .header-title h1 { font-size: 18px; }
        .app-content { padding: 12px; }
        .nav-label { font-size: 10px; }
    }
</style>

@code {
    bool ready, blocked, mustChange, drawerOpen;
    string blockMessage = "", currentUserName = "دانش‌آموز";
    int userPoints;
    HashSet<string> openGroups = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        currentUserName = user?.FindFirst(ClaimTypes.GivenName)?.Value
            ?? user?.FindFirst(ClaimTypes.Name)?.Value
            ?? "دانش‌آموز";
        var idClaim = user?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(idClaim, out var userId) || userId <= 0)
        {
            blocked = true;
            blockMessage = "لطفاً دوباره وارد شوید.";
            return;
        }

        var student = await Students.GetByUserIdAsync(userId);
        if (student == null)
        {
            blocked = true;
            blockMessage = "پروفایل دانش‌آموز یافت نشد.";
            return;
        }
        if (!string.Equals(student.Status, AcademyConstants.StudentStatus.Active, StringComparison.OrdinalIgnoreCase))
        {
            blocked = true;
            blockMessage = "حساب دانش‌آموزی شما غیرفعال است.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(student.FullName) && student.FullName.Trim() != "-")
            currentUserName = student.FullName.Trim();

        try { userPoints = await Points.GetBalanceAsync(student.Id); } catch { userPoints = 0; }

        mustChange = student.MustChangePassword;
        if (mustChange && !IsAllowedDuringPasswordChange())
        {
            Nav.NavigateTo("/academy/profile");
            return;
        }

        var path = (Nav?.Uri ?? "").ToLowerInvariant();
        if (path.Contains("/academy/course") || path.Contains("/academy/enrollment") || path.Contains("/academy/session") || path.Contains("/academy/request") || path.Contains("/academy/daily"))
            openGroups.Add("learn");
        else if (path.Contains("/academy/attendance") || path.Contains("/academy/calendar"))
            openGroups.Add("attend");
        else if (path.Contains("/academy/payment") || path.Contains("/academy/points") || path.Contains("/academy/missions"))
            openGroups.Add("finance");
        else if (path.Contains("/academy/certificate") || path.Contains("/academy/evaluation") || path.Contains("/academy/report"))
            openGroups.Add("progress");
        else if (path.Contains("/academy/ticket"))
            openGroups.Add("tickets");

        ready = true;
    }

    void ToggleDrawer() => drawerOpen = !drawerOpen;
    void ToggleGroup(string key) { if (!openGroups.Add(key)) openGroups.Remove(key); }
    bool IsGroupOpen(string key) => openGroups.Contains(key);
    void GoTo(string url) { Nav.NavigateTo(url, true); drawerOpen = false; }

    bool IsActive(string route)
    {
        var uri = Nav.Uri?.ToLowerInvariant() ?? "";
        return !string.IsNullOrEmpty(route) && uri.Contains(route.ToLowerInvariant());
    }

    bool HasSubPath()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri ?? "").Trim('/').ToLowerInvariant();
        return path.StartsWith("academy/") && path != "academy";
    }

    string GetPageTitle()
    {
        var uri = Nav.Uri?.ToLowerInvariant() ?? "";
        if (uri.Contains("/academy/courses/") && uri.Contains("/quiz")) return "آزمون";
        if (uri.Contains("/academy/courses/")) return "جزئیات دوره";
        if (uri.Contains("/academy/courses")) return "دوره‌ها";
        if (uri.Contains("/academy/enrollments")) return "ثبت‌نام‌های من";
        if (uri.Contains("/academy/payments")) return "شهریه";
        if (uri.Contains("/academy/attendance")) return "حضورغیاب";
        if (uri.Contains("/academy/sessions")) return "جلسات";
        if (uri.Contains("/academy/daily")) return "روزهای Daily";
        if (uri.Contains("/academy/requests")) return "درخواست‌ها";
        if (uri.Contains("/academy/calendar")) return "تقویم";
        if (uri.Contains("/academy/certificates")) return "گواهی";
        if (uri.Contains("/academy/evaluations")) return "ارزیابی";
        if (uri.Contains("/academy/learn")) return "درس و آزمون";
        if (uri.Contains("/academy/missions")) return "ماموریت امتیاز";
        if (uri.Contains("/academy/points")) return "امتیاز آموزشگاه";
        if (uri.Contains("/academy/reports")) return "گزارش من";
        if (uri.Contains("/academy/tickets/create")) return "ثبت تیکت";
        if (uri.Contains("/academy/tickets")) return "تیکت‌ها";
        if (uri.Contains("/academy/profile")) return "پروفایل";
        if (uri.Contains("/academy/attend")) return "ثبت حضور";
        return "پیشخوان";
    }

    bool IsAllowedDuringPasswordChange()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri ?? "").TrimStart('/');
        return path.StartsWith("academy/profile", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("academy/payment", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("academy/attend", StringComparison.OrdinalIgnoreCase);
    }
}
