@page "/academy/courses"
@layout StudentLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@attribute [Authorize(Roles = "Student")]

<p class="empty-text">لیست دوره‌های فعال. برای ثبت‌نام وارد جزئیات دوره شوید.</p>
@if (!string.IsNullOrEmpty(message))
{
    <div style="padding:12px;border-radius:8px;background:#fee2e2;color:#991b1b;margin-bottom:16px;">@message</div>
}
@if (loading) { <p>در حال بارگذاری...</p> }
else if (items.Count == 0) { <p style="color:#94a3b8;">دوره فعالی نیست.</p> }
else
{
    <div class="academy-cards">
        @foreach (var x in items)
        {
            <a href="/academy/courses/@x.Id" class="academy-card" style="display:block;text-decoration:none;color:inherit;">
                @if (!string.IsNullOrEmpty(x.ImageUrl))
                {
                    <img src="@x.ImageUrl" alt="" style="width:100%;height:140px;object-fit:cover;border-radius:12px;margin-bottom:10px;" />
                }
                <div class="academy-card-top" style="margin-bottom:8px;padding-bottom:8px;">
                    <div class="academy-card-id">
                        <strong>@x.Title</strong>
                        <span class="academy-card-meta">@(x.InstructorName ?? "مربی نامشخص")</span>
                    </div>
                    @if (HasDaily(x.Id))
                    {
                        <span class="status-badge status-info">روزانه</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(x.LocationName))
                {
                    <div class="academy-card-row"><span>مکان</span><strong>@x.LocationName</strong></div>
                }
                @if (x.Price.HasValue)
                {
                    <div class="academy-card-row"><span>شهریه</span><strong>@x.Price.Value.ToString("N0") ریال</strong></div>
                }
            </a>
        }
    </div>
}

@code {
    [Inject] IAcademyCourseService Service { get; set; }
    List<AcademyCourseDto> items = new();
    HashSet<int> dailyIds = new();
    bool loading = true;
    string message = "";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            items = await Service.GetAllAsync(isActive: true) ?? new();
            foreach (var x in items)
            {
                try
                {
                    var full = await Service.GetByIdAsync(x.Id);
                    if (full?.Schedules?.Any(s => s.IsDaily) == true)
                        dailyIds.Add(x.Id);
                }
                catch { }
            }
        }
        catch { message = "دوره‌ها در دسترس نیست."; }
        loading = false;
    }
    private bool HasDaily(int id) => dailyIds.Contains(id);
}
