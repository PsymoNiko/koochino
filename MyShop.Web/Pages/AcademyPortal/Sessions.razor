@page "/academy/sessions"
@layout StudentLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@attribute [Authorize(Roles = "Student")]

<h1 style="margin-bottom:16px;">جلسات قابل ثبت‌نام</h1>
@if (!string.IsNullOrEmpty(message)) { <div style="padding:12px;border-radius:8px;margin-bottom:12px;background:#ecfdf5;">@message</div> }
@if (loading) { <p>در حال بارگذاری...</p> }
else if (student == null) { <p>پروفایل دانش‌آموز یافت نشد. از ادمین بخواهید شما را ثبت کند.</p> }
else if (!sessions.Any()) { <p>جلسه‌ای برای ثبت‌نام نیست.</p> }
else
{
    <div class="academy-cards">
        @foreach (var s in sessions.Where(x => x.Status == AcademyConstants.SessionStatus.Open || x.Status == AcademyConstants.SessionStatus.Scheduled))
        {
            <div class="academy-card">
                <div class="academy-card-top">
                    <div class="academy-card-id">
                        <strong>@s.ActivityTitle</strong>
                        <span class="academy-card-meta">@s.StartsAt.ToString("yyyy/MM/dd HH:mm") — @(s.LocationName ?? "مکان نامشخص")</span>
                    </div>
                </div>
                <div class="academy-card-row"><span>ظرفیت</span><strong>@(s.Capacity?.ToString() ?? "∞")</strong></div>
                <div class="academy-card-row"><span>تأیید شده</span><strong>@s.ApprovedCount</strong></div>
                <button class="btn-card" @onclick="() => RequestJoin(s.Id)">درخواست شرکت</button>
            </div>
        }
    </div>
}
@code {
    [Inject] IAcademyActivitySessionService SessionService { get; set; }
    [Inject] IAcademyActivityRequestService RequestService { get; set; }
    [Inject] IAcademyStudentService Students { get; set; }
    [Inject] AuthenticationStateProvider Auth { get; set; }
    AcademyStudentDto student;
    List<AcademyActivitySessionDto> sessions = new();
    bool loading = true; string message = "";
    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(idClaim, out var userId))
            student = await Students.GetByUserIdAsync(userId);
        try { sessions = await SessionService.GetAllAsync() ?? new(); }
        catch { message = "خطا در بارگذاری جلسات."; }
        loading = false;
    }
    private async Task RequestJoin(int sessionId)
    {
        if (student == null) return;
        var r = await RequestService.CreateAsync(new CreateAcademyActivityRequestDto { SessionId = sessionId, StudentId = student.Id });
        message = r.Ok ? "درخواست ثبت شد و منتظر تأیید مربی است." : (r.Error ?? "خطا");
        sessions = await SessionService.GetAllAsync() ?? new();
    }
}
