    private async Task SaveStore()
    {
        step2Errors.Clear();
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(storeDraft.StoreName)) step2Errors["storeName"] = "نام فروشگاه را وارد کنید.";
        if (selectedProvinceId == null) step2Errors["province"] = "استان را انتخاب کنید.";
        if (storeDraft.StoreCity == null || storeDraft.StoreCity == 0) step2Errors["city"] = "شهر را انتخاب کنید.";
        if (string.IsNullOrWhiteSpace(storeDraft.StoreAddress)) step2Errors["address"] = "آدرس مغازه را وارد کنید.";
        if (string.IsNullOrWhiteSpace(storeDraft.StorePostCode) || storeDraft.StorePostCode.Length != 10) step2Errors["postCode"] = "کد پستی باید دقیقاً ۱۰ رقم باشد.";
        if (string.IsNullOrWhiteSpace(storeDraft.StorePhone) || storeDraft.StorePhone.Length != 8) step2Errors["phone"] = "تلفن مغازه باید دقیقاً ۸ رقم باشد.";
        if (!storeDraft.StoreLatitude.HasValue || !storeDraft.StoreLongitude.HasValue) step2Errors["location"] = "لطفاً موقعیت مغازه را روی نقشه مشخص کنید یا از GPS استفاده کنید.";

        if (step2Errors.Count > 0)
        {
            errorMessage = "لطفاً فیلدهای مشخص‌شده را تکمیل کنید.";
            return;
        }

        savingStep2 = true;
        try
        {
            storeDraft.IsLocationEnabled = true;
            int storeId;
            if (editingExistingStore && storeDraft.StoreID > 0)
            {
                await StoreService.UpdateAsync(storeDraft);
                storeId = storeDraft.StoreID;
            }
            else
            {
                storeDraft.UserID = userId;
                storeId = await StoreService.CreateAsync(storeDraft);
            }

            if (progress != null)
                await VerificationService.AttachStoreAsync(progress.VerificationId, storeId);

            await LoadStateAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "خطا در ثبت فروشگاه: " + ex.Message;
        }
        finally { savingStep2 = false; }
    }

    private void EnsureVerificationCode()
    {
        if (CanUploadDoc(IdentityDocumentTypes.Selfie) && string.IsNullOrWhiteSpace(verificationCode))
            verificationCode = VerificationService.GenerateVerificationCode();
    }

    private async Task SelectFile(InputFileChangeEventArgs e, string docType)
    {
        var file = e.File;
        if (file == null) return;
        errorMessage = "";
        pendingDocType = docType;
        if (docType == IdentityDocumentTypes.Selfie)
            EnsureVerificationCode();

        var maxMb = settings.IdentityVerificationMaxFileSizeMB > 0 ? settings.IdentityVerificationMaxFileSizeMB : 5;
        var maxBytes = (long)maxMb * 1024 * 1024;
        if (file.Size > maxBytes)
        {
            var sizeMb = Math.Round(file.Size / 1024.0 / 1024.0, 1);
            errorMessage = $"حجم عکس انتخابی ({sizeMb} مگابایت) بیشتر از حد مجاز است. لطفاً عکسی با حجم حداکثر {maxMb} مگابایت انتخاب کنید.";
            StateHasChanged();
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(maxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            preparingPreview = true;
            pendingBytes = ms.ToArray();
            pendingFileName = file.Name;
            pendingPreviewUrl = $"data:{(string.IsNullOrEmpty(file.ContentType) ? "image/jpeg" : file.ContentType)};base64,{Convert.ToBase64String(pendingBytes)}";
            pendingDocType = docType;
        }
        catch (Exception ex)
        {
            errorMessage = FriendlyFileError(ex);
        }
        finally
        {
            preparingPreview = false;
            StateHasChanged();
        }
    }

    private static string FriendlyFileError(Exception ex)
    {
        var text = ex?.Message ?? "";
        if (ex is JSException || text.Contains("_blazorFilesById") || text.Contains("blazorFiles"))
            return "ارتباط با سرور در حین انتخاب عکس قطع شده بود (معمولاً به‌خاطر باز شدن دوربین یا افت شبکه). لطفاً دوباره عکس را انتخاب کنید.";
        return "خطا در پردازش تصویر. لطفاً دوباره تلاش کنید.";
    }

    private void DiscardPending()
    {
        pendingBytes = null;
        pendingFileName = null;
        pendingPreviewUrl = null;
        pendingDocType = null;
    }

    private async Task ConfirmUpload(string docType)
    {
        if (pendingBytes == null || pendingDocType != docType) return;
        errorMessage = "";
        uploadingDoc = true;
        StateHasChanged();

        try
        {
            var (success, url, msg) = await DocumentUpload.UploadBytesAsync(userId, pendingDocType, pendingBytes, pendingFileName, settings.IdentityVerificationMaxFileSizeMB);
            if (success)
            {
                var code = pendingDocType == IdentityDocumentTypes.Selfie ? verificationCode : null;
                await DocumentService.UploadAsync(userId, progress?.VerificationId, pendingDocType, url, code);
                docsSummary = await DocumentService.GetSummaryAsync(userId);
                DiscardPending();
            }
            else
            {
                errorMessage = msg;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "خطا در آپلود: " + ex.Message;
        }
        finally
        {
            uploadingDoc = false;
        }
    }

