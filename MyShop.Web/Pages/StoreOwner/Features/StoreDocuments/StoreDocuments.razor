@page "/StoreOwner/StoreDocuments/{StoreId:int}"
@layout StoreLayout
@using MyShop.Core.Helpers

@using MyShop.Core.Models
@using MyShop.Application.Interfaces
@using System.Security.Claims
@using System.Linq
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@inject IStoreService StoreService
@inject IStoreDocumentService StoreDocumentService
@inject MyShop.Web.Services.StoreDocumentUploadService StoreDocumentUpload
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JSRuntime

<div class="container-content" dir="rtl" lang="fa">
    <div class="documents-breadcrumb">
        <button type="button" class="back-link" @onclick="@(() => Nav.NavigateTo("/StoreOwner/StoreDocuments"))">← بازگشت به لیست فروشگاه‌ها</button>
    </div>
    <div class="documents-header">
        <h2>مدیریت مدارک و گالری</h2>
        <span class="store-name-header">@(storeName ?? "فروشگاه")</span>
        <div class="header-actions-wrap">
            <button class="btn-secondary btn-sm" @onclick="ShowAddGalleryForm">
                <span>🖼️</span> افزودن عکس به گالری
            </button>
            <button class="btn-primary" @onclick="ShowAddForm">
                <span>+</span> افزودن مدرک
            </button>
        </div>
    </div>

    @if (loading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else
    {
        var docList = DocumentsOnly;
        var galleryList = GalleryOnly;

        @* بخش گالری عکس *@
        <section class="section-block gallery-section">
            <h3 class="section-title">🖼️ گالری عکس فروشگاه</h3>
            @if (galleryList.Count == 0)
            {
                <div class="empty-state small">
                    <p>هنوز عکسی در گالری نیست. با دکمه «افزودن عکس به گالری» عکس اضافه کنید.</p>
                </div>
            }
            else
            {
                <div class="gallery-grid">
                    @foreach (var item in galleryList)
                    {
                        <div class="gallery-item @(item.DocumentType == "کاور" ? "gallery-item-cover" : "")">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <div class="gallery-thumb" @onclick="@(() => ViewDocument(item))">
                                    <MyShop.Web.Components.OptimizedImage Src="@item.ImageUrl" Alt="@item.Title" Lazy="true" />
                                    @if (item.DocumentType == "کاور")
                                    {
                                        <span class="gallery-cover-badge">کاور پروفایل</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="gallery-thumb gallery-thumb-placeholder">
                                    <span>🖼️</span>
                                </div>
                            }
                            <div class="gallery-item-footer">
                                <span class="gallery-item-title">@(string.IsNullOrEmpty(item.Title) ? "عکس گالری" : item.Title)</span>
                                <div class="gallery-item-actions">
                                    @if (item.DocumentType != "کاور")
                                    {
                                        <button type="button" class="btn-cover" @onclick="@(() => SetAsProfileCover(item.DocumentId))" title="انتخاب به عنوان کاور پروفایل">📷 کاور</button>
                                    }
                                    <button type="button" class="btn-icon-delete" @onclick="@(() => DeleteDocument(item.DocumentId))" title="حذف">🗑️</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        @* بخش مدارک *@
        <section class="section-block documents-section">
            <h3 class="section-title">📄 مدارک فروشگاه <span class="pending-badge">@(DocumentsOnly.Count(d => !d.IsApproved)) در حال بررسی</span></h3>
            @if (docList.Count == 0)
            {
                <div class="empty-state small">
                    <p>هنوز مدرکی ثبت نکرده‌اید. با دکمه «افزودن مدرک» مدرک جدید اضافه کنید.</p>
                </div>
            }
            else
            {
                <div class="documents-grid">
                    @foreach (var doc in docList)
                    {
                        <div class="document-card">
                            <div class="document-header">
                                <h3>@doc.Title</h3>
                                <div class="document-actions">
                                    <button class="btn-edit" @onclick="@(() => ViewDocument(doc))" title="مشاهده">👁️</button>
                                    <button class="btn-delete" @onclick="@(() => DeleteDocument(doc.DocumentId))" title="حذف">🗑️</button>
                                </div>
                            </div>
                            <div class="document-body">
                                <p class="document-type"><strong>نوع:</strong> @doc.DocumentType</p>
                                @if (!string.IsNullOrEmpty(doc.Description))
                                {
                                    <p class="document-description">@doc.Description</p>
                                }
                                <p class="document-date">تاریخ آپلود: @PersianDateHelper.ToPersianDateString(doc.UploadedAt)</p>
                                <p class="document-status">
                                    @if (doc.IsApproved)
                                    {
                                        <span class="badge badge-success">✅ تایید شده</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">⏳ در انتظار تایید</span>
                                    }
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }

    @if (showForm)
    {
        <div class="modal-overlay" @onclick="HideForm">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>@(isGalleryForm ? "افزودن عکس به گالری" : "افزودن مدرک جدید")</h3>
                    <button class="btn-close" @onclick="HideForm">×</button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentDocument" OnValidSubmit="SaveDocument">
                        <div class="form-group">
                            <label>عنوان مدرک *</label>
                            <input class="form-control" @bind="currentDocument.Title" required />
                        </div>

                        <div class="form-group">
                            <label>نوع مدرک *</label>
                            <select class="form-control" @bind="currentDocument.DocumentType" required disabled="@isGalleryForm">
                                <option value="">انتخاب کنید</option>
                                <option value="گالری">🖼️ گالری عکس</option>
                                <option value="پروفایل">📷 پروفایل مغازه</option>
                                <option value="جواز کسب">جواز کسب</option>
                                <option value="اجاره نامه">اجاره نامه</option>
                                <option value="پروانه بهداشت">پروانه بهداشت</option>
                                <option value="مدارک هویتی">مدارک هویتی</option>
                                <option value="سایر">سایر</option>
                            </select>
                            @if (isGalleryForm)
                            {
                                <p class="form-hint">در حال افزودن عکس به گالری هستید.</p>
                            }
                        </div>

                        <div class="form-group">
                            <label>توضیحات</label>
                            <textarea class="form-control" rows="3" @bind="currentDocument.Description"></textarea>
                        </div>

                        <div class="form-group">
                            <label>@(isGalleryForm ? "آپلود تصویر (حداکثر 900KB) *" : "آپلود تصویر یا PDF (حداکثر 900KB) *")</label>
                            <InputFile OnChange="HandleFileSelected" accept="@(isGalleryForm ? "image/*" : "image/*,.pdf")" />
                            @if (selectedFile != null)
                            {
                                <p style="margin-top: 8px; color: #6b7280; font-size: 14px;">
                                    فایل انتخاب شده: @selectedFile.Name (@(selectedFileSize / 1024) KB)
                                </p>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(message))
                        {
                            <div class="alert @(message.Contains("موفق") ? "alert-success" : "alert-danger")">
                                @message
                            </div>
                        }

                        <div class="form-actions">
                            <button type="submit" class="btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-small"></span>
                                }
                                else
                                {
                                    <span>ذخیره</span>
                                }
                            </button>
                            <button type="button" class="btn-secondary" @onclick="HideForm" disabled="@saving">
                                انصراف
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>

<style>
