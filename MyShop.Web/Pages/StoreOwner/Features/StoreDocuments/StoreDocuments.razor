    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

@code {
    [Parameter] public int StoreId { get; set; }

    private string storeName;
    private List<StoreDocument> documents = new();
    private StoreDocument currentDocument = new();
    private bool loading = true;
    private bool saving = false;
    private bool showForm = false;
    private bool isGalleryForm = false;
    private string message = "";
    private IBrowserFile selectedFile;
    private long selectedFileSize = 0;

    private List<StoreDocument> DocumentsOnly => documents?.Where(d => d.DocumentType != "گالری" && d.DocumentType != "کاور").ToList() ?? new List<StoreDocument>();
    private List<StoreDocument> GalleryOnly => documents?.Where(d => d.DocumentType == "گالری" || d.DocumentType == "کاور").OrderBy(d => d.DisplayOrder).ToList() ?? new List<StoreDocument>();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/Account/login-store", true);
            return;
        }

        var idStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? user.FindFirst("UserId")?.Value;
        if (!int.TryParse(idStr, out var userId) || userId <= 0)
        {
            Nav.NavigateTo("/Account/login-store", true);
            return;
        }

        var owned = await StoreService.GetByUserIdAsync(userId) ?? new List<Store>();
        if (!owned.Any(s => s.StoreID == StoreId || s.Id == StoreId))
        {
            Nav.NavigateTo("/StoreOwner/StoreDocuments", true);
            return;
        }

        await LoadStoreName();
        await LoadDocuments();
    }

    private async Task LoadStoreName()
    {
        try
        {
            var store = await StoreService.GetByIdAsync(StoreId);
            storeName = store?.StoreName;
        }
        catch
        {
            storeName = null;
        }
    }

    private async Task LoadDocuments()
    {
        loading = true;
        message = "";
        try
        {
            documents = await StoreDocumentService.GetByStoreIdAsync(StoreId);
        }
        catch (Exception ex)
        {
            message = UserFacingErrorHelper.Format(ex, "خطا در بارگذاری مدارک:");
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowAddForm()
    {
        isGalleryForm = false;
        currentDocument = new StoreDocument { StoreId = StoreId };
        showForm = true;
        message = "";
        selectedFile = null;
    }

    private void ShowAddGalleryForm()
    {
        isGalleryForm = true;
        currentDocument = new StoreDocument { StoreId = StoreId, DocumentType = "گالری", Title = "عکس گالری" };
        showForm = true;
        message = "";
        selectedFile = null;
    }

    private void HideForm()
    {
        showForm = false;
        isGalleryForm = false;
        currentDocument = new StoreDocument();
        selectedFile = null;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileSize = e.File.Size;

        if (selectedFileSize > 900 * 1024) // 900KB
        {
            message = "حجم فایل نباید بیشتر از 900KB باشد";
            selectedFile = null;
            selectedFileSize = 0;
            return;
        }
        message = "";
    }

    private async Task SaveDocument()
    {
        saving = true;
        message = "";

        try
        {
            if (selectedFile == null)
            {
                message = "لطفا فایلی انتخاب کنید";
                saving = false;
                return;
            }

            var (uploadOk, relativeUrl, uploadMsg) = await StoreDocumentUpload.UploadAsync(StoreId, selectedFile, isGalleryForm);
            if (!uploadOk)
            {
                message = uploadMsg;
                saving = false;
                return;
            }

            currentDocument.ImageUrl = relativeUrl;
            currentDocument.FileSize = selectedFile.Size;
            currentDocument.MimeType = selectedFile.ContentType ?? "";
            currentDocument.UploadedAt = DateTime.UtcNow;

            var docId = await StoreDocumentService.CreateAsync(currentDocument);
            if (docId > 0)
            {
                if (currentDocument.DocumentType == "پروفایل" && !string.IsNullOrEmpty(currentDocument.ImageUrl))
                {
                    var store = await StoreService.GetByIdAsync(StoreId);
                    if (store != null)
                    {
                        store.StoreProfileImageUrl = currentDocument.ImageUrl;
                        await StoreService.UpdateAsync(store);
                        message = "عکس پروفایل مغازه با موفقیت ذخیره و در پروفایل نمایش داده می‌شود.";
                    }
                    else
                        message = "مدرک با موفقیت ذخیره شد.";
                }
                else
                    message = "مدرک با موفقیت ذخیره شد.";
                await LoadDocuments();
                await LoadStoreName();
                StateHasChanged();
                await Task.Delay(1200);
                HideForm();
            }
            else
            {
                message = "خطا در ثبت رکورد در دیتابیس.";
            }
        }
        catch (Exception ex)
        {
            message = UserFacingErrorHelper.Format(ex, "خطا:");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ViewDocument(StoreDocument doc)
    {
        if (string.IsNullOrEmpty(doc?.ImageUrl)) return;
        var url = doc.ImageUrl.StartsWith("http") ? doc.ImageUrl : Nav.ToAbsoluteUri(doc.ImageUrl).ToString();
        await JSRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task SetAsProfileCover(int documentId)
    {
        try
        {
            var ok = await StoreDocumentService.SetAsProfileCoverAsync(StoreId, documentId);
            await LoadDocuments();
            await LoadStoreName();
            message = ok ? "این عکس به عنوان کاور پروفایل فروشگاه انتخاب شد." : "خطا در انتخاب کاور.";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            message = UserFacingErrorHelper.Format(ex, "خطا:");
        }
    }

    private async Task DeleteDocument(int documentId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "آیا از حذف این مدرک اطمینان دارید؟"))
            return;

        try
        {
            var doc = await StoreDocumentService.GetByIdAsync(documentId);
            var deleted = await StoreDocumentService.DeleteAsync(documentId);
            if (deleted && doc != null && !string.IsNullOrEmpty(doc.ImageUrl))
                StoreDocumentUpload.TryDeleteFile(doc.ImageUrl);
            await LoadDocuments();
            if (deleted) message = "مدرک حذف شد.";
        }
        catch (Exception ex)
        {
            message = UserFacingErrorHelper.Format(ex, "خطا:");
        }
    }
}
