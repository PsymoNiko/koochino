            StorePos2 = DigitNormalizer.ToAsciiDigitsOnly(store.StorePos2),
            StorePos3 = DigitNormalizer.ToAsciiDigitsOnly(store.StorePos3),
            StoreLatitude = store.StoreLatitude,
            StoreLongitude = store.StoreLongitude,
            StoreProfileImageUrl = store.StoreProfileImageUrl,
            StoreOpeningHours = store.StoreOpeningHours,
            StoreClosingHours = store.StoreClosingHours,
            StoreWorkingDays = store.StoreWorkingDays,
            StoreWebsite = store.StoreWebsite,
            StoreSocialMedia = store.StoreSocialMedia,
            IsLocationEnabled = store.IsLocationEnabled,
            CategoryId = store.CategoryId,
            CompanyId = store.CompanyId
        };
        selectedOpeningHour = ParseHour(store.StoreOpeningHours);
        selectedClosingHour = ParseHour(store.StoreClosingHours);
        selectedDayIds = string.IsNullOrWhiteSpace(store.StoreWorkingDays)
            ? new List<int>()
            : store.StoreWorkingDays.Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(s =>
                {
                    var t = s.Trim();
                    if (int.TryParse(t, out var id) && days.Any(d => d.Id == id))
                        return id;
                    var day = days.FirstOrDefault(d => string.Equals(d.Name?.Trim(), t, StringComparison.OrdinalIgnoreCase));
                    return day?.Id ?? 0;
                })
                .Where(id => id > 0)
                .Distinct()
                .OrderBy(x => x)
                .ToList();
        citiesLoadError = false;
        try
        {
            if (store.StoreCity.HasValue && store.StoreCity.Value > 0)
            {
                var city = await LocationService.GetCityByIdAsync(store.StoreCity.Value);
                if (city != null)
                {
                    selectedProvinceId = city.ProvinceId;
                    cities = await LocationService.GetCitiesByProvinceIdAsync(city.ProvinceId) ?? new List<City>();
                }
                else
                {
                    selectedProvinceId = null;
                    cities = new List<City>();
                }
            }
            else
            {
                selectedProvinceId = null;
                cities = new List<City>();
            }
        }
        catch
        {
            selectedProvinceId = null;
            cities = new List<City>();
            citiesLoadError = true;
        }

        if (provinces.Count == 0)
            await LoadProvinces();
        showForm = true;
        message = "";
        locationMessage = "";
        pendingLat = currentStore.StoreLatitude.HasValue ? (double)currentStore.StoreLatitude.Value : null;
        pendingLng = currentStore.StoreLongitude.HasValue ? (double)currentStore.StoreLongitude.Value : null;
        locationDirty = false;
        _mapPickerId = $"map-picker-{store.StoreID}";
        await Task.Delay(300);
        await InitializeMapPicker();
    }

    private async Task InitializeMapPicker()
    {
        try
        {
            _mapPickerDotNetRef?.Dispose();
            var mapId = _mapPickerId;
            var initialLat = currentStore.StoreLatitude.HasValue ? (double)currentStore.StoreLatitude.Value : 0;
            var initialLng = currentStore.StoreLongitude.HasValue ? (double)currentStore.StoreLongitude.Value : 0;
            _mapPickerDotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initNeshanMapPicker", mapId, initialLat, initialLng, _mapPickerDotNetRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine("InitializeMapPicker: " + ex.Message);
        }
    }

    private async Task HideForm()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("removeNeshanMap", _mapPickerId);
        }
        catch { }
        _mapPickerDotNetRef?.Dispose();
        _mapPickerDotNetRef = null;
        showForm = false;
        currentStore = new Store();
        editingStore = null;
        selectedProvinceId = null;
        cities = new List<City>();
        selectedDayIds = new List<int>();
        message = "";
    }

    private async Task SaveStore()
    {
        saving = true;
        message = "";

        try
        {
            currentStore.StoreOpeningHours = selectedOpeningHour.ToString("00") + ":00";
            currentStore.StoreClosingHours = selectedClosingHour.ToString("00") + ":00";
            currentStore.StoreWorkingDays = selectedDayIds.Count > 0
                ? string.Join(",", selectedDayIds.OrderBy(x => x))
                : null;

            if (string.IsNullOrWhiteSpace(currentStore.StoreName))
            {
                message = "نام فروشگاه الزامی است";
                saving = false;
                return;
            }

            if (editingStore != null)
            {
                // Update
                // اطمینان از اینکه StoreID و SellerId حفظ می‌شوند
                currentStore.StoreID = editingStore.StoreID;
                currentStore.SellerId = editingStore.SellerId;
                currentStore.UserID = editingStore.UserID;
                currentStore.StoreCreatedAt = editingStore.StoreCreatedAt;
                currentStore.StoreStat = editingStore.StoreStat;
                
                var success = await StoreService.UpdateAsync(currentStore);
                if (success)
                {
                    message = "فروشگاه با موفقیت به‌روزرسانی شد";
                    // بارگذاری مجدد داده‌ها از دیتابیس
                    await LoadStores();
                    StateHasChanged();
                    await Task.Delay(1500);
                    await HideForm();
                }
                else
                {
                    message = "خطا در به‌روزرسانی فروشگاه";
                }
            }
            else
            {
                // Create
                var storeId = await StoreService.CreateAsync(currentStore);
                if (storeId > 0)
                {
                    message = "فروشگاه با موفقیت ثبت شد";
                    await LoadStores();
                    await Task.Delay(1500);
                    await HideForm();
                }
                else
                {
                    message = "خطا در ثبت فروشگاه";
                }
            }
        }
        catch (Exception ex)
        {
            message = UserFacingErrorHelper.Format(ex, "خطا:");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteStore(int storeId)
    {
        try
        {
            var (can, reasons) = await StoreService.CanDeleteAsync(storeId);
            if (!can)
            {
                var detail = reasons.Count > 0 ? "\n" + string.Join("\n", reasons) : "";
                await JSRuntime.InvokeVoidAsync("alert",
                    "امکان حذف نیست — با پشتیبانی صحبت کنید." + detail);
                return;
            }

            if (!await JSRuntime.InvokeAsync<bool>("confirm", "آیا از حذف این فروشگاه اطمینان دارید؟"))
                return;

            var success = await StoreService.DeleteAsync(storeId);
            if (success)
            {
                message = "فروشگاه با موفقیت حذف شد";
                await LoadStores();
            }
            else
            {
                message = "خطا در حذف فروشگاه";
            }
        }
        catch (Exception ex)
        {
            message = UserFacingErrorHelper.Format(ex, "خطا:");
        }
    }
}
