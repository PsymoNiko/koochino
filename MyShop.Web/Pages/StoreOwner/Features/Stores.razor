    private async Task ConfirmStoreLocationAsync()
    {
        if (currentStore == null || !pendingLat.HasValue || !pendingLng.HasValue)
            return;

        savingLocation = true;
        locationMessage = "";
        StateHasChanged();
        try
        {
            currentStore.StoreLatitude = (decimal)pendingLat.Value;
            currentStore.StoreLongitude = (decimal)pendingLng.Value;
            currentStore.IsLocationEnabled = true;

            var address = await GeoLocation.ReverseGeocodeAsync(pendingLat.Value, pendingLng.Value);
            if (!string.IsNullOrWhiteSpace(address))
                currentStore.StoreAddress = address;

            if (editingStore != null && editingStore.StoreID > 0)
            {
                currentStore.StoreID = editingStore.StoreID;
                currentStore.SellerId = editingStore.SellerId;
                currentStore.UserID = editingStore.UserID;
                currentStore.StoreCreatedAt = editingStore.StoreCreatedAt;
                currentStore.StoreStat = editingStore.StoreStat;
                currentStore.StoreOpeningHours = selectedOpeningHour.ToString("00") + ":00";
                currentStore.StoreClosingHours = selectedClosingHour.ToString("00") + ":00";
                currentStore.StoreWorkingDays = selectedDayIds.Count > 0
                    ? string.Join(",", selectedDayIds.OrderBy(x => x))
                    : currentStore.StoreWorkingDays;

                var ok = await StoreService.UpdateAsync(currentStore);
                locationMessage = ok
                    ? (string.IsNullOrWhiteSpace(address) ? "موقعیت مغازه ثبت شد." : "موقعیت ثبت شد و آدرس در فیلد آدرس نوشته شد.")
                    : "موقعیت در فرم ثبت شد؛ ذخیره سرور ناموفق بود. دکمه ذخیره فروشگاه را بزنید.";
            }
            else
            {
                locationMessage = string.IsNullOrWhiteSpace(address)
                    ? "موقعیت انتخاب شد. با ذخیره فروشگاه ثبت می‌شود."
                    : "آدرس از روی نقشه پر شد. با ذخیره فروشگاه موقعیت ثبت می‌شود.";
            }

            locationDirty = false;
        }
        catch (Exception ex)
        {
            locationMessage = UserFacingErrorHelper.Format(ex, "خطا در ثبت موقعیت:");
        }
        finally
        {
            savingLocation = false;
            StateHasChanged();
        }
    }

