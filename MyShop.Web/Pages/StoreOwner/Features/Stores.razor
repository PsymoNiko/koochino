    private static int ParseHour(string hourStr)
    {
        if (string.IsNullOrWhiteSpace(hourStr)) return 9;
        var parts = hourStr.Trim().Split(':', '-');
        if (parts.Length > 0 && int.TryParse(parts[0].Trim(), out var h) && h >= 0 && h <= 24) return h;
        return 9;
    }

    private string GetStoreQrUrl(int storeId) => _storeQrDataUrls.TryGetValue(storeId, out var url) ? url : "";

    private async Task OpenPrintDesign(int storeId, int design)
    {
        var url = Nav.ToAbsoluteUri($"/StoreOwner/Stores/Print/{design}/{storeId}");
        await JSRuntime.InvokeVoidAsync("open", url.ToString(), "_blank");
    }

    private async Task LoadStores()
    {
        loading = true;
        StateHasChanged();
        try
        {
            stores = await StoreService.GetByUserIdAsync(userId) ?? new List<Store>();
            var baseUrl = Nav.ToAbsoluteUri(Nav.Uri).GetLeftPart(UriPartial.Authority);
            _storeQrDataUrls = stores.ToDictionary(s => s.StoreID, s => QrCodeService.ToDataUrl($"{baseUrl}/customer/submit-order?storeId={s.StoreID}", 4));
            StateHasChanged();
        }
        catch (Exception ex)
        {
            message = UserFacingErrorHelper.Format(ex, "خطا در بارگذاری فروشگاه‌ها:");
            StateHasChanged();
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

