    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/Account/login-store", true);
            return;
        }

        if (!user.IsInRole("StoreOwner"))
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out userId))
        {
            message = "خطا در دریافت اطلاعات کاربر";
            loading = false;
            return;
        }

        await LoadStores();
        try { days = await LocationService.GetDaysAsync() ?? new List<Day>(); }
        catch { days = new List<Day>(); }

        await LoadProvinces();

        try { storeCategories = await StoreCategoryService.GetAllAsync(activeOnly: true) ?? new List<StoreCategory>(); }
        catch { storeCategories = new List<StoreCategory>(); }

        try
        {
            var siteId = Tenant?.HasSite == true ? Tenant.SiteId : 0;
            var siteSettings = await SiteSettingsService.GetSettingsAsync(siteId);
            requireIdentityVerification = siteSettings.RequireIdentityVerificationForStoreFeatures;
            var idStatus = await UserService.GetIdentityVerificationStatusAsync(userId);
            identityVerified = idStatus == "Approved";
        }
        catch { }
    }

    private async Task LoadProvinces()
    {
        loadingProvinces = true;
        provincesLoadError = false;
        try
        {
            await LocationService.EnsureIranLocationsSeededAsync();
            provinces = await LocationService.GetProvincesAsync() ?? new List<Province>();
            if (provinces.Count == 0) provincesLoadError = true;
        }
        catch
        {
            provinces = new List<Province>();
            provincesLoadError = true;
        }
        finally
        {
            loadingProvinces = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnProvinceSelectedAsync(int? provinceId)
    {
        selectedProvinceId = provinceId;
        currentStore.StoreCity = null;
        citiesLoadError = false;
        try
        {
            cities = selectedProvinceId.HasValue
                ? (await LocationService.GetCitiesByProvinceIdAsync(selectedProvinceId.Value) ?? new List<City>())
                : new List<City>();
        }
        catch
        {
            cities = new List<City>();
            citiesLoadError = true;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnCitySelected(int? cityId)
    {
        currentStore.StoreCity = cityId;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleDay(int dayId, bool isChecked)
    {
        if (isChecked && !selectedDayIds.Contains(dayId))
            selectedDayIds.Add(dayId);
        else if (!isChecked)
            selectedDayIds.Remove(dayId);
        selectedDayIds = selectedDayIds.OrderBy(x => x).ToList();
