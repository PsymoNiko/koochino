@page "/StoreOwner/Stores"
@layout StoreLayout
@using MyShop.Core.Helpers

@using MyShop.Core.Models
@using MyShop.Application.Interfaces
@using MyShop.Application.Interfaces.Settings
@using MyShop.Core.Interfaces
@using System.Security.Claims
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@using MyShop.Web.Services
@inject IStoreService StoreService
@inject IStoreCategoryService StoreCategoryService
@inject ILocationService LocationService
@inject IUserService UserService
@inject ISiteAdminSettingsService SiteSettingsService
@inject ICurrentTenant Tenant
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject MyShop.Web.Services.IGeoLocationService GeoLocation
@using System.Linq
@using Microsoft.Extensions.Configuration

<div class="container-content" dir="rtl" lang="fa">

    <div class="stores-header">
        <h2>مدیریت فروشگاه‌ها</h2>
        <button class="btn-primary" @onclick="ShowAddForm">
            <span>+</span> افزودن فروشگاه جدید
        </button>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="phone-gate-alert" style="display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:14px;margin-bottom:16px;border-radius:12px;background:#eff6ff;border:1px solid #93c5fd;color:#1e3a8a;">
            <span>@message</span>
        </div>
    }

    @if (identityVerified)
    {
        <div class="phone-gate-alert" style="display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:14px;margin-bottom:16px;border-radius:12px;background:#ecfdf5;border:1px solid #6ee7b7;color:#065f46;">
            <span>احراز هویت تایید شده است؛ ویرایش مشخصات و آدرس فروشگاه غیرفعال است.</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="phone-gate-alert" style="display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:14px;margin-bottom:16px;border-radius:12px;background:#eff6ff;border:1px solid #93c5fd;color:#1e3a8a;">
            <span>@message</span>
        </div>
    }

    @if (identityVerified)
    {
        <div class="phone-gate-alert" style="display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:14px;margin-bottom:16px;border-radius:12px;background:#ecfdf5;border:1px solid #6ee7b7;color:#065f46;">
            <span>احراز هویت تایید شده است؛ ویرایش مشخصات و آدرس فروشگاه غیرفعال است.</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(message) && !showForm)
    {
        <div class="phone-gate-alert" style="display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:14px;margin-bottom:16px;border-radius:12px;background:#fff7ed;border:1px solid #fdba74;color:#9a3412;">
            <span>@message</span>
            <button type="button" class="btn-link" @onclick="@(() => message = "")">بستن</button>
        </div>
    }

    @if (identityVerified)
    {
        <div style="padding:12px 14px;margin-bottom:16px;border-radius:12px;background:#ecfdf5;border:1px solid #6ee7b7;color:#065f46;font-size:.92rem;">
            احراز هویت شما تایید شده است؛ ویرایش مشخصات و آدرس فروشگاه‌ها قفل شده است.
        </div>
    }

    @if (!string.IsNullOrEmpty(message) && !showForm)
    {
        <div class="phone-gate-alert" style="display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:14px;margin-bottom:16px;border-radius:12px;background:#fff7ed;border:1px solid #fdba74;color:#9a3412;">
            <span>@message</span>
            <button type="button" class="btn-link" @onclick="@(() => message = "")">بستن</button>
        </div>
    }

    @if (identityVerified)
    {
        <div style="padding:12px 14px;margin-bottom:16px;border-radius:12px;background:#ecfdf5;border:1px solid #6ee7b7;color:#065f46;font-size:.92rem;">
            احراز هویت شما تایید شده است؛ ویرایش مشخصات و آدرس فروشگاه‌ها قفل شده است.
        </div>
    }

    @if (!string.IsNullOrEmpty(message) && !showForm)
    {
        <div class="phone-gate-alert" style="display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:14px;margin-bottom:16px;border-radius:12px;background:#fff7ed;border:1px solid #fdba74;color:#9a3412;">
            <span>@message</span>
            <button type="button" class="btn-link" @onclick="@(() => message = "")">بستن</button>
        </div>
    }

    @if (identityVerified)
    {
        <div style="padding:12px 14px;margin-bottom:16px;border-radius:12px;background:#ecfdf5;border:1px solid #6ee7b7;color:#065f46;font-size:.92rem;">
            احراز هویت شما تایید شده است؛ ویرایش مشخصات و آدرس فروشگاه‌ها قفل شده است.
        </div>
    }

    @if (requireIdentityVerification && !identityVerified)
    {
        <div class="phone-gate-alert" style="display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:14px;margin-bottom:16px;border-radius:12px;background:#fff7ed;border:1px solid #fdba74;color:#9a3412;">
            <span>🪪 برای افزودن فروشگاه جدید، ابتدا احراز هویت خود را تکمیل کنید.</span>
            <button type="button" class="btn-primary" @onclick='@(() => Nav.NavigateTo("/StoreOwner/IdentityVerification"))'>احراز هویت</button>
        </div>
    }

    @if (loading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else if (stores == null || stores.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🏪</div>
            <h3>هنوز فروشگاهی ثبت نکرده‌اید</h3>
            <p>برای شروع، فروشگاه جدیدی اضافه کنید</p>
            <button class="btn-primary" @onclick="ShowAddForm">
                افزودن فروشگاه
            </button>
        </div>
    }
    else
    {
        <div class="stores-grid">
            @foreach (var store in stores)
            {
                <div class="store-card">
                    <div class="store-header">
                        <h3>@store.StoreName</h3>
                        <div class="store-actions">
                            <button class="btn-print" @onclick="@(() => OpenPrintDesign(store.StoreID, 1))" title="پرینت طرح ۱">
                                🖨️۱
                            </button>
                            <button class="btn-print" @onclick="@(() => OpenPrintDesign(store.StoreID, 2))" title="پرینت طرح ۲">
                                🖨️۲
                            </button>
                            <button class="btn-print" @onclick="@(() => OpenPrintDesign(store.StoreID, 3))" title="پوستر تبلیغاتی">
                                🖨️۳
                            </button>
                            <button class="btn-edit" @onclick="@(() => EditStore(store))" title="@(identityVerified ? "پس از تایید احراز هویت، ویرایش مشخصات و آدرس ممکن نیست" : "ویرایش")" disabled="@identityVerified" style="@(identityVerified ? "opacity:.45;cursor:not-allowed;" : null)">
                                ✏️
                            </button>
                            <button class="btn-documents" @onclick="@(() => Nav.NavigateTo($"/StoreOwner/StoreDocuments/{store.StoreID}"))" title="مدارک">
                                📄
                            </button>
                            <button class="btn-delete" @onclick="@(() => DeleteStore(store.StoreID))" title="حذف">
                                🗑️
                            </button>
                        </div>
                    </div>
                    <div class="store-body">
                        @if (!string.IsNullOrEmpty(store.StoreProfileImageUrl))
                        {
                            <div class="store-image">
                                <MyShop.Web.Components.OptimizedImage Src="@store.StoreProfileImageUrl" Alt="@store.StoreName" Lazy="true" Style="width: 100%; height: 200px; object-fit: cover; border-radius: 8px; margin-bottom: 12px;" />
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(store.StoreDescription))
                        {
                            <p class="store-description">@store.StoreDescription</p>
                        }
                        @if (!string.IsNullOrEmpty(store.StoreAddress))
                        {
                            <p class="store-info"><strong>آدرس:</strong> @store.StoreAddress</p>
                        }
                        @if (!string.IsNullOrEmpty(store.StorePhone))
                        {
                            <p class="store-info"><strong>تلفن:</strong> @store.StorePhone</p>
                        }
                        @if (store.CategoryId.HasValue)
                        {
                            var catName = storeCategories.FirstOrDefault(c => c.Id == store.CategoryId)?.Name
                                          ?? store.CategoryName;
                            if (!string.IsNullOrEmpty(catName))
                            {
                                <p class="store-info"><strong>دسته:</strong> @catName</p>
                            }
                        }
                        <p class="store-info"><strong>وضعیت فروشگاه:</strong> <span class="store-status-badge @(store.StoreStat ? "store-status-active" : "store-status-pending")">@(store.StoreStat ? "فعال" : "تحت بررسی")</span></p>
                        @if (!string.IsNullOrEmpty(store.StoreOpeningHours) && !string.IsNullOrEmpty(store.StoreClosingHours))
                        {
                            <p class="store-info"><strong>ساعات کاری:</strong> @store.StoreOpeningHours - @store.StoreClosingHours</p>
                        }
                        @if (!string.IsNullOrEmpty(store.StoreWebsite))
                        {
                            <p class="store-info"><strong>وب‌سایت:</strong> <a href="@store.StoreWebsite" target="_blank" style="color: #2563eb;">@store.StoreWebsite</a></p>
                        }
                        @if (store.StoreLatitude.HasValue && store.StoreLongitude.HasValue && store.IsLocationEnabled)
                        {
                            <p class="store-info"><strong>📍 موقعیت:</strong> روی نقشه فعال</p>
                        }
                        @if (store.StoreRating.HasValue)
                        {
                            <p class="store-info"><strong>⭐ امتیاز:</strong> @store.StoreRating.Value.ToString("0.0") (@store.StoreReviewCount نظر)</p>
                        }
                        <p class="store-date">تاریخ ایجاد: @PersianDateHelper.ToPersianDateString(store.StoreCreatedAt)</p>
                        <div class="store-qr-section">
                            <p class="store-qr-label">📱 QR ثبت سفارش — مشتری اسکن کند</p>
                            @if (GetStoreQrUrl(store.StoreID) is string qrUrl && !string.IsNullOrEmpty(qrUrl))
                            {
                                <div class="store-qr-box">
                                    <img src="@qrUrl" alt="QR ثبت سفارش" class="store-qr-img" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (showForm)
    {
        <div class="modal-overlay" @onclick="@(async () => await HideForm())">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>@(editingStore != null ? "ویرایش فروشگاه" : "افزودن فروشگاه جدید")</h3>
                    <button class="btn-close" @onclick="@(async () => await HideForm())">×</button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentStore" OnValidSubmit="SaveStore">
                        <div class="form-group">
                            <label>نام فروشگاه *</label>
                            <input type="text" class="form-control" required
                                   placeholder="فقط حرف و عدد"
                                   value="@currentStore.StoreName"
                                   @oninput="OnStoreNameInput"
                                   title="فقط حروف و اعداد مجاز است" />
                        </div>

                        <div class="form-group">
                            <label>توضیحات</label>
                            <textarea class="form-control" rows="3" placeholder="فقط حروف"
                                   value="@currentStore.StoreDescription"
                                   @oninput="OnStoreDescriptionInput"
                                   title="فقط حروف مجاز است"></textarea>
                        </div>

                        <div class="form-group">
                            <label>نام خانوادگی فروشنده</label>
                            <input type="text" class="form-control"
                                   placeholder="فقط حروف"
                                   value="@currentStore.StoreFamilyName"
                                   @oninput="OnStoreFamilyNameInput"
                                   title="فقط حروف مجاز است" />
                        </div>

                        <div class="form-group">
                            <label>استان</label>
                            <SearchableSelect TItem="Province" TValue="int?"
                                              Items="provinces"
                                              ValueSelector="p => (int?)p.Id"
                                              TextSelector="p => p.Name"
                                              SelectedValue="selectedProvinceId"
                                              SelectedValueChanged="OnProvinceSelectedAsync"
                                              Placeholder="@(loadingProvinces ? "در حال بارگذاری..." : "-- انتخاب استان --")"
                                              SearchPlaceholder="جستجوی استان..."
                                              Disabled="@loadingProvinces" />
                            @if (provincesLoadError)
                            {
                                <div class="field-error-hint">
                                    خطا در بارگذاری لیست استان‌ها.
                                    <button type="button" class="btn-link" @onclick="LoadProvinces">تلاش دوباره</button>
                                </div>
                            }
                        </div>
                        <div class="form-group">
                            <label>شهر</label>
                            <SearchableSelect TItem="City" TValue="int?"
                                              Items="cities"
                                              ValueSelector="c => (int?)c.Id"
                                              TextSelector="c => c.Name"
                                              SelectedValue="currentStore.StoreCity"
                                              SelectedValueChanged="OnCitySelected"
                                              Placeholder="-- انتخاب شهر --"
                                              SearchPlaceholder="جستجوی شهر..."
                                              Disabled="@(selectedProvinceId == null)" />
                            @if (citiesLoadError)
                            {
                                <div class="field-error-hint">
                                    خطا در بارگذاری لیست شهرها.
                                    <button type="button" class="btn-link" @onclick="@(() => OnProvinceSelectedAsync(selectedProvinceId))">تلاش دوباره</button>
                                </div>
                            }
                            else if (selectedProvinceId.HasValue && cities.Count == 0 && !loadingProvinces)
                            {
                                <div class="field-error-hint">برای این استان شهری ثبت نشده است.</div>
                            }
                        </div>
                        <div class="form-group">
                            <label>آدرس</label>
                            <input class="form-control" @bind="currentStore.StoreAddress" />
                        </div>

                        <div class="form-group">
                            <label>کد پستی</label>
                            <input type="text" class="form-control" inputmode="numeric" maxlength="10" pattern="[0-9]{10}"
                                   placeholder="۱۰ رقم"
                                   value="@currentStore.StorePostCode"
                                   @oninput="OnPostCodeInput"
                                   title="کد پستی باید دقیقاً ۱۰ رقم باشد" />
                            @if (!string.IsNullOrEmpty(currentStore.StorePostCode) && currentStore.StorePostCode.Length != 10)
                            {
                                <small class="text-danger">کد پستی باید دقیقاً ۱۰ رقم باشد</small>
                            }
                        </div>

                        <div class="form-group">
                            <label>تلفن</label>
                            <input type="text" class="form-control" inputmode="numeric" pattern="[0-9]*"
                                   value="@currentStore.StorePhone"
                                   @oninput="OnPhoneInput"
                                   title="فقط عدد وارد کنید" />
                        </div>

                        <div class="form-group">
                            <label>دسته‌بندی</label>
                            <select class="form-control" @bind="categoryIdBind">
                                <option value="0">انتخاب کنید</option>
                                @foreach (var cat in storeCategories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label>شماره پوز 1</label>
                            <input type="text" class="form-control" inputmode="numeric" pattern="[0-9]*"
                                   value="@currentStore.StorePos1"
                                   @oninput="OnPos1Input"
                                   title="فقط عدد وارد کنید" />
                        </div>

                        <div class="form-group">
                            <label>شماره پوز 2</label>
                            <input type="text" class="form-control" inputmode="numeric" pattern="[0-9]*"
                                   value="@currentStore.StorePos2"
                                   @oninput="OnPos2Input"
                                   title="فقط عدد وارد کنید" />
                        </div>

                        <div class="form-group">
                            <label>شماره پوز 3</label>
                            <input type="text" class="form-control" inputmode="numeric" pattern="[0-9]*"
                                   value="@currentStore.StorePos3"
                                   @oninput="OnPos3Input"
                                   title="فقط عدد وارد کنید" />
                        </div>

                        <hr style="margin: 24px 0; border: none; border-top: 2px solid #e5e7eb;" />
                        <h4 style="margin-bottom: 16px; color: #1f2937;">موقعیت روی نقشه</h4>
                        <div class="form-group">
                            <label>انتخاب موقعیت</label>
                            <p class="map-hint">نقشه در حالت عادی بارگذاری می‌شود (مرکز تهران). می‌توانید با کلیک روی نقشه موقعیت را دستی انتخاب کنید یا از دکمه زیر استفاده از موقعیت فعلی را بپذیرید.</p>
                            <div id="@GetMapPickerId()" class="neshan-map-picker-box"></div>
                            <div class="map-actions">
                                <button type="button" class="btn-map-location" @onclick="RequestCurrentLocationAsync">
                                    📍 دریافت موقعیت فعلی
                                </button>
                                <button type="button" class="btn-map-save" @onclick="ConfirmStoreLocationAsync"
                                        disabled="@(savingLocation || !HasPendingLocation)">
                                    @(savingLocation ? "در حال ثبت موقعیت..." : "ثبت موقعیت")
                                </button>
                            </div>
                            @if (locationDirty)
                            {
                                <p class="map-pending-note">موقعیت روی نقشه انتخاب شد. برای ذخیره روی «ثبت موقعیت» بزنید تا مختصات ذخیره شود و آدرس پر گردد.</p>
                            }
                            @if (!string.IsNullOrEmpty(locationMessage))
                            {
                                <p class="map-location-ok">@locationMessage</p>
                            }
                            <small style="color: #6b7280; font-size: 12px; margin-top: 4px; display: block;">
                                روی نقشه کلیک کنید تا موقعیت فروشگاه را دستی مشخص کنید، یا با «دریافت موقعیت فعلی» دسترسی لوکیشن را بپذیرید. نقشه از OpenStreetMap یا <a href="https://platform.neshan.org" target="_blank" rel="noopener">نقشه نشان</a> (در تنظیمات سایت) استفاده می‌کند.
                            </small>
                        </div>
                        <div style="display: none;" aria-hidden="true">
                            <h4 style="margin-bottom: 16px; color: #1f2937;">اطلاعات تکمیلی</h4>
                            <div class="form-group">
                                <label>عرض جغرافیایی (Latitude) - برای نقشه</label>
                                <input type="number" step="any" class="form-control" placeholder="35.6892" @bind="currentStore.StoreLatitude" />
                            </div>
                            <div class="form-group">
                                <label>طول جغرافیایی (Longitude) - برای نقشه</label>
                                <input type="number" step="any" class="form-control" placeholder="51.3890" @bind="currentStore.StoreLongitude" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>
                                <input type="checkbox" @bind="currentStore.IsLocationEnabled" />
                                نمایش فروشگاه روی نقشه
                            </label>
                        </div>
                        <div class="form-group">
                            <label>ساعت شروع کار</label>
                            <select class="form-control" @bind="selectedOpeningHour">
                                @for (var h = 0; h <= 24; h++)
                                {
                                    <option value="@h">@(h.ToString("00")):00</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label>ساعت پایان کار</label>
                            <select class="form-control" @bind="selectedClosingHour">
                                @for (var h = 0; h <= 24; h++)
                                {
                                    <option value="@h">@(h.ToString("00")):00</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label>روزهای کاری</label>
                            <div class="days-checkbox-list">
                                @foreach (var day in days)
                                {
                                    <label class="day-checkbox-item">
                                        <input type="checkbox" checked="@selectedDayIds.Contains(day.Id)" @onchange="@(e => ToggleDay(day.Id, (bool)e.Value))" />
                                        <span>@day.Name</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="form-group">
                            <label>وب‌سایت</label>
                            <input type="url" class="form-control" placeholder="https://example.com" @bind="currentStore.StoreWebsite" />
                        </div>

                        <div class="form-group">
                            <label>شبکه‌های اجتماعی (JSON - اختیاری)</label>
                            <textarea class="form-control" rows="3" placeholder='{"instagram": "https://...", "telegram": "..."}' @bind="currentStore.StoreSocialMedia"></textarea>
                            <small style="color: #6b7280; font-size: 12px;">فرمت JSON برای ذخیره اطلاعات شبکه‌های اجتماعی</small>
                        </div>

                      

                        @if (!string.IsNullOrEmpty(message))
                        {
                            <div class="alert @(message.Contains("موفق") ? "alert-success" : "alert-danger")">
                                @message
                            </div>
                        }

                        <div class="form-actions">
                            <button type="submit" class="btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-small"></span>
                                }
                                else
                                {
                                    <span>@(editingStore != null ? "ذخیره تغییرات" : "ثبت فروشگاه")</span>
                                }
                            </button>
                            <button type="button" class="btn-secondary" @onclick="@(async () => await HideForm())" disabled="@saving">
                                انصراف
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

</div>

<style>
    .stores-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid #e5e7eb;
    }

    .stores-header h2 {
        margin: 0;
        font-size: 24px;
        color: #1f2937;
    }

    .btn-primary {
        background: linear-gradient(135deg, #2563eb, #3b82f6);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
