@code {
    private List<Coupon> coupons = new();
    private List<Store> stores = new();
    private Coupon currentCoupon = new();
    private Coupon editingCoupon;
    private bool loading = true;
    private bool saving = false;
    private bool showForm = false;
    private string message = "";
    private string walletSummary = "";
    private int userId;
    private bool phoneVerified = true;
    private bool voucherEnabled;
    
    // Amount formatting
    private string formattedMinBuy = "";
    private string formattedMaxBuy = "";
    private string editCouponCodeDisplay = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/Account/login-store", true);
            return;
        }

        if (!user.IsInRole("StoreOwner"))
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out userId))
        {
            message = "خطا در دریافت اطلاعات کاربر";
            loading = false;
            return;
        }

        try { phoneVerified = await UserService.IsPhoneVerifiedAsync(userId); }
        catch { phoneVerified = false; }
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            stores = await StoreService.GetByUserIdAsync(userId);
            coupons = await CouponService.GetByUserIdAsync(userId);
            try { voucherEnabled = BillingSettings != null && (await BillingSettings.GetAsync())?.VoucherEnabled == true; } catch { }
            walletSummary = "";
            if (VoucherWallet != null && stores != null)
            {
                long a = 0, r = 0;
                foreach (var s in stores)
                {
                    try
                    {
                        var w = await VoucherWallet.GetAsync(s.StoreID);
                        a += w?.Available ?? 0;
                        r += w?.Reserved ?? 0;
                    }
                    catch { }
                }
                walletSummary = $"کیف پول: آزاد {a:N0} / رزرو {r:N0} تومان";
            }
        }
        catch
        {
            message = "خطا در بارگذاری اطلاعات";
        }
        finally
        {
            loading = false;
        }
    }

    private void GoToCreate()
    {
        if (!phoneVerified)
        {
            message = "برای تعریف کوپن ابتدا شماره تلفن را فعال کنید.";
            return;
        }
        if (stores.Count == 0)
        {
            message = "ابتدا باید حداقل یک فروشگاه ثبت کنید";
            return;
        }
        Nav.NavigateTo("/StoreOwner/Gifts/Create", true);
    }

    private void EditCoupon(Coupon coupon)
    {
        editingCoupon = coupon;
        currentCoupon = new Coupon
        {
            CoponID = coupon.CoponID,
            CoponTitle = coupon.CoponTitle,
            CoponCode = coupon.CoponCode ?? "",
            StoreID = coupon.StoreID,
            UserID = coupon.UserID,
            CoponStock = coupon.CoponStock,
            CoponMinBuy = coupon.CoponMinBuy,
            CoponMaxBuy = coupon.CoponMaxBuy,
            CoponStartDate = coupon.CoponStartDate,
            CoponExpireDate = coupon.CoponExpireDate,
            CoponStatStor = coupon.CoponStatStor,
            CoponStatAdmin = coupon.CoponStatAdmin,
            DiscountType = coupon.DiscountType,
            DiscountValue = coupon.DiscountValue
        };
        formattedMinBuy = FormatAmountString(currentCoupon.CoponMinBuy);
        formattedMaxBuy = FormatAmountString(currentCoupon.CoponMaxBuy);
        editCouponCodeDisplay = currentCoupon.CoponCode ?? "";
        showForm = true;
        message = "";
    }

    private void HideForm()
    {
        showForm = false;
        currentCoupon = new Coupon();
        editingCoupon = null;
        formattedMinBuy = "";
        formattedMaxBuy = "";
        message = "";
    }
    
    private void OnMinBuyInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        var digitsOnly = new string(input.Where(char.IsDigit).ToArray());
        
        if (long.TryParse(digitsOnly, out long amount))
        {
            currentCoupon.CoponMinBuy = amount.ToString();
            formattedMinBuy = NumberFormatHelper.Format(amount.ToString());
        }
        else if (string.IsNullOrEmpty(digitsOnly))
        {
            currentCoupon.CoponMinBuy = "";
            formattedMinBuy = "";
        }
        
        StateHasChanged();
    }
    
    private void OnMaxBuyInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        var digitsOnly = new string(input.Where(char.IsDigit).ToArray());
        
        if (long.TryParse(digitsOnly, out long amount))
        {
            currentCoupon.CoponMaxBuy = amount.ToString();
            formattedMaxBuy = NumberFormatHelper.Format(amount.ToString());
        }
        else if (string.IsNullOrEmpty(digitsOnly))
        {
            currentCoupon.CoponMaxBuy = "";
            formattedMaxBuy = "";
        }
        
        StateHasChanged();
    }

    private void OnEditCouponCodeInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        var allowed = new string(raw.Where(c => char.IsLetterOrDigit(c) && c < 128).ToArray());
        if (allowed.Length > 10) allowed = allowed.Substring(0, 10);
        currentCoupon.CoponCode = allowed.ToUpperInvariant();
        editCouponCodeDisplay = currentCoupon.CoponCode;
        StateHasChanged();
    }
    
    private string FormatAmountString(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";
        
        var numbersOnly = new string(value.Where(char.IsDigit).ToArray());
        if (string.IsNullOrEmpty(numbersOnly))
            return "";
        
        if (long.TryParse(numbersOnly, out long number))
        {
            return number.ToString("#,##0");
        }
        
        return value;
    }

    private async Task SaveCoupon()
    {
        saving = true;
        message = "";

        try
        {
            if (!await UserService.IsPhoneVerifiedAsync(userId))
            {
                phoneVerified = false;
                message = "برای تعریف/ویرایش کوپن ابتدا شماره تلفن را فعال کنید.";
                saving = false;
                return;
            }

            currentCoupon.CoponCode = (currentCoupon.CoponCode ?? "").Trim().ToUpperInvariant();
            if (string.IsNullOrWhiteSpace(currentCoupon.CoponCode))
            {
                message = "کد کوپن الزامی است (فقط حروف و اعداد انگلیسی، حداکثر ۱۰ کاراکتر)";
                saving = false;
                return;
            }
            if (currentCoupon.CoponCode.Length > 10) currentCoupon.CoponCode = currentCoupon.CoponCode.Substring(0, 10);
            if (string.IsNullOrWhiteSpace(currentCoupon.CoponTitle))
            {
                message = "عنوان کوپن الزامی است";
                saving = false;
                return;
            }
            if (currentCoupon.CoponStartDate.HasValue && currentCoupon.CoponExpireDate < currentCoupon.CoponStartDate.Value)
            {
                message = "تاریخ انقضا باید بعد از تاریخ شروع باشد";
                saving = false;
                return;
            }

            if (currentCoupon.StoreID <= 0)
            {
                message = "لطفاً فروشگاه را انتخاب کنید";
                saving = false;
                return;
            }

            if (voucherEnabled) currentCoupon.DiscountType = 0;

            if (editingCoupon == null)
            {
                message = "برای افزودن کوپن جدید از صفحه ایجاد استفاده کنید.";
                saving = false;
                return;
            }

            var success = await CouponService.UpdateAsync(currentCoupon);
            if (success)
            {
                message = "کوپن با موفقیت به‌روزرسانی شد";
                await LoadData();
                await Task.Delay(1500);
                HideForm();
            }
            else
            {
                message = "خطا در به‌روزرسانی کوپن (موجودی کیف پول کافی نیست یا داده نامعتبر است).";
            }
        }
        catch (InvalidOperationException ex) when (ex.Message == "DUPLICATE_COUPON_CODE")
        {
            message = "این کد کوپن قبلاً ثبت شده است. کد دیگری انتخاب کنید.";
        }
        catch
        {
            message = "خطا در ذخیره کوپن";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteCoupon(int couponId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "آیا از حذف این کوپن اطمینان دارید؟"))
        {
            return;
        }

        try
        {
            var success = await CouponService.DeleteAsync(couponId);
            if (success)
            {
                message = "کوپن با موفقیت حذف شد";
                await LoadData();
            }
            else
            {
                message = "خطا در حذف کوپن";
            }
        }
        catch (Exception ex)
        {
            message = UserFacingErrorHelper.ToPersianError(ex);
        }
    }

    private async Task ToggleStatus(int couponId, bool status)
    {
        try
        {
            var success = await CouponService.ToggleStoreStatusAsync(couponId, status);
            if (success)
            {
                message = status ? "کوپن فعال شد" : "کوپن غیرفعال شد";
                await LoadData();
            }
            else
            {
                message = "خطا در تغییر وضعیت";
            }
        }
        catch
        {
            message = "خطا در تغییر وضعیت";
        }
    }

    private string GetDiscountSummary(Coupon c)
    {
        if (c.DiscountValue.HasValue)
            return c.DiscountType == 1 ? $"{c.DiscountValue}٪" : $"{NumberFormatHelper.Format(c.DiscountValue.Value)} تومان";
        if (c.DiscountPercent.HasValue)
            return $"{c.DiscountPercent}٪";
        if (c.DiscountAmount.HasValue)
            return $"{NumberFormatHelper.Format(c.DiscountAmount.Value)} تومان";
        return "-";
    }
}
