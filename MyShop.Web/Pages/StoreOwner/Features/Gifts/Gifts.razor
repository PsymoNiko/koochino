@page "/StoreOwner/Gifts"
@layout StoreLayout
@using MyShop.Core.Helpers

@using MyShop.Core.Models
@using MyShop.Application.Interfaces
@using System.Security.Claims
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq
@using System
@inject ICouponService CouponService
@inject IStoreService StoreService
@inject IUserService UserService
@inject MyShop.Application.Interfaces.Finance.IStoreVoucherWalletService VoucherWallet
@inject MyShop.Application.Interfaces.Finance.IStoreBillingSettingsService BillingSettings
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JSRuntime

<div class="container-content" dir="rtl" lang="fa">
    <div class="gifts-header">
        <h2>مدیریت کدهای تخفیف</h2>
        <div class="gifts-header-actions">
            <button class="btn-secondary" @onclick="@(() => Nav.NavigateTo("/StoreOwner/GiftsUsed"))">کدهای استفاده‌شده</button>
            <button class="btn-primary" @onclick="GoToCreate" disabled="@(!phoneVerified)" title="@(phoneVerified ? "" : "فعال‌سازی تلفن لازم است")">
                <span>+</span> افزودن کد تخفیف
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(walletSummary))
    {
        <p class="hint" style="color:#0f766e;margin:8px 0 16px;">@walletSummary — <a href="/storeowner/voucher-wallet">جزئیات کیف پول</a></p>
    }

    @if (!phoneVerified)
    {
        <div class="phone-gate-alert">
            <span>📱 برای تعریف کوپن، ابتدا شماره تلفن همراه خود را فعال کنید.</span>
            <button type="button" class="btn-primary" @onclick="@(() => Nav.NavigateTo("/StoreOwner/UserProfile"))">فعال‌سازی تلفن</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(message.Contains("موفق") ? "alert-success" : "alert-danger")">
            @message
        </div>
    }

    @if (loading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else if (coupons == null || coupons.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🎫</div>
            <h3>هنوز کوپنی ثبت نکرده‌اید</h3>
            <p>برای شروع، کوپن جدیدی اضافه کنید</p>
            <button class="btn-primary" @onclick="GoToCreate" disabled="@(!phoneVerified)" title="@(phoneVerified ? "" : "فعال‌سازی تلفن لازم است")">
                افزودن کوپن
            </button>
        </div>
    }
    else
    {
        <div class="m-cards">
            @foreach (var coupon in coupons)
            {
                <article class="m-card">
                    <div class="m-card-head">
                        <div>
                            <h4 class="m-card-title">@coupon.CoponTitle</h4>
                            <p class="m-card-sub">@(string.IsNullOrEmpty(coupon.CoponCode) ? coupon.CoponTitle : coupon.CoponCode) · @coupon.StoreName</p>
                        </div>
                    </div>
                    <div class="m-card-rows">
                        <div class="m-row"><span class="k">تخفیف</span><span class="v">@GetDiscountSummary(coupon)</span></div>
                        <div class="m-row"><span class="k">موجودی</span><span class="v">@coupon.CoponStock</span></div>
                        <div class="m-row"><span class="k">حداقل خرید</span><span class="v">@NumberFormatHelper.Format(coupon.CoponMinBuy) تومان</span></div>
                        <div class="m-row"><span class="k">حداکثر تخفیف</span><span class="v">@NumberFormatHelper.Format(coupon.CoponMaxBuy) تومان</span></div>
                        <div class="m-row"><span class="k">شروع</span><span class="v">@(coupon.CoponStartDate.HasValue ? PersianDateHelper.ToPersianDateString(coupon.CoponStartDate.Value) : "-")</span></div>
                        <div class="m-row"><span class="k">انقضا</span><span class="v">@PersianDateHelper.ToPersianDateString(coupon.CoponExpireDate)</span></div>
                        <div class="m-row">
                            <span class="k">وضعیت</span>
                            <span class="v">
                                @if (coupon.CoponStatAdmin && coupon.CoponStatStor)
                                {
                                    <span class="text-success">تایید شده</span>
                                }
                                else if (!coupon.CoponStatAdmin)
                                {
                                    <span class="text-warning">در انتظار تایید ادمین</span>
                                }
                                else
                                {
                                    <span class="text-danger">غیرفعال</span>
                                }
                            </span>
                        </div>
                    </div>
                    <div class="m-card-foot">
                        <button type="button" class="btn-secondary" @onclick="@(() => EditCoupon(coupon))">ویرایش</button>
                        <button type="button" class="btn-secondary" @onclick="@(() => DeleteCoupon(coupon.CoponID))">حذف</button>
                        @if (coupon.CoponStatStor)
                        {
                            <button type="button" class="btn-secondary" @onclick="@(() => ToggleStatus(coupon.CoponID, false))">غیرفعال</button>
                        }
                        else
                        {
                            <button type="button" class="btn-secondary" @onclick="@(() => ToggleStatus(coupon.CoponID, true))">فعال</button>
                        }
                    </div>
                </article>
            }
        </div>
    }

    @if (showForm && editingCoupon != null)
    {
        <div class="modal-overlay" @onclick="HideForm">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>ویرایش کوپن</h3>
                    <button class="modal-close" @onclick="HideForm">×</button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentCoupon" OnValidSubmit="SaveCoupon">
                        <div class="form-row">
                            <div class="form-group">
                                <label>کد کوپن * <span class="label-hint">فقط حروف و اعداد انگلیسی، حداکثر ۱۰ کاراکتر</span></label>
                                <input type="text" class="form-control coupon-code-input" 
                                       value="@editCouponCodeDisplay" 
                                       @oninput="OnEditCouponCodeInput"
                                       placeholder="مثال: WELCOME10" required maxlength="10" />
                            </div>
                            <div class="form-group">
                                <label>عنوان کوپن *</label>
                                <input type="text" class="form-control" @bind="currentCoupon.CoponTitle" placeholder="مثال: تخفیف ویژه" required maxlength="50" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>فروشگاه *</label>
                            <select class="form-control" @bind="currentCoupon.StoreID" required>
                                <option value="0">انتخاب فروشگاه</option>
                                @foreach (var store in stores)
                                {
                                    <option value="@store.StoreID">@store.StoreName</option>
                                }
                            </select>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>نوع تخفیف *</label>
                                <select class="form-control" @bind="currentCoupon.DiscountType" disabled="@voucherEnabled">
                                    <option value="0">مبلغ ثابت (تومان)</option>
                                    @if (!voucherEnabled)
                                    {
                                        <option value="1">درصد (%)</option>
                                    }
                                </select>
                                @if (voucherEnabled)
                                {
                                    <small class="label-hint">با کیف پول فقط مبلغ ثابت (تومان) مجاز است.</small>
                                }
                            </div>
                            <div class="form-group">
                                <label>@(currentCoupon.DiscountType == 1 ? "درصد تخفیف (۱–۱۰۰) *" : "مبلغ تخفیف (تومان) *")</label>
                                <input type="number" class="form-control" @bind="currentCoupon.DiscountValue" min="@(currentCoupon.DiscountType == 1 ? 1 : 0)" max="@(currentCoupon.DiscountType == 1 ? 100 : (long?)null)" placeholder="@(currentCoupon.DiscountType == 1 ? "مثال: 10" : "مثال: 50000")" required />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>تعداد موجود *</label>
                                <input type="number" class="form-control" @bind="currentCoupon.CoponStock" min="1" required />
                            </div>
                            <div class="form-group">
                                <label>مبلغ حداقل خرید (تومان) *</label>
                                <input type="text" 
                                       class="form-control amount-input" 
                                       value="@formattedMinBuy"
                                       @oninput="OnMinBuyInput"
                                       placeholder="مثال: 100,000" 
                                       required />
                                <input type="hidden" @bind="currentCoupon.CoponMinBuy" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>مبلغ حداکثر تخفیف (تومان) *</label>
                                <input type="text" 
                                       class="form-control amount-input" 
                                       value="@formattedMaxBuy"
                                       @oninput="OnMaxBuyInput"
                                       placeholder="مثال: 50,000" 
                                       required />
                                <input type="hidden" @bind="currentCoupon.CoponMaxBuy" />
                            </div>
                            <div class="form-group">
                                <label>تاریخ شروع اعتبار</label>
                                <input type="date" class="form-control" @bind="currentCoupon.CoponStartDate" />
                            </div>
                            <div class="form-group">
                                <label>تاریخ انقضا *</label>
                                <input type="date" class="form-control" @bind="currentCoupon.CoponExpireDate" required />
                            </div>
                        </div>
                        <div class="form-actions">
                            <button type="button" class="btn-secondary" @onclick="HideForm" disabled="@saving">انصراف</button>
                            <button type="submit" class="btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-small"></span>
                                }
                                else
                                {
                                    <span>ذخیره</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>

