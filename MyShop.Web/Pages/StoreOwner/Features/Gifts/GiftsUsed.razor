@page "/StoreOwner/GiftsUsed"
@layout StoreLayout

@using MyShop.Core.Models.Dto
@using MyShop.Application.Interfaces
@using System.Security.Claims
@using System.Linq
@inject ICouponService CouponService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<div class="container-content" dir="rtl" lang="fa">
    <div class="page-header-row">
        <h2>کوپن‌های استفاده‌شده</h2>
        <button class="btn-back" @onclick="@(() => Nav.NavigateTo("/StoreOwner/Gifts"))">← بازگشت به لیست کوپن‌ها</button>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(message.Contains("موفق") ? "alert-success" : "alert-danger")">@message</div>
    }

    @if (loading)
    {
        <div class="loading-box">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else if (usages == null || !usages.Any())
    {
        <div class="empty-state">
            <p>هنوز هیچ استفاده‌ای از کوپن‌های شما ثبت نشده است.</p>
        </div>
    }
    else
    {
        <div class="m-cards">
            @foreach (var u in usages)
            {
                <article class="m-card">
                    <div class="m-card-head">
                        <div>
                            <h4 class="m-card-title">@u.CouponCode</h4>
                            <p class="m-card-sub">@u.StoreName · @PersianDateHelper.ToPersianDateTimeString(u.UsedAt)</p>
                        </div>
                        @if (u.ApprovedByStore == true)
                        {
                            <span class="badge badge-success">تایید شده</span>
                        }
                        else
                        {
                            <span class="badge badge-warning">در انتظار تایید</span>
                        }
                    </div>
                    <div class="m-card-rows">
                        <div class="m-row"><span class="k">مشتری</span><span class="v">@u.UserName</span></div>
                        <div class="m-row"><span class="k">تلفن</span><span class="v">@u.UserPhone</span></div>
                        <div class="m-row"><span class="k">مبلغ خرید</span><span class="v">@NumberFormatHelper.Format(u.PurchaseAmount) تومان</span></div>
                        <div class="m-row"><span class="k">تخفیف</span><span class="v ok">@NumberFormatHelper.Format(u.DiscountAmount) تومان</span></div>
                    </div>
                    @if (u.ApprovedByStore != true)
                    {
                        <div class="m-card-foot">
                            <button type="button" class="btn-approve" @onclick="@(() => ApproveUsage(u.Id))" disabled="@approving">تایید</button>
                        </div>
                    }
                </article>
            }
        </div>
    }
</div>

<style>
    .page-header-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }
    .page-header-row h2 { margin: 0; font-size: 1.35rem; }
    .btn-back { background: none; border: 1px solid #2563eb; color: #2563eb; padding: 8px 16px; border-radius: 8px; cursor: pointer; font-size: 14px; }
    .btn-back:hover { background: #eff6ff; }
    .loading-box { text-align: center; padding: 40px; }
    .spinner { width: 40px; height: 40px; border: 3px solid #e5e7eb; border-top-color: #2563eb; border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 12px; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .empty-state { text-align: center; padding: 40px; background: #f9fafb; border-radius: 12px; }
    .table-wrap { overflow-x: auto; background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th, .data-table td { padding: 12px; text-align: right; border-bottom: 1px solid #eee; }
    .data-table th { background: #f3f4f6; font-weight: 600; }
    .badge { padding: 4px 10px; border-radius: 6px; font-size: 12px; }
    .badge-success { background: #d1fae5; color: #065f46; }
    .badge-warning { background: #fef3c7; color: #92400e; }
    .btn-approve { background: #2563eb; color: #fff; border: none; padding: 6px 14px; border-radius: 6px; cursor: pointer; font-size: 13px; }
    .btn-approve:hover:not(:disabled) { background: #1d4ed8; }
    .btn-approve:disabled { opacity: 0.6; cursor: not-allowed; }
    .text-muted { color: #9ca3af; }
</style>

@code {
    private List<CouponUsageStoreOwnerDto> usages = new();
    private bool loading = true;
    private bool approving = false;
    private string message = "";
    private int userId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var claim = state.User.FindFirst(ClaimTypes.NameIdentifier);
        if (claim == null || !int.TryParse(claim.Value, out userId))
        {
            Nav.NavigateTo("/Account/login-store", true);
            return;
        }
        await LoadUsages();
        loading = false;
    }

    private async Task LoadUsages()
    {
        try
        {
            usages = await CouponService.GetUsageReportByStoreOwnerAsync(userId);
        }
        catch
        {
            message = "خطا در بارگذاری لیست.";
        }
    }

    private async Task ApproveUsage(int usageId)
    {
        approving = true;
        message = "";
        try
        {
            var ok = await CouponService.ApproveCouponUsageByStoreAsync(usageId, userId);
            if (ok)
            {
                message = "تایید با موفقیت ثبت شد.";
                await LoadUsages();
            }
            else
                message = "امکان تایید این مورد وجود ندارد.";
        }
        catch
        {
            message = "خطا در تایید.";
        }
        approving = false;
    }

}
