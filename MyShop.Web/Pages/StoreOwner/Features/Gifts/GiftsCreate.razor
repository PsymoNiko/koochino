@page "/storeowner/gifts/create"
@layout StoreLayout
@using MyShop.Core.Helpers
@using MyShop.Core.Models
@using MyShop.Core.Models.Finance
@using MyShop.Application.Interfaces
@using MyShop.Application.Interfaces.Finance
@using MyShop.Application.Interfaces.Settings
@using MyShop.Core.Interfaces
@using System.Security.Claims
@using System.Linq
@using Microsoft.AspNetCore.Components.Forms
@inject ICouponService CouponService
@inject IStoreService StoreService
@inject IUserService UserService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JSRuntime
@inject IStoreBillingSettingsService BillingSettings
@inject IStoreVoucherWalletService VoucherWallet
@inject ISiteAdminSettingsService SiteSettingsService
@inject ICurrentTenant Tenant

<div class="container-content gifts-create-page" dir="rtl" lang="fa">
    <div class="page-header">
        <button type="button" class="back-link" @onclick="@(() => Nav.NavigateTo("/StoreOwner/Gifts"))">← بازگشت به لیست کدهای تخفیف</button>
        <h2>ساخت کد تخفیف جدید</h2>
        <p class="page-sub">کد را تعریف کنید؛ پس از ثبت، در انتظار تأیید ادمین می‌ماند.</p>
    </div>

    @if (!phoneVerified)
    {
        <div class="gate-alert">
            <span>📱 برای تعریف کوپن، ابتدا شماره تلفن همراه خود را فعال کنید.</span>
            <button type="button" class="btn-primary btn-sm" @onclick="@(() => Nav.NavigateTo("/StoreOwner/UserProfile"))">فعال‌سازی تلفن</button>
        </div>
    }

    @if (requireIdentityVerification && !identityVerified)
    {
        <div class="gate-alert">
            <span>🪪 برای تعریف کد تخفیف، ابتدا احراز هویت خود را تکمیل کنید.</span>
            <button type="button" class="btn-primary btn-sm" @onclick="@(() => Nav.NavigateTo("/StoreOwner/IdentityVerification"))">احراز هویت</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(message.Contains("موفق") ? "alert-success" : "alert-danger")">@message</div>
    }

    <div class="form-card @(requireIdentityVerification && !identityVerified ? "form-disabled" : "")">
        <EditForm Model="model" OnValidSubmit="SubmitCreate">

            <section class="form-section">
                <div class="section-head">
                    <span class="section-badge">۱</span>
                    <div>
                        <h3 class="section-title">اطلاعات پایه</h3>
                        <p class="section-desc">کد، عنوان و فروشگاه</p>
                    </div>
                </div>

                <div class="form-group">
                    <label>کد کوپن * <span class="label-hint">فقط حروف و اعداد انگلیسی، دقیقاً ۸ کاراکتر</span></label>
                    <div class="coupon-code-wrap">
                        <input type="text" class="form-control coupon-code-input"
                               value="@couponCodeDisplay"
                               @oninput="OnCouponCodeInput"
                               placeholder="مثال: JAS41241"
                               maxlength="8"
                               required
                               autocomplete="off" />
                        <span class="coupon-counter @(couponCodeDisplay.Length == 8 ? "ok" : "")">@(couponCodeDisplay.Length)/8</span>
                    </div>
                    <small class="field-hint">پس از ثبت: <b>k@(model.StoreID > 0 ? model.StoreID.ToString() : "…")-@(!string.IsNullOrEmpty(couponCodeDisplay) ? couponCodeDisplay : "XXXXXXXX")</b></small>
                </div>

                <div class="form-group">
                    <label>عنوان کوپن *</label>
                    <input type="text" class="form-control" @bind="model.CoponTitle" placeholder="مثال: تخفیف ویژه نوروز" maxlength="50" required />
                </div>

                <div class="form-group">
                    <label>فروشگاه *</label>
                    <select class="form-control" value="@model.StoreID" @onchange="OnStoreChanged" required>
                        <option value="0">انتخاب فروشگاه</option>
                        @foreach (var s in stores)
                        {
                            <option value="@s.StoreID">@s.StoreName</option>
                        }
                    </select>
                </div>

                @if (voucherEnabled && model.StoreID > 0)
                {
                    <div class="wallet-chip @(walletAvailable <= 0 ? "warn" : "")">
                        <div class="wallet-chip-main">
                            <span class="wallet-chip-label">اعتبار آزاد کیف پول</span>
                            <strong class="wallet-chip-value">@NumberFormatHelper.Format(walletAvailable) <span>تومان</span></strong>
                        </div>
                        <a class="wallet-chip-link" href="/storeowner/voucher-wallet">مشاهده کیف پول</a>
                    </div>
                }
            </section>

            <section class="form-section">
                <div class="section-head">
                    <span class="section-badge">۲</span>
                    <div>
                        <h3 class="section-title">مبلغ و تعداد</h3>
                        <p class="section-desc">نوع تخفیف و موجودی کد</p>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>نوع تخفیف *</label>
                        <select class="form-control" @bind="model.DiscountType" disabled="@voucherEnabled">
                            <option value="0">مبلغ ثابت (تومان)</option>
                            @if (!voucherEnabled)
                            {
                                <option value="1">درصد (%)</option>
                            }
                        </select>
                        @if (voucherEnabled)
                        {
                            <small class="field-hint">با کیف پول فقط مبلغ ثابت (تومان) مجاز است.</small>
                        }
                    </div>
                    <div class="form-group">
                        <label>@(model.DiscountType == 1 ? "درصد تخفیف (۱–۱۰۰) *" : "مبلغ تخفیف (تومان) *")</label>
                        @if (model.DiscountType == 1)
                        {
                            <input type="number" class="form-control" @bind="model.DiscountValue" min="1" max="100" placeholder="10" required />
                        }
                        else
                        {
                            <input type="text" class="form-control amount-input" inputmode="numeric"
                                   value="@formattedDiscount"
                                   @oninput="OnDiscountInput"
                                   placeholder="۲۰٬۰۰۰"
                                   required />
                        }
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>تعداد موجود *</label>
                        <input type="number" class="form-control" value="@model.CoponStock" @onchange="OnStockChanged" min="1" required />
                    </div>
                    <div class="form-group">
                        <label>مبلغ حداقل خرید (تومان) *</label>
                        <input type="text" class="form-control amount-input" value="@formattedMinBuy" @oninput="OnMinBuyInput" placeholder="۱۰۰٬۰۰۰" required />
                    </div>
                </div>

                @if (voucherEnabled && model.DiscountType == 0 && RequiredFaceValue > 0)
                {
                    <div class="face-value-bar @(RequiredFaceValue > walletAvailable ? "over" : "ok")">
                        <div>
                            <span class="fv-label">اعتبار لازم از کیف پول</span>
                            <strong>@NumberFormatHelper.Format(RequiredFaceValue) تومان</strong>
                            <small>(مبلغ × تعداد)</small>
                        </div>
                        @if (RequiredFaceValue > walletAvailable)
                        {
                            <span class="fv-badge">بیش از موجودی</span>
                        }
                        else
                        {
                            <span class="fv-badge ok">کافی است</span>
                        }
                    </div>
                }

                <div class="form-group">
                    <label>سقف تخفیف قابل اعمال (تومان) *</label>
                    <input type="text" class="form-control amount-input" value="@formattedMaxBuy" @oninput="OnMaxBuyInput" placeholder="۵۰٬۰۰۰" required />
                    <small class="field-hint">حداکثر مبلغی که از این کد روی یک خرید کم می‌شود.</small>
                </div>
            </section>

            <section class="form-section">
                <div class="section-head">
                    <span class="section-badge">۳</span>
                    <div>
                        <h3 class="section-title">بازه اعتبار</h3>
                        <p class="section-desc">شروع و انقضای کد</p>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>تاریخ شروع اعتبار</label>
                        <input type="date" class="form-control" @bind="model.CoponStartDate" />
                    </div>
                    <div class="form-group">
                        <label>تاریخ انقضا *</label>
                        <input type="date" class="form-control" @bind="model.CoponExpireDate" required />
                    </div>
                </div>
            </section>

            <div class="form-actions">
                <button type="button" class="btn-secondary" @onclick="@(() => Nav.NavigateTo("/StoreOwner/Gifts"))">انصراف</button>
                <button type="submit" class="btn-primary" disabled="@(saving || (requireIdentityVerification && !identityVerified))">
                    @if (saving) { <span class="spinner-small"></span> }
                    else { <span>ایجاد کوپن</span> }
                </button>
            </div>
        </EditForm>
    </div>
</div>

@if (showWalletPopup)
{
    <div class="modal-overlay" @onclick="CloseWalletPopup">
        <div class="wallet-popup" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="wallet-popup-icon">⚠️</div>
            <h3>اعتبار کیف پول کافی نیست</h3>
            <p class="wallet-popup-text">
                اعتبار آزاد شما <strong>@NumberFormatHelper.Format(walletAvailable)</strong> تومان است
                و کمتر از مبلغ موردنیاز (<strong>@NumberFormatHelper.Format(popupRequired)</strong> تومان) می‌باشد.
            </p>
            <div class="wallet-popup-max">
                <span>حداکثر مبلغی که می‌توانید برای هر کد ثبت کنید:</span>
                <strong>@NumberFormatHelper.Format(popupMaxUnit) تومان</strong>
                @if (model.CoponStock > 1)
                {
                    <small>با تعداد @model.CoponStock — سقف کل اعتبار: @NumberFormatHelper.Format(walletAvailable) تومان</small>
                }
            </div>
            <div class="wallet-popup-actions">
                <button type="button" class="btn-primary" @onclick="ApplyMaxAndClose">اعمال حداکثر مبلغ</button>
                <button type="button" class="btn-secondary" @onclick="CloseWalletPopup">متوجه شدم</button>
                <a class="btn-link" href="/storeowner/voucher-wallet">رفتن به کیف پول</a>
            </div>
        </div>
    </div>
}

