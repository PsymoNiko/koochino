@code {
    private Coupon model = new();
    private List<Store> stores = new();
    private string message = "";
    private bool saving = false;
    private int userId;
    private bool phoneVerified = true;
    private bool identityVerified = true;
    private bool requireIdentityVerification;
    private string formattedMinBuy = "";
    private string formattedMaxBuy = "";
    private string formattedDiscount = "";
    private string couponCodeDisplay = "";
    private bool voucherEnabled;
    private long walletAvailable;
    private bool showWalletPopup;
    private long popupRequired;
    private long popupMaxUnit;

    private long RequiredFaceValue
    {
        get
        {
            if (model.DiscountType != 0) return 0;
            var unit = model.DiscountValue ?? 0;
            var stock = model.CoponStock < 0 ? 0 : model.CoponStock;
            return unit * stock;
        }
    }

    private long MaxUnitFromWallet
    {
        get
        {
            if (walletAvailable <= 0) return 0;
            var stock = model.CoponStock < 1 ? 1 : model.CoponStock;
            return walletAvailable / stock;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;
        if (!user.Identity?.IsAuthenticated ?? true) { Nav.NavigateTo("/Account/login-store", true); return; }
        if (!user.IsInRole("StoreOwner")) { Nav.NavigateTo("/access-denied"); return; }
        var claim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (claim == null || !int.TryParse(claim.Value, out userId)) { message = "خطا در احراز هویت"; return; }

        try { phoneVerified = await UserService.IsPhoneVerifiedAsync(userId); }
        catch { phoneVerified = false; }
        try { voucherEnabled = (await BillingSettings.GetAsync())?.VoucherEnabled == true; } catch { }
        try
        {
            var siteId = Tenant?.HasSite == true ? Tenant.SiteId : 0;
            var siteSettings = await SiteSettingsService.GetSettingsAsync(siteId);
            requireIdentityVerification = siteSettings.RequireIdentityVerificationForStoreFeatures;
            if (requireIdentityVerification)
            {
                var idStatus = await UserService.GetIdentityVerificationStatusAsync(userId);
                identityVerified = idStatus == "Approved";
            }
        }
        catch { }

        try
        {
            stores = await StoreService.GetByUserIdAsync(userId) ?? new();
            model = new Coupon
            {
                UserID = userId,
                CoponStatStor = true,
                CoponStatAdmin = false,
                CoponStartDate = DateTime.Now.Date,
                CoponExpireDate = DateTime.Now.AddDays(30),
                DiscountType = 0,
                CoponStock = 1
            };
            couponCodeDisplay = "";
            if (stores.Count == 1)
            {
                model.StoreID = stores[0].StoreID;
                await RefreshWalletAsync(model.StoreID);
            }
        }
        catch (Exception ex)
        {
            message = UserFacingErrorHelper.Format(ex, "خطا در بارگذاری:");
        }
    }

    private async Task OnStoreChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sid))
            model.StoreID = sid;
        else
            model.StoreID = 0;
        await RefreshWalletAsync(model.StoreID);
    }

    private async Task RefreshWalletAsync(int storeId)
    {
        walletAvailable = 0;
        if (!voucherEnabled || storeId <= 0) return;
        try
        {
            var w = await VoucherWallet.GetAsync(storeId);
            walletAvailable = w?.Available ?? 0;
        }
        catch { walletAvailable = 0; }
    }

    private void OnDiscountInput(ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (long.TryParse(digits, out long n))
        {
            model.DiscountValue = n;
            formattedDiscount = NumberFormatHelper.Format(n);
        }
        else if (string.IsNullOrEmpty(digits))
        {
            model.DiscountValue = null;
            formattedDiscount = "";
        }
        StateHasChanged();
    }

    private void OnStockChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n) && n >= 1)
            model.CoponStock = n;
        else
            model.CoponStock = 1;
        StateHasChanged();
    }

    private void OnMinBuyInput(ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (long.TryParse(digits, out long n)) { model.CoponMinBuy = n.ToString(); formattedMinBuy = NumberFormatHelper.Format(n); }
        else if (string.IsNullOrEmpty(digits)) { model.CoponMinBuy = ""; formattedMinBuy = ""; }
        StateHasChanged();
    }

    private void OnMaxBuyInput(ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
        if (long.TryParse(digits, out long n)) { model.CoponMaxBuy = n.ToString(); formattedMaxBuy = NumberFormatHelper.Format(n); }
        else if (string.IsNullOrEmpty(digits)) { model.CoponMaxBuy = ""; formattedMaxBuy = ""; }
        StateHasChanged();
    }

    private void OnCouponCodeInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        var allowed = new string(raw.Where(c => char.IsLetterOrDigit(c) && c < 128).ToArray());
        if (allowed.Length > 8) allowed = allowed.Substring(0, 8);
        couponCodeDisplay = allowed.ToUpperInvariant();
        StateHasChanged();
    }

    private void OpenWalletPopup(long required)
    {
        popupRequired = required;
        popupMaxUnit = MaxUnitFromWallet;
        showWalletPopup = true;
    }

    private void CloseWalletPopup()
    {
        showWalletPopup = false;
    }

    private void ApplyMaxAndClose()
    {
        var max = MaxUnitFromWallet;
        model.DiscountValue = max;
        formattedDiscount = max > 0 ? NumberFormatHelper.Format(max) : "";
        showWalletPopup = false;
        message = max > 0
            ? $"مبلغ تخفیف روی حداکثر مجاز ({NumberFormatHelper.Format(max)} تومان) تنظیم شد."
            : "موجودی کیف پول صفر است؛ ابتدا شارژ کنید.";
    }

    private async Task SubmitCreate()
    {
        message = "";
        saving = true;
        try
        {
            if (!await UserService.IsPhoneVerifiedAsync(userId))
            {
                phoneVerified = false;
                message = "برای تعریف کوپن ابتدا شماره تلفن را فعال کنید.";
                return;
            }

            if (requireIdentityVerification && await UserService.GetIdentityVerificationStatusAsync(userId) != "Approved")
            {
                identityVerified = false;
                message = "برای تعریف کد تخفیف ابتدا احراز هویت خود را تکمیل کنید.";
                return;
            }

            var userCode = (couponCodeDisplay ?? "").Trim().ToUpperInvariant();
            if (userCode.Length != 8) { message = "کد کوپن باید دقیقاً ۸ کاراکتر (فقط حروف و اعداد انگلیسی) باشد. الان " + userCode.Length + " کاراکتر وارد شده."; return; }
            if (model.StoreID <= 0) { message = "فروشگاه را انتخاب کنید"; return; }
            model.CoponCode = "k" + model.StoreID + "-" + userCode;
            if (!model.DiscountValue.HasValue || model.DiscountValue.Value < 0) { message = "مقدار تخفیف را وارد کنید"; return; }
            if (voucherEnabled) model.DiscountType = 0;
            if (model.DiscountType == 1 && (model.DiscountValue < 1 || model.DiscountValue > 100)) { message = "درصد تخفیف باید بین ۱ تا ۱۰۰ باشد"; return; }
            if (model.CoponStock < 1) { message = "تعداد موجود باید حداقل ۱ باشد"; return; }
            if (model.CoponStartDate.HasValue && model.CoponExpireDate < model.CoponStartDate.Value) { message = "تاریخ انقضا باید بعد از تاریخ شروع باشد"; return; }

            if (voucherEnabled && model.DiscountType == 0)
            {
                await RefreshWalletAsync(model.StoreID);
                var required = RequiredFaceValue;
                if (required > walletAvailable)
                {
                    OpenWalletPopup(required);
                    return;
                }
            }

            var id = await CouponService.CreateAsync(model);
            if (id > 0)
            {
                message = "کوپن با موفقیت ایجاد شد و در انتظار تایید ادمین است.";
                StateHasChanged();
                await Task.Delay(2000);
                Nav.NavigateTo("/StoreOwner/Gifts", true);
            }
            else if (id == -2)
            {
                message = "این کد کوپن قبلاً ثبت شده است. کد دیگری انتخاب کنید.";
            }
            else if (id == -4)
            {
                await RefreshWalletAsync(model.StoreID);
                OpenWalletPopup(RequiredFaceValue);
            }
            else if (id == -5)
            {
                message = "با کیف پول فقط تخفیف مبلغ ثابت (تومان) مجاز است یا رزرو اعتبار ناموفق بود.";
            }
            else
                message = "خطا در ایجاد کوپن.";
        }
        catch (Exception ex)
        {
            message = UserFacingErrorHelper.Format(ex, "خطا:");
        }
        finally
        {
            saving = false;
        }
    }
}
