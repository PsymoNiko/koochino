@page "/StoreOwner/ChanceBoxUsed"
@layout StoreLayout

@using MyShop.Core.Models
@using MyShop.Application.Interfaces
@using System.Security.Claims
@using System.Linq
@inject IChanceBoxService ChanceBoxService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<div class="container-content" dir="rtl" lang="fa">
    <div class="page-header-row">
        <h2>جعبه شانس‌های استفاده‌شده</h2>
        <button class="btn-back" @onclick="@(() => Nav.NavigateTo("/StoreOwner/ChanceBox"))">← بازگشت به مدیریت جعبه شانس</button>
    </div>

    @if (loading)
    {
        <div class="loading-box">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else if (usages == null || !usages.Any())
    {
        <div class="empty-state">
            <p>هنوز کسی کد جعبه شانس شما را استفاده نکرده است.</p>
        </div>
    }
    else
    {
        <div class="m-cards">
            @foreach (var u in usages)
            {
                <article class="m-card">
                    <div class="m-card-head">
                        <div>
                            <h4 class="m-card-title">@u.Code</h4>
                            <p class="m-card-sub">@u.StoreName · @PersianDateHelper.ToPersianDateTimeString(u.UsedAt)</p>
                        </div>
                    </div>
                    <div class="m-card-rows">
                        <div class="m-row"><span class="k">مشتری</span><span class="v">@u.UserName</span></div>
                        <div class="m-row"><span class="k">مبلغ خرید</span><span class="v ok">@NumberFormatHelper.Format(u.PurchaseAmount) تومان</span></div>
                    </div>
                </article>
            }
        </div>
    }
</div>

<style>
    .page-header-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }
    .page-header-row h2 { margin: 0; font-size: 1.35rem; }
    .btn-back { background: none; border: 1px solid #2563eb; color: #2563eb; padding: 8px 16px; border-radius: 8px; cursor: pointer; font-size: 14px; }
    .btn-back:hover { background: #eff6ff; }
    .loading-box { text-align: center; padding: 40px; }
    .spinner { width: 40px; height: 40px; border: 3px solid #e5e7eb; border-top-color: #2563eb; border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 12px; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .empty-state { text-align: center; padding: 40px; background: #f9fafb; border-radius: 12px; color: #6b7280; }
    .table-wrap { overflow-x: auto; background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th, .data-table td { padding: 12px; text-align: right; border-bottom: 1px solid #eee; }
    .data-table th { background: #f3f4f6; font-weight: 600; }
</style>

@code {
    private List<ChanceBoxCodeUsage> usages = new();
    private bool loading = true;
    private int userId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var claim = state.User.FindFirst(ClaimTypes.NameIdentifier);
        if (claim == null || !int.TryParse(claim.Value, out userId))
        {
            Nav.NavigateTo("/Account/login-store", true);
            return;
        }
        await LoadUsages();
        loading = false;
    }

    private async Task LoadUsages()
    {
        try
        {
            usages = await ChanceBoxService.GetUsagesForStoreOwnerAsync(userId) ?? new List<ChanceBoxCodeUsage>();
        }
        catch
        {
            usages = new List<ChanceBoxCodeUsage>();
        }
    }
}
