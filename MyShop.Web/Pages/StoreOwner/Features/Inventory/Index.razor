@page "/storeowner/inventory"
@layout StoreLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces
@using MyShop.Application.Interfaces.Inventory
@using MyShop.Core.Models
@using MyShop.Core.Models.Inventory
@using MyShop.Core.Helpers
@using System.Security.Claims
@attribute [Authorize(Roles = "StoreOwner")]
@inject IStoreOwnerPermissionService Perms
@inject IWarehouseService WarehouseService
@inject IStoreService StoreService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<div class="container-content" dir="rtl" style="padding:16px;">
    @if (!allowed) { <div class="alert alert-danger">دسترسی به ماژول انبار برای شما فعال نیست.</div> }
    else
    {
        @if (!string.IsNullOrEmpty(loadError))
        {
            <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px;border-radius:8px;margin-bottom:12px;">@loadError</div>
        }
        @if (loading)
        {
            <p>در حال بارگذاری...</p>
        }
        else
        {
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
            <h2>انبارهای من</h2>
            <button style="padding:8px 14px;background:#dc2626;color:#fff;border:none;border-radius:8px;" @onclick="()=>showForm=true">+ انبار جدید</button>
        </div>
        @if (!string.IsNullOrEmpty(msg)) { <p>@msg</p> }
        @if (showForm)
        {
            <div style="background:#fff;padding:12px;border-radius:12px;margin-bottom:12px;">
                <label>فروشگاه</label>
                <select class="form-control" @bind="form.StoreId">
                    @foreach (var s in myStores) { <option value="@s.StoreID">@s.StoreName</option> }
                </select>
                <label>نام انبار</label><input class="form-control" @bind="form.Name" />
                <label>کد</label><input class="form-control" @bind="form.Code" />
                <button style="margin-top:8px;padding:8px 14px;background:#059669;color:#fff;border:none;border-radius:8px;" @onclick="Save">ذخیره</button>
                <button style="margin-top:8px;padding:8px 14px;" @onclick="()=>showForm=false">انصراف</button>
            </div>
        }
        <div class="m-cards">
            @foreach (var w in warehouses)
            {
                <article class="m-card">
                    <div class="m-card-head">
                        <div>
                            <h4 class="m-card-title">@w.Name</h4>
                            <p class="m-card-sub">@GetStore(w.StoreId)</p>
                        </div>
                    </div>
                    <div class="m-card-rows">
                        <div class="m-row"><span class="k">کد</span><span class="v">@(w.Code??"—")</span></div>
                        <div class="m-row"><span class="k">وضعیت</span><span class="v">@(w.IsActive?"فعال":"غیرفعال")</span></div>
                    </div>
                </article>
            }
        </div>
        }
    }
</div>
@code {
    bool allowed, loading = true; int userId;
    List<Store> myStores = new();
    List<WarehouseDto> warehouses = new();
    CreateWarehouseDto form = new() { IsActive = true };
    bool showForm; string msg, loadError = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var st = await AuthProvider.GetAuthenticationStateAsync();
            int.TryParse(st.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value, out userId);
            allowed = await Perms.HasAsync(userId, StoreOwnerModules.Inventory);
            if (!allowed) return;
            myStores = await StoreService.GetByUserIdAsync(userId) ?? new();
            if (myStores.Any()) form.StoreId = myStores[0].StoreID;
            await Load();
        }
        catch (Exception ex)
        {
            loadError = UserFacingErrorHelper.ToPersianError(ex);
        }
        finally
        {
            loading = false;
        }
    }
    async Task Load()
    {
        warehouses = new();
        foreach (var s in myStores)
            warehouses.AddRange(await WarehouseService.GetAllAsync(s.StoreID) ?? new());
    }
    string GetStore(int? id) => myStores.FirstOrDefault(s => s.StoreID == id)?.StoreName ?? "—";
    async Task Save()
    {
        try
        {
            if (form.StoreId == null || string.IsNullOrWhiteSpace(form.Name)) { msg="فروشگاه و نام الزامی است"; return; }
            if (!myStores.Any(s => s.StoreID == form.StoreId)) { msg="فروشگاه نامعتبر"; return; }
            var id = await WarehouseService.CreateAsync(form);
            msg = id>0 ? "ایجاد شد" : "خطا";
            showForm = false; form = new(){ IsActive=true, StoreId=myStores.FirstOrDefault()?.StoreID }; await Load();
        }
        catch (Exception ex)
        {
            msg = UserFacingErrorHelper.ToPersianError(ex);
        }
    }
}
