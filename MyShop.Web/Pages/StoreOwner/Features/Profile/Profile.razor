@page "/storeowner/profile"
@layout StoreLayout
@using MyShop.Core.Helpers

@using MyShop.Core.Models
@using MyShop.Core.Models.Dto
@using MyShop.Application.Interfaces
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@using MyShop.Web.Services

@inject IUserService UserService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject UserDocumentUploadService DocumentUpload

<div class="container-content" dir="rtl" lang="fa">

    @if (loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else if (model == null || string.IsNullOrEmpty(model.PhoneNumber))
    {
        <div class="alert alert-danger">
            <p>@message</p>
            <p>لطفاً دوباره وارد شوید.</p>
        </div>
    }
    else
    {
        <ul class="nav nav-tabs mb-4" role="tablist">
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == 1 ? "active" : "")" @onclick="@(() => activeTab = 1)">
                    اطلاعات حساب
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == 2 ? "active" : "")" @onclick="@(() => activeTab = 2)">
                    مشخصات پروفایل و مدارک
                </button>
            </li>
        </ul>

        @if (activeTab == 1)
        {
            <EditForm Model="model" OnValidSubmit="Save">
                <div class="form-group">
                    <label>شماره موبایل</label>
                    <input class="form-control" @bind="model.PhoneNumber" readonly />
                </div>
                <div class="form-group">
                    <label>نام کاربری</label>
                    <input class="form-control" @bind="model.Username" />
                </div>
                <div class="form-group">
                    <label>نام</label>
                    <input class="form-control" @bind="model.FirstName" />
                </div>
                <div class="form-group">
                    <label>نام خانوادگی</label>
                    <input class="form-control" @bind="model.LastName" />
                </div>
                <div class="form-group">
                    <label>ایمیل</label>
                    <input class="form-control" @bind="model.Email" />
                </div>
                <div class="form-group">
                    <label>کد ملی</label>
                    <input class="form-control" @bind="model.NationalCode" />
                </div>
                <button class="btn btn-primary mt-3" disabled="@saving">
                    @if (saving)
                    {
                        <span class="spinner-small"></span>
                        <span>در حال ذخیره...</span>
                    }
                    else
                    {
                        <span>ذخیره اطلاعات</span>
                    }
                </button>
                @if (!string.IsNullOrEmpty(message))
                {
                    <p class="text-danger mt-2">@message</p>
                }
            </EditForm>
        }
        else
        {
            <div class="profile-documents-tab">
                <p class="text-muted mb-3">فرمت مجاز: JPG و PNG — حجم: حداقل ۵۰ کیلوبایت، حداکثر ۱ مگابایت</p>

                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <label class="d-block fw-bold mb-2">عکس پروفایل</label>
                                @if (!string.IsNullOrEmpty(model.ProfilePictureUrl))
                                {
                                    <img src="@model.ProfilePictureUrl" alt="پروفایل" class="rounded-circle mb-2" style="width:100px;height:100px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="bg-light rounded-circle d-inline-block mb-2" style="width:100px;height:100px;line-height:100px;">بدون عکس</div>
                                }
                                <InputFile class="form-control form-control-sm" OnChange="@(e => UploadDocument(e, DocTypeProfile))" accept=".jpg,.jpeg,.png" />
                                @if (uploadMessage.TryGetValue("ProfilePicture", out var pm))
                                {
                                    <div class="small mt-2 @(pm.success ? "text-success" : "text-danger")">@pm.text</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <label class="d-block fw-bold mb-2">عکس روی کارت ملی</label>
                                @if (!string.IsNullOrEmpty(model.NationalIdFrontImageUrl))
                                {
                                    <img src="@model.NationalIdFrontImageUrl" alt="کارت ملی رو" class="img-thumbnail mb-2" style="max-height:100px;object-fit:contain;" />
                                }
                                else
                                {
                                    <div class="bg-light border rounded d-inline-block mb-2 p-3 small">ارسال نشده</div>
                                }
                                <InputFile class="form-control form-control-sm" OnChange="@(e => UploadDocument(e, DocTypeNationalFront))" accept=".jpg,.jpeg,.png" />
                                @if (uploadMessage.TryGetValue("NationalIdFront", out var pm2))
                                {
                                    <div class="small mt-2 @(pm2.success ? "text-success" : "text-danger")">@pm2.text</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <label class="d-block fw-bold mb-2">عکس پشت کارت ملی</label>
                                @if (!string.IsNullOrEmpty(model.NationalIdBackImageUrl))
                                {
                                    <img src="@model.NationalIdBackImageUrl" alt="کارت ملی پشت" class="img-thumbnail mb-2" style="max-height:100px;object-fit:contain;" />
                                }
                                else
                                {
                                    <div class="bg-light border rounded d-inline-block mb-2 p-3 small">ارسال نشده</div>
                                }
                                <InputFile class="form-control form-control-sm" OnChange="@(e => UploadDocument(e, DocTypeNationalBack))" accept=".jpg,.jpeg,.png" />
                                @if (uploadMessage.TryGetValue("NationalIdBack", out var pm3))
                                {
                                    <div class="small mt-2 @(pm3.success ? "text-success" : "text-danger")">@pm3.text</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(documentsStatusMessage))
                {
                    <div class="alert @(documentsStatusSuccess ? "alert-success" : "alert-danger") py-2 px-3 small mb-0" role="alert">
                        @documentsStatusMessage
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    const string DocTypeProfile = "ProfilePicture";
    const string DocTypeNationalFront = "NationalIdFront";
    const string DocTypeNationalBack = "NationalIdBack";

    UserProfileVm model = new();
    UpdateUserProfileDto modelUpdate = new();
    bool loading = true;
    bool saving = false;
    string message = "";
    int activeTab = 1;

    string documentsStatusMessage = "";
    bool documentsStatusSuccess;
    Dictionary<string, (bool success, string text)> uploadMessage = new();

    bool _loaded;
    int _userId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var user = state.User;

            if (!user.Identity?.IsAuthenticated ?? true)
            {
                loading = false;
                Nav.NavigateTo("/Account/login-store", true);
                return;
            }

            if (!user.IsInRole("StoreOwner"))
            {
                loading = false;
                Nav.NavigateTo("/access-denied");
                return;
            }

            var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
            if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out _userId))
            {
                message = "خطا در دریافت اطلاعات کاربر";
                loading = false;
                return;
            }

            model = await UserService.GetProfileAsync(_userId);

            if (model == null)
            {
                message = "پروفایل کاربری یافت نشد";
                loading = false;
                return;
            }

            modelUpdate.PhoneNumber = model.PhoneNumber;
            modelUpdate.FirstName = model.FirstName;
            modelUpdate.LastName = model.LastName;
            modelUpdate.Email = model.Email;
            modelUpdate.NationalCode = model.NationalCode;
            modelUpdate.Username = model.Username;
        }
        catch (Exception ex)
        {
            message = UserFacingErrorHelper.ToPersianError(ex);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    async Task Save()
    {
        saving = true;
        message = "";

        modelUpdate.PhoneNumber = model.PhoneNumber;
        modelUpdate.FirstName = model.FirstName;
        modelUpdate.LastName = model.LastName;
        modelUpdate.Email = model.Email;
        modelUpdate.NationalCode = model.NationalCode;
        modelUpdate.Username = model.Username;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out int userId))
        {
            message = "خطا در دریافت اطلاعات کاربر";
            saving = false;
            return;
        }

        modelUpdate.UserId = userId;
        var result = await UserService.UpdateProfileAsync(modelUpdate);

        if (result > 0)
        {
            message = "اطلاعات ذخیره شد";
            model = await UserService.GetProfileAsync(userId);
        }
        else
        {
            message = result switch
            {
                0 => "خطا در به‌روزرسانی",
                2 => "نام کاربری تکراری است",
                3 => "کد ملی تکراری است",
                4 => "ایمیل تکراری است",
                -1 => "خطای داخلی سرور",
                _ => "خطای نامشخص"
            };
        }

        saving = false;
    }

    async Task UploadDocument(InputFileChangeEventArgs e, string documentType)
    {
        var file = e.File;
        if (file == null) return;

        documentsStatusMessage = "";
        uploadMessage[documentType] = (false, "در حال آپلود...");
        StateHasChanged();

        var (success, msg) = await DocumentUpload.UploadAsync(_userId, documentType, file);
        uploadMessage[documentType] = (success, msg);
        documentsStatusMessage = msg;
        documentsStatusSuccess = success;

        if (success)
            model = await UserService.GetProfileAsync(_userId);

        StateHasChanged();
    }
}

<style>
    .container-content {
        direction: rtl;
        padding: 20px;
    }

    /* ========== Loading State ========== */
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        gap: 16px;
        direction: rtl;
    }

    .loading-state .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #f3f4f6;
        border-top-color: #2563eb;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* ========== Tabs ========== */
    .nav-tabs {
        display: flex;
        border-bottom: 2px solid #e5e7eb;
        margin-bottom: 24px;
        direction: rtl;
        flex-wrap: wrap;
    }

    .nav-item {
        flex: 1;
        min-width: 120px;
    }

    .nav-link {
        width: 100%;
        padding: 12px 16px;
        background: transparent;
        border: none;
        border-bottom: 3px solid transparent;
        color: #6b7280;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        text-align: center;
        min-height: 44px;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        transition: all 0.2s ease;
    }

    .nav-link.active {
        color: #2563eb;
        border-bottom-color: #2563eb;
        background: rgba(37, 99, 235, 0.1);
    }

    .nav-link:active {
        transform: scale(0.98);
    }

    /* ========== Forms ========== */
    .form-group {
        margin-bottom: 20px;
        direction: rtl;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 500;
        color: #374151;
    }

    .form-control {
        width: 100%;
        padding: 14px 16px;
        font-size: 15px;
        color: #1f2937;
        background: #ffffff;
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        transition: all 0.2s ease;
        direction: rtl;
        text-align: right;
        font-family: 'Vazir', 'Vazirmatn', 'Tahoma', sans-serif;
        box-sizing: border-box;
        min-height: 48px;
        -webkit-tap-highlight-color: transparent;
    }

    .form-control:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .form-control[readonly] {
        background: #f9fafb;
        cursor: not-allowed;
    }

    .btn {
        padding: 14px 28px;
        font-size: 15px;
        font-weight: 600;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        min-height: 48px;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    .btn-primary:active:not(:disabled) {
        transform: scale(0.98);
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    }

    .btn-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .spinner-small {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
    }

    /* ========== Documents Tab ========== */
    .profile-documents-tab {
        direction: rtl;
    }

    .profile-documents-tab .text-muted {
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 20px;
    }

    .profile-documents-tab .card {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        margin-bottom: 16px;
    }

    .profile-documents-tab .card-body {
        padding: 20px;
    }

    .profile-documents-tab .form-control-sm {
        padding: 10px;
        font-size: 13px;
        min-height: 44px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        width: 100%;
        -webkit-tap-highlight-color: transparent;
    }

    .alert {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        direction: rtl;
    }

    .alert-danger {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fca5a5;
    }

    .alert-success {
        background: #d1fae5;
        color: #065f46;
        border: 1px solid #6ee7b7;
    }

    .text-danger {
        color: #dc2626;
    }

    /* ========== Responsive ========== */
    @@media (max-width: 768px) {
        .container-content {
            padding: 12px;
        }

        .nav-tabs {
            flex-direction: column;
        }

        .nav-item {
            width: 100%;
        }

        .nav-link {
            text-align: right;
            border-bottom: 1px solid #e5e7eb;
            border-right: 3px solid transparent;
        }

        .nav-link.active {
            border-right-color: #2563eb;
            border-bottom-color: #e5e7eb;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-control {
            padding: 12px 14px;
            font-size: 14px;
        }

        .btn {
            width: 100%;
            padding: 14px;
        }

        .profile-documents-tab .row {
            flex-direction: column;
        }

        .profile-documents-tab .col-md-4 {
            width: 100%;
            margin-bottom: 16px;
        }
    }
</style>
