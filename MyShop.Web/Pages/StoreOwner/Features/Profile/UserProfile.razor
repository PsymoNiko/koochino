@page "/StoreOwner/UserProfile"
@layout StoreLayout
@using MyShop.Core.Helpers

@using MyShop.Core.Models
@using MyShop.Core.Models.Dto
@using MyShop.Core.Models.Messaging
@using MyShop.Application.Interfaces
@using MyShop.Application.Interfaces.Messaging
@using MyShop.Application.Services.Messaging
@using System.Security.Claims
@using Microsoft.Extensions.Configuration

@inject IUserService UserService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IConfiguration Configuration
@inject IUserMessagingLinkRepository MessagingLinks
@inject IMessagingOtpService OtpService

<div class="container-content" dir="rtl" lang="fa">

    @if (loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else if (model == null || string.IsNullOrEmpty(model.PhoneNumber))
    {
        <div class="alert alert-danger">
            <p>@message</p>
            <p>لطفاً دوباره وارد شوید.</p>
        </div>
    }
    else
    {
        @if (!phoneVerified)
        {
            <section class="phone-activate">
                <h2 class="section-title">فعال‌سازی تلفن همراه</h2>
                <p class="section-hint">
                    برای تایید سفارش باید شماره تلفن فعال باشد.
                    بات بله یا تلگرام را باز کنید، /start بزنید و شماره را بفرستید (ترجیحاً اشتراک مخاطب)، سپس کد را از اینجا بگیرید.
                </p>
                <div class="messenger-row">
                    <a class="messenger-link bale" href="@baleBotUrl" target="_blank" rel="noopener" title="باز کردن بات بله">
                        <img src="/images/messaging/bale.svg" alt="بله" width="48" height="48" />
                        <span>شروع بات بله</span>
                    </a>
                    <a class="messenger-link telegram" href="@telegramBotUrl" target="_blank" rel="noopener" title="باز کردن بات تلگرام">
                        <img src="/images/messaging/telegram.svg" alt="تلگرام" width="48" height="48" />
                        <span>شروع بات تلگرام</span>
                    </a>
                </div>
                <div class="link-status @(baleLinked || telegramLinked ? "ok" : "warn")">
                    @if (baleLinked || telegramLinked)
                    {
                        <span>
                            وضعیت:
                            @if (baleLinked) { <text>بله متصل@(baleUsername)</text> }
                            @if (baleLinked && telegramLinked) { <text> · </text> }
                            @if (telegramLinked) { <text>تلگرام متصل@(telegramUsername)</text> }
                        </span>
                    }
                    else
                    {
                        <span>وضعیت: هنوز به بات متصل نشده.</span>
                    }
                </div>
                <div class="otp-row" style="flex-wrap:wrap;gap:8px;">
                    <button type="button" class="btn btn-otp" disabled="@(otpBusy || string.IsNullOrWhiteSpace(model.PhoneNumber) || !baleLinked)" @onclick="() => RequestOtp(MessagingProviders.Bale)">
                        @(otpBusy && otpProvider == MessagingProviders.Bale ? "در حال ارسال..." : "ارسال کد به بله")
                    </button>
                    <button type="button" class="btn btn-otp" style="background:#229ED9;" disabled="@(otpBusy || string.IsNullOrWhiteSpace(model.PhoneNumber) || !telegramLinked)" @onclick="() => RequestOtp(MessagingProviders.Telegram)">
                        @(otpBusy && otpProvider == MessagingProviders.Telegram ? "در حال ارسال..." : "ارسال کد به تلگرام")
                    </button>
                    <input class="form-control otp-input" @bind="otpCode" @bind:event="oninput" placeholder="کد ۶ رقمی" dir="ltr" maxlength="8" />
                    <button type="button" class="btn btn-verify" disabled="@(otpBusy || string.IsNullOrWhiteSpace(otpCode))" @onclick="VerifyOtp">
                        تأیید کد
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(otpMessage))
                {
                    <p class="@(otpOk ? "text-success" : "text-danger") mt-2">@otpMessage</p>
                }
            </section>
        }
        else
        {
            <div class="phone-verified-banner">
                ✅ شماره موبایل شما فعال است@(string.IsNullOrWhiteSpace(model.PhoneNumber) ? "" : $" ({model.PhoneNumber})").
            </div>
        }

        <ul class="nav nav-tabs mb-4" role="tablist">
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == 1 ? "active" : "")" @onclick="@(() => activeTab = 1)">
                    اطلاعات حساب
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == 2 ? "active" : "")" @onclick="@(() => activeTab = 2)">
                    مشخصات پروفایل و مدارک
                </button>
            </li>
        </ul>

        @if (activeTab == 1)
        {
            <EditForm Model="model" OnValidSubmit="Save">
                <div class="form-group">
                    <label>شماره موبایل</label>
                    <input class="form-control" @bind="model.PhoneNumber" readonly />
                </div>
                <div class="form-group">
                    <label>نام کاربری</label>
                    <input class="form-control" @bind="model.Username" />
                </div>
                <div class="form-group">
                    <label>نام</label>
                    <input class="form-control" value="@model.FirstName" @oninput="OnFirstNameInput" title="فقط فارسی" />
                </div>
                <div class="form-group">
                    <label>نام خانوادگی</label>
                    <input class="form-control" value="@model.LastName" @oninput="OnLastNameInput" title="فقط فارسی" />
                </div>
                <div class="form-group">
                    <label>ایمیل</label>
                    <input class="form-control" @bind="model.Email" />
                </div>
                <div class="form-group">
                    <label>کد ملی</label>
                    <input class="form-control" maxlength="10" dir="ltr" inputmode="numeric" value="@model.NationalCode" @oninput="OnNationalCodeInput" placeholder="۱۰ رقم" title="فقط عدد" />
                </div>
                <button class="btn btn-primary mt-3" disabled="@saving">
                    @if (saving)
                    {
                        <span class="spinner-small"></span>
                        <span>در حال ذخیره...</span>
                    }
                    else
                    {
                        <span>ذخیره اطلاعات</span>
                    }
                </button>
                @if (!string.IsNullOrEmpty(message))
                {
                    <p class="text-danger mt-2">@message</p>
                }
            </EditForm>
            <ChangePasswordForm />
        }
        else
        {
            <div class="profile-images-link-card">
                <div class="pil-icon" aria-hidden="true">📷</div>
                <h3>عکس پروفایل و مدارک</h3>
                <p>عکس پروفایل و تصویر کارت ملی را در صفحه اختصاصی مدیریت کنید.</p>
                <a href="/StoreOwner/ProfileImages" class="btn btn-primary pil-btn">مدیریت تصاویر</a>
            </div>
        }
    }
</div>

@code {
    UserProfileVm model = new();
    UpdateUserProfileDto modelUpdate = new();
    bool loading = true;
    bool saving = false;
    string message = "";
    int activeTab = 1;

    void OnFirstNameInput(ChangeEventArgs e) =>
        model.FirstName = MyShop.Core.Helpers.PersianTextNormalizer.PersianLettersOnly(e.Value?.ToString() ?? "");

    void OnLastNameInput(ChangeEventArgs e) =>
        model.LastName = MyShop.Core.Helpers.PersianTextNormalizer.PersianLettersOnly(e.Value?.ToString() ?? "");

    void OnNationalCodeInput(ChangeEventArgs e) =>
        model.NationalCode = MyShop.Core.Helpers.DigitNormalizer.ToNationalCodeInput(e.Value?.ToString() ?? "");

    bool _loaded;
    int _userId;

    string baleBotUrl = "https://ble.ir/";
    string telegramBotUrl = "https://t.me/";
    bool baleLinked;
    bool telegramLinked;
    string baleUsername = "";
    string telegramUsername = "";
    string otpCode = "";
    string otpMessage = "";
    string otpProvider = MessagingProviders.Bale;
    bool otpOk;
    bool otpBusy;
    bool phoneVerified;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var user = state.User;

            if (!user.Identity?.IsAuthenticated ?? true)
            {
                loading = false;
                Nav.NavigateTo("/Account/login-store", true);
                return;
            }

            if (!user.IsInRole("StoreOwner"))
            {
                loading = false;
                Nav.NavigateTo("/access-denied");
                return;
            }

            var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
            if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out _userId))
            {
                message = "خطا در دریافت اطلاعات کاربر";
                loading = false;
                return;
            }

            model = await UserService.GetProfileAsync(_userId);

            if (model == null)
            {
                message = "پروفایل کاربری یافت نشد";
                loading = false;
                return;
            }

            phoneVerified = model.IsPhoneVerified;
            modelUpdate.PhoneNumber = model.PhoneNumber;
            modelUpdate.FirstName = model.FirstName;
            modelUpdate.LastName = model.LastName;
            modelUpdate.Email = model.Email;
            modelUpdate.NationalCode = model.NationalCode;
            modelUpdate.Username = model.Username;

            var linkCfg = Configuration["Bale:BotLink"];
            baleBotUrl = string.IsNullOrWhiteSpace(linkCfg) ? "https://ble.ir/HoseinThingsbot" : linkCfg.Trim();
            var tgCfg = Configuration["Telegram:BotLink"];
            telegramBotUrl = string.IsNullOrWhiteSpace(tgCfg) ? "https://t.me/" : tgCfg.Trim();
            await RefreshMessengerLinkStatus();
        }
        catch (Exception ex)
        {
            message = UserFacingErrorHelper.ToPersianError(ex);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    async Task RefreshMessengerLinkStatus()
    {
        try
        {
            baleLinked = false;
            telegramLinked = false;
            baleUsername = "";
            telegramUsername = "";
            var phone = MessagingOtpService.NormalizePhone(model?.PhoneNumber);
            if (string.IsNullOrWhiteSpace(phone)) return;

            var bale = await MessagingLinks.GetByPhoneAsync(MessagingProviders.Bale, phone);
            if (bale != null && !string.IsNullOrWhiteSpace(bale.ChatId))
            {
                baleLinked = true;
                if (!string.IsNullOrWhiteSpace(bale.Username))
                    baleUsername = " (@" + bale.Username.TrimStart('@') + ")";
            }
            var tg = await MessagingLinks.GetByPhoneAsync(MessagingProviders.Telegram, phone);
            if (tg != null && !string.IsNullOrWhiteSpace(tg.ChatId))
            {
                telegramLinked = true;
                if (!string.IsNullOrWhiteSpace(tg.Username))
                    telegramUsername = " (@" + tg.Username.TrimStart('@') + ")";
            }
        }
        catch { }
    }

    async Task RequestOtp(string provider)
    {
        otpBusy = true;
        otpProvider = provider;
        otpMessage = "";
        otpOk = false;
        try
        {
            var r = await OtpService.SendOtpAsync(model.PhoneNumber, MessagingPurposes.Register, provider);
            otpOk = r.Success;
            otpMessage = r.Message ?? (r.Success ? "کد ارسال شد." : "ارسال ناموفق");
            await RefreshMessengerLinkStatus();
        }
        catch (Exception ex)
        {
            otpOk = false;
            otpMessage = UserFacingErrorHelper.ToPersianError(ex);
        }
        finally { otpBusy = false; }
    }

    async Task VerifyOtp()
    {
        otpBusy = true;
        otpMessage = "";
        otpOk = false;
        try
        {
            var phone = MessagingOtpService.NormalizePhone(model?.PhoneNumber);
            if (await UserService.IsPhoneVerifiedByAnotherUserAsync(phone, _userId))
            {
                otpOk = false;
                otpMessage = "این شماره قبلاً برای اکانت دیگری تأیید شده است.";
                return;
            }

            var providers = new[] { otpProvider, MessagingProviders.Bale, MessagingProviders.Telegram }
                .Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
            MessagingResult r = null;
            string usedProvider = otpProvider;
            foreach (var p in providers)
            {
                r = await OtpService.VerifyOtpAsync(model.PhoneNumber, MessagingPurposes.Register, otpCode, p);
                usedProvider = p;
                if (r.Success) break;
            }

            otpOk = r?.Success == true;
            otpMessage = r?.Message ?? (otpOk ? "فعال‌سازی انجام شد." : "تأیید ناموفق");
            if (otpOk)
            {
                otpCode = "";
                await UserService.SetPhoneVerifiedAsync(_userId, true);
                phoneVerified = true;
                model.IsPhoneVerified = true;
                try
                {
                    var link = await MessagingLinks.GetByPhoneAsync(usedProvider, phone);
                    if (link != null)
                    {
                        link.UserId = _userId;
                        link.IsVerified = true;
                        await MessagingLinks.UpsertAsync(link);
                    }
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            otpOk = false;
            otpMessage = UserFacingErrorHelper.ToPersianError(ex);
        }
        finally { otpBusy = false; }
    }

    async Task Save()
    {
        saving = true;
        message = "";

        modelUpdate.PhoneNumber = model.PhoneNumber;
        modelUpdate.FirstName = model.FirstName;
        modelUpdate.LastName = model.LastName;
        modelUpdate.Email = model.Email;
        modelUpdate.NationalCode = model.NationalCode;
        modelUpdate.Username = model.Username;

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out int userId))
        {
            message = "خطا در دریافت اطلاعات کاربر";
            saving = false;
            return;
        }

        modelUpdate.UserId = userId;
        var result = await UserService.UpdateProfileAsync(modelUpdate);

        if (result > 0)
        {
            message = "اطلاعات ذخیره شد";
            model = await UserService.GetProfileAsync(userId);
        }
        else
        {
            message = result switch
            {
                0 => "خطا در به‌روزرسانی",
                2 => "نام کاربری تکراری است",
                3 => "کد ملی تکراری است",
                4 => "ایمیل تکراری است",
                -1 => "خطای داخلی سرور",
                _ => "خطای نامشخص"
            };
        }

        saving = false;
    }
}

<style>
    .container-content {
        direction: rtl;
        padding: 20px;
    }

    /* ========== Loading State ========== */
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        gap: 16px;
        direction: rtl;
    }

    .loading-state .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #f3f4f6;
        border-top-color: #2563eb;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* ========== Tabs ========== */
    .nav-tabs {
        display: flex;
        border-bottom: 2px solid #e5e7eb;
        margin-bottom: 24px;
        direction: rtl;
        flex-wrap: wrap;
    }

    .nav-item {
        flex: 1;
        min-width: 120px;
    }

    .nav-link {
        width: 100%;
        padding: 12px 16px;
        background: transparent;
        border: none;
        border-bottom: 3px solid transparent;
        color: #6b7280;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        text-align: center;
        min-height: 44px;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        transition: all 0.2s ease;
    }

    .nav-link.active {
        color: #2563eb;
        border-bottom-color: #2563eb;
        background: rgba(37, 99, 235, 0.1);
    }

    .nav-link:active {
        transform: scale(0.98);
    }

    /* ========== Forms ========== */
    .form-group {
        margin-bottom: 20px;
        direction: rtl;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 500;
        color: #374151;
        text-align: right;
    }

    .form-control {
        width: 100%;
        padding: 14px 16px;
        font-size: 15px;
        color: #1f2937;
        background: #ffffff;
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        transition: all 0.2s ease;
        direction: rtl;
        text-align: right;
        font-family: 'Vazir', 'Vazirmatn', 'Tahoma', sans-serif;
        box-sizing: border-box;
        min-height: 48px;
        -webkit-tap-highlight-color: transparent;
    }

    .form-control:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .form-control[readonly] {
        background: #f9fafb;
        cursor: not-allowed;
    }

    .btn {
        padding: 14px 28px;
        font-size: 15px;
        font-weight: 600;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        min-height: 48px;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    .btn-primary:active:not(:disabled) {
        transform: scale(0.98);
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    }

    .btn-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .spinner-small {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
    }

    /* ========== Documents Tab ========== */
    .profile-documents-tab {
        direction: rtl;
    }

    .profile-documents-tab .text-muted {
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 20px;
    }

    .profile-documents-tab .card {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        margin-bottom: 16px;
    }

    .profile-documents-tab .card-body {
        padding: 20px;
        text-align: right;
    }

    .profile-documents-tab .form-control-sm {
        padding: 10px;
        font-size: 13px;
        min-height: 44px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        width: 100%;
        -webkit-tap-highlight-color: transparent;
    }

    .alert {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        direction: rtl;
    }

    .alert-danger {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fca5a5;
    }

    .alert-success {
        background: #d1fae5;
        color: #065f46;
        border: 1px solid #6ee7b7;
    }

    .text-danger {
        color: #dc2626;
    }

    /* ========== Responsive ========== */
    @@media (max-width: 768px) {
        .container-content {
            padding: 12px;
        }

        .nav-tabs {
            flex-direction: column;
        }

        .nav-item {
            width: 100%;
        }

        .nav-link {
            text-align: right;
            border-bottom: 1px solid #e5e7eb;
            border-right: 3px solid transparent;
        }

        .nav-link.active {
            border-right-color: #2563eb;
            border-bottom-color: #e5e7eb;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-control {
            padding: 12px 14px;
            font-size: 14px;
        }

        .btn {
            width: 100%;
            padding: 14px;
        }

        .profile-documents-tab .row {
            flex-direction: column;
        }

        .profile-documents-tab .col-md-4 {
            width: 100%;
            margin-bottom: 16px;
        }
    }

    .phone-activate {
        margin-bottom: 24px; padding: 18px; border: 1px solid #e5e7eb; border-radius: 12px;
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    }
    .phone-activate .section-title { margin: 0 0 8px; font-size: 1.15rem; color: #0f172a; }
    .phone-activate .section-hint { margin: 0 0 14px; color: #475569; font-size: 0.92rem; line-height: 1.7; }
    .messenger-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-bottom: 12px; }
    .messenger-link {
        display: inline-flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 12px;
        text-decoration: none; font-weight: 600; border: 1px solid #d1fae5; background: #ecfdf5; color: #065f46;
    }
    .link-status { padding: 10px 12px; border-radius: 8px; margin-bottom: 12px; font-size: 0.9rem; }
    .link-status.ok { background: #ecfdf5; color: #065f46; }
    .link-status.warn { background: #fff7ed; color: #9a3412; }
    .otp-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .otp-input { max-width: 160px; text-align: center; letter-spacing: 0.15em; }
    .btn-otp { background: #00a884; color: #fff; border: none; border-radius: 10px; padding: 12px 16px; font-weight: 600; cursor: pointer; }
    .btn-verify { background: #0f766e; color: #fff; border: none; border-radius: 10px; padding: 12px 16px; font-weight: 600; cursor: pointer; }
    .btn-otp:disabled, .btn-verify:disabled { opacity: 0.6; cursor: not-allowed; }
    .phone-verified-banner {
        margin-bottom: 16px; padding: 12px 14px; border-radius: 10px; background: #ecfdf5; color: #065f46; font-weight: 600;
    }

    .profile-images-link-card {
        text-align: center;
        padding: 28px 20px;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        background: linear-gradient(180deg, #f8fafc 0%, #fff 100%);
    }

    .profile-images-link-card .pil-icon { font-size: 2.5rem; margin-bottom: 12px; }
    .profile-images-link-card h3 { margin: 0 0 8px; font-size: 1.1rem; color: #0f172a; }
    .profile-images-link-card p { margin: 0 0 18px; color: #64748b; font-size: 0.9rem; line-height: 1.6; }
    .profile-images-link-card .pil-btn { width: 100%; justify-content: center; text-decoration: none; }
</style>
