                                @onclick="@(() => GoTo("/StoreOwner/Reports"))">
                            <KooIcon Name="bar-chart" Size="18" /> <span>گزارش فروش</span>
                        </button>
                        <button type="button" class="koo-drawer-item @(IsActive("/storeowner/commerce-reports") ? "active" : "")"
                                @onclick="@(() => GoTo("/StoreOwner/commerce-reports"))">
                            <KooIcon Name="bar-chart" Size="18" /> <span>گزارش فروش آنلاین</span>
