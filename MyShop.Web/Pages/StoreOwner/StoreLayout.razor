    <!-- ========== Content area ========== -->
    <div class="koo-contentarea">
        <header class="koo-topbar">
            <div class="koo-topbar-row">
                <button class="koo-icon-btn koo-menu-btn" type="button" @onclick="ToggleDrawer" aria-label="منو">
                    <KooIcon Name="menu" />
                </button>
                <h1 class="koo-topbar-title">@GetPageTitle()</h1>
                <div class="koo-topbar-actions">
                    <AnnouncementNotificationIcon />
                    <button class="koo-icon-btn koo-avatar-btn" type="button"
                            @onclick="@(() => GoTo("/StoreOwner/ProfileImages"))" aria-label="پروفایل">
                        <img src="@AvatarUrl" onerror="this.onerror=null; this.src='/img/pro.jpg';" alt="پروفایل" />
                    </button>
                </div>
            </div>
        </header>

        <main class="koo-main">
            <div class="koo-inner">
                <AnnouncementDisplay />
                @if (!registrationComplete && !IsActive("/storeowner/identityverification"))
                {
                    <div class="koo-reg-gate">
                        <div class="koo-reg-gate-icon">🪪</div>
                        <h3>برای استفاده از امکانات، لطفا فرایند ثبت‌نام خود را کامل کنید.</h3>
                        <button type="button" class="koo-reg-gate-btn" @onclick="@(() => GoTo("/StoreOwner/IdentityVerification"))">تکمیل فرآیند</button>
                    </div>
                }
                else
                {
                    @if (registrationComplete && idAggregatedStatus == "Pending")
                    {
                        <div class="koo-id-banner koo-id-banner-pending">⏳ هویت شما در حال بررسی است.</div>
                    }
                    else if (registrationComplete && idAggregatedStatus == "Rejected")
                    {
                        <div class="koo-id-banner koo-id-banner-rejected">
                            <span>❌ مدارک ارسالی شما رد شده است@(!string.IsNullOrEmpty(idRejectionReason) ? $": {idRejectionReason}" : ".")</span>
                            <button type="button" @onclick="@(() => GoTo("/StoreOwner/IdentityVerification"))">ارسال مجدد</button>
                        </div>
                    }
                    @Body
                }
            </div>
        </main>

