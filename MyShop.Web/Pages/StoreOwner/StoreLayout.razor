                    @onclick="@(() => GoTo("/storeowner/voucher-wallet"))">
                <KooIcon Name="wallet" /> <span>کیف پول</span>
            </button>
            <button type="button" class="koo-sidenav-item @(IsActive("/storeowner/billing") ? "active" : "")"
                    @onclick="@(() => GoTo("/storeowner/billing"))">
                <KooIcon Name="credit-card" /> <span>صورتحساب</span>
            </button>
            <button type="button" class="koo-sidenav-item @(IsActive("/storeowner/packages") ? "active" : "")"
                    @onclick="@(() => GoTo("/storeowner/packages"))">
                <KooIcon Name="credit-card" /> <span>پکیج‌ها</span>
            </button>

            <div class="koo-sidenav-section">حساب و پشتیبانی</div>
            <button type="button" class="koo-sidenav-item @(IsProfileActive ? "active" : "")"
                    @onclick="@(() => GoTo("/StoreOwner/UserProfile"))">
