@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using MyShop.Web.Components
@using MyShop.Application.Interfaces
@using MyShop.Application.Interfaces.Inventory
@using MyShop.Core.Models.Inventory
@using MyShop.Application.Interfaces.Settings
@using MyShop.Application.Interfaces.Users
@using MyShop.Core.Interfaces
@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContext
@inject AuthenticationStateProvider AuthProvider
@inject IUserService UserService
@inject IStoreOwnerPermissionService StoreOwnerPerms
@inject IInventoryStockService InventoryStockService
@inject IStoreService StoreService
@inject ISiteAdminSettingsService SiteSettingsService
@inject IUserIdentityVerificationService IdentityVerificationService
@inject IUserIdentityDocumentService IdentityDocumentService
@inject ICurrentTenant Tenant
@inject IJSRuntime JS
@attribute [Authorize(Roles = "StoreOwner")]

@code {
    bool drawerOpen = false;
    string currentUserName = "";
    string profilePictureUrl = "";
    HashSet<string> openGroups = new HashSet<string>();
    Dictionary<string, bool> moduleMap = new(StringComparer.OrdinalIgnoreCase);
    int inventoryLowBadge;
    bool registrationComplete = true;
    string idAggregatedStatus;
    string idRejectionReason;

    bool HasModule(string key)
    {
        if (moduleMap.TryGetValue(key, out var v)) return v;
        return StoreOwnerModules.DefaultAccess(key);
    }

    protected override void OnInitialized()
    {
        var path = (Nav?.Uri ?? "").ToLower();
        if (path.Contains("/storeowner/stores") || path.Contains("/storeowner/storedocuments")) openGroups.Add("stores");
        else if (path.Contains("/storeowner/products") || path.Contains("/storeowner/inventory")) openGroups.Add("inventory");
        else if (path.Contains("/storeowner/gifts")) openGroups.Add("coupons");
        else if (path.Contains("/storeowner/chancebox")) openGroups.Add("chancebox");
        else if (path.Contains("/storeowner/userprofile") || path.Contains("/storeowner/profileimages") || path.Contains("/storeowner/profile")) openGroups.Add("profile");
        else if (path.Contains("/storeowner/tickets")) openGroups.Add("tickets");
        else if (path.Contains("/storeowner/billing") || path.Contains("/storeowner/packages") || path.Contains("/voucher-wallet")) openGroups.Add("finance");
        else if (path.Contains("/storeowner/reports") || path.Contains("/commerce-reports")) openGroups.Add("reports");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            var user = state.User;
            currentUserName = user.FindFirst(ClaimTypes.Name)?.Value ?? "کاربر";

            var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
            {
                try
                {
                    var profile = await UserService.GetProfileAsync(userId);
                    if (!string.IsNullOrEmpty(profile?.ProfilePictureUrl))
                        profilePictureUrl = profile.ProfilePictureUrl;
                }
                catch
                {
                    profilePictureUrl = "";
                }
                try { moduleMap = await StoreOwnerPerms.GetMapAsync(userId); }
                catch { moduleMap = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase); }
                try
                {
                    var idProfile = await UserService.GetProfileAsync(userId);
                    var progress = await IdentityVerificationService.GetRegistrationProgressAsync(userId);
                    var phoneVerified = idProfile?.IsPhoneVerified ?? false;
                    var step1Done = progress != null && !string.IsNullOrWhiteSpace(progress.NationalCode) && !string.IsNullOrWhiteSpace(progress.FatherName) && phoneVerified;
                    var step2Done = progress?.StoreId != null;
                    var summary = await IdentityDocumentService.GetSummaryAsync(userId);
                    registrationComplete = step1Done && step2Done && summary.BothSubmitted;
                    idAggregatedStatus = summary.AggregatedStatus;
                    idRejectionReason = summary.RejectionReason;
                }
                catch { registrationComplete = true; }
                if (HasModule(StoreOwnerModules.Inventory))
                {
                    try
                    {
                        var stores = await StoreService.GetByUserIdAsync(userId) ?? new();
                        foreach (var s in stores)
                            inventoryLowBadge += await InventoryStockService.CountLowStockAsync(s.StoreID);
                    }
                    catch { inventoryLowBadge = 0; }
                }
            }
        }
        catch
        {
            currentUserName = "کاربر";
            profilePictureUrl = "";
        }
    }

    void ToggleDrawer()
    {
        drawerOpen = !drawerOpen;
    }

    void GoTo(string url)
    {
        Nav.NavigateTo(url, true);
        drawerOpen = false;
    }

    void ToggleGroup(string key)
    {
        if (openGroups.Contains(key)) openGroups.Remove(key);
        else openGroups.Add(key);
    }

    bool IsGroupOpen(string key) => openGroups.Contains(key);

    bool IsActive(string route)
    {
        try
        {
            if (Nav == null || string.IsNullOrEmpty(route)) return false;
            var uri = Nav.Uri?.ToLower() ?? "";
            return uri.Contains(route.ToLower());
        }
        catch
        {
            return false;
        }
    }

    string GetPageTitle()
    {
        try
        {
            if (Nav == null) return "پنل فروشنده";
            var uri = Nav.Uri?.ToLower() ?? "";
            if (uri.Contains("/dashboard")) return "پیشخوان";
            if (uri.Contains("/stores")) return "فروشگاه‌ها";
            if (uri.Contains("/inventory")) return "انبار";
            if (uri.Contains("/products")) return "محصولات";
            if (uri.Contains("/gifts/create")) return "ایجاد کد تخفیف";
            if (uri.Contains("/giftsused")) return "کدهای استفاده‌شده";
            if (uri.Contains("/gifts")) return "کدهای تخفیف";
            if (uri.Contains("/voucher-wallet")) return "کیف پول";
            if (uri.Contains("/chanceboxused")) return "جعبه شانس‌های استفاده‌شده";
            if (uri.Contains("/chancebox")) return "جعبه شانس";
            if (uri.Contains("/commerce-settlements")) return "تسویه فروش آنلاین";
            if (uri.Contains("/commerce-reports")) return "گزارش فروش آنلاین";
            if (uri.Contains("/storeowner/reports")) return "گزارش فروش";
            if (uri.Contains("/commerce-orders")) return "سفارشات آنلاین";
            if (uri.Contains("/orders")) return "سفارشات خرید";
            if (uri.Contains("/profileimages")) return "عکس پروفایل";
            if (uri.Contains("/userprofile") || uri.Contains("/profile")) return "پروفایل";
            if (uri.Contains("/storedocuments")) return "مدارک و گالری";
            if (uri.Contains("/packages")) return "پکیج‌ها";
            if (uri.Contains("/billing")) return "صورتحساب";
            if (uri.Contains("/assistant")) return "دستیار هوشمند";
            if (uri.Contains("/tickets/create")) return "ثبت تیکت";
            if (uri.Contains("/tickets")) return "پشتیبانی";
            return "پنل فروشنده";
        }
        catch
        {
            return "پنل فروشنده";
        }
    }

    string AvatarUrl => string.IsNullOrEmpty(profilePictureUrl) ? "/img/pro.jpg" : profilePictureUrl;

    bool IsOrdersActive => IsActive("/storeowner/orders") && !IsActive("/commerce-orders");

    bool IsProfileActive => IsActive("/storeowner/userprofile") || IsActive("/storeowner/profileimages") || (IsActive("/storeowner/profile") && !IsActive("/userprofile"));

    async Task ShowPwaInstall()
    {
        try
        {
            await JS.InvokeVoidAsync("koochinoPwaInstall");
        }
        catch { /* جلوگیری از قطع circuit */ }
        drawerOpen = false;
    }
}


<div class="koo-app" dir="rtl" lang="fa">

