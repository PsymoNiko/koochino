                                @onclick="@(() => GoTo("/StoreOwner/Gifts"))">
                            <KooIcon Name="tag" Size="18" /> <span>لیست کدها</span>
                        </button>
                        <button type="button" class="koo-drawer-item @(IsActive("/storeowner/gifts/create") ? "active" : "")"
                                @onclick="@(() => GoTo("/StoreOwner/Gifts/Create"))">
                            <KooIcon Name="plus" Size="18" /> <span>ایجاد کد تخفیف</span>
                        </button>
                        <button type="button" class="koo-drawer-item @(IsActive("/storeowner/giftsused") ? "active" : "")"
                                @onclick="@(() => GoTo("/StoreOwner/GiftsUsed"))">
                            <KooIcon Name="ticket" Size="18" /> <span>کدهای استفاده‌شده</span>
                        </button>
                    </div>
                }
            </div>

            <div class="koo-drawer-group">
                <button type="button" class="koo-drawer-item @(IsGroupOpen("chancebox") ? "open" : "")"
                        @onclick="@(() => ToggleGroup("chancebox"))">
                    <KooIcon Name="gift" /> <span>جعبه شانس</span>
                    <span class="koo-drawer-chevron"><KooIcon Name="chevron-down" Size="16" /></span>
                </button>
                @if (IsGroupOpen("chancebox"))
                {
                    <div class="koo-drawer-submenu">
                        <button type="button" class="koo-drawer-item @(IsActive("/storeowner/chancebox") && !IsActive("/chanceboxused") ? "active" : "")"
                                @onclick="@(() => GoTo("/StoreOwner/ChanceBox"))">
                            <KooIcon Name="gift" Size="18" /> <span>مدیریت جعبه شانس</span>
                        </button>
                        <button type="button" class="koo-drawer-item @(IsActive("/storeowner/chanceboxused") ? "active" : "")"
                                @onclick="@(() => GoTo("/StoreOwner/ChanceBoxUsed"))">
                            <KooIcon Name="gift" Size="18" /> <span>استفاده‌شده‌ها</span>
                        </button>
                    </div>
                }
            </div>

            <div class="koo-drawer-group">
                <button type="button" class="koo-drawer-item @(IsGroupOpen("tickets") ? "open" : "")"
                        @onclick="@(() => ToggleGroup("tickets"))">
                    <KooIcon Name="ticket" /> <span>پشتیبانی</span>
                    <span class="koo-drawer-chevron"><KooIcon Name="chevron-down" Size="16" /></span>
                </button>
                @if (IsGroupOpen("tickets"))
                {
                    <div class="koo-drawer-submenu">
                        <button type="button" class="koo-drawer-item @(IsActive("/storeowner/tickets/create") ? "active" : "")"
                                @onclick="@(() => GoTo("/storeowner/tickets/create"))">
                            <KooIcon Name="pencil" Size="18" /> <span>ثبت تیکت</span>
                        </button>
                        <button type="button" class="koo-drawer-item @(IsActive("/storeowner/tickets") && !IsActive("/tickets/create") ? "active" : "")"
                                @onclick="@(() => GoTo("/storeowner/tickets"))">
                            <KooIcon Name="clipboard-list" Size="18" /> <span>مشاهده تیکت‌ها</span>
                        </button>
                    </div>
                }
            </div>

            <div class="koo-drawer-group">
                <button type="button" class="koo-drawer-item @(IsGroupOpen("profile") ? "open" : "")"
                        @onclick="@(() => ToggleGroup("profile"))">
                    <KooIcon Name="user" /> <span>پروفایل</span>
                    <span class="koo-drawer-chevron"><KooIcon Name="chevron-down" Size="16" /></span>
                </button>
                @if (IsGroupOpen("profile"))
                {
                    <div class="koo-drawer-submenu">
                        <button type="button" class="koo-drawer-item @(IsActive("/storeowner/userprofile") ? "active" : "")"
                                @onclick="@(() => GoTo("/StoreOwner/UserProfile"))">
                            <KooIcon Name="user" Size="18" /> <span>اطلاعات کاربری</span>
                        </button>
                        <button type="button" class="koo-drawer-item @(IsActive("/storeowner/profileimages") ? "active" : "")"
                                @onclick="@(() => GoTo("/StoreOwner/ProfileImages"))">
                            <KooIcon Name="image" Size="18" /> <span>عکس پروفایل</span>
                        </button>
                        <button type="button" class="koo-drawer-item @(IsActive("/storeowner/profile") && !IsActive("/userprofile") && !IsActive("/profileimages") ? "active" : "")"
                                @onclick="@(() => GoTo("/StoreOwner/Profile"))">
                            <KooIcon Name="store" Size="18" /> <span>پروفایل فروشگاه</span>
                        </button>
                    </div>
                }
            </div>

            <div class="koo-drawer-group">
                <button type="button" class="koo-drawer-item @(IsGroupOpen("finance") ? "open" : "")"
                        @onclick="@(() => ToggleGroup("finance"))">
                    <KooIcon Name="wallet" /> <span>امور مالی</span>
                    <span class="koo-drawer-chevron"><KooIcon Name="chevron-down" Size="16" /></span>
                </button>
                @if (IsGroupOpen("finance"))
                {
                    <div class="koo-drawer-submenu">
                        <button type="button" class="koo-drawer-item @(IsActive("/storeowner/billing") ? "active" : "")"
                                @onclick="@(() => GoTo("/storeowner/billing"))">
                            <KooIcon Name="credit-card" Size="18" /> <span>صورتحساب</span>
                        </button>
                        <button type="button" class="koo-drawer-item @(IsActive("/storeowner/packages") ? "active" : "")"
                                @onclick="@(() => GoTo("/storeowner/packages"))">
                            <KooIcon Name="credit-card" Size="18" /> <span>پکیج</span>
                        </button>
                        <button type="button" class="koo-drawer-item @(IsActive("/storeowner/voucher-wallet") ? "active" : "")"
                                @onclick="@(() => GoTo("/storeowner/voucher-wallet"))">
                            <KooIcon Name="wallet" Size="18" /> <span>کیف پول</span>
                        </button>
                    </div>
                }
            </div>

            @if (HasModule(StoreOwnerModules.Inventory))
            {
                <div class="koo-drawer-group">
                    <button type="button" class="koo-drawer-item @(IsGroupOpen("inventory") ? "open" : "")"
                            @onclick="@(() => ToggleGroup("inventory"))">
                        <KooIcon Name="box" /> <span>انبار و موجودی</span>
                        <span class="koo-drawer-chevron"><KooIcon Name="chevron-down" Size="16" /></span>
                    </button>
                    @if (IsGroupOpen("inventory"))
                    {
                        <div class="koo-drawer-submenu">
                            <button type="button" class="koo-drawer-item @(IsActive("/storeowner/products") ? "active" : "")"
                                    @onclick="@(() => GoTo("/StoreOwner/Products"))">
                                <KooIcon Name="box" Size="18" /> <span>محصولات</span>
                            </button>
                            <button type="button" class="koo-drawer-item @(IsActive("/storeowner/inventory") && !IsActive("/inventory/") ? "active" : "")"
                                    @onclick="@(() => GoTo("/storeowner/inventory"))">
                                <KooIcon Name="box" Size="18" /> <span>انبارها</span>
                            </button>
                            <button type="button" class="koo-drawer-item @(IsActive("/storeowner/inventory/stock") ? "active" : "")"
                                    @onclick="@(() => GoTo("/storeowner/inventory/stock"))">
                                <KooIcon Name="box" Size="18" /> <span>موجودی@(inventoryLowBadge > 0 ? $" ({inventoryLowBadge})" : "")</span>
                            </button>
                            <button type="button" class="koo-drawer-item @(IsActive("/storeowner/inventory/purchase") ? "active" : "")"
                                    @onclick="@(() => GoTo("/storeowner/inventory/purchase"))">
                                <KooIcon Name="package" Size="18" /> <span>فاکتور خرید</span>
                            </button>
                            <button type="button" class="koo-drawer-item @(IsActive("/storeowner/inventory/sale") ? "active" : "")"
                                    @onclick="@(() => GoTo("/storeowner/inventory/sale"))">
                                <KooIcon Name="package" Size="18" /> <span>فاکتور فروش</span>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <button type="button" class="koo-drawer-item @(IsActive("/storeowner/products") ? "active" : "")"
                        @onclick="@(() => GoTo("/StoreOwner/Products"))">
                    <KooIcon Name="box" /> <span>محصولات</span>
                </button>
            }

            <button type="button" class="koo-drawer-item @(IsActive("/storeowner/assistant") ? "active" : "")"
                    @onclick="@(() => GoTo("/storeowner/assistant"))">
                <KooIcon Name="cpu" /> <span>دستیار هوشمند</span>
            </button>

            <div class="koo-drawer-divider"></div>

            <button type="button" class="koo-drawer-item" @onclick="ShowPwaInstall">
                <KooIcon Name="smartphone" /> <span>نصب اپ کوچینو</span>
            </button>
            <button type="button" class="koo-drawer-item koo-drawer-item-logout"
                    @onclick="@(() => GoTo("/Account/logout"))">
                <KooIcon Name="log-out" /> <span>خروج</span>
            </button>
        </nav>
    </div>
</div>
