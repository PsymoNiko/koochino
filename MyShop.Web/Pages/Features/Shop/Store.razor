@page "/store/{StoreId:int}"
@layout EmptyLayout
@using MyShop.Application.Interfaces
@using MyShop.Core.Models
@using MyShop.Core.Models.Dto
@using System.Linq
@using Microsoft.AspNetCore.Components.Authorization
@using MyShop.Application.Interfaces.Commerce
@inject IStoreService StoreService
@inject IStoreDocumentService StoreDocumentService
@inject ICommentService CommentService
@inject ICouponService CouponService
@inject ICommerceShopCatalogService ShopCatalog
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject MyShop.Application.Interfaces.IPageSeoService PageSeoService

<MyShop.Web.Components.SeoHead PageKey="store"
    TitleOverride="@(store?.StoreName != null ? store.StoreName + " | کوچینو" : null)"
    DescriptionOverride="@(store?.StoreDescription)"
    OgImageOverride="@(store?.StoreProfileImageUrl)"
    CanonicalOverride="@(store != null ? Nav.ToAbsoluteUri(Nav.Uri).GetLeftPart(UriPartial.Path) : null)" />

<div class="store-page" dir="rtl" lang="fa">
    @if (loading)
    {
        <div class="store-loading">
            <div class="store-spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else if (store == null)
    {
        <div class="store-notfound">
            <p>فروشگاه یافت نشد.</p>
            <a href="/" class="store-btn-back">بازگشت به صفحه اصلی</a>
        </div>
    }
    else
    {
        <header class="store-header">
            <div class="store-cover">
                @if (!string.IsNullOrEmpty(store.StoreProfileImageUrl))
                {
                    <MyShop.Web.Components.OptimizedImage Src="@store.StoreProfileImageUrl" Alt="@store.StoreName" Lazy="true" />
                }
                <div class="store-cover-overlay"></div>
            </div>
            <div class="store-header-actions">
                <button type="button" class="store-back" @onclick="GoHome" aria-label="بازگشت">
                    <span class="store-back-arrow">←</span> بازگشت
                </button>
                <button type="button" class="store-back store-back-stores" @onclick="GoToStoresList" aria-label="لیست فروشگاه‌ها">
                    🏪 لیست فروشگاه‌ها
                </button>
                @if (authIsAuthenticated)
                {
                    <a href="@authPanelUrl" class="store-header-auth-user">کاربر گرامی : @authDisplayName</a>
                }
                else
                {
                    <a href="/Account/selectrole" class="store-header-auth-login">🔐 ورود</a>
                }
            </div>
        </header>

        <main class="store-main">
            <section class="store-hero">
                <div class="store-hero-avatar">
                    @if (!string.IsNullOrEmpty(store.StoreProfileImageUrl))
                    {
                        <MyShop.Web.Components.OptimizedImage Src="@store.StoreProfileImageUrl" Alt="@store.StoreName" Lazy="false" />
                    }
                    else
                    {
                        <span class="store-hero-icon">🏪</span>
                    }
                </div>
                <div class="store-hero-text">
                    <h1 class="store-name">@store.StoreName</h1>
                    @if (!string.IsNullOrEmpty(store.StoreFamilyName))
                    {
                        <p class="store-cat">@store.StoreFamilyName</p>
                    }
                    <div class="store-stats">
                        @if (store.StoreRating.HasValue)
                        {
                            <span class="store-rating-badge">
                                <span class="store-star">★</span> @store.StoreRating.Value.ToString("0.0")
                            </span>
                        }
                        <span class="store-stat-dot">·</span>
                        <span>@(commentCount?.TotalCount ?? 0) نظر</span>
                    </div>
                </div>
                @if (isCustomer)
                {
                    <a href="/customer/submit-order?storeId=@StoreId" class="store-cta">ثبت سفارش</a>
                }
                else
                {
                    <a href="/Account/login-customer" class="store-cta">ورود و خرید از این فروشگاه</a>
                }
            </section>

            <nav class="store-tabs">
                <button type="button" class="store-tab @(activeTab == "about" ? "active" : "")" @onclick='() => activeTab = "about"'>درباره</button>
                <button type="button" class="store-tab @(activeTab == "products" ? "active" : "")" @onclick='() => activeTab = "products"'>محصولات آنلاین</button>
                <button type="button" class="store-tab @(activeTab == "gallery" ? "active" : "")" @onclick='() => activeTab = "gallery"'>گالری</button>
                <button type="button" class="store-tab @(activeTab == "reviews" ? "active" : "")" @onclick='() => activeTab = "reviews"'>نظرات</button>
            </nav>

            <div class="store-tab-content">
                @if (activeTab == "about")
                {
                    <div class="store-about">
                        @if (!string.IsNullOrEmpty(store.StoreDescription))
                        {
                            <p class="store-desc">@store.StoreDescription</p>
                        }
                        <div class="store-meta-list">
                            @if (!string.IsNullOrEmpty(store.StoreAddress))
                            {
                                <div class="store-meta-row"><span class="store-meta-icon">📍</span> @store.StoreAddress</div>
                            }
                            @if (!string.IsNullOrEmpty(store.StorePhone))
                            {
                                <div class="store-meta-row"><span class="store-meta-icon">📞</span> @store.StorePhone</div>
                            }
                            @if (!string.IsNullOrEmpty(store.StoreOpeningHours) || !string.IsNullOrEmpty(store.StoreClosingHours))
                            {
                                <div class="store-meta-row"><span class="store-meta-icon">🕐</span> @(store.StoreOpeningHours ?? "?") تا @(store.StoreClosingHours ?? "?")</div>
                            }
                           
                        </div>

                        @if (activeStoreCoupons != null && activeStoreCoupons.Count > 0)
                        {
                            <div class="store-coupons-section">
                                <h4 class="store-coupons-title">🎫 کوپن‌های فعال</h4>
                                <div class="store-coupons-list">
                                    @foreach (var coupon in activeStoreCoupons)
                                    {
                                        <div class="store-coupon-card">
                                            <span class="store-coupon-title">@coupon.CoponTitle</span>
                                            <span class="store-coupon-code">@coupon.CoponCode</span>
                                            <span class="store-coupon-discount">@GetCouponDiscountText(coupon)</span>
                                            <span class="store-coupon-expire">اعتبار تا @PersianDateHelper.ToPersianDateString(coupon.CoponExpireDate)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (activeTab == "products")
                {
                    <div class="store-about">
                        @if (commerceProducts == null || commerceProducts.Count == 0)
                        {
                            <p class="store-empty">محصول آنلاین برای این فروشگاه ثبت نشده است.</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var p in commerceProducts)
                                {
                                    <li style="margin-bottom:8px;"><a href="/shop/product/@p.Id">@p.Name</a></li>
                                }
                            </ul>
                        }
                    </div>
                }
                else if (activeTab == "gallery")
                {
                    <div class="store-gallery">
                        @if (galleryDocuments == null || galleryDocuments.Count == 0)
                        {
                            <p class="store-empty">تصویری در گالری ثبت نشده است.</p>
                        }
                        else
                        {
                            <div class="store-gallery-grid">
                                @foreach (var doc in galleryDocuments.OrderBy(d => d.DisplayOrder))
                                {
                                    @if (!string.IsNullOrEmpty(doc.ImageUrl))
                                    {
                                        <div class="store-gallery-item">
                                            <MyShop.Web.Components.OptimizedImage Src="@doc.ImageUrl" Alt="@doc.Title" Lazy="true" />
                                            @if (!string.IsNullOrEmpty(doc.Title))
                                            {
                                                <span class="store-gallery-title">@doc.Title</span>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
                else if (activeTab == "reviews")
                {
                    <div class="store-reviews">
                        @if (commentCount != null && commentCount.TotalCount > 0)
                        {
                            <div class="store-rating-summary">
                                <div class="store-rating-value">@(commentCount.AvgRate?.ToString("0.0") ?? "-")</div>
                                <div class="store-rating-label">از ۵ · @commentCount.TotalCount نظر</div>
                            </div>
                        }
                        @if (approvedComments == null || approvedComments.Count == 0)
                        {
                            <p class="store-empty">هنوز نظری ثبت نشده است.</p>
                        }
                        else
                        {
                            <div class="store-review-list">
                                @foreach (var c in approvedComments.Take(20))
                                {
                                    <article class="store-review-item">
                                        <div class="store-review-meta">@c.UserDisplayName <span class="store-review-date">@PersianDateHelper.ToPersianDateString(c.CreatedAt)</span> @(c.Rate.HasValue ? $" · ★ {c.Rate}" : "")</div>
                                        <p class="store-review-text">@c.Text</p>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </main>
    }
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&display=swap');
    .store-page {
        font-family: 'Vazirmatn', Tahoma, sans-serif;
        direction: rtl;
        text-align: right;
        --store-primary: #E31837;
        --store-primary-dark: #C41230;
        --store-bg: #f8fafb;
        --store-card: #ffffff;
        --store-text: #1e293b;
        --store-text-muted: #64748b;
        --store-border: #e2e8f0;
        --store-radius: 16px;
        --store-radius-sm: 12px;
        --store-shadow: 0 4px 24px rgba(0,0,0,0.06);
        background: var(--store-bg);
        min-height: 100vh;
        padding-bottom: 3rem;
    }
    .store-loading { text-align: right; padding: 5rem 1rem; color: var(--store-text-muted); }
    .store-loading p { margin-top: 1rem; }
    .store-spinner {
        width: 52px; height: 52px;
        border: 4px solid var(--store-border);
        border-top-color: var(--store-primary);
        border-radius: 50%;
        animation: store-spin 0.8s linear infinite;
        margin: 0 auto;
    }
    @@keyframes store-spin { to { transform: rotate(360deg); } }
    .store-notfound { text-align: right; padding: 5rem 1.5rem; }
    .store-notfound p { margin-bottom: 1rem; color: var(--store-text); }
    .store-btn-back { display: inline-block; background: var(--store-primary); color: #fff; padding: 12px 24px; border-radius: 999px; text-decoration: none; font-weight: 600; }
    .store-header { position: relative; }
    .store-cover {
        height: 220px;
        background: linear-gradient(135deg, var(--store-primary) 0%, var(--store-primary-dark) 100%);
        position: relative;
        overflow: hidden;
    }
    .store-cover img { width: 100%; height: 100%; object-fit: cover; opacity: 0.92; }
    .store-cover-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.35) 100%);
    }
    .store-header-actions {
        position: absolute;
        top: 1rem;
        right: 1rem;
        left: 1rem;
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 0.5rem;
        z-index: 2;
    }
    .store-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(255,255,255,0.95);
        border: none;
        padding: 10px 18px;
        border-radius: 999px;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--store-text);
        cursor: pointer;
        z-index: 2;
        box-shadow: var(--store-shadow);
    }
    .store-back-arrow { font-size: 1.1rem; }
    .store-header-auth-login,
    .store-header-auth-user {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--store-text);
        background: rgba(255,255,255,0.95);
        box-shadow: var(--store-shadow);
    }
    .store-header-auth-login:hover,
    .store-header-auth-user:hover { opacity: 0.9; }
    .store-main { max-width: 720px; margin: 0 auto; padding: 0 1.25rem; direction: rtl; text-align: right; }
    .store-hero {
        background: var(--store-card);
        margin-top: -56px;
        position: relative;
        z-index: 1;
        border-radius: var(--store-radius) var(--store-radius) 0 0;
        box-shadow: var(--store-shadow);
        padding: 1.5rem 1.5rem 1.75rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem;
    }
    .store-hero-avatar {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        border: 4px solid var(--store-card);
        background: linear-gradient(145deg, #f1f5f9, #e2e8f0);
        overflow: hidden;
        flex-shrink: 0;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .store-hero-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .store-hero-icon { font-size: 2.5rem; }
    .store-hero-text { flex: 1; min-width: 0; text-align: right; }
    .store-name { font-size: 1.6rem; font-weight: 700; margin: 0 0 0.25rem 0; color: var(--store-text); line-height: 1.3; text-align: right; }
    .store-cat { color: var(--store-text-muted); font-size: 0.9rem; margin: 0 0 0.5rem 0; text-align: right; }
    .store-stats { font-size: 0.9rem; color: var(--store-text-muted); display: flex; align-items: center; justify-content: flex-end; gap: 0.35rem; flex-wrap: wrap; }
    .store-rating-badge { display: inline-flex; align-items: center; gap: 0.25rem; color: #b45309; font-weight: 600; }
    .store-star { color: #f59e0b; }
    .store-stat-dot { opacity: 0.6; }
    .store-cta {
        display: inline-block;
        width: 100%;
        max-width: 280px;
        text-align: center;
        background: linear-gradient(135deg, var(--store-primary), var(--store-primary-dark));
        color: #fff;
        padding: 14px 24px;
        border-radius: 999px;
        font-weight: 600;
        text-decoration: none;
        font-size: 0.95rem;
        box-shadow: 0 4px 14px rgba(227, 24, 55, 0.35);
    }
    .store-tabs {
        display: flex;
        flex-direction: row;
        justify-content: flex-start;
        width: 100%;
        background: var(--store-card);
        padding: 0 0.5rem;
        border-bottom: 1px solid var(--store-border);
        gap: 0.25rem;
        direction: rtl;
    }
    .store-tab {
        padding: 1rem 1.25rem;
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--store-text-muted);
        border: none;
        background: none;
        cursor: pointer;
        border-bottom: 3px solid transparent;
        margin-bottom: -1px;
        transition: color 0.2s, border-color 0.2s;
        text-align: right;
        direction: rtl;
    }
    .store-tab:hover { color: var(--store-text); }
    .store-tab.active { color: var(--store-primary); border-bottom-color: var(--store-primary); }
    .store-tab-content {
        background: var(--store-card);
        padding: 1.75rem 1.25rem;
        min-height: 240px;
        border-radius: 0 0 var(--store-radius) var(--store-radius);
        box-shadow: 0 4px 24px rgba(0,0,0,0.04);
        text-align: right;
        direction: rtl;
    }
    .store-about, .store-gallery, .store-reviews { text-align: right; direction: rtl; }
    .store-about .store-desc { margin: 0 0 1.25rem 0; line-height: 1.85; color: var(--store-text); font-size: 1rem; text-align: right; }
    .store-meta-list { display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-end; direction: rtl; text-align: right; }
    .store-meta-row { font-size: 0.95rem; color: var(--store-text); display: flex; align-items: center; flex-direction: row-reverse; gap: 0.5rem; text-align: right; direction: rtl; justify-content: flex-end; }
    .store-meta-icon { flex-shrink: 0; }
    .store-meta-row a { color: var(--store-primary); font-weight: 500; }
    .store-coupons-section { margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--store-border); text-align: right; direction: rtl; }
    .store-coupons-title { font-size: 1.1rem; font-weight: 600; margin: 0 0 1rem 0; color: var(--store-text); text-align: right; }
    .store-coupons-list { display: flex; flex-direction: column; gap: 0.75rem; text-align: right; direction: rtl; }
    .store-coupon-card {
        display: flex; flex-wrap: wrap; flex-direction: row-reverse; align-items: center; justify-content: flex-end; gap: 0.5rem 1rem;
        padding: 0.85rem 1rem; background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
        border-radius: var(--store-radius-sm); border: 1px solid #bbf7d0;
        font-size: 0.9rem; text-align: right; direction: rtl;
    }
    .store-coupon-title { font-weight: 600; color: var(--store-text); }
    .store-coupon-code { font-family: monospace; background: #fff; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600; color: var(--store-primary); }
    .store-coupon-discount { color: #15803d; font-weight: 500; }
    .store-coupon-expire { color: var(--store-text-muted); font-size: 0.85rem; }
    .store-empty { color: var(--store-text-muted); text-align: right; padding: 2.5rem 1rem; font-size: 0.95rem; }
    .store-gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 1rem;
    }
    .store-gallery-item {
        border-radius: var(--store-radius-sm);
        overflow: hidden;
        background: #f1f5f9;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .store-gallery-item:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.1); }
    .store-gallery-item img { width: 100%; height: 170px; object-fit: cover; display: block; }
    .store-gallery-title { display: block; padding: 0.65rem 0.75rem; font-size: 0.85rem; color: var(--store-text-muted); text-align: right; }
    .store-rating-summary {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        padding: 1.25rem;
        border-radius: var(--store-radius-sm);
        margin-bottom: 1.5rem;
        text-align: right;
        border: 1px solid #fde68a;
    }
    .store-rating-value { font-size: 2.25rem; font-weight: 700; color: #b45309; line-height: 1; }
    .store-rating-label { font-size: 0.9rem; color: #92400e; margin-top: 0.35rem; text-align: right; }
    .store-review-list { display: flex; flex-direction: column; gap: 1rem; }
    .store-review-item {
        padding: 1.25rem;
        background: var(--store-bg);
        border-radius: var(--store-radius-sm);
        border: 1px solid var(--store-border);
        text-align: right;
    }
    .store-review-meta { font-size: 0.85rem; color: var(--store-text-muted); margin-bottom: 0.5rem; text-align: right; }
    .store-review-date { opacity: 0.85; }
    .store-review-text { margin: 0; font-size: 0.95rem; line-height: 1.7; color: var(--store-text); text-align: right; }
</style>

@code {
    [Parameter] public int StoreId { get; set; }

    private MyShop.Core.Models.Store store;
    private bool loading = true;
    private List<MyShop.Core.Models.StoreDocument> galleryDocuments;
    private CommentCountResultDto commentCount;
    private List<CommentDto> approvedComments = new();
    private string activeTab = "about";
    private bool isCustomer;
    private bool authIsAuthenticated;
    private string authDisplayName = "";
    private string authPanelUrl = "/";
    private List<Coupon> activeStoreCoupons = new();
    private List<MyShop.Core.Models.Products.ProductDto> commerceProducts = new();

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            isCustomer = state.User?.Identity?.IsAuthenticated == true && state.User.IsInRole("Customer");
            authIsAuthenticated = state?.User?.Identity?.IsAuthenticated == true;
            if (authIsAuthenticated && state.User != null)
            {
                authDisplayName = state.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? state.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "کاربر";
                var role = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                authPanelUrl = role == "Admin" ? "/admin" : role == "StoreOwner" ? "/storeowner/dashboard" : "/customer/Dashboard";
            }

            store = await StoreService.GetByIdAsync(StoreId);
            if (store == null)
            {
                loading = false;
                return;
            }
            var allDocs = await StoreDocumentService.GetByStoreIdAsync(StoreId);
            galleryDocuments = (allDocs ?? new List<MyShop.Core.Models.StoreDocument>())
                .Where(d => d.DocumentType == "گالری" || d.DocumentType == "پروفایل")
                .ToList();
            commentCount = await CommentService.GetCountByStoreAsync(StoreId);
            var flat = await CommentService.GetFlatByStoreAsync(StoreId);
            approvedComments = (flat ?? new List<CommentDto>()).Where(c => c.StatusView == 1 && !c.IsDeleted).OrderByDescending(c => c.CreatedAt).ToList();

            var storeCoupons = await CouponService.GetByStoreIdAsync(StoreId) ?? new List<Coupon>();
            var today = DateTime.Today;
            activeStoreCoupons = storeCoupons
                .Where(c => c.CoponStatAdmin
                    && c.CoponExpireDate >= today
                    && (!c.CoponStartDate.HasValue || c.CoponStartDate.Value <= today)
                    && c.CoponStock > 0)
                .OrderBy(c => c.CoponExpireDate)
                .ToList();
            try
            {
                var all = await ShopCatalog.ListVisibleAsync(null) ?? new();
                commerceProducts = all.Where(p => p.IsActive && p.StoreId == StoreId).ToList();
            }
            catch { commerceProducts = new(); }
        }
        catch
        {
            store = null;
        }
        finally
        {
            loading = false;
        }
    }

    private void GoHome() => Nav.NavigateTo("/", true);
    private void GoToStoresList() => Nav.NavigateTo("/stores", true);

    private static string GetCouponDiscountText(Coupon c)
    {
        if (c.DiscountValue.HasValue)
            return c.DiscountType == 1 ? $"{c.DiscountValue}٪ تخفیف" : $"{c.DiscountValue:N0} تومان تخفیف";
        if (c.DiscountPercent.HasValue)
            return $"{c.DiscountPercent}٪ تخفیف";
        if (c.DiscountAmount.HasValue)
            return $"{c.DiscountAmount:N0} تومان تخفیف";
        return "تخفیف";
    }
}
