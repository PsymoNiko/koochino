@page "/admin/Dashboard"
@layout AdminLayout
@using MyShop.Application.Interfaces
@using MyShop.Application.Interfaces.Tickets
@using MyShop.Application.Interfaces.ProjectManagement
@using MyShop.Application.Interfaces.Commerce
@using MyShop.Application.Interfaces.Dashboard
@using MyShop.Application.Interfaces.Sites
@using MyShop.Application.Interfaces.SupportChat
@using MyShop.Core.Models
@using MyShop.Core.Models.Dto
@using MyShop.Core.Models.Tickets
@using MyShop.Core.Models.ProjectManagement
@using MyShop.Core.Models.Commerce
@using MyShop.Core.Models.Dashboard
@using MyShop.Core.Models.Sites
@using MyShop.Core.Models.SupportChat
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using System.Linq
@using MyShop.Web.Services
@inject IOrderService OrderService
@inject ICouponService CouponService
@inject IChanceBoxService ChanceBoxService
@inject IUserService UserService
@inject IUserActivityService ActivityService
@inject IStoreService StoreService
@inject ITicketService TicketService
@inject IProjectService ProjectService
@inject IProjectBoardService ProjectBoardService
@inject MyShop.Application.Interfaces.Inventory.IInventoryStockService InventoryStockService
@inject ICommerceService CommerceService
@inject IDashboardWidgetService WidgetService
@inject IPointService PointService
@inject ISiteService SiteService
@inject ISupportChatService SupportChat
@inject ISupportAssistService SupportAssist
@inject ISupportAnalyticsService SupportAnalytics
@inject MyShop.Core.Interfaces.ICurrentTenant CurrentTenant
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

@attribute [Authorize(Roles = "Admin")]

@if (loading)
{
    <div class="dash-loading" dir="rtl">
        <div class="spinner"></div>
        <p>در حال بارگذاری گزارش‌ها...</p>
    </div>
}
else
{
<div class="admin-biz-dash" dir="rtl" lang="fa">

    <div class="page-header">
        <div class="page-header-row">
            <div>
                <div class="page-pretitle">گزارش عملیاتی @(CurrentTenant.HasSite ? ("— " + CurrentTenant.SiteName) : "")</div>
                <h1 class="page-title">پیشخوان مدیریت</h1>
                @if (CurrentTenant.HasSite)
                {
                    <div class="site-badge">سایت: @CurrentTenant.SiteName <span>(@CurrentTenant.SiteCode)</span></div>
                }
            </div>
            <div class="page-actions" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                @if (adminSites.Count > 1)
                {
                    <select class="btn btn-outline" style="padding:6px 10px;" @bind="selectedSiteFilter" @bind:after="OnSiteFilterChanged">
                        <option value="0">@(hasFullSiteAccess ? "همه سایت‌های مجاز" : "سایت جاری")</option>
                        @foreach (var s in adminSites)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                }
                <button type="button" class="btn btn-outline" @onclick="ExportDashboardCsv">خروجی CSV</button>
                <button type="button" class="btn btn-outline" @onclick="OpenWidgetManager">مدیریت ظاهر داشبورد</button>
                <a class="btn btn-outline" href="/admin/sales-reports">گزارش کامل فروش</a>
                <a class="btn btn-primary" href="/admin/orders-pending">سفارشات در انتظار</a>
                <a class="btn btn-outline" href="/admin/commerce/orders">سفارشات آنلاین</a>
            </div>
        </div>
    </div>

    <div class="dash-widgets" style="display:flex;flex-direction:column;gap:0;">

    @if (IsWidgetVisible("commerce-kpis") && commerceKpis != null)
    {
        <section class="dash-section" style='@WidgetStyle("commerce-kpis")'>
            <div class="section-head">
                <h2 class="section-title">فروشگاه آنلاین (Commerce)</h2>
                <a class="section-link" href="/admin/commerce/orders">جزئیات ←</a>
            </div>
            <div class="kpi-row col-4">
                <div class="kpi-card"><div class="kpi-label">سفارش امروز</div><div class="kpi-value">@commerceKpis.OrdersToday</div></div>
                <div class="kpi-card"><div class="kpi-label">سفارش ماه</div><div class="kpi-value">@commerceKpis.OrdersMonth</div></div>
                <div class="kpi-card"><div class="kpi-label">درآمد ماه (ریال)</div><div class="kpi-value" dir="ltr">@commerceKpis.RevenueMonth.ToString("N0")</div></div>
                <div class="kpi-card"><div class="kpi-label">سبدهای فعال / اقلام</div><div class="kpi-value">@commerceKpis.ActiveCarts / @commerceKpis.CartItemsTotal</div></div>
            </div>
            <div class="kpi-row col-4" style="margin-top:10px;">
                <div class="kpi-card"><div class="kpi-label">در انتظار پرداخت</div><div class="kpi-value">@commerceKpis.AwaitingPayment</div></div>
                <div class="kpi-card"><div class="kpi-label">آماده‌سازی</div><div class="kpi-value">@commerceKpis.Processing</div></div>
                <div class="kpi-card"><div class="kpi-label">ارسال‌شده</div><div class="kpi-value">@commerceKpis.Shipped</div></div>
                <div class="kpi-card"><div class="kpi-label">درآمد امروز</div><div class="kpi-value" dir="ltr">@commerceKpis.RevenueToday.ToString("N0")</div></div>
            </div>
        </section>
    }

    @if (!string.IsNullOrEmpty(loadError))
    {
        <div class="dash-alert">@loadError</div>
    }

    @if (lowStockCount > 0)
    {
        <div class="dash-alert" style="background:#fff7ed;border:1px solid #fdba74;color:#9a3412;">
            ⚠️ <strong>@lowStockCount</strong> مورد کمبود موجودی —
            <a href="/admin/inventory/stock" style="color:#c2410c;font-weight:600;">مشاهده موجودی</a>
        </div>
    }

    <!-- ========== 1) فروش ========== -->
    @if (IsWidgetVisible("sales"))
    {
    <section class="dash-section" style='@WidgetStyle("sales")'>
        <div class="section-head">
            <h2 class="section-title">۱. فروش</h2>
            <a class="section-link" href="/admin/sales-reports">جزئیات ←</a>
        </div>

        <div class="kpi-row col-4">
            <div class="kpi-card kpi-primary">
                <div class="kpi-label">فروش این ماه</div>
                <div class="kpi-value">@NumberFormatHelper.Format(salesMonthAmount)</div>
                <div class="kpi-meta">@NumberFormatHelper.Format(salesMonthCount) سفارش تکمیل‌شده</div>
                @if (salesLastMonthAmount > 0)
                {
                    <div class="kpi-meta @(salesGrowthPercent >= 0 ? "up" : "down")">
                        @(salesGrowthPercent >= 0 ? "↑" : "↓") @Math.Abs(salesGrowthPercent)% نسبت به ماه قبل
                    </div>
                }
            </div>
            <div class="kpi-card">
                <div class="kpi-label">فروش ماه قبل</div>
                <div class="kpi-value">@NumberFormatHelper.Format(salesLastMonthAmount)</div>
                <div class="kpi-meta">@NumberFormatHelper.Format(salesLastMonthCount) سفارش</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">فروش ۷ روز اخیر</div>
                <div class="kpi-value">@NumberFormatHelper.Format(sales7DaysAmount)</div>
                <div class="kpi-meta">میانگین روزانه: @NumberFormatHelper.Format(sales7DaysAmount / 7)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">امروز</div>
                <div class="kpi-value">@NumberFormatHelper.Format(salesTodayAmount)</div>
                <div class="kpi-meta">@NumberFormatHelper.Format(salesTodayCount) سفارش</div>
            </div>
        </div>

        <div class="charts-row col-8-4">
            <div class="chart-panel">
                <div class="chart-panel-head">
                    <h3>روند فروش روزانه (۳۰ روز)</h3>
                    <span class="chart-hint">سفارشات تاییدشده</span>
                </div>
                <div id="salesTrendChart" class="echart-host" style="height:320px"></div>
            </div>
            <div class="chart-panel">
                <div class="chart-panel-head">
                    <h3>ترکیب فروش این ماه</h3>
                </div>
                <div id="salesMixChart" class="echart-host" style="height:300px"></div>
                <div class="mix-legend">
                    <span>عادی: @NumberFormatHelper.Format(mixNormalAmount)</span>
                    <span>کوپن: @NumberFormatHelper.Format(mixCouponAmount)</span>
                    <span>جعبه‌شانس: @NumberFormatHelper.Format(mixChanceAmount)</span>
                </div>
            </div>
        </div>
    </section>
    }

    <!-- ========== 2) سفارشات ========== -->
    @if (IsWidgetVisible("orders"))
    {
    <section class="dash-section" style='@WidgetStyle("orders")'>
        <div class="section-head">
            <h2 class="section-title">۲. سفارشات</h2>
            <a class="section-link" href="/admin/financial-orders">همه سفارشات ←</a>
        </div>

        <div class="kpi-row col-4">
            <a class="kpi-card kpi-warn @(pendingOrdersCount > 0 ? "pulse" : "")" href="/admin/orders-pending">
                <div class="kpi-label">در انتظار تایید</div>
                <div class="kpi-value">@NumberFormatHelper.Format(pendingOrdersCount)</div>
                <div class="kpi-meta">نیاز به بررسی ادمین</div>
            </a>
            <div class="kpi-card">
                <div class="kpi-label">تاییدشده این ماه</div>
                <div class="kpi-value">@NumberFormatHelper.Format(ordersCompletedMonth)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">ردشده این ماه</div>
                <div class="kpi-value">@NumberFormatHelper.Format(ordersRejectedMonth)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">کل این ماه</div>
                <div class="kpi-value">@NumberFormatHelper.Format(ordersTotalMonth)</div>
            </div>
        </div>

        <div class="charts-row col-2">
            <div class="chart-panel">
                <div class="chart-panel-head"><h3>وضعیت سفارش‌ها (این ماه)</h3></div>
                <div id="orderStatusChart" class="echart-host" style="height:300px"></div>
            </div>
            <div class="chart-panel">
                <div class="chart-panel-head"><h3>تعداد سفارش روزانه (۳۰ روز)</h3></div>
                <div id="ordersDailyChart" class="echart-host" style="height:300px"></div>
            </div>
        </div>
    </section>
    }

    <!-- ========== 3) کدهای تخفیف ========== -->
    @if (IsWidgetVisible("coupons"))
    {
    <section class="dash-section" style='@WidgetStyle("coupons")'>
        <div class="section-head">
            <h2 class="section-title">۳. کدهای تخفیف</h2>
            <a class="section-link" href="/admin/coupons">مدیریت کوپن ←</a>
        </div>

        <div class="kpi-row col-4">
            <div class="kpi-card">
                <div class="kpi-label">استفاده این ماه</div>
                <div class="kpi-value">@NumberFormatHelper.Format(couponUsagesMonth)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">مجموع تخفیف این ماه</div>
                <div class="kpi-value">@NumberFormatHelper.Format(couponDiscountMonth)</div>
                <div class="kpi-meta">تومان</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">کوپن‌های فعال</div>
                <div class="kpi-value">@NumberFormatHelper.Format(activeCouponCount)</div>
            </div>
            <a class="kpi-card kpi-warn" href="/admin/coupons">
                <div class="kpi-label">در انتظار تایید</div>
                <div class="kpi-value">@NumberFormatHelper.Format(pendingCouponCount)</div>
            </a>
        </div>

        <div class="charts-row col-1">
            <div class="chart-panel">
                <div class="chart-panel-head">
                    <h3>۵ کوپن پراستفاده (۳۰ روز اخیر)</h3>
                </div>
                @if (topCouponLabels.Count == 0)
                {
                    <div class="chart-empty">در این بازه استفاده‌ای ثبت نشده است.</div>
                }
                else
                {
                    <div id="topCouponsChart" class="echart-host" style="height:300px"></div>
                }
            </div>
        </div>
    </section>
    }

    <!-- ========== 4) جعبه شانس ========== -->
    @if (IsWidgetVisible("chancebox"))
    {
    <section class="dash-section" style='@WidgetStyle("chancebox")'>
        <div class="section-head">
            <h2 class="section-title">۴. جعبه شانس</h2>
            <a class="section-link" href="/admin/chancebox-stores">فروشگاه‌ها ←</a>
        </div>

        <div class="kpi-row col-4">
            <div class="kpi-card">
                <div class="kpi-label">فروشگاه دارای جعبه‌شانس</div>
                <div class="kpi-value">@NumberFormatHelper.Format(chanceBoxStoreCount)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">سفارش جعبه‌شانس این ماه</div>
                <div class="kpi-value">@NumberFormatHelper.Format(chanceBoxOrdersMonth)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">مبلغ فروش جعبه‌شانس</div>
                <div class="kpi-value">@NumberFormatHelper.Format(chanceBoxAmountMonth)</div>
                <div class="kpi-meta">تومان · این ماه</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">سهم از فروش ماه</div>
                <div class="kpi-value">@chanceBoxSharePercent%</div>
            </div>
        </div>

        <div class="charts-row col-1">
            <div class="chart-panel">
                <div class="chart-panel-head">
                    <h3>فروش روزانه جعبه‌شانس (۳۰ روز)</h3>
                </div>
                <div id="chanceBoxChart" class="echart-host" style="height:280px"></div>
            </div>
        </div>
    </section>
    }

    <!-- ========== 5) کاربران ========== -->
    @if (IsWidgetVisible("users"))
    {
    <section class="dash-section" style='@WidgetStyle("users")'>
        <div class="section-head">
            <h2 class="section-title">۵. کاربران</h2>
            <a class="section-link" href="/admin/users">مدیریت کاربران ←</a>
        </div>
        <div class="kpi-row col-4">
            <div class="kpi-card">
                <div class="kpi-label">کل کاربران</div>
                <div class="kpi-value">@NumberFormatHelper.Format(userTotalCount)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">فعال</div>
                <div class="kpi-value">@NumberFormatHelper.Format(userActiveCount)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">غیرفعال</div>
                <div class="kpi-value">@NumberFormatHelper.Format(userInactiveCount)</div>
            </div>
            <a class="kpi-card kpi-primary" href="/admin/online-users">
                <div class="kpi-label">آنلاین الان</div>
                <div class="kpi-value">@NumberFormatHelper.Format(userOnlineCount)</div>
                <div class="kpi-meta">لاگین امروز: @NumberFormatHelper.Format(userTodayLogins)</div>
            </a>
        </div>
        <div class="charts-row col-2">
            <div class="chart-panel">
                <div class="chart-panel-head"><h3>توزیع نقش کاربران</h3></div>
                <div id="userRolesChart" class="echart-host" style="height:300px"></div>
            </div>
            <div class="chart-panel">
                <div class="chart-panel-head"><h3>ثبت‌نام روزانه (۳۰ روز)</h3></div>
                <div id="userRegTrendChart" class="echart-host" style="height:300px"></div>
            </div>
        </div>
    </section>
    }

    <!-- ========== 6) تیکت‌ها ========== -->
    @if (IsWidgetVisible("tickets"))
    {
    <section class="dash-section" style='@WidgetStyle("tickets")'>
        <div class="section-head">
            <h2 class="section-title">۶. تیکت‌های پشتیبانی</h2>
            <a class="section-link" href="/admin/tickets">لیست تیکت‌ها ←</a>
        </div>
        <div class="kpi-row col-4">
            <div class="kpi-card">
                <div class="kpi-label">کل تیکت‌ها</div>
                <div class="kpi-value">@NumberFormatHelper.Format(ticketTotal)</div>
            </div>
            <a class="kpi-card kpi-warn @(ticketWaiting > 0 ? "pulse" : "")" href="/admin/tickets">
                <div class="kpi-label">در انتظار پاسخ</div>
                <div class="kpi-value">@NumberFormatHelper.Format(ticketWaiting)</div>
            </a>
            <div class="kpi-card">
                <div class="kpi-label">پاسخ‌داده‌شده</div>
                <div class="kpi-value">@NumberFormatHelper.Format(ticketAnswered)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">بسته / اتمام</div>
                <div class="kpi-value">@NumberFormatHelper.Format(ticketClosed)</div>
            </div>
        </div>
        <div class="charts-row col-8-4">
            <div class="chart-panel">
                <div class="chart-panel-head"><h3>وضعیت تیکت‌ها</h3></div>
                <div id="ticketStatusChart" class="echart-host" style="height:300px"></div>
            </div>
            <div class="chart-panel">
                <div class="chart-panel-head"><h3>خلاصه پشتیبانی</h3></div>
                <div class="sys-list">
                    <div class="sys-row"><span>باز / در صف</span><strong>@NumberFormatHelper.Format(ticketWaiting)</strong></div>
                    <div class="sys-row"><span>در حال پیگیری</span><strong>@NumberFormatHelper.Format(ticketAnswered)</strong></div>
                    <div class="sys-row"><span>بسته شده</span><strong>@NumberFormatHelper.Format(ticketClosed)</strong></div>
                    <div class="sys-row"><span>نرخ بسته بودن</span><strong>@ticketClosedRate%</strong></div>
                </div>
            </div>
        </div>
    </section>
    }

    @if (IsWidgetVisible("live-chat"))
    {
    <section class="dash-section" style='@WidgetStyle("live-chat")'>
        <div class="section-head">
            <h2 class="section-title">چت آنلاین پشتیبانی</h2>
            <a class="section-link" href="/admin/support/conversations">صندوق گفتگوها ←</a>
        </div>
        <div class="kpi-row col-4">
            <a class="kpi-card kpi-warn @(supportWaiting > 0 ? "pulse" : "")" href="/admin/support/conversations">
                <div class="kpi-label">در انتظار پاسخ</div>
                <div class="kpi-value">@NumberFormatHelper.Format(supportWaiting)</div>
            </a>
            <div class="kpi-card">
                <div class="kpi-label">گفتگوی فعال</div>
                <div class="kpi-value">@NumberFormatHelper.Format(supportActive)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">اعلان خوانده‌نشده</div>
                <div class="kpi-value">@NumberFormatHelper.Format(supportUnreadNotif)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">میانگین رضایت</div>
                <div class="kpi-value">@(supportAvgCsat.HasValue ? supportAvgCsat.Value.ToString("0.0") : "—")</div>
            </div>
        </div>
        <div class="charts-row col-8-4">
            <div class="chart-panel">
                <div class="chart-panel-head"><h3>آخرین پیام‌ها</h3></div>
                @if (supportInbox.Count == 0)
                {
                    <p class="muted" style="padding:16px;">گفتگوی بازی نیست.</p>
                }
                else
                {
                    <div class="sys-list">
                        @foreach (var t in supportInbox.Take(8))
                        {
                            <a class="sys-row" href="/admin/support/conversations/@t.Id" style="text-decoration:none;color:inherit;">
                                <span>@(string.IsNullOrWhiteSpace(t.VisitorName) ? (t.UserDisplayName ?? "مهمان") : t.VisitorName)</span>
                                <strong>@(t.UnreadByAdmin > 0 ? t.UnreadByAdmin + " جدید" : t.Status)</strong>
                            </a>
                            <div style="padding:0 12px 8px;color:#64748b;font-size:.82rem;">@(t.LastMessagePreview ?? "—")</div>
                        }
                    </div>
                }
            </div>
            <div class="chart-panel">
                <div class="chart-panel-head"><h3>گزارش امروز</h3></div>
                <div class="sys-list">
                    <div class="sys-row"><span>گفتگوهای امروز</span><strong>@NumberFormatHelper.Format(supportTodayChats)</strong></div>
                    <div class="sys-row"><span>پیام کاربران</span><strong>@NumberFormatHelper.Format(supportUserMsgs)</strong></div>
                    <div class="sys-row"><span>پاسخ ادمین</span><strong>@NumberFormatHelper.Format(supportAdminMsgs)</strong></div>
                    <div class="sys-row"><span>بسته شده</span><strong>@NumberFormatHelper.Format(supportClosed)</strong></div>
                </div>
            </div>
        </div>
    </section>
    }

    <!-- ========== 7) وضعیت کلی سیستم ========== -->
    @if (IsWidgetVisible("system"))
    {
    <section class="dash-section" style='@WidgetStyle("system")'>
        <div class="section-head">
            <h2 class="section-title">۷. وضعیت کلی سیستم</h2>
            <a class="section-link" href="/admin/modules">ماژول‌ها ←</a>
        </div>
        <div class="kpi-row col-4">
            <div class="kpi-card">
                <div class="kpi-label">فروشگاه‌ها</div>
                <div class="kpi-value">@NumberFormatHelper.Format(sysStoreTotal)</div>
                <div class="kpi-meta">فعال: @NumberFormatHelper.Format(sysStoreActive) · انتظار: @NumberFormatHelper.Format(sysStorePending)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">کاربران آنلاین</div>
                <div class="kpi-value">@NumberFormatHelper.Format(userOnlineCount)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">سفارش در صف</div>
                <div class="kpi-value">@NumberFormatHelper.Format(pendingOrdersCount)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">تیکت در صف</div>
                <div class="kpi-value">@NumberFormatHelper.Format(ticketWaiting)</div>
            </div>
        </div>
        <div class="charts-row col-2">
            <div class="chart-panel">
                <div class="chart-panel-head"><h3>ورود یکتای روزانه (۱۴ روز)</h3></div>
                <div id="loginTrendChart" class="echart-host" style="height:280px"></div>
            </div>
            <div class="chart-panel">
                <div class="chart-panel-head"><h3>سلامت عملیاتی</h3></div>
                <div class="sys-list">
