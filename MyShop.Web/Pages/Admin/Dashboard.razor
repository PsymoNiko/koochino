    private async Task RenderAllChartsAsync()
    {
        try
        {
            // wait for echarts from host
            for (var i = 0; i < 40; i++)
            {
                var ok = await JS.InvokeAsync<bool>("checkChartJsLoaded");
                if (ok) break;
                await Task.Delay(100);
            }

            await Task.Delay(50);

            await JS.InvokeVoidAsync("renderSalesTrendChart",
                salesTrendLabels.ToArray(),
                salesTrendValues.Select(v => (double)v).ToArray());

            await JS.InvokeVoidAsync("renderSalesMixChart",
                new[] { "فروش عادی", "با کوپن", "جعبه‌شانس" },
                new[] { (double)mixNormalAmount, (double)mixCouponAmount, (double)mixChanceAmount });

            await JS.InvokeVoidAsync("renderOrderStatusChart",
                new[] { "در انتظار", "تاییدشده", "ردشده" },
                new[] { ordersPendingMonth, ordersCompletedMonth, ordersRejectedMonth });

            await JS.InvokeVoidAsync("renderOrdersDailyChart",
                ordersDailyLabels.ToArray(),
                ordersDailyValues.ToArray());

            if (topCouponLabels.Count > 0)
            {
                await JS.InvokeVoidAsync("renderTopCouponsChart",
                    topCouponLabels.ToArray(),
                    topCouponValues.ToArray());
            }

            await JS.InvokeVoidAsync("renderChanceBoxChart",
                chanceDailyLabels.ToArray(),
                chanceDailyValues.Select(v => (double)v).ToArray());

            await JS.InvokeVoidAsync("renderUserRolesChart",
                userRoleLabels.ToArray(),
                userRoleValues.ToArray());

            await JS.InvokeVoidAsync("renderUserRegTrendChart",
                userRegLabels.ToArray(),
                userRegValues.ToArray());

            await JS.InvokeVoidAsync("renderTicketStatusChart",
                new[] { "در انتظار", "پاسخ‌داده‌شده", "بسته" },
                new[] { ticketWaiting, ticketAnswered, ticketClosed });

            if (loginTrendLabels.Count > 0)
            {
                await JS.InvokeVoidAsync("renderLoginTrendChart",
                    loginTrendLabels.ToArray(),
                    loginTrendValues.ToArray());
            }

            if (projectStatusLabels.Count > 0)
            {
                await JS.InvokeVoidAsync("renderProjectStatusChart",
                    projectStatusLabels.ToArray(),
                    projectStatusValues.ToArray());
            }

            await JS.InvokeVoidAsync("renderProjectTasksChart",
                new[] { "Todo", "Doing", "Done" },
                new[] { taskTodoCount, taskDoingCount, taskDoneCount });

            if (phaseLabels.Count > 0)
            {
                await JS.InvokeVoidAsync("renderProjectPhasesChart",
                    phaseLabels.ToArray(),
                    phaseValues.ToArray());
            }

            if (IsWidgetVisible("points-loyalty"))
            {
                await JS.InvokeVoidAsync("renderPointsDailyChart",
                    pts.DailyLabels.ToArray(),
                    pts.DailyApproved.ToArray(),
                    pts.DailyPending.ToArray());
                await JS.InvokeVoidAsync("renderPointsStatusChart",
                    new[] { "تاییدشده", "در انتظار", "ردشده" },
                    new[] { pts.TxApprovedMonth, pts.TxPending, pts.TxRejectedMonth });
                if (pts.TopMissionLabels.Count > 0)
                {
                    await JS.InvokeVoidAsync("renderPointsTopMissionsChart",
                        pts.TopMissionLabels.ToArray(),
                        pts.TopMissionValues.ToArray());
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Chart render error: " + ex.Message);
        }
    }

    private async Task ExportDashboardCsv()
    {
        var csv = CsvExportHelper.ToCsv(
            new[] { "Metric", "Value" },
            new[]
            {
                new object[] { "SalesMonthCount", salesMonthCount },
                new object[] { "SalesTodayCount", salesTodayCount },
                new object[] { "OrdersCompletedMonth", ordersCompletedMonth },
                new object[] { "OrdersPendingMonth", ordersPendingMonth },
                new object[] { "OrdersRejectedMonth", ordersRejectedMonth },
                new object[] { "UsersTotal", userTotalCount },
                new object[] { "UsersActive", userActiveCount },
                new object[] { "CouponUsagesMonth", couponUsagesMonth },
                new object[] { "ChanceBoxOrdersMonth", chanceBoxOrdersMonth },
                new object[] { "StoresTotal", sysStoreTotal },
                new object[] { "TicketsWaiting", ticketWaiting },
                new object[] { "CommerceOrdersToday", commerceKpis?.OrdersToday ?? 0 },
                new object[] { "CommerceRevenueMonth", commerceKpis?.RevenueMonth ?? 0 },
                new object[] { "MissionsActive", pts.MissionsActive },
                new object[] { "MissionsTotal", pts.MissionsTotal },
                new object[] { "PointsTxPending", pts.TxPending },
                new object[] { "PointsApprovedMonth", pts.PointsApprovedMonth },
                new object[] { "UsersWithPoints", pts.UsersWithPoints }
            });
        var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
        var b64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval",
            $"var a=document.createElement('a');a.href='data:text/csv;base64,{b64}';a.download='dashboard-kpis.csv';a.click();");
    }
