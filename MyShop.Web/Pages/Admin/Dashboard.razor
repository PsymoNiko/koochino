@code {
    private bool loading = true;
    private bool chartsRendered;
    private string loadError = "";

    // Sales
    private long salesMonthAmount, salesLastMonthAmount, sales7DaysAmount, salesTodayAmount;
    private int salesMonthCount, salesLastMonthCount, salesTodayCount;
    private double salesGrowthPercent;
    private long mixNormalAmount, mixCouponAmount, mixChanceAmount;
    private List<string> salesTrendLabels = new();
    private List<long> salesTrendValues = new();

    // Orders
    private int pendingOrdersCount, ordersCompletedMonth, ordersRejectedMonth, ordersPendingMonth, ordersTotalMonth;
    private List<string> ordersDailyLabels = new();
    private List<int> ordersDailyValues = new();

    // Coupons
    private int couponUsagesMonth, activeCouponCount, pendingCouponCount;
    private long couponDiscountMonth;
    private List<string> topCouponLabels = new();
    private List<int> topCouponValues = new();

    // Chance box
    private int chanceBoxStoreCount, chanceBoxOrdersMonth, chanceBoxSharePercent;
    private long chanceBoxAmountMonth;
    private List<string> chanceDailyLabels = new();
    private List<long> chanceDailyValues = new();

    // Users
    private int userTotalCount, userActiveCount, userInactiveCount, userOnlineCount, userTodayLogins;
    private List<string> userRoleLabels = new();
    private List<int> userRoleValues = new();
    private List<string> userRegLabels = new();
    private List<int> userRegValues = new();

    // Tickets
    private int ticketTotal, ticketWaiting, ticketAnswered, ticketClosed, ticketClosedRate;

    // System
    private int sysStoreTotal, sysStoreActive, sysStorePending;
    private List<string> loginTrendLabels = new();
    private List<int> loginTrendValues = new();
    private int lowStockCount;
    private CommerceDashboardKpis commerceKpis;

    // Projects
    private int projectTotalCount, projectActiveCount, phaseTotalCount, taskTotalCount;
    private int projectAvgProgress;
    private int taskTodoCount, taskDoingCount, taskDoneCount;
    private List<string> projectStatusLabels = new();
    private List<int> projectStatusValues = new();
    private List<string> phaseLabels = new();
    private List<int> phaseValues = new();

    private PointsLoyaltyDashboardDto pts = new();
    private int ptsApproveRate;
    private string ptsAvgApproved = "—";

    private int supportWaiting, supportActive, supportUnreadNotif, supportTodayChats, supportUserMsgs, supportAdminMsgs, supportClosed;
    private double? supportAvgCsat;
    private List<SupportChatThread> supportInbox = new();

    // Widgets + site filter
    private List<UserDashboardWidget> widgetLayout = new();
    private bool showWidgetManager;
    private bool savingWidgets;
    private string widgetFlash = "";
    private int adminUserId;
    private List<Site> adminSites = new();
    private int selectedSiteFilter;
    private bool hasFullSiteAccess = true;
    private HashSet<int> allowedSiteIds = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Task.Delay(50);
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true ||
                authState.User.FindFirst(ClaimTypes.Role)?.Value != "Admin")
            {
                Nav.NavigateTo("/Account/login-admin", true);
                return;
            }

            int.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out adminUserId);
            await LoadSiteScopeAsync();
            try
            {
                if (adminUserId > 0)
                    widgetLayout = await WidgetService.GetEffectiveLayoutAsync(adminUserId, "Admin");
            }
            catch { widgetLayout = new(); }

            await LoadBusinessDataAsync();
        }
        catch (Exception ex)
        {
            loadError = "خطا در بارگذاری داشبورد: " + ex.Message;
            Console.WriteLine(ex);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadSiteScopeAsync()
    {
        try
        {
            var all = await SiteService.ListAsync(true) ?? new List<Site>();
            var ids = adminUserId > 0
                ? await SiteService.GetAdminSiteIdsAsync(adminUserId)
                : new List<int>();
            hasFullSiteAccess = ids == null || ids.Count == 0;
            allowedSiteIds = hasFullSiteAccess
                ? new HashSet<int>(all.Select(s => s.Id))
                : new HashSet<int>(ids);
            adminSites = all.Where(s => allowedSiteIds.Contains(s.Id)).ToList();
            if (selectedSiteFilter == 0 && CurrentTenant.HasSite && allowedSiteIds.Contains(CurrentTenant.SiteId))
                selectedSiteFilter = CurrentTenant.SiteId;
        }
        catch
        {
            adminSites = new();
            hasFullSiteAccess = true;
        }
    }

    private async Task OnSiteFilterChanged()
    {
        loading = true;
        chartsRendered = false;
        StateHasChanged();
        try { await LoadBusinessDataAsync(); }
        finally { loading = false; chartsRendered = false; }
    }

    private int? EffectiveSiteId()
    {
        if (selectedSiteFilter > 0) return selectedSiteFilter;
        if (CurrentTenant.HasSite) return CurrentTenant.SiteId;
        return null;
    }

    private bool IsWidgetVisible(string key)
    {
        if (widgetLayout == null || widgetLayout.Count == 0) return true;
        var w = widgetLayout.FirstOrDefault(x => string.Equals(x.WidgetKey, key, StringComparison.OrdinalIgnoreCase));
        return w == null || w.IsVisible;
    }

    private string WidgetStyle(string key) => $"order:{GetWidgetOrder(key)}";

    private int GetWidgetOrder(string key)
    {
        var w = widgetLayout?.FirstOrDefault(x => string.Equals(x.WidgetKey, key, StringComparison.OrdinalIgnoreCase));
        return w?.SortOrder ?? 100;
    }

    private void OpenWidgetManager()
    {
        showWidgetManager = true;
        widgetFlash = "";
    }

    private void SetWidgetVisible(int idx, bool visible)
    {
        if (idx < 0 || idx >= widgetLayout.Count) return;
        widgetLayout[idx].IsVisible = visible;
    }

    private void MoveWidget(int idx, int delta)
    {
        var ni = idx + delta;
        if (ni < 0 || ni >= widgetLayout.Count) return;
        var item = widgetLayout[idx];
        widgetLayout.RemoveAt(idx);
        widgetLayout.Insert(ni, item);
        for (var i = 0; i < widgetLayout.Count; i++)
            widgetLayout[i].SortOrder = (i + 1) * 10;
    }

    private async Task SaveWidgets()
    {
        if (adminUserId <= 0) return;
        savingWidgets = true;
        try
        {
            for (var i = 0; i < widgetLayout.Count; i++)
                widgetLayout[i].SortOrder = (i + 1) * 10;
            await WidgetService.SaveLayoutAsync(adminUserId, "Admin", widgetLayout);
            widgetFlash = "ذخیره شد.";
            showWidgetManager = false;
        }
        catch (Exception ex) { widgetFlash = "خطا: " + ex.Message + " — اسکریپت sql/Admin_DashboardWidgets_And_Home.sql را اجرا کنید."; }
        finally { savingWidgets = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!loading && !chartsRendered)
        {
            chartsRendered = true;
            await RenderAllChartsAsync();
        }
    }

    private async Task LoadBusinessDataAsync()
    {
        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);
        var lastMonthStart = monthStart.AddMonths(-1);
        var lastMonthEnd = monthStart.AddDays(-1);
        var from30 = today.AddDays(-29);
        const int maxRows = 5000;
        const byte statusCompleted = 1;
        const byte statusPending = 0;
        const byte statusRejected = 2;

        // --- Orders completed this month by type (sales) ---
        var monthNormal = await SafeOrders(monthStart, monthEnd, 0, statusCompleted, maxRows);
        var monthCoupon = await SafeOrders(monthStart, monthEnd, 1, statusCompleted, maxRows);
        var monthChance = await SafeOrders(monthStart, monthEnd, 2, statusCompleted, maxRows);

        mixNormalAmount = monthNormal.Sum(o => o.FinalAmount);
        mixCouponAmount = monthCoupon.Sum(o => o.FinalAmount);
        mixChanceAmount = monthChance.Sum(o => o.FinalAmount);
        salesMonthAmount = mixNormalAmount + mixCouponAmount + mixChanceAmount;
        salesMonthCount = monthNormal.Count + monthCoupon.Count + monthChance.Count;
        chanceBoxOrdersMonth = monthChance.Count;
        chanceBoxAmountMonth = mixChanceAmount;
        chanceBoxSharePercent = salesMonthAmount > 0
            ? (int)Math.Round(100.0 * mixChanceAmount / salesMonthAmount)
            : 0;

        var lastNormal = await SafeOrders(lastMonthStart, lastMonthEnd, null, statusCompleted, maxRows);
        salesLastMonthAmount = lastNormal.Sum(o => o.FinalAmount);
        salesLastMonthCount = lastNormal.Count;
        if (salesLastMonthAmount > 0)
            salesGrowthPercent = Math.Round(100.0 * (salesMonthAmount - salesLastMonthAmount) / salesLastMonthAmount, 1);
        else
            salesGrowthPercent = salesMonthAmount > 0 ? 100 : 0;

        // All completed orders last 30 days (any type) for trend
        var all30 = new List<Order>();
        all30.AddRange(await SafeOrders(from30, today, 0, statusCompleted, maxRows));
        all30.AddRange(await SafeOrders(from30, today, 1, statusCompleted, maxRows));
        all30.AddRange(await SafeOrders(from30, today, 2, statusCompleted, maxRows));

        salesTrendLabels.Clear();
        salesTrendValues.Clear();
        ordersDailyLabels.Clear();
        ordersDailyValues.Clear();
        chanceDailyLabels.Clear();
        chanceDailyValues.Clear();

        for (var d = from30; d <= today; d = d.AddDays(1))
        {
            var label = PersianDateHelper.ToPersianDateString(d);
            var dayOrders = all30
                .Where(o => (o.OrderDate != default ? o.OrderDate.Date : o.CreatedAt.Date) == d)
                .ToList();

            var daySales = dayOrders.Sum(o => o.FinalAmount);
            salesTrendLabels.Add(label);
            salesTrendValues.Add(daySales);
            ordersDailyLabels.Add(label);
            ordersDailyValues.Add(dayOrders.Count);

            var dayChance = dayOrders.Where(o => o.OrderType == 2).Sum(o => o.FinalAmount);
            chanceDailyLabels.Add(label);
            chanceDailyValues.Add(dayChance);

            if (d == today)
            {
                salesTodayAmount = daySales;
                salesTodayCount = dayOrders.Count;
            }
        }

        sales7DaysAmount = salesTrendValues.Skip(Math.Max(0, salesTrendValues.Count - 7)).Sum();

        // Order status this month (all types)
        var monthAllPending = await SafeOrders(monthStart, monthEnd, null, statusPending, maxRows);
        var monthAllRejected = await SafeOrders(monthStart, monthEnd, null, statusRejected, maxRows);
        ordersPendingMonth = monthAllPending.Count;
        ordersCompletedMonth = salesMonthCount;
        ordersRejectedMonth = monthAllRejected.Count;
        ordersTotalMonth = ordersPendingMonth + ordersCompletedMonth + ordersRejectedMonth;

        var pendingList = await OrderService.GetPendingOrdersAsync(null);
        pendingOrdersCount = pendingList?.Count ?? 0;

        try
        {
            lowStockCount = adminUserId > 0
                ? await InventoryStockService.CountLowStockForUserAsync(adminUserId)
                : await InventoryStockService.CountLowStockAsync(null);
        }
        catch { lowStockCount = 0; }

        try
        {
            var siteId = EffectiveSiteId();
            commerceKpis = await CommerceService.GetDashboardKpisAsync(siteId);
        }
        catch { commerceKpis = null; }

        // Coupons
        try
        {
            var usages = await CouponService.GetUsageReportForAdminAsync(null, null) ?? new List<CouponUsageReportDto>();
            var monthUsages = usages.Where(u => u.UsedAt.Date >= monthStart && u.UsedAt.Date <= monthEnd).ToList();
            couponUsagesMonth = monthUsages.Count;
            couponDiscountMonth = monthUsages.Sum(u => u.DiscountAmount);

            var last30Usages = usages.Where(u => u.UsedAt.Date >= from30 && u.UsedAt.Date <= today).ToList();
            var top = last30Usages
                .GroupBy(u => string.IsNullOrWhiteSpace(u.CouponCode) ? ("#" + u.CoponID) : u.CouponCode!)
                .Select(g => new { Code = g.Key, Count = g.Count() })
                .OrderByDescending(x => x.Count)
                .Take(5)
                .ToList();
            topCouponLabels = top.Select(t => t.Code).ToList();
            topCouponValues = top.Select(t => t.Count).ToList();

            var active = await CouponService.GetAllActiveAsync();
            activeCouponCount = active?.Count ?? 0;
            var pending = await CouponService.GetAllPendingAsync();
            pendingCouponCount = pending?.Count ?? 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine("Coupon stats: " + ex.Message);
        }

        // Chance box stores
        try
        {
            var storesCb = await ChanceBoxService.GetAdminStoresWithChanceBoxAsync(null);
            chanceBoxStoreCount = storesCb?.Count ?? 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine("ChanceBox stores: " + ex.Message);
        }

        await LoadUsersAndSystemAsync(today, from30, monthStart);
        await LoadTicketsAsync();
        await LoadSupportChatAsync();
        await LoadProjectsAsync();
        await LoadPointsLoyaltyAsync();
    }

    private async Task LoadUsersAndSystemAsync(DateTime today, DateTime from30, DateTime monthStart)
    {
        try
        {
            userTotalCount = await UserService.CountAsync();
            var users = await UserService.GetUsersAsync("") ?? new List<UserDto>();
            var siteFilter = EffectiveSiteId();
            if (siteFilter.HasValue)
                users = users.Where(u => u.SiteId == null || u.SiteId == siteFilter.Value).ToList();
            else if (!hasFullSiteAccess && allowedSiteIds.Count > 0)
                users = users.Where(u => u.SiteId == null || allowedSiteIds.Contains(u.SiteId.Value)).ToList();
            userTotalCount = users.Count;
            userActiveCount = users.Count(u => u.IsActive);
            userInactiveCount = users.Count(u => !u.IsActive);

            var roleGroups = users
                .GroupBy(u => string.IsNullOrWhiteSpace(u.RoleName) ? "بدون نقش" : u.RoleName.Trim())
                .Select(g => new { Name = TranslateRole(g.Key), Count = g.Count() })
                .OrderByDescending(x => x.Count)
                .Take(6)
                .ToList();
            userRoleLabels = roleGroups.Select(r => r.Name).ToList();
            userRoleValues = roleGroups.Select(r => r.Count).ToList();

            userRegLabels.Clear();
            userRegValues.Clear();
            for (var d = from30; d <= today; d = d.AddDays(1))
            {
                userRegLabels.Add(PersianDateHelper.ToPersianDateString(d));
                userRegValues.Add(users.Count(u => u.CreatedAt.Date == d));
            }

            try
            {
                userOnlineCount = await ActivityService.GetOnlineUserCountAsync();
                var loginStats = await ActivityService.GetDailyLoginStatsAsync(14) ?? new List<DailyLoginStat>();
                userTodayLogins = loginStats.FirstOrDefault(s => s.Date.Date == today)?.UniqueLogins ?? 0;
                loginTrendLabels = loginStats.OrderBy(s => s.Date).Select(s => PersianDateHelper.ToPersianDateString(s.Date)).ToList();
                loginTrendValues = loginStats.OrderBy(s => s.Date).Select(s => s.UniqueLogins).ToList();
            }
            catch (Exception ex)
            {
                Console.WriteLine("Activity: " + ex.Message);
            }

            var allStores = await StoreService.GetAllAsync() ?? new List<Store>();
            var sf = EffectiveSiteId();
            if (sf.HasValue)
                allStores = allStores.Where(s => s.SiteId == null || s.SiteId == sf.Value).ToList();
            else if (!hasFullSiteAccess && allowedSiteIds.Count > 0)
                allStores = allStores.Where(s => s.SiteId == null || allowedSiteIds.Contains(s.SiteId.Value)).ToList();
            sysStoreTotal = allStores.Count;
            sysStoreActive = allStores.Count(s => s.StoreStat);
            sysStorePending = allStores.Count(s => !s.StoreStat);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Users/system: " + ex.Message);
        }
    }

