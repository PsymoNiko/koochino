    private async Task LoadProjectsAsync()
    {
        try
        {
            var projects = await ProjectService.GetAllAsync() ?? new List<ProjectDto>();
            projectTotalCount = projects.Count;
            projectActiveCount = projects.Count(p =>
                string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase));
            projectAvgProgress = projects.Count == 0
                ? 0
                : (int)Math.Round(projects.Average(p => (double)p.Progress));

            // refresh stale progress for active projects (cap for performance)
            foreach (var p in projects.Where(x =>
                         string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase) ||
                         string.Equals(x.Status, "Planning", StringComparison.OrdinalIgnoreCase))
                     .Take(20))
            {
                try
                {
                    var refreshed = await ProjectBoardService.RecalculateProgressAsync(p.Id);
                    p.Progress = refreshed;
                }
                catch { /* ignore per-project recalc failures */ }
            }
            if (projects.Count > 0)
                projectAvgProgress = (int)Math.Round(projects.Average(p => (double)p.Progress));

            var statusMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["Planning"] = "برنامه‌ریزی",
                ["Active"] = "فعال",
                ["OnHold"] = "متوقف",
                ["Done"] = "تمام‌شده",
                ["Completed"] = "تمام‌شده"
            };
            var statusGroups = projects
                .GroupBy(p => string.IsNullOrWhiteSpace(p.Status) ? "نامشخص" : p.Status.Trim())
                .Select(g => new
                {
                    Name = statusMap.TryGetValue(g.Key, out var fa) ? fa : g.Key,
                    Count = g.Count()
                })
                .OrderByDescending(x => x.Count)
                .ToList();
            projectStatusLabels = statusGroups.Select(x => x.Name).ToList();
            projectStatusValues = statusGroups.Select(x => x.Count).ToList();

            var phaseAgg = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            taskTodoCount = taskDoingCount = taskDoneCount = 0;
            phaseTotalCount = 0;
            taskTotalCount = 0;

            // limit board fetches for performance
            foreach (var p in projects.Take(40))
            {
                try
                {
                    var board = await ProjectBoardService.GetBoardAsync(p.Id);
                    if (board == null) continue;

                    phaseTotalCount += board.Phases?.Count ?? 0;
                    var tasks = new List<ProjectTaskItem>();
                    if (board.Phases != null)
                    {
                        foreach (var ph in board.Phases)
                        {
                            var title = string.IsNullOrWhiteSpace(ph.Title) ? "بدون عنوان" : ph.Title.Trim();
                            var cnt = ph.Tasks?.Count ?? 0;
                            if (!phaseAgg.ContainsKey(title)) phaseAgg[title] = 0;
                            phaseAgg[title] += cnt;
                            if (ph.Tasks != null) tasks.AddRange(ph.Tasks);
                        }
                    }
                    if (board.UnphasedTasks != null)
                    {
                        tasks.AddRange(board.UnphasedTasks);
                        if (board.UnphasedTasks.Count > 0)
                        {
                            if (!phaseAgg.ContainsKey("بدون فاز")) phaseAgg["بدون فاز"] = 0;
                            phaseAgg["بدون فاز"] += board.UnphasedTasks.Count;
                        }
                    }

                    taskTotalCount += tasks.Count;
                    foreach (var t in tasks)
                    {
                        var st = (t.Status ?? "Todo").Trim();
                        if (st.Equals("Done", StringComparison.OrdinalIgnoreCase) || t.CompletedAt.HasValue)
                            taskDoneCount++;
                        else if (st.Equals("Doing", StringComparison.OrdinalIgnoreCase) || st.Equals("InProgress", StringComparison.OrdinalIgnoreCase))
                            taskDoingCount++;
                        else
                            taskTodoCount++;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Project board {p.Id}: {ex.Message}");
                }
            }

            var topPhases = phaseAgg.OrderByDescending(kv => kv.Value).Take(8).ToList();
            phaseLabels = topPhases.Select(kv => kv.Key).ToList();
            phaseValues = topPhases.Select(kv => kv.Value).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Projects: " + ex.Message);
        }
    }

    private async Task LoadPointsLoyaltyAsync()
    {
        if (!IsWidgetVisible("points-loyalty")) return;
        try
        {
            pts = await PointService.GetLoyaltyDashboardAsync() ?? new PointsLoyaltyDashboardDto();
            var decided = pts.TxApprovedMonth + pts.TxRejectedMonth;
            ptsApproveRate = decided > 0 ? (int)Math.Round(100.0 * pts.TxApprovedMonth / decided) : 0;
            ptsAvgApproved = pts.TxApprovedMonth > 0
                ? NumberFormatHelper.Format((long)Math.Round((double)pts.PointsApprovedMonth / pts.TxApprovedMonth))
                : "—";
        }
        catch (Exception ex)
        {
            Console.WriteLine("Points loyalty: " + ex.Message);
            pts = new PointsLoyaltyDashboardDto();
        }
    }

    private static string TranslateRole(string role)
    {
        if (string.IsNullOrWhiteSpace(role)) return "بدون نقش";
        var r = role.ToLowerInvariant();
        if (r.Contains("admin")) return "ادمین";
        if (r.Contains("shop") || r.Contains("store") || r.Contains("فروش")) return "فروشگاه‌دار";
        if (r.Contains("customer") || r.Contains("مشتری")) return "مشتری";
        return role;
    }

