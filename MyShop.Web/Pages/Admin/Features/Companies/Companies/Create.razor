@page "/admin/companies/create"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Companies
@using MyShop.Core.Models.Companies
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding: 24px;">
    <h1 class="page-title">ایجاد شرکت</h1>
    @if (!string.IsNullOrEmpty(message)) { <div class="alert @(message.Contains("موفق") ? "alert-success" : "alert-danger")" style="padding: 12px; border-radius: 8px; margin-bottom: 16px;">@message</div> }
    @if (holdings.Count == 0) { <p class="text-muted">ابتدا یک هلدینگ ایجاد کنید. <a href="/admin/holdings/create">ایجاد هلدینگ</a></p> }
    else
    {
        <EditForm Model="@model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="form-group"><label>هلدینگ</label><InputSelect @bind-Value="model.HoldingId" class="form-control">@foreach (var h in holdings) { <option value="@h.Id">@h.Name</option> }</InputSelect></div>
            <div class="form-group"><label>کد</label><InputText @bind-Value="model.Code" class="form-control" /></div>
            <div class="form-group"><label>نام</label><InputText @bind-Value="model.Name" class="form-control" /></div>
            <div class="form-group"><label>آدرس</label><InputTextArea @bind-Value="model.Address" class="form-control" rows="2" /></div>
            <div class="form-group"><label>تلفن</label><InputText @bind-Value="model.Phone" class="form-control" /></div>
            <div class="form-group"><label>توضیحات</label><InputTextArea @bind-Value="model.Description" class="form-control" rows="2" /></div>
            <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="form-group"><label>فعال</label><InputCheckbox @bind-Value="model.IsActive" class="form-control" /></div>
                <div class="form-group"><label>ترتیب</label><InputNumber @bind-Value="model.SortOrder" class="form-control" /></div>
            </div>
            <div style="display: flex; gap: 12px; margin-top: 20px;"><button type="submit" class="btn-primary">ذخیره</button><a href="/admin/companies" class="btn-secondary">انصراف</a></div>
        </EditForm>
    }
</div>
@code {
    [Inject] private IHoldingService HoldingService { get; set; }
    [Inject] private ICompanyService Service { get; set; }
    [Inject] private NavigationManager Nav { get; set; }
    private List<HoldingDto> holdings = new();
    private CreateCompanyDto model = new CreateCompanyDto { IsActive = true };
    private string message = "";
    protected override async Task OnInitializedAsync() { holdings = await HoldingService.GetAllAsync(null) ?? new List<HoldingDto>(); if (holdings.Count > 0 && model.HoldingId == 0) model.HoldingId = holdings[0].Id; }
    private async Task Submit() { message = ""; var id = await Service.CreateAsync(model); if (id > 0) { message = "شرکت با موفقیت ایجاد شد."; Nav.NavigateTo("/admin/companies"); } else message = "خطا در ایجاد."; }
}
