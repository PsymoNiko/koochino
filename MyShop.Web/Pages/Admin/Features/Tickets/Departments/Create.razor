@page "/admin/tickets/departments/create"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Tickets
@using MyShop.Core.Models.Tickets
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding: 24px;">
    <h1 class="page-title">ایجاد دپارتمان تیکت</h1>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(message.Contains("موفق") ? "alert-success" : "alert-danger")" style="padding: 12px; border-radius: 8px; margin-bottom: 16px;">@message</div>
    }

    <EditForm Model="@model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <div class="form-group">
            <label>نام دپارتمان *</label>
            <InputText @bind-Value="model.Name" class="form-control" />
        </div>
        <div class="form-group">
            <label>توضیحات</label>
            <InputTextArea @bind-Value="model.Description" class="form-control" rows="3" />
        </div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="form-group">
                <label>ایمیل</label>
                <InputText @bind-Value="model.Email" class="form-control" />
            </div>
            <div class="form-group">
                <label>ترتیب نمایش</label>
                <InputNumber @bind-Value="model.SortOrder" class="form-control" />
            </div>
        </div>
        <div class="form-group">
            <label><InputCheckbox @bind-Value="model.IsActive" /> فعال</label>
        </div>
        <div style="display: flex; gap: 12px; margin-top: 20px;">
            <button type="submit" class="btn-primary">ذخیره</button>
            <a href="/admin/tickets/departments" class="btn-secondary">انصراف</a>
        </div>
    </EditForm>
</div>

@code {
    [Inject] private ITicketService Service { get; set; }
    [Inject] private NavigationManager Nav { get; set; }

    private CreateTicketDepartmentDto model = new CreateTicketDepartmentDto { IsActive = true };
    private string message = "";

    private async Task Submit()
    {
        message = "";
        if (string.IsNullOrWhiteSpace(model.Name))
        {
            message = "نام دپارتمان الزامی است.";
            return;
        }
        var id = await Service.CreateDepartmentAsync(model);
        if (id > 0)
            Nav.NavigateTo("/admin/tickets/departments");
        else
            message = "خطا در ایجاد دپارتمان.";
    }
}
