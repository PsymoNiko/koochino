        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
    }

    .btn-primary {
        background: #dc2626;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        cursor: pointer;
    }

    .btn-primary:hover {
        background: #b91c1c;
    }

    .btn-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-secondary {
        background: #6b7280;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        cursor: pointer;
    }

    .btn-secondary:hover {
        background: #4b5563;
    }

    .usage-report-section { padding: 20px; background: white; border-radius: 8px; margin-top: 16px; }
    .usage-filters { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-bottom: 20px; }
    .filter-input { width: 180px; }
    .filter-select { min-width: 200px; }
</style>

@code {
    [CascadingParameter] public AdminAuthState Auth { get; set; }
    private List<Coupon> coupons = new();
    private List<Coupon> allCoupons = new();
    private List<Coupon> allCouponsForFilter = new();
    private Coupon currentCoupon = new();
    private Coupon editingCoupon;
    private bool loading = true;
    private bool saving = false;
    private bool showForm = false;
    private string message = "";
    private string filterType = "pending";
    private int pendingCount = 0;
    private List<CouponUsageReportDto> usageReport = new();
    private bool usageReportLoading;
    private int? usageFilterUserId;
    private int usageFilterCoponId;
    // Amount formatting
    private string formattedMinBuy = "";
    private string formattedMaxBuy = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/Account/login-admin", true);
            return;
        }

        var uid = int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
        if (uid <= 0 || !await AdminPerms.HasAsync(uid, "Shop", AdminPermissionActions.Read))
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        await LoadCoupons();
    }

    private async Task LoadCoupons()
    {
        loading = true;
        message = "";
        try
        {
            var pending = await CouponService.GetAllPendingAsync();
            pendingCount = pending.Count;
            
            if (filterType == "pending")
            {
                coupons = pending;
            }
            else
            {
                try
                {
                    coupons = await CouponService.GetAllAsync();
                }
                catch (Exception ex)
                {
                    // Fallback: اگر GetAllAsync خطا داد، از ترکیب pending و active استفاده می‌کنیم
                    var active = await CouponService.GetAllActiveAsync();
                    var allCouponsList = new List<Coupon>();
                    allCouponsList.AddRange(pending);
                    allCouponsList.AddRange(active);
                    // حذف تکراری‌ها بر اساس CoponID
                    coupons = allCouponsList.GroupBy(c => c.CoponID).Select(g => g.First()).OrderByDescending(c => c.CoponInsertDate).ToList();
                    
                    if (coupons.Count == 0)
                    {
                        message = $"خطا در بارگذاری همه کوپن‌ها. لطفاً Stored Procedure spCopon_GetAll را در دیتابیس اجرا کنید. خطا: {ex.Message}";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            message = $"خطا در بارگذاری کوپن‌ها: {ex.Message}";
            coupons = new List<Coupon>();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SetFilter(string type)
    {
        filterType = type;
        if (type == "usage")
        {
            if (allCouponsForFilter.Count == 0)
                allCouponsForFilter = (await CouponService.GetAllAsync()) ?? new List<Coupon>();
            await LoadUsageReport();
        }
        else
        {
            await LoadCoupons();
        }
    }

    private async Task LoadUsageReport()
    {
        usageReportLoading = true;
        try
        {
            usageReport = await CouponService.GetUsageReportForAdminAsync(
                usageFilterUserId > 0 ? usageFilterUserId : null,
                usageFilterCoponId > 0 ? usageFilterCoponId : null) ?? new List<CouponUsageReportDto>();
        }
        finally
        {
            usageReportLoading = false;
        }
    }

    private void EditCoupon(Coupon coupon)
    {
        editingCoupon = coupon;
        currentCoupon = new Coupon
        {
            CoponID = coupon.CoponID,
            CoponTitle = coupon.CoponTitle,
            CoponCode = coupon.CoponCode ?? "",
            StoreID = coupon.StoreID,
            StoreName = coupon.StoreName ?? "",
            UserID = coupon.UserID,
            CoponStock = coupon.CoponStock,
            CoponMinBuy = coupon.CoponMinBuy,
            CoponMaxBuy = coupon.CoponMaxBuy,
            CoponStartDate = coupon.CoponStartDate,
            CoponExpireDate = coupon.CoponExpireDate,
            CoponStatStor = coupon.CoponStatStor,
            CoponStatAdmin = coupon.CoponStatAdmin,
            DiscountType = coupon.DiscountType,
            DiscountValue = coupon.DiscountValue
        };
        formattedMinBuy = FormatAmountString(currentCoupon.CoponMinBuy);
        formattedMaxBuy = FormatAmountString(currentCoupon.CoponMaxBuy);
        showForm = true;
        message = "";
    }

    private void HideForm()
    {
        showForm = false;
        currentCoupon = new Coupon();
        editingCoupon = null;
        formattedMinBuy = "";
        formattedMaxBuy = "";
        message = "";
    }
    
    private void OnMinBuyInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        var digitsOnly = new string(input.Where(char.IsDigit).ToArray());
        
        if (long.TryParse(digitsOnly, out long amount))
        {
            currentCoupon.CoponMinBuy = amount.ToString();
            formattedMinBuy = NumberFormatHelper.Format(amount.ToString());
        }
        else if (string.IsNullOrEmpty(digitsOnly))
        {
            currentCoupon.CoponMinBuy = "";
            formattedMinBuy = "";
        }
        
        StateHasChanged();
    }
    
    private void OnMaxBuyInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        var digitsOnly = new string(input.Where(char.IsDigit).ToArray());
        
        if (long.TryParse(digitsOnly, out long amount))
        {
            currentCoupon.CoponMaxBuy = amount.ToString();
            formattedMaxBuy = NumberFormatHelper.Format(amount.ToString());
        }
        else if (string.IsNullOrEmpty(digitsOnly))
        {
            currentCoupon.CoponMaxBuy = "";
            formattedMaxBuy = "";
        }
        
        StateHasChanged();
    }
    
    private string FormatAmountString(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";
        
        var numbersOnly = new string(value.Where(char.IsDigit).ToArray());
        if (string.IsNullOrEmpty(numbersOnly))
            return "";
        
        if (long.TryParse(numbersOnly, out long number))
        {
            return number.ToString("#,##0");
        }
        
        return value;
    }

    private async Task SaveCoupon()
    {
        saving = true;
        message = "";

        try
        {
            currentCoupon.CoponCode = (currentCoupon.CoponCode ?? "").Trim().ToUpperInvariant();
            if (currentCoupon.CoponCode.Length > 10) currentCoupon.CoponCode = currentCoupon.CoponCode.Substring(0, 10);
            if (currentCoupon.CoponStartDate.HasValue && currentCoupon.CoponExpireDate < currentCoupon.CoponStartDate.Value)
            {
                message = "تاریخ انقضا باید بعد از تاریخ شروع باشد";
                saving = false;
                return;
            }
            var success = await CouponService.UpdateAsync(currentCoupon);
            if (success)
            {
                message = "کوپن با موفقیت به‌روزرسانی شد";
                await LoadCoupons();
                await Task.Delay(1500);
                HideForm();
            }
            else
            {
                message = "خطا در به‌روزرسانی کوپن";
            }
        }
        catch (InvalidOperationException ex) when (ex.Message == "DUPLICATE_COUPON_CODE")
        {
            message = "این کد کوپن قبلاً ثبت شده است. کد دیگری انتخاب کنید.";
        }
        catch
        {
            message = "خطا در ذخیره کوپن";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ApproveCoupon(int couponId, bool approved)
    {
        try
        {
            var success = await CouponService.ApproveByAdminAsync(couponId, approved);
            if (success)
            {
                message = approved ? "کوپن تایید شد" : "کوپن رد شد";
                // به‌روزرسانی pendingCount
                var pending = await CouponService.GetAllPendingAsync();
                pendingCount = pending.Count;
                // بارگذاری مجدد کوپن‌ها بر اساس فیلتر فعلی
                await LoadCoupons();
            }
            else
            {
                message = "خطا در تغییر وضعیت";
            }
        }
        catch
        {
            message = "خطا در تغییر وضعیت";
        }
    }

    private async Task DeleteCoupon(int couponId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "آیا از حذف این کوپن اطمینان دارید؟"))
        {
            return;
        }

        try
        {
            var success = await CouponService.DeleteAsync(couponId);
            if (success)
            {
                message = "کوپن با موفقیت حذف شد";
                await LoadCoupons();
            }
            else
            {
                message = "خطا در حذف کوپن";
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private string GetDiscountSummary(Coupon c)
    {
        if (c.DiscountValue.HasValue)
            return c.DiscountType == 1 ? $"{c.DiscountValue}٪" : $"{NumberFormatHelper.Format(c.DiscountValue.Value)} تومان";
        if (c.DiscountPercent.HasValue)
            return $"{c.DiscountPercent}٪";
        if (c.DiscountAmount.HasValue)
            return $"{NumberFormatHelper.Format(c.DiscountAmount.Value)} تومان";
        return "-";
    }
}
