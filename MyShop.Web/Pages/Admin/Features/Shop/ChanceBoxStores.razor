    }

    .search-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        margin-bottom: 24px;
    }
    .search-bar .search-input {
        flex: 1;
        min-width: 220px;
        padding: 10px 14px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 14px;
        direction: rtl;
    }
    .search-bar .search-input:focus {
        outline: none;
        border-color: #dc2626;
    }
    .search-bar .btn-search {
        padding: 10px 20px;
        background: #dc2626;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 500;
    }
    .search-bar .btn-search:hover {
