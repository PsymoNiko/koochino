    }

    .table-wrap {
        overflow-x: auto;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        border: 1px solid #e5e7eb;
    }
    .data-table {
        width: 100%;
        border-collapse: collapse;
