@page "/admin/chancebox-stores"
@layout AdminLayout

@using MyShop.Core.Models.Dto
@using MyShop.Application.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject IChanceBoxService ChanceBoxService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<div class="container-content" dir="rtl" lang="fa">
    <div class="chancebox-header">
        <h2>جعبه شانس فروشگاه‌ها</h2>
        <p class="subtitle">لیست مغازه‌دارانی که جعبه شانس تعریف کرده‌اند</p>
    </div>

    <div class="search-bar">
        <input type="text"
               class="search-input"
               placeholder="جستجو بر اساس نام فروشگاه یا کد شانس..."
               @bind="searchText"
               @bind:event="oninput"
               @onkeypress="@(e => { if (e.Key == "Enter") Search(); })" />
        <button type="button" class="btn-search" @onclick="Search">🔍 جستجو</button>
        @if (!string.IsNullOrEmpty(searchText))
        {
            <button type="button" class="btn-clear" @onclick="ClearSearch">پاک کردن</button>
        }
    </div>

    @if (loading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else if (items == null || items.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🎲</div>
            <h3>هیچ فروشگاهی با جعبه شانس یافت نشد</h3>
            <p>@(string.IsNullOrWhiteSpace(searchText) ? "هنوز مغازه‌داری جعبه شانس تعریف نکرده است." : "با معیار جستجوی فعلی موردی یافت نشد.")</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>نام فروشگاه</th>
                        <th>مالک</th>
                        <th>کد شانس (نمونه)</th>
                        <th>تعداد کدها</th>
                        <th>تعداد استفاده کاربران</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in items)
                    {
                        <tr>
                            <td><strong>@row.StoreName</strong></td>
                            <td>@row.OwnerName</td>
                            <td>@(row.SampleCode ?? "-")</td>
                            <td>@row.TotalCodes</td>
                            <td>@row.UsageCount</td>
                            <td>
                                <button type="button" class="btn-more" @onclick="@(() => OpenUsages(row))">
                                    مشاهده بیشتر
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* مودال مشاهده استفاده‌ها *@
@if (showUsagesModal && selectedStore != null)
{
    <div class="modal-overlay" @onclick="CloseUsagesModal">
        <div class="modal-content usages-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>استفاده‌های جعبه شانس — @selectedStore.StoreName</h3>
                <button type="button" class="modal-close" @onclick="CloseUsagesModal">×</button>
            </div>
            <div class="modal-body">
                @if (usagesLoading)
                {
                    <p class="text-muted">در حال بارگذاری...</p>
                }
                else if (usagesList == null || usagesList.Count == 0)
                {
                    <p class="text-muted">هنوز کاربری از جعبه شانس این فروشگاه استفاده نکرده است.</p>
                }
                else
                {
                    <div class="usages-list">
                        @foreach (var u in usagesList)
                        {
                            <div class="usage-card">
                                <div class="usage-row">
                                    <span class="usage-label">کاربر:</span>
                                    <span>@u.UserName</span>
                                </div>
                                <div class="usage-row">
                                    <span class="usage-label">زمان:</span>
                                    <span>@PersianDateHelper.ToPersianDateTimeString(u.UsedAt)</span>
                                </div>
                                <div class="usage-row">
                                    <span class="usage-label">مبلغ خرید:</span>
                                    <span>@NumberFormatHelper.Format(u.PurchaseAmount) تومان</span>
                                </div>
                                <div class="usage-row">
                                    <span class="usage-label">کد:</span>
                                    <span>@u.Code</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(u.Description))
                                {
                                    <div class="usage-row usage-desc">
                                        <span class="usage-label">توضیحات جعبه:</span>
                                        <span>@u.Description</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(u.PrizeDescription))
                                {
                                    <div class="usage-row usage-desc">
                                        <span class="usage-label">توضیح جایزه:</span>
                                        <span>@u.PrizeDescription</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    List<AdminChanceBoxStoreDto>? items = new();
    string searchText = "";
    bool loading = true;
    bool _loaded;

    AdminChanceBoxStoreDto? selectedStore;
    List<ChanceBoxUsageDetailDto>? usagesList;
    bool showUsagesModal;
    bool usagesLoading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded) return;
        _loaded = true;
        await LoadData();
    }

    async Task LoadData()
    {
        loading = true;
        try
        {
            var search = string.IsNullOrWhiteSpace(searchText) ? null : searchText.Trim();
            items = (await ChanceBoxService.GetAdminStoresWithChanceBoxAsync(search)) ?? new List<AdminChanceBoxStoreDto>();
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    void Search()
    {
        _ = LoadData();
    }

    void ClearSearch()
    {
        searchText = "";
        _ = LoadData();
    }

    async Task OpenUsages(AdminChanceBoxStoreDto store)
    {
        selectedStore = store;
        showUsagesModal = true;
        usagesLoading = true;
        usagesList = null;
        StateHasChanged();

        try
        {
            usagesList = (await ChanceBoxService.GetUsagesByStoreIdForAdminAsync(store.StoreId)) ?? new List<ChanceBoxUsageDetailDto>();
        }
        finally
        {
            usagesLoading = false;
            StateHasChanged();
        }
    }

    void CloseUsagesModal()
    {
        showUsagesModal = false;
        selectedStore = null;
        usagesList = null;
    }

}

<style>
    .chancebox-header {
        margin-bottom: 24px;
    }
    .chancebox-header h2 {
        margin: 0 0 8px 0;
        font-size: 1.5rem;
        color: #1f2937;
    }
    .chancebox-header .subtitle {
        margin: 0;
        color: #6b7280;
