        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid #e5e7eb;
        background: #fef2f2;
    }
    .modal-header h3 {
        margin: 0;
        font-size: 1.1rem;
        color: #1f2937;
    }
    .modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #6b7280;
