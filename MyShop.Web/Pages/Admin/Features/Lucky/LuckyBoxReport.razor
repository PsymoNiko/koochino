@page "/admin/lucky-box-report"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using MyShop.Application.Interfaces.Lucky
@using MyShop.Core.Helpers
@using MyShop.Core.Models.Lucky
@inject ILuckyLeagueService LuckyService

<div class="container-content" dir="rtl">
    <h2>گزارش باز کردن جعبه شانس</h2>
    <p class="hint">هر بار که مشتری جعبه‌ای را در لیگ شانس باز می‌کند، اینجا ثبت می‌شود — برندگان، پوچ‌ها و جزئیات جایزه.</p>

    <div class="stats-row">
        <div class="stat-card">
            <span class="stat-label">کل بازشده</span>
            <span class="stat-value">@stats.TotalOpened.ToString("N0", CultureInfo.InvariantCulture)</span>
        </div>
        <div class="stat-card win">
            <span class="stat-label">برندگان</span>
            <span class="stat-value">@stats.WinnersCount.ToString("N0", CultureInfo.InvariantCulture)</span>
        </div>
        <div class="stat-card lose">
            <span class="stat-label">پوچ</span>
            <span class="stat-value">@stats.LosersCount.ToString("N0", CultureInfo.InvariantCulture)</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">نرخ برد</span>
            <span class="stat-value">@stats.WinRatePercent.ToString("N1", CultureInfo.InvariantCulture)%</span>
        </div>
    </div>

    <div class="filter-card">
        <div class="filter-grid">
            <label>نتیجه
                <select @bind="outcomeFilter" @bind:after="ReloadAsync">
                    <option value="All">همه</option>
                    <option value="Winners">کاربران برنده</option>
                    <option value="Losers">کاربران پوچ</option>
                </select>
            </label>
            <label>لیگ
                <select @bind="leagueIdFilter" @bind:after="ReloadAsync">
                    <option value="0">همه لیگ‌ها</option>
                    @foreach (var l in leagues)
                    {
                        <option value="@l.Id">@LuckyLeagueTheme.GetDisplayName(l.ThemeKey, l.Name)</option>
                    }
                </select>
            </label>
            <label>از تاریخ
                <input type="date" @bind="fromDate" @bind:after="ReloadAsync" />
            </label>
            <label>تا تاریخ
                <input type="date" @bind="toDate" @bind:after="ReloadAsync" />
            </label>
            <label>جستجو (نام / موبایل / جایزه)
                <input @bind="searchText" @bind:event="oninput" placeholder="مثلاً 0938..." @onkeypress="OnSearchKey" />
            </label>
        </div>
        <button class="btn btn-primary" @onclick="ReloadAsync">اعمال فیلتر</button>
    </div>

    @if (loading)
    {
        <p class="loading-text">در حال بارگذاری...</p>
    }
    else if (rows.Count == 0)
    {
        <div class="empty">هنوز جعبه‌ای باز نشده یا با فیلتر فعلی موردی نیست.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>زمان</th>
                        <th>کاربر</th>
                        <th>موبایل</th>
                        <th>لیگ</th>
                        <th>نتیجه</th>
                        <th>جایزه</th>
                        <th>پرداخت</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        <tr class="@(r.IsLosing ? "row-lose" : "row-win")">
                            <td>@r.OpenedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm", CultureInfo.InvariantCulture)</td>
                            <td>@(r.Username ?? "—") <small class="muted">#@r.UserId</small></td>
                            <td>@(r.PhoneNumber ?? "—")</td>
                            <td>@LuckyLeagueTheme.GetDisplayName(r.ThemeKey, r.LeagueName)</td>
                            <td>
                                <span class="badge @(r.IsLosing ? "badge-lose" : "badge-win")">@r.OutcomeLabel</span>
                            </td>
                            <td>@r.PrizeDisplay</td>
                            <td>
                                @if (string.Equals(r.PaymentMethod, "Chance", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span>شانس</span>
                                }
                                else
                                {
                                    <span>@(r.PointsSpent?.ToString("N0", CultureInfo.InvariantCulture) ?? "—") امتیاز</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (hasMore)
        {
            <button class="btn" style="margin-top:12px;" @onclick="LoadMore" disabled="@loadingMore">بارگذاری بیشتر</button>
        }
    }
</div>

<style>
.container-content{max-width:1200px;margin:0 auto;padding:16px}
.hint{color:#6b7280;font-size:.9rem;margin-bottom:16px}
.stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:16px}
.stat-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:14px;display:flex;flex-direction:column;gap:4px}
.stat-card.win{border-color:#86efac;background:#f0fdf4}
.stat-card.lose{border-color:#fecaca;background:#fef2f2}
.stat-label{font-size:.8rem;color:#6b7280}
.stat-value{font-size:1.35rem;font-weight:700;color:#111827}
.filter-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:16px;margin-bottom:16px}
.filter-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:12px}
.filter-grid label{display:flex;flex-direction:column;gap:4px;font-size:.85rem;color:#374151}
.filter-grid input,.filter-grid select{padding:8px 10px;border:1px solid #d1d5db;border-radius:8px}
.table-wrap{overflow:auto;background:#fff;border:1px solid #e5e7eb;border-radius:12px}
.table{width:100%;border-collapse:collapse;font-size:.9rem}
.table th,.table td{padding:10px 12px;text-align:right;border-bottom:1px solid #f3f4f6}
.table th{background:#f9fafb;font-weight:600;color:#374151}
.badge{display:inline-block;padding:2px 10px;border-radius:999px;font-size:.8rem;font-weight:600}
.badge-win{background:#dcfce7;color:#166534}
.badge-lose{background:#fee2e2;color:#991b1b}
.muted{color:#9ca3af}
.empty,.loading-text{padding:24px;text-align:center;color:#6b7280}
.btn{padding:8px 16px;border-radius:8px;border:1px solid #d1d5db;background:#fff;cursor:pointer}
.btn-primary{background:#2563eb;color:#fff;border-color:#2563eb}
</style>

@code {
    const int PageSize = 50;

    List<LuckyLeague> leagues = new();
    List<LuckyBoxOpenReportRow> rows = new();
    LuckyBoxOpenReportStats stats = new();
    bool loading = true;
    bool loadingMore;
    bool hasMore;
    int skip;

    string outcomeFilter = "All";
    int leagueIdFilter;
    string searchText = "";
    DateTime? fromDate;
    DateTime? toDate;

    protected override async Task OnInitializedAsync()
    {
        leagues = await LuckyService.GetAllLeaguesAsync(activeOnly: false) ?? new List<LuckyLeague>();
        await ReloadAsync();
    }

    async Task ReloadAsync()
    {
        loading = true;
        skip = 0;
        rows = new List<LuckyBoxOpenReportRow>();
        try
        {
            var (fromUtc, toUtc) = GetDateRangeUtc();
            var leagueId = leagueIdFilter > 0 ? leagueIdFilter : (int?)null;
            stats = await LuckyService.GetBoxOpenReportStatsAsync(leagueId, outcomeFilter, fromUtc, toUtc, searchText)
                ?? new LuckyBoxOpenReportStats();
            var page = await LuckyService.GetBoxOpenReportAsync(leagueId, outcomeFilter, fromUtc, toUtc, searchText, 0, PageSize)
                ?? new List<LuckyBoxOpenReportRow>();
            rows = page;
            hasMore = page.Count >= PageSize;
        }
        finally
        {
            loading = false;
        }
    }

    async Task LoadMore()
    {
        loadingMore = true;
        try
        {
            skip += PageSize;
            var (fromUtc, toUtc) = GetDateRangeUtc();
            var leagueId = leagueIdFilter > 0 ? leagueIdFilter : (int?)null;
            var page = await LuckyService.GetBoxOpenReportAsync(leagueId, outcomeFilter, fromUtc, toUtc, searchText, skip, PageSize)
                ?? new List<LuckyBoxOpenReportRow>();
            rows.AddRange(page);
            hasMore = page.Count >= PageSize;
        }
        finally
        {
            loadingMore = false;
        }
    }

    (DateTime? fromUtc, DateTime? toUtc) GetDateRangeUtc()
    {
        DateTime? from = fromDate.HasValue
            ? DateTime.SpecifyKind(fromDate.Value.Date, DateTimeKind.Local).ToUniversalTime()
            : null;
        DateTime? to = toDate.HasValue
            ? DateTime.SpecifyKind(toDate.Value.Date.AddDays(1), DateTimeKind.Local).ToUniversalTime()
            : null;
        return (from, to);
    }

    async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ReloadAsync();
    }
}
