@page "/admin/online-users"
@layout AdminLayout
@using MyShop.Application.Interfaces
@using MyShop.Core.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Timers
@implements IAsyncDisposable
@inject IUserActivityService ActivityService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JSRuntime

<div class="online-users-container">
    <div class="page-header">
        <h2>کاربران آنلاین و آمار لاگین</h2>
    </div>

    @if (loading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else
    {
        <!-- آمار کلی -->
        <div class="stats-cards">
            <div class="stat-card stat-card-online">
                <div class="stat-icon">🟢</div>
                <div class="stat-content">
                    <div class="stat-label">کاربران آنلاین</div>
                    <div class="stat-value">@onlineUserCount</div>
                </div>
            </div>
            <div class="stat-card stat-card-info">
                <div class="stat-icon">📊</div>
                <div class="stat-content">
                    <div class="stat-label">لاگین امروز</div>
                    <div class="stat-value">@todayLogins</div>
                </div>
            </div>
            <div class="stat-card stat-card-success">
                <div class="stat-icon">📈</div>
                <div class="stat-content">
                    <div class="stat-label">لاگین این هفته</div>
                    <div class="stat-value">@weekLogins</div>
                </div>
            </div>
        </div>

        <!-- نمودار لاگین روزانه -->
        <div class="chart-card">
            <div class="chart-header">
                <h3>روند لاگین روزانه</h3>
                <button class="test-chart-btn" @onclick="ForceRenderLoginChart" title="رندر مجدد">
                    🔄
                </button>
            </div>
            <div class="chart-body-small">
                @if (loginChartLoading && !loginChartRendered)
                {
                    <div class="chart-loading">
                        <div class="spinner"></div>
                    </div>
                }
                @if (loginChartRendered)
                {
                    <canvas id="dailyLoginChart"></canvas>
                }
            </div>
        </div>

        <!-- لیست کاربران آنلاین -->
        <div class="online-users-card">
            <div class="card-header">
                <h3>کاربران آنلاین</h3>
                <button class="refresh-btn" @onclick="RefreshOnlineUsers">
                    🔄 به‌روزرسانی
                </button>
            </div>
            <div class="card-body">
                @if (onlineUsers == null || onlineUsers.Count == 0)
                {
                    <div class="empty-message">
                        <p>هیچ کاربر آنلاینی وجود ندارد</p>
                    </div>
                }
                else
                {
                    <table class="online-users-table">
                        <thead>
                            <tr>
                                <th>نام کاربری</th>
                                <th>نام</th>
                                <th>نقش</th>
                                <th>آخرین فعالیت</th>
                                <th>تعداد Session</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in onlineUsers)
                            {
                                <tr>
                                    <td>@user.Username</td>
                                    <td>@($"{user.FirstName} {user.LastName}")</td>
                                    <td>@user.RoleName</td>
                                    <td>@(user.LastActivityAt?.ToString("HH:mm:ss") ?? "-")</td>
                                    <td>@user.ActiveSessions</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
</div>

@code {
#nullable enable
    private bool loading = true;
    private int onlineUserCount = 0;
    private int todayLogins = 0;
    private int weekLogins = 0;
    private List<OnlineUser> onlineUsers = new List<OnlineUser>();
    private List<DailyLoginStat> dailyLoginStats = new List<DailyLoginStat>();
    private System.Timers.Timer? refreshTimer;
    
    private bool loginChartLoading = true;
    private bool loginChartRendered = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Nav.NavigateTo("/Account/login-admin", true);
                return;
            }

            var currentRole = authState.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
            if (currentRole != "Admin")
            {
                Nav.NavigateTo("/Account/login-admin", true);
                return;
            }

            await LoadData();
            InitializeAutoRefresh();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OnInitializedAsync: {ex.Message}");
            Nav.NavigateTo("/Account/login-admin", true);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadData()
    {
        try
        {
            onlineUsers = await ActivityService.GetOnlineUsersAsync();
            onlineUserCount = await ActivityService.GetOnlineUserCountAsync();
            dailyLoginStats = await ActivityService.GetDailyLoginStatsAsync(30);
            
            // محاسبه لاگین امروز و این هفته
            var today = DateTime.Now.Date;
            var weekStart = today.AddDays(-(int)today.DayOfWeek);
            
            todayLogins = dailyLoginStats
                .Where(s => s.Date.Date == today)
                .Sum(s => s.UniqueLogins);
            
            weekLogins = dailyLoginStats
                .Where(s => s.Date.Date >= weekStart)
                .Sum(s => s.UniqueLogins);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
    }

    private void InitializeAutoRefresh()
    {
        // به‌روزرسانی خودکار هر 10 ثانیه
        refreshTimer = new System.Timers.Timer(10000); // 10 seconds
        refreshTimer.Elapsed += async (sender, e) =>
        {
            await InvokeAsync(async () =>
            {
                await LoadData();
                StateHasChanged();
            });
        };
        refreshTimer.AutoReset = true;
        refreshTimer.Start();
    }

    private async Task RefreshOnlineUsers()
    {
        await LoadData();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !loading && !loginChartRendered)
        {
            await Task.Delay(2000);
            await RenderLoginChart();
        }
    }

    private async Task ForceRenderLoginChart()
    {
        loginChartRendered = false;
        loginChartLoading = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(300);
        await RenderLoginChart();
    }

    private async Task RenderLoginChart()
    {
        try
        {
            loginChartLoading = false;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(500);

            bool canvasExists = await JSRuntime.InvokeAsync<bool>("checkCanvasExists", "dailyLoginChart");
            if (!canvasExists)
            {
                loginChartRendered = true;
                await InvokeAsync(StateHasChanged);
                return;
            }

            var labels = dailyLoginStats.Select(s => PersianDateHelper.ToPersianDateString(s.Date)).ToArray();
            var values = dailyLoginStats.Select(s => s.UniqueLogins).ToArray();

            await JSRuntime.InvokeVoidAsync("renderDailyLoginChart", labels, values);

            loginChartRendered = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering login chart: {ex.Message}");
            loginChartLoading = false;
            loginChartRendered = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (refreshTimer is not null)
        {
            refreshTimer.Stop();
            refreshTimer.Dispose();
        }
        await Task.CompletedTask;
    }
}

<style>
    .online-users-container {
        padding: 20px;
        direction: rtl;
    }

    .page-header {
        margin-bottom: 30px;
    }

    .page-header h2 {
        font-size: 24px;
        font-weight: 700;
        color: #1f2937;
    }

    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
        border-radius: 16px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 4px 16px rgba(59, 130, 246, 0.15);
    }

    .stat-card-online {
        background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
        box-shadow: 0 4px 16px rgba(16, 185, 129, 0.15);
    }

    .stat-card-success {
        background: linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%);
        box-shadow: 0 4px 16px rgba(139, 92, 246, 0.15);
    }

    .stat-icon {
        font-size: 48px;
    }

    .stat-content {
        flex: 1;
    }

    .stat-label {
        color: rgba(255, 255, 255, 0.95);
        font-size: 14px;
        margin-bottom: 8px;
    }

    .stat-value {
        color: #ffffff;
        font-size: 32px;
        font-weight: 800;
    }

    .online-users-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        margin-top: 30px;
    }

    .card-header {
        background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%);
        padding: 20px 24px;
        border-bottom: 2px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-header h3 {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
        color: #1f2937;
    }

    .refresh-btn {
        background: #3b82f6;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .refresh-btn:hover {
        background: #2563eb;
        transform: translateY(-2px);
    }

    .card-body {
        padding: 0;
    }

    .online-users-table {
        width: 100%;
        border-collapse: collapse;
    }

    .online-users-table thead {
        background: #f9fafb;
    }

    .online-users-table th {
        padding: 12px 16px;
        text-align: right;
        font-size: 13px;
        font-weight: 600;
        color: #6b7280;
        border-bottom: 1px solid #e5e7eb;
    }

    .online-users-table tbody tr {
        border-bottom: 1px solid #f3f4f6;
        transition: background-color 0.15s ease;
    }

    .online-users-table tbody tr:hover {
        background-color: #f9fafb;
    }

    .online-users-table td {
        padding: 12px 16px;
        font-size: 14px;
        color: #374151;
        text-align: right;
    }

    .empty-message {
        padding: 40px 20px;
        text-align: center;
        color: #9ca3af;
    }

    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
    }

    .loading-container .spinner {
        width: 48px;
        height: 48px;
        border: 4px solid #e5e7eb;
        border-top-color: #3b82f6;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-bottom: 16px;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>
