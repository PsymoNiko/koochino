                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("alert",
                    newStatus ? "کاربر با موفقیت فعال شد" : "کاربر با موفقیت غیرفعال شد");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "خطا در تغییر وضعیت کاربر");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا: {ex.Message}");
        }
    }

    private async Task ChangeUserPassword()
    {
        if (selectedUser == null) return;

        passwordMessage = "";
        passwordSuccess = false;

        var pwd = adminNewPassword ?? "";
        var confirm = adminConfirmPassword ?? "";

        if (string.IsNullOrWhiteSpace(pwd) || pwd.Length < 8)
        {
            passwordMessage = "رمز عبور باید حداقل ۸ کاراکتر باشد.";
            StateHasChanged();
            return;
        }
        if (pwd != confirm)
        {
            passwordMessage = "رمز عبور و تکرار آن یکسان نیستند.";
            StateHasChanged();
            return;
        }

        changingPassword = true;
        StateHasChanged();
        try
        {
            var (ok, error) = await AuthService.SetUserPasswordByAdminAsync(selectedUser.Id, pwd);
            passwordSuccess = ok;
            passwordMessage = ok ? "رمز عبور با موفقیت تغییر کرد." : (error ?? "خطا در تغییر رمز عبور.");
            if (ok)
            {
                adminNewPassword = "";
                adminConfirmPassword = "";
            }
        }
        catch (Exception ex)
        {
            passwordSuccess = false;
            passwordMessage = "خطا: " + ex.Message;
        }
        finally
        {
            changingPassword = false;
            StateHasChanged();
        }
    }
}
