    private async Task LoadUsers()
    {
        loading = true;
        StateHasChanged();
        
        try
        {
            // دریافت همه کاربران
            allUsers = await UserService.GetUsersAsync("");
            
            // گروه‌بندی کاربران تکراری و ترکیب نقش‌ها (از UserRoles)
            var groupedUsers = allUsers
                .GroupBy(u => u.Id)
                .Select(g =>
                {
                    var firstUser = g.First();
                    var roles = g
                        .SelectMany(u =>
                        {
                            if (u.Roles != null && u.Roles.Count > 0) return u.Roles;
                            if (string.IsNullOrWhiteSpace(u.RoleName)) return Enumerable.Empty<string>();
                            return u.RoleName.Split(',').Select(x => x.Trim());
                        })
                        .Where(r => !string.IsNullOrWhiteSpace(r))
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .ToList();

                    firstUser.Roles = roles;
                    firstUser.RoleName = roles.Count > 0 ? string.Join(", ", roles) : firstUser.RoleName;
                    return firstUser;
                })
                .ToList();

            allUsers = groupedUsers;
            
            // اعمال فیلتر و جستجو
            users = ApplyFilters(allUsers);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا در بارگذاری کاربران: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private List<UserDto> ApplyFilters(List<UserDto> userList)
    {
        // اعمال فیلتر وضعیت / نقش
        var filtered = filterType switch
        {
            "active" => userList.Where(u => u.IsActive).ToList(),
            "inactive" => userList.Where(u => !u.IsActive).ToList(),
            "customer" => userList.Where(u => HasUserRole(u, "Customer")).ToList(),
            "store" => userList.Where(u => HasUserRole(u, "StoreOwner")).ToList(),
            _ => userList
        };
        
        // اعمال جستجو
        if (string.IsNullOrWhiteSpace(searchQuery))
            return filtered;
            
        var query = searchQuery.ToLower().Trim();
        
        return searchType switch
        {
            "name" => filtered.Where(u => 
                (!string.IsNullOrEmpty(u.FirstName) && u.FirstName.ToLower().Contains(query)) ||
                (!string.IsNullOrEmpty(u.LastName) && u.LastName.ToLower().Contains(query))).ToList(),
            "email" => filtered.Where(u => 
                !string.IsNullOrEmpty(u.Email) && 
                u.Email.ToLower().Contains(query)).ToList(),
            "phone" => filtered.Where(u => 
                !string.IsNullOrEmpty(u.PhoneNumber) && 
                u.PhoneNumber.Contains(query)).ToList(),
            "nationalcode" => filtered.Where(u => 
                !string.IsNullOrEmpty(u.NationalCode) && 
                u.NationalCode.Contains(query)).ToList(),
            "status" => filtered.Where(u => 
                (u.IsActive && query.Contains("فعال")) ||
                (!u.IsActive && query.Contains("غیرفعال"))).ToList(),
            _ => filtered
        };
    }

    private Task SetFilter(string filter)
    {
        filterType = filter;
        users = ApplyFilters(allUsers);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ApplySearch()
    {
        users = ApplyFilters(allUsers);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ClearSearch()
    {
        searchQuery = "";
        users = ApplyFilters(allUsers);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private string GetFullName(UserDto user)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(user.FirstName)) parts.Add(user.FirstName);
        if (!string.IsNullOrEmpty(user.LastName)) parts.Add(user.LastName);
        return parts.Any() ? string.Join(" ", parts) : $"کاربر #{user.Id}";
    }

    private static string RoleLabel(string role)
    {
        if (string.IsNullOrWhiteSpace(role)) return role;
        var r = role.Trim().Replace(" ", "").Replace("_", "");
        if (r.Equals("Customer", StringComparison.OrdinalIgnoreCase) || r.Equals("مشتری", StringComparison.OrdinalIgnoreCase))
            return "مشتری";
        if (r.Equals("StoreOwner", StringComparison.OrdinalIgnoreCase) || r.Equals("Store", StringComparison.OrdinalIgnoreCase)
            || r.Equals("مغازه‌دار", StringComparison.OrdinalIgnoreCase) || r.Equals("فروشگاه‌دار", StringComparison.OrdinalIgnoreCase))
            return "مغازه‌دار";
        if (r.Equals("Admin", StringComparison.OrdinalIgnoreCase) || r.Equals("ادمین", StringComparison.OrdinalIgnoreCase))
            return "ادمین";
        return role;
    }

    private static bool HasUserRole(UserDto user, string role)
    {
        if (user == null) return false;
        if (user.Roles != null && user.Roles.Any(r => RoleEquals(r, role)))
            return true;
        return RoleEquals(user.RoleName, role)
            || (!string.IsNullOrEmpty(user.RoleName) && user.RoleName.Split(',').Any(x => RoleEquals(x, role)));
    }

    private static bool RoleEquals(string a, string b)
    {
        if (string.IsNullOrWhiteSpace(a) || string.IsNullOrWhiteSpace(b)) return false;
        var left = a.Trim().Replace(" ", "").Replace("_", "");
        var right = b.Trim().Replace(" ", "").Replace("_", "");
        if (left.Equals(right, StringComparison.OrdinalIgnoreCase)) return true;
        if (RoleLabel(a) == RoleLabel(b)) return true;
        return false;
    }

    private bool HasRole(string role)
        => userRoles != null && userRoles.Any(r => RoleEquals(r, role));

