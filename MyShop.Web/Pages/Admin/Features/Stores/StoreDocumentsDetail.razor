@code {
    [Parameter] public int StoreId { get; set; }
    
    private Store store;
    private List<StoreDocument> documents = new();
    private List<StoreDocument> DocList => documents?.Where(d => d.DocumentType != "گالری").ToList() ?? new List<StoreDocument>();
    private List<StoreDocument> GalleryList => documents?.Where(d => d.DocumentType == "گالری").OrderBy(d => d.DisplayOrder).ToList() ?? new List<StoreDocument>();
    private bool loading = true;
    private bool showImageModal = false;
    private string selectedImageUrl = "";
    private int _adminUserId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;
        var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (idClaim != null && int.TryParse(idClaim.Value, out var uid))
            _adminUserId = uid;
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            store = await StoreService.GetByIdAsync(StoreId);
            documents = await StoreDocumentService.GetByStoreIdAsync(StoreId);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا در بارگذاری اطلاعات: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/admin/store-documents");
    }

    private string GetDocumentTypeName(string documentType)
    {
        if (string.IsNullOrEmpty(documentType)) return "-";
        return documentType switch
        {
            "گالری" => "گالری عکس",
            "پروفایل" => "پروفایل مغازه",
            "کاور" => "کاور پروفایل",
            "جواز کسب" => "جواز کسب",
            "اجاره نامه" => "اجاره نامه",
            "پروانه بهداشت" => "پروانه بهداشت",
            "مدارک هویتی" => "مدارک هویتی",
            "سایر" => "سایر",
            _ => documentType
        };
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private void ViewImage(string imageUrl)
    {
        selectedImageUrl = imageUrl;
        showImageModal = true;
    }

    private void CloseImageModal()
    {
        showImageModal = false;
        selectedImageUrl = "";
    }

    private async Task ApproveDocument(int documentId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "آیا مطمئن هستید که می‌خواهید این مدرک را تایید کنید؟");
        if (!confirmed) return;

        try
        {
            var result = await StoreDocumentService.ApproveAsync(documentId, true, _adminUserId);
            if (result) await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "خطا: " + ex.Message);
        }
    }

    private async Task RejectDocument(int documentId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "آیا مطمئن هستید که می‌خواهید تایید این مدرک را لغو کنید؟");
        if (!confirmed) return;

        try
        {
            var result = await StoreDocumentService.ApproveAsync(documentId, false, _adminUserId);
            if (result) await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "خطا: " + ex.Message);
        }
    }

    private async Task DeleteDocument(int documentId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "آیا مطمئن هستید که می‌خواهید این مدرک را حذف کنید؟");
        if (!confirmed) return;

        try
        {
            var doc = await StoreDocumentService.GetByIdAsync(documentId);
            var result = await StoreDocumentService.DeleteAsync(documentId);
            if (result && doc != null && !string.IsNullOrEmpty(doc.ImageUrl))
                StoreDocumentUpload.TryDeleteFile(doc.ImageUrl);
            if (result) await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "خطا: " + ex.Message);
        }
    }
}
