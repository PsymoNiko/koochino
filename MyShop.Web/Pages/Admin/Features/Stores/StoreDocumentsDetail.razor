@page "/admin/store-documents/{StoreId:int}"
@layout AdminLayout

@using MyShop.Core.Models
@using MyShop.Application.Interfaces
@using Microsoft.JSInterop
@using System.Security.Claims
@using System.Linq
@inject IStoreService StoreService
@inject IStoreDocumentService StoreDocumentService
@inject MyShop.Web.Services.StoreDocumentUploadService StoreDocumentUpload
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthProvider

<div class="container-content" dir="rtl" lang="fa">
    <div class="documents-header">
        <button class="btn-back" @onclick="GoBack">
            ← بازگشت
        </button>
        <h2>مدارک فروشگاه: @(store?.StoreName ?? "در حال بارگذاری...")</h2>
    </div>

    @if (loading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else if (store == null)
    {
        <div class="alert alert-error">
            فروشگاه یافت نشد
        </div>
    }
    else
    {
        <div class="store-info-section">
            <div class="info-card">
                <h3>اطلاعات فروشگاه</h3>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="label">شناسه:</span>
                        <span class="value">@store.StoreID</span>
                    </div>
                    <div class="info-item">
                        <span class="label">نام:</span>
                        <span class="value">@store.StoreName</span>
                    </div>
                    <div class="info-item">
                        <span class="label">آدرس:</span>
                        <span class="value">@(store.StoreAddress ?? "-")</span>
                    </div>
                    <div class="info-item">
                        <span class="label">تلفن:</span>
                        <span class="value">@(store.StorePhone ?? "-")</span>
                    </div>
                </div>
            </div>
        </div>

        @* بخش گالری عکس *@
        <div class="documents-section">
            <div class="section-header">
                <h3>🖼️ گالری عکس فروشگاه</h3>
                <p class="section-description">تصاویر ارسال شده توسط فروشنده برای گالری.</p>
            </div>
            @if (GalleryList.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">🖼️</div>
                    <h4>هنوز عکسی در گالری ارسال نشده است</h4>
                </div>
            }
            else
            {
                <div class="documents-grid gallery-grid">
                    @foreach (var doc in GalleryList)
                    {
                        <div class="document-card @(doc.IsApproved ? "approved" : "pending")">
                            <div class="document-header">
                                <div class="document-title">
                                    <h4>@(string.IsNullOrEmpty(doc.Title) ? "عکس گالری" : doc.Title)</h4>
                                    <span class="document-type">گالری</span>
                                </div>
                                <div class="document-status">
                                    @if (doc.IsApproved)
                                    {
                                        <span class="badge badge-success">✓ تایید شده</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">⏳ در انتظار تایید</span>
                                    }
                                </div>
                            </div>
                            <div class="document-body">
                                <div class="document-meta">
                                    <div class="meta-item">
                                        <span class="meta-label">تاریخ ارسال:</span>
                                        <span class="meta-value">@PersianDateHelper.ToPersianDateTimeString(doc.UploadedAt)</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(doc.ImageUrl))
                                {
                                    <div class="document-image">
                                        <img src="@doc.ImageUrl" alt="@doc.Title" @onclick="@(() => ViewImage(doc.ImageUrl))" />
                                    </div>
                                }
                            </div>
                            <div class="document-actions">
                                @if (!doc.IsApproved)
                                {
                                    <button class="btn-approve" @onclick="@(() => ApproveDocument(doc.DocumentId))">✓ تایید</button>
                                }
                                else
                                {
                                    <button class="btn-reject" @onclick="@(() => RejectDocument(doc.DocumentId))">✗ لغو تایید</button>
                                }
                                <button class="btn-delete" @onclick="@(() => DeleteDocument(doc.DocumentId))">🗑️ حذف</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="documents-section">
            <div class="section-header">
                <h3>📄 مدارک فروشگاه</h3>
                <p class="section-description">
                    در این بخش می‌توانید مدارک ارسال شده توسط فروشنده را مشاهده و مدیریت کنید.
                </p>
            </div>

            @if (DocList.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">📄</div>
                    <h4>هنوز مدرکی ارسال نشده است</h4>
                    <p>فروشنده هنوز هیچ مدرکی برای این فروشگاه ارسال نکرده است.</p>
                </div>
            }
            else
            {
                <div class="documents-grid">
                    @foreach (var doc in DocList)
                    {
                        <div class="document-card @(doc.IsApproved ? "approved" : "pending")">
                            <div class="document-header">
                                <div class="document-title">
                                    <h4>@doc.Title</h4>
                                    <span class="document-type">@GetDocumentTypeName(doc.DocumentType)</span>
                                </div>
                                <div class="document-status">
                                    @if (doc.IsApproved)
                                    {
                                        <span class="badge badge-success">✓ تایید شده</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">⏳ در انتظار تایید</span>
                                    }
                                </div>
                            </div>
                            
                            <div class="document-body">
                                @if (!string.IsNullOrEmpty(doc.Description))
                                {
                                    <p class="document-description">@doc.Description</p>
                                }
                                
                                <div class="document-meta">
                                    <div class="meta-item">
                                        <span class="meta-label">تاریخ ارسال:</span>
                                        <span class="meta-value">@PersianDateHelper.ToPersianDateTimeString(doc.UploadedAt)</span>
                                    </div>
                                    @if (doc.ExpiryDate.HasValue)
                                    {
                                        <div class="meta-item">
                                            <span class="meta-label">تاریخ انقضا:</span>
                                            <span class="meta-value">@PersianDateHelper.ToPersianDateString(doc.ExpiryDate.Value)</span>
                                        </div>
                                    }
                                    <div class="meta-item">
                                        <span class="meta-label">حجم فایل:</span>
                                        <span class="meta-value">@FormatFileSize(doc.FileSize)</span>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(doc.ImageUrl))
                                {
                                    <div class="document-image">
                                        <img src="@doc.ImageUrl" alt="@doc.Title" @onclick="@(() => ViewImage(doc.ImageUrl))" />
                                    </div>
                                }
                            </div>

                            <div class="document-actions">
                                @if (!doc.IsApproved)
                                {
                                    <button class="btn-approve" @onclick="@(() => ApproveDocument(doc.DocumentId))">
                                        ✓ تایید
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-reject" @onclick="@(() => RejectDocument(doc.DocumentId))">
                                        ✗ لغو تایید
                                    </button>
                                }
                                <button class="btn-delete" @onclick="@(() => DeleteDocument(doc.DocumentId))">
                                    🗑️ حذف
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@if (showImageModal)
{
    <div class="image-modal" @onclick="CloseImageModal">
        <div class="image-modal-content" @onclick:stopPropagation="true">
            <button class="btn-close-modal" @onclick="CloseImageModal">✕</button>
            <img src="@selectedImageUrl" alt="مدرک" />
        </div>
    </div>
}

