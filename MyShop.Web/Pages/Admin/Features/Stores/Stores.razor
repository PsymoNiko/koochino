@page "/admin/stores"
@layout AdminLayout
@using MyShop.Core.Models
@using MyShop.Application.Interfaces
@using System.Security.Claims
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@using MyShop.Application.Interfaces.Companies
@using MyShop.Core.Models.Companies
@using MyShop.Web.Components.Admin.Stores
@inject IStoreService StoreService
@inject ICompanyService CompanyService
@inject IAuthService AuthService
@inject IUserService UserService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JSRuntime
@inject MyShop.Application.Interfaces.Users.IUserIdentityDocumentService IdentityDocumentService

@inject AuthenticationStateProvider AuthProvider

<div class="container-content" dir="rtl" lang="fa">
    <div class="stores-header">
        <h2>مدیریت فروشگاه‌ها</h2>
        <div class="header-controls">
            <div class="filter-buttons">
                <span style="margin-left: 12px;">شرکت:</span>
                <select class="search-type-select" style="margin-left: 8px; min-width: 160px;" value="@filterCompanyId" @onchange="OnCompanyFilterChange">
                    <option value="0">همه</option>
                    @foreach (var c in companies)
                    { <option value="@c.Id">@c.Name</option> }
                </select>
                <button class="btn-filter @(filterType == "all" ? "active" : "")" @onclick="@(() => SetFilter("all"))">
                    همه فروشگاه‌ها
                </button>
                <button class="btn-filter @(filterType == "active" ? "active" : "")" @onclick="@(() => SetFilter("active"))">
                    فعال
                </button>
                <button class="btn-filter @(filterType == "pending" ? "active" : "")" @onclick="@(() => SetFilter("pending"))">
                    تحت بررسی
                </button>
                <button class="btn-filter @(filterType == "inactive" ? "active" : "")" @onclick="@(() => SetFilter("inactive"))">
                    غیرفعال
                </button>
            </div>
            <div class="search-container">
                <select class="search-type-select" @bind="searchType" @bind:event="onchange">
                    <option value="storename">نام فروشگاه</option>
                    <option value="storeid">شماره فروشگاه</option>
                    <option value="owner">مالک</option>
                    <option value="phone">تلفن</option>
                    <option value="address">آدرس</option>
                </select>
                <div class="search-input-wrapper">
                    <input type="text" class="search-input" placeholder="جستجو..." @bind="searchQuery" @bind:event="oninput" @onkeypress="@(async (e) => { if (e.Key == "Enter") await ApplySearch(); })" />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button class="btn-clear-search-inline" @onclick="ClearSearch" title="پاک کردن">✕</button>
                    }
                </div>
                <button class="btn-search" @onclick="ApplySearch">🔍</button>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else if (stores == null || stores.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🏪</div>
            <h3>هیچ فروشگاهی یافت نشد</h3>
        </div>
    }
    else
    {
        <div class="stores-table-container">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>شناسه</th>
                        <th>نام فروشگاه</th>
                        <th>مالک</th>
                        <th>آدرس</th>
                        <th>تلفن</th>
                        <th>ساعات کاری</th>
                        <th>تاریخ ثبت</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var store in stores)
                    {
                        <tr>
                            <td>@store.StoreID</td>
                            <td><strong>@store.StoreName</strong></td>
                            <td>@GetOwnerName(store.SellerId)</td>
                            <td>@(string.IsNullOrEmpty(store.StoreAddress) ? "-" : store.StoreAddress)</td>
                            <td>@(string.IsNullOrEmpty(store.StorePhone) ? "-" : store.StorePhone)</td>
                            <td>
                                @if (!string.IsNullOrEmpty(store.StoreOpeningHours) && !string.IsNullOrEmpty(store.StoreClosingHours))
                                {
                                    <span>@store.StoreOpeningHours - @store.StoreClosingHours</span>
                                    @if (!string.IsNullOrEmpty(store.StoreWorkingDays))
                                    {
                                        <br /><small style="color: #6b7280;">@store.StoreWorkingDays</small>
                                    }
                                }
                                else
                                {
                                    <span style="color: #9ca3af;">-</span>
                                }
                            </td>
                            <td>@PersianDateHelper.ToPersianDateString(store.StoreCreatedAt)</td>
                            <td>
                                @if (store.StoreStat)
                                {
                                    <span class="badge badge-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">تحت بررسی</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn-action btn-details" 
                                            @onclick="@(() => ShowStoreDetails(store))"
                                            title="مشاهده جزئیات">
                                        👁️
                                    </button>
                                    @if (Auth?.CanUpdate("Stores") == true)
                                    {
                                        <button class="btn-action btn-toggle @(store.StoreStat ? "btn-deactivate" : "btn-activate")" 
                                                @onclick="@(() => ToggleStoreStatus(store))"
                                                title="@(store.StoreStat ? "غیرفعال کردن" : "فعال کردن")">
                                            @if (store.StoreStat)
                                            {
                                                <span>⏸️</span>
                                            }
                                            else
                                            {
                                                <span>✅</span>
                                            }
                                        </button>
                                    }
                                    @if (Auth?.CanDelete("Stores") == true)
                                    {
                                        <button class="btn-action btn-delete" 
                                                @onclick="@(() => DeleteStore(store))"
                                                title="حذف">
                                            🗑️
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* Modal برای نمایش جزئیات فروشگاه و فروشنده *@
@if (showDetailsModal)
{
    <div class="modal-overlay" @onclick="@(async () => await CloseDetailsModal())">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>
                    جزئیات فروشگاه و فروشنده
                    @if (!string.IsNullOrEmpty(identityStatusLabel))
                    {
                        <span class="badge @identityStatusCssClass" style="margin-right:10px;font-size:12px;vertical-align:middle;">@identityStatusLabel</span>
                    }
                </h3>
                    <button class="btn-close-modal" @onclick="@(async () => await CloseDetailsModal())">✕</button>
            </div>
            <div class="modal-body">
                @if (loadingDetails)
                {
                    <div class="loading-details">
                        <div class="spinner-small"></div>
                        <p>در حال بارگذاری...</p>
                    </div>
                }
                else if (selectedStore != null && selectedUser != null)
                {
                    <div class="detail-tabs">
                        <button type="button" class="detail-tab @(activeDetailTab == "overview" ? "active" : "")" @onclick="@(() => activeDetailTab = "overview")">کلی</button>
                        <button type="button" class="detail-tab @(activeDetailTab == "documents" ? "active" : "")" @onclick="@(() => activeDetailTab = "documents")">📄 مدارک</button>
                        <button type="button" class="detail-tab @(activeDetailTab == "identity" ? "active" : "")" @onclick="@(() => activeDetailTab = "identity")">🪪 احراز هویت مالک</button>
                    </div>
                }
                @if (selectedStore != null && selectedUser != null && activeDetailTab == "documents")
                {
                    <StoreDocumentsDetail @key="selectedStore.StoreID" StoreId="@selectedStore.StoreID" />
                }
                else if (selectedStore != null && selectedUser != null && activeDetailTab == "identity")
                {
                    <StoreOwnerIdentityPanel @key="selectedUser.Id" UserId="@selectedUser.Id" OnChanged="@RefreshIdentityStatusBadge" />
                }
                else if (selectedStore != null && selectedUser != null && activeDetailTab == "overview")
                {
                    @if (isEditingUser)
                    {
                        <div class="edit-form">
                            <h4>ویرایش اطلاعات فروشنده</h4>
                            <div class="form-group">
                                <label>نام کاربری:</label>
                                <input type="text" class="form-input" @bind="editingUser.Username" />
                            </div>
                            <div class="form-group">
                                <label>نام:</label>
                                <input type="text" class="form-input" @bind="editingUser.FirstName" />
                            </div>
                            <div class="form-group">
                                <label>نام خانوادگی:</label>
                                <input type="text" class="form-input" @bind="editingUser.LastName" />
                            </div>
                            <div class="form-group">
                                <label>ایمیل:</label>
                                <input type="email" class="form-input" @bind="editingUser.Email" />
                            </div>
                            <div class="form-group">
                                <label>شماره تلفن:</label>
                                <input type="text" class="form-input" @bind="editingUser.PhoneNumber" />
                            </div>
                            <div class="form-group">
                                <label>کد ملی:</label>
                                <input type="text" class="form-input" @bind="editingUser.NationalCode" />
                            </div>
                            <div class="form-actions">
                                <button class="btn-save" @onclick="SaveUserChanges" disabled="@savingUser">
                                    @if (savingUser)
                                    {
                                        <span class="spinner-small"></span>
                                    }
                                    ذخیره تغییرات
                                </button>
                                <button class="btn-cancel" @onclick="CancelEdit">انصراف</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="details-section">
                            <h4>اطلاعات فروشنده</h4>
                            <div class="info-grid">
                                <div class="info-item">
                                    <span class="info-label">نام کاربری:</span>
                                    <span class="info-value">@selectedUser.Username</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">نام و نام خانوادگی:</span>
                                    <span class="info-value">@($"{selectedUser.FirstName} {selectedUser.LastName}".Trim())</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">ایمیل:</span>
                                    <span class="info-value">@(string.IsNullOrEmpty(selectedUser.Email) ? "-" : selectedUser.Email)</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">شماره تلفن:</span>
                                    <span class="info-value">@(string.IsNullOrEmpty(selectedUser.PhoneNumber) ? "-" : selectedUser.PhoneNumber)</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">کد ملی:</span>
                                    <span class="info-value">@(string.IsNullOrEmpty(selectedUser.NationalCode) ? "-" : selectedUser.NationalCode)</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">وضعیت:</span>
                                    <span class="info-value">
                                        <span class="badge @(selectedUser.IsActive ? "badge-success" : "badge-danger")">
                                            @(selectedUser.IsActive ? "فعال" : "غیرفعال")
                                        </span>
                                    </span>
                                </div>
                            </div>
                            <div class="section-actions">
                                @if (Auth?.CanUpdate("Stores") == true)
                                {
                                    <button class="btn-edit" @onclick="StartEditingUser">✏️ ویرایش اطلاعات فروشنده</button>
                                    <button class="btn-toggle-user @(selectedUser.IsActive ? "btn-deactivate" : "btn-activate")" 
                                            @onclick="ToggleUserStatus">
                                        @(selectedUser.IsActive ? "⏸️ غیرفعال کردن کاربر" : "✅ فعال کردن کاربر")
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="details-section">
                            <h4>جزئیات فروشگاه انتخاب شده</h4>
                            @if (isEditingStore)
                            {
                                <div class="edit-form">
                                    <h4>ویرایش اطلاعات فروشگاه</h4>
                                    <div class="form-group">
                                        <label>شرکت:</label>
                                        <select class="form-input" @bind="editingStore.CompanyId">
                                            <option value="">— انتخاب نکنید —</option>
                                            @foreach (var c in companies)
                                            { <option value="@(c.Id)">@c.Name</option> }
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>نام فروشگاه:</label>
                                        <input type="text" class="form-input" @bind="editingStore.StoreName" />
                                    </div>
                                    <div class="form-group">
                                        <label>نام خانوادگی فروشگاه:</label>
                                        <input type="text" class="form-input" @bind="editingStore.StoreFamilyName" />
                                    </div>
                                    <div class="form-group">
                                        <label>تلفن فروشگاه:</label>
                                        <input type="text" class="form-input" @bind="editingStore.StorePhone" />
                                    </div>
                                    <div class="form-group">
                                        <label>کد پستی:</label>
                                        <input type="text" class="form-input" @bind="editingStore.StorePostCode" />
                                    </div>
                                    <div class="form-group">
                                        <label>شهر (کد):</label>
                                        <input type="number" class="form-input" @bind="editingStore.StoreCity" />
                                    </div>
                                    <div class="form-group">
                                        <label>آدرس:</label>
                                        <textarea class="form-input" rows="3" @bind="editingStore.StoreAddress"></textarea>
                                    </div>
                                    <div class="form-group">
                                        <label>توضیحات:</label>
                                        <textarea class="form-input" rows="4" @bind="editingStore.StoreDescription"></textarea>
                                    </div>
                                    <div class="form-group">
                                        <label>موقعیت جغرافیایی 1:</label>
                                        <input type="text" class="form-input" @bind="editingStore.StorePos1" />
                                    </div>
                                    <div class="form-group">
                                        <label>موقعیت جغرافیایی 2:</label>
                                        <input type="text" class="form-input" @bind="editingStore.StorePos2" />
                                    </div>
                                    <div class="form-group">
                                        <label>موقعیت جغرافیایی 3:</label>
                                        <input type="text" class="form-input" @bind="editingStore.StorePos3" />
                                    </div>
                                    <hr style="margin: 24px 0; border: none; border-top: 2px solid #e5e7eb;" />
                                    <h4 style="margin-bottom: 16px; color: #1f2937;">اطلاعات تکمیلی</h4>
                                    <div class="form-group">
                                        <label>ساعت شروع کار:</label>
                                        <input type="text" class="form-input" placeholder="09:00" @bind="editingStore.StoreOpeningHours" />
                                    </div>
                                    <div class="form-group">
                                        <label>ساعت پایان کار:</label>
                                        <input type="text" class="form-input" placeholder="21:00" @bind="editingStore.StoreClosingHours" />
                                    </div>
                                    <div class="form-group">
                                        <label>روزهای کاری:</label>
                                        <input type="text" class="form-input" placeholder="شنبه,یکشنبه,دوشنبه" @bind="editingStore.StoreWorkingDays" />
                                    </div>
                                    <div class="form-group">
                                        <label>وب‌سایت:</label>
                                        <input type="url" class="form-input" @bind="editingStore.StoreWebsite" />
                                    </div>
                                    <div class="form-group">
                                        <label>شبکه‌های اجتماعی (JSON):</label>
                                        <textarea class="form-input" rows="3" placeholder='{"instagram": "...", "telegram": "..."}' @bind="editingStore.StoreSocialMedia"></textarea>
                                    </div>
                                    <div class="form-group">
                                        <label>آدرس تصویر پروفایل:</label>
                                        <input type="url" class="form-input" @bind="editingStore.StoreProfileImageUrl" />
                                    </div>
                                    <div class="form-group">
                                        <label>عرض جغرافیایی:</label>
                                        <input type="number" step="0.00000001" class="form-input" @bind="editingStore.StoreLatitude" />
                                    </div>
                                    <div class="form-group">
                                        <label>طول جغرافیایی:</label>
                                        <input type="number" step="0.00000001" class="form-input" @bind="editingStore.StoreLongitude" />
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            <input type="checkbox" @bind="editingStore.IsLocationEnabled" />
                                            نمایش روی نقشه
                                        </label>
                                    </div>
                                    <div class="form-actions">
                                        <button class="btn-save" @onclick="SaveStoreChanges" disabled="@savingStore">
                                            @if (savingStore)
                                            {
                                                <span class="spinner-small"></span>
                                            }
                                            ذخیره تغییرات
                                        </button>
                                        <button class="btn-cancel" @onclick="CancelEditStore">انصراف</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="info-grid">
                                    <div class="info-item">
                                        <span class="info-label">شرکت:</span>
                                        <span class="info-value">@GetCompanyName(selectedStore.CompanyId)</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">شناسه فروشگاه:</span>
                                        <span class="info-value">@selectedStore.StoreID</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">نام فروشگاه:</span>
                                        <span class="info-value"><strong>@selectedStore.StoreName</strong></span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">نام خانوادگی فروشگاه:</span>
                                        <span class="info-value">@(string.IsNullOrEmpty(selectedStore.StoreFamilyName) ? "-" : selectedStore.StoreFamilyName)</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">وضعیت:</span>
                                        <span class="info-value">
                                            <span class="badge @(selectedStore.StoreStat ? "badge-success" : "badge-warning")">
                                                @(selectedStore.StoreStat ? "فعال" : "تحت بررسی")
                                            </span>
                                        </span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">تلفن فروشگاه:</span>
                                        <span class="info-value">@(string.IsNullOrEmpty(selectedStore.StorePhone) ? "-" : selectedStore.StorePhone)</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">کد پستی:</span>
                                        <span class="info-value">@(string.IsNullOrEmpty(selectedStore.StorePostCode) ? "-" : selectedStore.StorePostCode)</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">شهر:</span>
                                        <span class="info-value">@(selectedStore.StoreCity.HasValue ? selectedStore.StoreCity.Value.ToString() : "-")</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">تاریخ ثبت:</span>
                                        <span class="info-value">@PersianDateHelper.ToPersianDateTimeString(selectedStore.StoreCreatedAt)</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(selectedStore.StoreProfileImageUrl))
                                    {
                                        <div class="info-item-full">
                                            <span class="info-label">تصویر پروفایل:</span>
                                            <div class="info-value-box">
                                                <img src="@selectedStore.StoreProfileImageUrl" alt="@selectedStore.StoreName" style="max-width: 200px; max-height: 200px; border-radius: 8px;" />
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(selectedStore.StoreOpeningHours) && !string.IsNullOrEmpty(selectedStore.StoreClosingHours))
                                    {
                                        <div class="info-item">
                                            <span class="info-label">ساعات کاری:</span>
                                            <span class="info-value">@selectedStore.StoreOpeningHours - @selectedStore.StoreClosingHours</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(selectedStore.StoreWorkingDays))
                                    {
                                        <div class="info-item">
                                            <span class="info-label">روزهای کاری:</span>
                                            <span class="info-value">@selectedStore.StoreWorkingDays</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(selectedStore.StoreWebsite))
                                    {
                                        <div class="info-item">
                                            <span class="info-label">وب‌سایت:</span>
                                            <span class="info-value"><a href="@selectedStore.StoreWebsite" target="_blank" style="color: #2563eb;">@selectedStore.StoreWebsite</a></span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(selectedStore.StoreSocialMedia))
                                    {
                                        <div class="info-item-full">
                                            <span class="info-label">شبکه‌های اجتماعی:</span>
                                            <div class="info-value-box">
                                                <pre style="background: #f3f4f6; padding: 12px; border-radius: 6px; font-size: 12px; overflow-x: auto; margin: 0;">@selectedStore.StoreSocialMedia</pre>
                                            </div>
                                        </div>
                                    }
                                    @if (selectedStore.StoreLatitude.HasValue && selectedStore.StoreLongitude.HasValue)
                                    {
                                        <div class="info-item">
                                            <span class="info-label">موقعیت جغرافیایی:</span>
                                            <span class="info-value">
                                                Lat: @selectedStore.StoreLatitude.Value.ToString("F8"), 
                                                Lng: @selectedStore.StoreLongitude.Value.ToString("F8")
                                                @if (selectedStore.IsLocationEnabled)
                                                {
                                                    <span class="badge badge-success" style="margin-right: 8px;">فعال روی نقشه</span>
                                                }
                                            </span>
                                        </div>
                                        @if (selectedStore.IsLocationEnabled)
                                        {
                                            <div class="info-item-full">
                                                <span class="info-label">نقشه:</span>
                                                <div class="info-value-box" style="padding: 0; height: 400px;">
                                                    <div id="neshan-map-@selectedStore.StoreID" style="width: 100%; height: 400px; border-radius: 8px;"></div>
                                                </div>
                                            </div>
                                        }
                                    }
                                    @if (selectedStore.StoreRating.HasValue)
                                    {
                                        <div class="info-item">
                                            <span class="info-label">امتیاز:</span>
                                            <span class="info-value">
                                                ⭐ @selectedStore.StoreRating.Value.ToString("0.0") 
                                                (@selectedStore.StoreReviewCount نظر)
                                            </span>
                                        </div>
                                    }
                                </div>
                                <div class="info-item-full">
                                    <span class="info-label">آدرس:</span>
                                    <div class="info-value-box">
                                        @(string.IsNullOrEmpty(selectedStore.StoreAddress) ? "-" : selectedStore.StoreAddress)
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(selectedStore.StoreDescription))
                                {
                                    <div class="info-item-full">
                                        <span class="info-label">توضیحات:</span>
                                        <div class="info-value-box">
                                            @selectedStore.StoreDescription
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(selectedStore.StorePos1) || !string.IsNullOrEmpty(selectedStore.StorePos2) || !string.IsNullOrEmpty(selectedStore.StorePos3))
                                {
                                    <div class="info-item-full">
                                        <span class="info-label">موقعیت جغرافیایی:</span>
                                        <div class="info-value-box">
                                            @if (!string.IsNullOrEmpty(selectedStore.StorePos1))
                                            {
                                                <div>موقعیت 1: @selectedStore.StorePos1</div>
                                            }
