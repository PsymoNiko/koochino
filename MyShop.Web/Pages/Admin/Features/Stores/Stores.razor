                                }
                                <div class="section-actions">
                                    @if (Auth?.CanUpdate("Stores") == true)
                                    {
                                        <button class="btn-edit" @onclick="@(async () => await StartEditingStore())">✏️ ویرایش فروشگاه</button>
                                    }
                                    <button class="btn-documents" @onclick="@(() => activeDetailTab = "documents")">
