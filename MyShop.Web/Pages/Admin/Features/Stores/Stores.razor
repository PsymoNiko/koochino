    private async Task ToggleStoreStatusFromModal(Store store)
    {
        var newStatus = !store.StoreStat;
        var confirmMessage = newStatus 
            ? $"آیا مطمئن هستید که می‌خواهید فروشگاه '{store.StoreName}' را فعال کنید؟"
            : $"آیا مطمئن هستید که می‌خواهید فروشگاه '{store.StoreName}' را غیرفعال کنید؟";
        
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", confirmMessage);
        
        if (!confirmed)
            return;
        
        try
        {
            var result = await StoreService.ToggleStatusAsync(store.StoreID, newStatus);
            
            if (result)
            {
                store.StoreStat = newStatus;
                
                // به‌روزرسانی در لیست userStores
                var updatedStore = userStores.FirstOrDefault(s => s.StoreID == store.StoreID);
                if (updatedStore != null)
                {
                    updatedStore.StoreStat = newStatus;
                }
                
                // به‌روزرسانی در لیست اصلی
                var mainStore = allStores.FirstOrDefault(s => s.StoreID == store.StoreID);
                if (mainStore != null)
                {
                    mainStore.StoreStat = newStatus;
                }
                
                // اگر فروشگاه انتخاب شده همان فروشگاه است، به‌روزرسانی کن
                if (selectedStore != null && selectedStore.StoreID == store.StoreID)
                {
                    selectedStore.StoreStat = newStatus;
                }
                
                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("alert", 
                    newStatus ? "فروشگاه با موفقیت فعال شد" : "فروشگاه با موفقیت غیرفعال شد");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "خطا در تغییر وضعیت فروشگاه");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا: {ex.Message}");
        }
    }
