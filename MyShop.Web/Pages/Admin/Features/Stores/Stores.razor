    private string GetCompanyName(int? companyId)
    {
        if (!companyId.HasValue || companyId.Value == 0) return "-";
        var c = companies.FirstOrDefault(x => x.Id == companyId.Value);
        return c?.Name ?? "-";
    }

    private async Task LoadOwnerNames()
    {
        ownerNames.Clear();
        ownerUsers.Clear();
        var uniqueOwnerIds = allStores.Select(s => s.SellerId).Distinct();
        
        foreach (var ownerId in uniqueOwnerIds)
        {
            try
            {
                var owner = await AuthService.GetUserByIdAsync(ownerId);
                if (owner != null)
                {
                    var ownerName = !string.IsNullOrEmpty(owner.FirstName) && !string.IsNullOrEmpty(owner.LastName)
                        ? $"{owner.FirstName} {owner.LastName}"
                        : owner.Username ?? $"ID: {ownerId}";
                    ownerNames[ownerId] = ownerName;
                    ownerUsers[ownerId] = owner;
                }
                else
                {
                    ownerNames[ownerId] = $"ID: {ownerId}";
                }
            }
            catch
            {
                ownerNames[ownerId] = $"ID: {ownerId}";
            }
        }
    }

    private string GetOwnerName(int sellerId)
    {
        return ownerNames.ContainsKey(sellerId) ? ownerNames[sellerId] : $"ID: {sellerId}";
    }

