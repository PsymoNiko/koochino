        {
            "storename" => storeList.Where(s => 
                !string.IsNullOrEmpty(s.StoreName) && 
                s.StoreName.ToLower().Contains(query)).ToList(),
            "storeid" => storeList.Where(s => 
                s.StoreID.ToString().Contains(query)).ToList(),
            "owner" => storeList.Where(s => 
                ownerNames.ContainsKey(s.SellerId) && 
                ownerNames[s.SellerId].ToLower().Contains(query)).ToList(),
            "phone" => storeList.Where(s => 
                !string.IsNullOrEmpty(s.StorePhone) && 
                s.StorePhone.Contains(query)).ToList(),
            "address" => storeList.Where(s => 
                !string.IsNullOrEmpty(s.StoreAddress) && 
                s.StoreAddress.ToLower().Contains(query)).ToList(),
            _ => storeList
        };
    }
    
