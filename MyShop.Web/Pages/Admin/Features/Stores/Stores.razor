    private async Task ToggleStoreStatus(Store store)
    {
        var newStatus = !store.StoreStat;
        var confirmMessage = newStatus 
            ? $"آیا مطمئن هستید که می‌خواهید فروشگاه '{store.StoreName}' را فعال کنید؟"
            : $"آیا مطمئن هستید که می‌خواهید فروشگاه '{store.StoreName}' را غیرفعال کنید؟";

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", confirmMessage);
        
        if (!confirmed)
            return;

        try
        {
            var result = await StoreService.ToggleStatusAsync(store.StoreID, newStatus);
            
            if (result)
            {
                store.StoreStat = newStatus;
                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("alert", 
                    newStatus ? "فروشگاه با موفقیت فعال شد" : "فروشگاه با موفقیت غیرفعال شد");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "خطا در تغییر وضعیت فروشگاه");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا: {ex.Message}");
        }
    }

    private async Task DeleteStore(Store store)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"آیا مطمئن هستید که می‌خواهید فروشگاه '{store.StoreName}' را حذف کنید؟");
        
        if (!confirmed)
            return;

        try
        {
            var result = await StoreService.DeleteAsync(store.StoreID);
            
            if (result)
            {
                await LoadStores();
                await JSRuntime.InvokeVoidAsync("alert", "فروشگاه با موفقیت حذف شد");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "خطا در حذف فروشگاه");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا: {ex.Message}");
        }
    }
    
    private async Task ShowStoreDetails(Store store)
    {
        showDetailsModal = true;
        loadingDetails = true;
        isEditingUser = false;
        isEditingStore = false;
        activeDetailTab = "overview";
        StateHasChanged();
        
        try
        {
            // بارگذاری مجدد از دیتابیس برای اطمینان از دریافت همه فیلدها
            selectedStore = await StoreService.GetByIdAsync(store.StoreID);
            
            if (selectedStore == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "فروشگاه یافت نشد");
                showDetailsModal = false;
                return;
            }
            
            // دریافت اطلاعات فروشنده
            selectedUser = await AuthService.GetUserByIdAsync(selectedStore.SellerId);

            // دریافت تمام فروشگاه‌های این فروشنده
            userStores = await StoreService.GetByUserIdAsync(selectedStore.SellerId);

            await RefreshIdentityStatusBadge();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا در بارگذاری اطلاعات: {ex.Message}");
        }
        finally
        {
            loadingDetails = false;
            StateHasChanged();
            
            // نمایش نقشه اگر موقعیت فعال است
            if (selectedStore != null && selectedStore.IsLocationEnabled && 
                selectedStore.StoreLatitude.HasValue && selectedStore.StoreLongitude.HasValue)
            {
                await Task.Delay(300); // کمی تاخیر برای اطمینان از رندر شدن DOM
                await InitializeMap();
            }
        }
    }
    
    private async Task RefreshIdentityStatusBadge()
    {
        identityStatusLabel = "";
        identityStatusCssClass = "";
        if (selectedUser == null) return;
        try
        {
            var summary = await IdentityDocumentService.GetSummaryAsync(selectedUser.Id);
            if (summary == null || (summary.NationalCard == null && summary.Selfie == null))
            {
                identityStatusLabel = "⏳ در انتظار آپلود مدارک هویتی";
                identityStatusCssClass = "badge-warning";
            }
            else if (summary.AggregatedStatus == "Approved")
            {
                identityStatusLabel = "✓ هویت مالک تایید شده";
                identityStatusCssClass = "badge-success";
            }
            else if (summary.AggregatedStatus == "Rejected")
            {
                identityStatusLabel = "✗ مدرک هویتی رد شده";
                identityStatusCssClass = "badge-danger";
            }
            else
            {
                identityStatusLabel = "⏳ در انتظار بررسی مدرک هویتی";
                identityStatusCssClass = "badge-warning";
            }
        }
        catch { /* نمایش بج اختیاری است؛ خطا نباید مودال را بشکند */ }
    }

    private async Task InitializeMap()
    {
        if (selectedStore == null || !selectedStore.StoreLatitude.HasValue || !selectedStore.StoreLongitude.HasValue)
            return;
            
        try
        {
            var mapId = $"neshan-map-{selectedStore.StoreID}";
            await JSRuntime.InvokeVoidAsync("initNeshanMap", 
                mapId, 
                (double)selectedStore.StoreLatitude.Value, 
                (double)selectedStore.StoreLongitude.Value,
                selectedStore.StoreName);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing map: {ex.Message}");
        }
    }
    
    private async Task CloseDetailsModal()
    {
        // حذف نقشه قبل از بستن مودال
        if (selectedStore != null)
        {
            var mapId = $"neshan-map-{selectedStore.StoreID}";
            try
            {
                await JSRuntime.InvokeVoidAsync("removeNeshanMap", mapId);
