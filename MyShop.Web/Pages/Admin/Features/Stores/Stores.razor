            allStores = _adminUserId > 0
                ? await StoreService.GetAllForUserAsync(_adminUserId) ?? new List<Store>()
                : await StoreService.GetAllAsync() ?? new List<Store>();
            
            // اعمال فیلتر
            var filteredStores = allStores;
            switch (filterType)
            {
                case "active":
                    filteredStores = allStores.Where(s => s.StoreStat).ToList();
                    break;
                case "pending":
                    filteredStores = allStores.Where(s => !s.StoreStat).ToList();
                    break;
