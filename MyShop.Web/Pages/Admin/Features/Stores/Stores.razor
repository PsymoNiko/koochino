                                    </button>
                                    @if (Auth?.CanUpdate("Stores") == true)
                                    {
                                        <button class="btn-store-toggle @(selectedStore.StoreStat ? "btn-deactivate" : "btn-activate")" 
                                                @onclick="@(() => ToggleStoreStatusFromModal(selectedStore))">
                                            @(selectedStore.StoreStat ? "⏸️ غیرفعال کردن فروشگاه" : "✅ فعال کردن فروشگاه")
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="details-section">
