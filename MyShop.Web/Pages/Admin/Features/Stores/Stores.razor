    private async Task SaveStoreChanges()
    {
        if (editingStore == null || editingStore.StoreID == 0) return;
        
        savingStore = true;
        StateHasChanged();
        
        try
        {
            // حفظ فیلدهای مهم
            editingStore.SellerId = selectedStore.SellerId;
            editingStore.UserID = selectedStore.UserID;
            editingStore.StoreCreatedAt = selectedStore.StoreCreatedAt;
            editingStore.StoreStat = selectedStore.StoreStat;
            
            var result = await StoreService.UpdateAsync(editingStore);
            
            if (result)
            {
                // بارگذاری مجدد از دیتابیس برای اطمینان از به‌روزرسانی کامل
                var updatedStore = await StoreService.GetByIdAsync(editingStore.StoreID);
                if (updatedStore != null)
                {
                    selectedStore = updatedStore;
                }
                
                // به‌روزرسانی در لیست userStores
                var userStoreIndex = userStores.FindIndex(s => s.StoreID == editingStore.StoreID);
                if (userStoreIndex >= 0)
                {
                    userStores[userStoreIndex] = updatedStore ?? editingStore;
                }
                
                // به‌روزرسانی در لیست اصلی
                var mainStoreIndex = allStores.FindIndex(s => s.StoreID == editingStore.StoreID);
                if (mainStoreIndex >= 0)
                {
                    allStores[mainStoreIndex] = updatedStore ?? editingStore;
                }
                
                // به‌روزرسانی لیست نمایشی
                await LoadStores();
                
                isEditingStore = false;
                StateHasChanged();
                await JSRuntime.InvokeVoidAsync("alert", "فروشگاه با موفقیت به‌روزرسانی شد");
                
                // بارگذاری مجدد لیست فروشگاه‌ها
                await LoadStores();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "خطا در به‌روزرسانی فروشگاه");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا: {ex.Message}");
        }
        finally
        {
            savingStore = false;
            StateHasChanged();
        }
    }
    
    private async Task SaveUserChanges()
    {
        if (editingUser == null || editingUser.UserId == 0) return;
        
        savingUser = true;
        StateHasChanged();
        
        try
        {
            var result = await UserService.UpdateProfileAsync(editingUser);
            
            if (result > 0)
            {
                // بارگذاری مجدد اطلاعات کاربر
                selectedUser = await AuthService.GetUserByIdAsync(editingUser.UserId);
                
                // به‌روزرسانی دیکشنری‌ها
                if (ownerUsers.ContainsKey(editingUser.UserId))
                {
                    ownerUsers[editingUser.UserId] = selectedUser;
                }
                
                var ownerName = !string.IsNullOrEmpty(selectedUser.FirstName) && !string.IsNullOrEmpty(selectedUser.LastName)
                    ? $"{selectedUser.FirstName} {selectedUser.LastName}"
                    : selectedUser.Username ?? $"ID: {editingUser.UserId}";
                ownerNames[editingUser.UserId] = ownerName;
                
                isEditingUser = false;
                await JSRuntime.InvokeVoidAsync("alert", "اطلاعات با موفقیت به‌روزرسانی شد");
                
                // بارگذاری مجدد لیست فروشگاه‌ها
                await LoadStores();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "خطا در به‌روزرسانی اطلاعات");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا: {ex.Message}");
        }
        finally
        {
            savingUser = false;
            StateHasChanged();
        }
    }
    
