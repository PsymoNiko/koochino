                    // یا اگر نیاز به منطق دیگری دارید، می‌توانید تغییر دهید
                    filteredStores = allStores.Where(s => !s.StoreStat).ToList();
                    break;
                default:
                    filteredStores = allStores;
                    break;
            }
            
            // فیلتر بر اساس شرکت
            if (filterCompanyId > 0)
                filteredStores = filteredStores.Where(s => s.CompanyId.HasValue && s.CompanyId.Value == filterCompanyId).ToList();
            
            // اعمال جستجو
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                filteredStores = ApplySearchFilter(filteredStores);
