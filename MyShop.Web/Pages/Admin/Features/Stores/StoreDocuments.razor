@page "/admin/store-documents"
@layout AdminLayout

@using MyShop.Core.Models
@using MyShop.Core.Models.Dto
@using MyShop.Application.Interfaces
@using System.Linq
@using Microsoft.JSInterop
@inject IStoreService StoreService
@inject IStoreDocumentService StoreDocumentService
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<div class="container-content" dir="rtl" lang="fa">
    <div class="documents-header">
        <h2>مدیریت مدارک فروشگاه‌ها <span class="pending-badge">@totalPendingCount مدرک در حال بررسی</span></h2>
        <div class="filter-section">
            <div class="filter-row">
                <span class="filter-label">فیلتر:</span>
                <div class="filter-buttons">
                    <button type="button" class="filter-btn @(filterStoresWithDocsValue == "all" ? "filter-btn-active" : "")" @onclick="@(() => SetFilter("all"))">همه فروشگاه‌ها</button>
                    <button type="button" class="filter-btn @(filterStoresWithDocsValue == "withDocs" ? "filter-btn-active" : "")" @onclick="@(() => SetFilter("withDocs"))">دارای مدارک (تایید / در حال بررسی)</button>
                </div>
                <button type="button" class="btn-apply" @onclick="ApplyFilter">اعمال فیلتر</button>
            </div>
            <div class="search-row">
                <label class="search-label">جستجو با نام مغازه:</label>
                <input type="text" class="search-input" placeholder="نام فروشگاه را بنویسید..." @bind="searchStoreName" @onkeypress="OnSearchKeyPress" />
                <button type="button" class="btn-apply" @onclick="ApplyFilter">اعمال</button>
            </div>
        </div>
    </div>

    @* آخرین ۱۰ مدرک/اقدام ارسالی مغازه‌داران *@
    <div class="latest-docs-section">
        <h3 class="section-title">آخرین مدارک ارسالی (۱۰ مورد)</h3>
        @if (loadingLatest)
        {
            <p class="text-muted">در حال بارگذاری...</p>
        }
        else if (latestDocuments.Count == 0)
        {
            <div class="empty-inline">
                <p>هنوز مدرکی ارسال نشده است.</p>
            </div>
        }
        else
        {
            <div class="latest-docs-table-wrap">
                <table class="latest-docs-table">
                    <thead>
                        <tr>
                            <th>فروشگاه</th>
                            <th>عنوان / نوع</th>
                            <th>تاریخ ارسال</th>
                            <th>وضعیت</th>
                            <th>اقدام</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in latestDocuments)
                        {
                            <tr>
                                <td>@item.StoreName</td>
                                <td>
                                    <span class="doc-type-badge">@GetDocumentTypeLabel(item.DocumentType)</span>
                                    @item.Title
                                </td>
                                <td>@PersianDateHelper.ToPersianDateTimeString(item.UploadedAt)</td>
                                <td>
                                    @if (item.IsApproved)
                                    {
                                        <span class="badge badge-success">تایید شده</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">در انتظار تایید</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn-go" @onclick="@(() => ViewStoreDocuments(item.StoreId))">
                                        مدیریت
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="stores-section">
        <h3 class="section-title">لیست فروشگاه‌ها</h3>
        @if (loading)
        {
            <div class="loading">
                <div class="spinner"></div>
                <p>در حال بارگذاری...</p>
            </div>
        }
        else
        {
            var listToShow = filteredStores;
            <div class="stores-list">
                @foreach (var store in listToShow)
                {
                    var pendingForStore = GetPendingCountForStore(store.StoreID);
                    <div class="store-item">
                        <div class="store-info">
                            <h3>@store.StoreName</h3>
                            <p>شناسه: @store.StoreID @(pendingForStore > 0 ? $" · {pendingForStore} مدرک در حال بررسی" : "")</p>
                        </div>
                        <div class="store-actions">
                            <button class="btn-view-docs" @onclick="@(() => ViewStoreDocuments(store.StoreID))">
                                📄 مشاهده مدارک و گالری
                            </button>
                        </div>
                    </div>
                }
            </div>
            @if (listToShow.Count == 0)
            {
                <div class="empty-inline">
                    @if (!string.IsNullOrWhiteSpace(appliedSearchStoreName))
                    {
                        <p>نتیجه‌ای برای «@appliedSearchStoreName» یافت نشد.</p>
                    }
                    else if (appliedFilterValue == "withDocs")
                    {
                        <p>هیچ فروشگاهی با مدارک تایید شده یا در حال بررسی یافت نشد.</p>
                    }
                    else
                    {
                        <p>هیچ فروشگاهی در لیست نیست.</p>
                    }
                </div>
            }
        }
    </div>
</div>

<style>
    .documents-header {
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 2px solid #e5e7eb;
    }
    .filter-section { margin-top: 12px; }
    .filter-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }
    .filter-label { font-size: 14px; color: #374151; font-weight: 500; }
    .filter-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
    .filter-btn {
        padding: 8px 16px;
        border: 2px solid #d1d5db;
        border-radius: 8px;
        font-size: 14px;
        background: #fff;
        color: #374151;
        cursor: pointer;
        transition: all 0.2s;
    }
    .filter-btn:hover {
        border-color: #2563eb;
        color: #2563eb;
    }
    .filter-btn-active {
        background: #2563eb;
        border-color: #2563eb;
        color: #fff;
    }
    .btn-apply {
        padding: 8px 18px;
        background: #059669;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
    }
    .btn-apply:hover { background: #047857; }
    .search-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
    .search-label { font-size: 14px; color: #374151; }
    .search-input {
        padding: 8px 12px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 14px;
        min-width: 220px;
        direction: rtl;
    }
    .pending-badge {
        font-size: 0.85rem;
        font-weight: normal;
        color: #b45309;
        background: #fef3c7;
        padding: 2px 10px;
        border-radius: 8px;
        margin-right: 8px;
    }

    .stores-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .store-item {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.2s;
    }

    .store-item:hover {
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .store-info h3 {
        margin: 0 0 8px 0;
        font-size: 18px;
        color: #1f2937;
    }

    .store-info p {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
    }

    .btn-view-docs {
        background: #2563eb;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.2s;
    }

    .btn-view-docs:hover {
        background: #1d4ed8;
    }
</style>

@code {
    private List<Store> stores = new();
    private Dictionary<int, List<StoreDocument>> storeDocumentsMap = new();
    private List<StoreDocumentWithStoreDto> latestDocuments = new();
    private bool loading = true;
    private bool loadingLatest = true;
    private string filterStoresWithDocsValue = "all";
    private string appliedFilterValue = "all";
    private string searchStoreName = "";
    private string appliedSearchStoreName = "";
    private int totalPendingCount = 0;

    private List<Store> filteredStores
    {
        get
        {
            var list = appliedFilterValue == "withDocs"
                ? stores.Where(s => HasAnyDocApprovedOrPending(s.StoreID)).ToList()
                : stores;
            if (!string.IsNullOrWhiteSpace(appliedSearchStoreName))
            {
                var term = appliedSearchStoreName.Trim();
                list = list.Where(s => (s.StoreName ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            return list;
        }
    }

    private void SetFilter(string value)
    {
        filterStoresWithDocsValue = value;
        StateHasChanged();
    }

    private void ApplyFilter()
    {
        appliedFilterValue = filterStoresWithDocsValue;
        appliedSearchStoreName = searchStoreName?.Trim() ?? "";
        StateHasChanged();
    }

    private void OnSearchKeyPress(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ApplyFilter();
    }

    private bool HasAnyDocApprovedOrPending(int storeId)
    {
        if (!storeDocumentsMap.TryGetValue(storeId, out var docs) || docs == null) return false;
        return docs.Any(d => d.DocumentType != "گالری" && d.DocumentType != "کاور");
    }

    private int GetPendingCountForStore(int storeId)
    {
        if (!storeDocumentsMap.TryGetValue(storeId, out var docs) || docs == null) return 0;
        return docs.Count(d => d.DocumentType != "گالری" && d.DocumentType != "کاور" && !d.IsApproved);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadStores();
        await LoadLatestDocuments();
    }

    private async Task LoadStores()
    {
        loading = true;
        try
        {
            stores = await StoreService.GetAllAsync() ?? new List<Store>();
            if (stores.Count > 0)
            {
                var docTasks = stores.Select(s => StoreDocumentService.GetByStoreIdAsync(s.StoreID)).ToList();
                var docLists = await Task.WhenAll(docTasks);
                storeDocumentsMap = stores.Zip(docLists, (s, list) => (s.StoreID, list ?? new List<StoreDocument>()))
                    .ToDictionary(x => x.StoreID, x => x.Item2);
                totalPendingCount = storeDocumentsMap.Values.Sum(list =>
                    list.Count(d => d.DocumentType != "گالری" && d.DocumentType != "کاور" && !d.IsApproved));
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadLatestDocuments()
    {
        loadingLatest = true;
        try
        {
            latestDocuments = await StoreDocumentService.GetLatestAsync(10);
        }
        catch
        {
            latestDocuments = new List<StoreDocumentWithStoreDto>();
        }
        finally
        {
            loadingLatest = false;
        }
    }

    private static string GetDocumentTypeLabel(string documentType)
    {
        return documentType switch
        {
            "گالری" => "گالری",
            "پروفایل" => "پروفایل مغازه",
            "کاور" => "کاور پروفایل",
            "جواز کسب" => "جواز کسب",
            "اجاره نامه" => "اجاره نامه",
            "پروانه بهداشت" => "پروانه بهداشت",
            "مدارک هویتی" => "مدارک هویتی",
            "سایر" => "سایر",
            _ => string.IsNullOrEmpty(documentType) ? "-" : documentType
        };
    }

    private void ViewStoreDocuments(int storeId)
    {
        Nav.NavigateTo($"/admin/store-documents/{storeId}");
    }
}
