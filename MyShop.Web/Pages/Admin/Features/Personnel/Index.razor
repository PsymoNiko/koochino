@page "/admin/personnel"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Personnel
@using MyShop.Application.Interfaces.Companies
@using MyShop.Core.Models.Personnel
@using MyShop.Core.Models.Companies
@using MyShop.Core.Helpers
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <h1 class="page-title">لیست پرسنل</h1>
        <div style="display: flex; align-items: center; gap: 8px;">
            <span>شرکت:</span>
            <select class="form-control" style="min-width: 160px;" value="@filterCompanyId" @onchange="OnCompanyFilterChange">
                <option value="0">همه</option>
                @foreach (var c in companies) { <option value="@c.Id">@c.Name</option> }
            </select>
            @if (Auth?.CanCreate("Personnel") == true)
            {
                <a href="/admin/personnel/create" class="btn-primary" style="display: inline-block; padding: 10px 20px; background: #dc2626; color: white; text-decoration: none; border-radius: 8px;">➕ ایجاد پرسنل</a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(message.Contains("موفق") ? "alert-success" : "alert-danger")" style="padding: 12px; border-radius: 8px; margin-bottom: 16px;">@message</div>
    }

    @if (loading)
    {
        <p>در حال بارگذاری...</p>
    }
    else if (items == null || !items.Any())
    {
        <p class="text-muted">هیچ پرسنلی یافت نشد.@if (Auth?.CanCreate("Personnel") == true) { <a href="/admin/personnel/create">ایجاد پرسنل جدید</a> }</p>
    }
    else
    {
        <div class="table__box">
            <table class="table">
                <thead>
                    <tr class="title-row">
                        <th>نام</th>
                        <th>شرکت</th>
                        <th>سمت</th>
                        <th>بخش</th>
                        <th>تلفن</th>
                        <th>تاریخ استخدام</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in items)
                    {
                        <tr>
                            <td>@x.FullName</td>
                            <td>@GetCompanyName(x.CompanyId)</td>
                            <td>@(x.Position ?? "-")</td>
                            <td>@(x.Department ?? "-")</td>
                            <td>@(x.Phone ?? "-")</td>
                            <td>@(x.HireDate.HasValue ? PersianDateHelper.ToPersianDateString(x.HireDate.Value) : "-")</td>
                            <td>@(x.IsActive ? "فعال" : "غیرفعال")</td>
                            <td>
                                @if (Auth?.CanUpdate("Personnel") == true)
                                {
                                    <a href="/admin/personnel/edit/@x.Id" class="btn-edit" style="margin-left: 8px;">ویرایش</a>
                                }
                                @if (Auth?.CanDelete("Personnel") == true)
                                {
                                    <button type="button" class="btn-delete" @onclick="() => Delete(x.Id)">حذف</button>
                                }
                                @if (Auth?.CanUpdate("Personnel") != true && Auth?.CanDelete("Personnel") != true)
                                {
                                    <span>—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [CascadingParameter] public AdminAuthState Auth { get; set; }
    [Inject] private IPersonnelService Service { get; set; }
    [Inject] private ICompanyService CompanyService { get; set; }
    [Inject] private NavigationManager Nav { get; set; }
    [Inject] private IJSRuntime JSRuntime { get; set; }

    private List<PersonnelDto> items;
    private List<CompanyDto> companies = new();
    private int filterCompanyId;
    private bool loading = true;
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        companies = await CompanyService.GetAllAsync();
        await Load();
    }

    private void OnCompanyFilterChange(ChangeEventArgs e)
    {
        _ = int.TryParse(e.Value?.ToString(), out filterCompanyId);
        _ = InvokeAsync(Load);
    }

    private string GetCompanyName(int? id) => id == null ? "-" : (companies.FirstOrDefault(c => c.Id == id)?.Name ?? "-");

    private async Task Load()
    {
        loading = true;
        try
        {
            items = await Service.GetAllAsync(null, filterCompanyId > 0 ? filterCompanyId : null, null);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Delete(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "آیا از حذف این پرسنل اطمینان دارید؟"))
            return;
        var ok = await Service.DeleteAsync(id);
        message = ok ? "حذف با موفقیت انجام شد." : "خطا در حذف.";
        await Load();
    }
}
