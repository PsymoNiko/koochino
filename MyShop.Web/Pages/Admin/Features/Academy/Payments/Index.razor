@page "/admin/academy/payments"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <h1 class="page-title">پرداخت شهریه</h1>
        <div style="display:flex;gap:8px;">
            <a href="/admin/academy" class="btn-secondary">بازگشت</a>
            <a href="/admin/academy/enrollments" class="btn-secondary">ثبت‌نام‌ها</a>
        </div>
    </div>
    <div class="form-group" style="max-width:220px;margin-bottom:16px;">
        <label>وضعیت</label>
        <select class="form-control" @bind="filterStatus" @bind:after="Reload">
            <option value="">همه</option>
            <option value="@AcademyConstants.PaymentStatus.Pending">Pending</option>
            <option value="@AcademyConstants.PaymentStatus.Paid">Paid</option>
            <option value="@AcademyConstants.PaymentStatus.Failed">Failed</option>
            <option value="@AcademyConstants.PaymentStatus.Cancelled">Cancelled</option>
        </select>
    </div>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(ok ? "alert-success" : "alert-danger")" style="padding:12px;border-radius:8px;margin-bottom:16px;">@message</div>
    }
    @if (loading) { <p>در حال بارگذاری...</p> }
    else if (!items.Any()) { <p class="text-muted">پرداختی ثبت نشده.</p> }
    else
    {
        <div class="table__box"><table class="table">
            <thead>
                <tr class="title-row">
                    <th>دانش‌آموز</th><th>دوره</th><th>مبلغ</th><th>وضعیت</th><th>منبع</th><th>درگاه</th><th>پیگیری</th><th>تاریخ</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var x in items)
            {
                <tr>
                    <td>@x.StudentName<br/><small>@x.StudentPhone</small></td>
                    <td>@x.CourseTitle</td>
                    <td>@x.Amount.ToString("N0")</td>
                    <td>@StatusFa(x.Status)</td>
                    <td>@(x.Source == AcademyConstants.PaymentSource.Manual ? "نقدی" : "درگاه")</td>
                    <td>@(x.Gateway ?? "—")</td>
                    <td>@(x.GatewayRef ?? x.Authority ?? "—")</td>
                    <td>@(x.PaidAt?.ToString("yyyy/MM/dd HH:mm") ?? x.CreatedAt.ToString("yyyy/MM/dd HH:mm"))</td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</div>

@code {
    [Inject] IAcademyPaymentService PaymentSvc { get; set; }
    List<AcademyPaymentDto> items = new();
    string filterStatus = "", message = "";
    bool loading = true, ok;

    protected override Task OnInitializedAsync() => Reload();

    private async Task Reload()
    {
        loading = true; message = "";
        try
        {
            items = await PaymentSvc.GetAllAsync(status: string.IsNullOrWhiteSpace(filterStatus) ? null : filterStatus) ?? new();
        }
        catch { ok = false; message = "اسکریپت sql/Academy_Phase9_Payments.sql را اجرا کنید."; }
        loading = false;
    }

    private static string StatusFa(string s) => s switch
    {
        AcademyConstants.PaymentStatus.Pending => "در انتظار",
        AcademyConstants.PaymentStatus.Paid => "پرداخت شده",
        AcademyConstants.PaymentStatus.Failed => "ناموفق",
        AcademyConstants.PaymentStatus.Cancelled => "لغو شده",
        _ => s
    };
}
