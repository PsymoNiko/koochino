@page "/admin/academy/lessons"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <h1 class="page-title">درس و آزمون دوره‌ها</h1>
        <a href="/admin/academy" class="btn-secondary">بازگشت</a>
    </div>
    <p style="color:#64748b;">محتوا و آزمون روی همان دوره آموزشگاه است. Entity جدا ساخته نشده.</p>
    @if (loading) { <p>در حال بارگذاری...</p> }
    else if (items.Count == 0) { <p>دوره‌ای نیست. ابتدا از <a href="/admin/academy/courses">دوره‌ها</a> بسازید.</p> }
    else
    {
        <div class="table__box"><table class="table">
            <thead><tr class="title-row"><th>دوره</th><th>وضعیت</th><th>درس و آزمون</th></tr></thead>
            <tbody>
            @foreach (var x in items)
            {
                <tr>
                    <td>@x.Title</td>
                    <td>@(x.IsActive ? "فعال" : "غیرفعال")</td>
                    <td>
                        <a href="/admin/academy/courses/@x.Id/lessons" class="btn-edit">درس‌ها</a>
                        <a href="/admin/academy/courses/@x.Id/quiz" class="btn-edit">آزمون</a>
                        <a href="/academy/courses/@x.Id">نمای دانش‌آموز</a>
                    </td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</div>
@code {
    [Inject] IAcademyCourseService Courses { get; set; }
    List<AcademyCourseDto> items = new();
    bool loading = true;
    protected override async Task OnInitializedAsync()
    {
        try { items = await Courses.GetAllAsync() ?? new(); }
        catch { items = new(); }
        loading = false;
    }
}
