@page "/admin/academy/points"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
        <h1 class="page-title">امتیاز آموزشگاه</h1>
        <a href="/admin/academy" class="btn-secondary">بازگشت</a>
    </div>
    <p style="color:#64748b;margin-bottom:16px;">جدا از امتیاز فروشگاه. حضور +۵، ارزیابی +۲۰، قبولی آزمون +۳۰، تکمیل دوره +۵۰.</p>
    @if (loading) { <p>در حال بارگذاری...</p> }
    else if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-danger" style="padding:12px;border-radius:8px;">@message</div>
    }
    else
    {
        <div class="table__box"><table class="table">
            <thead><tr class="title-row"><th>#</th><th>دانش‌آموز</th><th>امتیاز</th></tr></thead>
            <tbody>
            @{ var n = 1; }
            @foreach (var x in board)
            {
                <tr><td>@(n++)</td><td>@x.StudentName</td><td>@x.Balance</td></tr>
            }
            </tbody>
        </table></div>
    }
</div>

@code {
    [Inject] IAcademyPointsService PointSvc { get; set; }
    List<AcademyPointEntryDto> board = new();
    bool loading = true;
    string message = "";

    protected override async Task OnInitializedAsync()
    {
        try { board = await PointSvc.GetLeaderboardAsync(30) ?? new(); }
        catch { message = "اسکریپت sql/Academy_Phase16_Points.sql را اجرا کنید."; }
        loading = false;
    }
}
