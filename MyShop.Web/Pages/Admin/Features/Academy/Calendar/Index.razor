@page "/admin/academy/calendar"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@using MyShop.Web.Components
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <h1 class="page-title">تقویم جلسات</h1>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a href="/admin/academy/courses" class="btn-secondary">دوره‌ها</a>
            <a href="/admin/academy/sessions" class="btn-secondary">جلسات فعالیت</a>
            <a href="/admin/academy" class="btn-secondary">بازگشت</a>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-danger" style="padding:12px;border-radius:8px;margin-bottom:16px;">@message</div>
    }
    <AcademyCalendarView Events="events" Loading="loading" Viewer="Admin" RangeChanged="LoadRange" />
</div>

@code {
    [Inject] IAcademyCalendarService CalendarSvc { get; set; }
    List<AcademyCalendarEventDto> events = new();
    bool loading = true;
    string message = "";

    private async Task LoadRange(AcademyCalendarRange range)
    {
        loading = true;
        message = "";
        try
        {
            events = await CalendarSvc.GetAsync(range.From, range.To) ?? new();
        }
        catch
        {
            message = "اسکریپت sql/Academy_Phase12_Calendar.sql را اجرا کنید.";
            events = new();
        }
        loading = false;
    }
}
