@page "/admin/academy/requests/create"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding:24px;">
    <h1 class="page-title">ثبت درخواست فعالیت (ادمین)</h1>
    @if (!string.IsNullOrEmpty(message)) { <div class="alert @(ok?"alert-success":"alert-danger")" style="padding:12px;border-radius:8px;margin:16px 0;">@message</div> }
    <EditForm Model="model" OnValidSubmit="Submit">
        <div class="form-group">
            <label>جلسه</label>
            <select class="form-control" @bind="model.SessionId">
                <option value="0">—</option>
                @foreach (var s in sessions)
                {
                    <option value="@s.Id">@s.ActivityTitle — @s.StartsAt.ToString("yyyy/MM/dd HH:mm") (@s.Status)</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label>دانش‌آموز</label>
            <select class="form-control" @bind="model.StudentId">
                <option value="0">—</option>
                @foreach (var st in students) { <option value="@st.Id">@(st.FullName ?? st.PhoneNumber) (#@st.Id)</option> }
            </select>
        </div>
        <div class="form-group"><label>یادداشت دانش‌آموز</label><InputTextArea @bind-Value="model.StudentNote" class="form-control" rows="2" /></div>
        <div style="display:flex;gap:12px;margin-top:20px;">
            <button type="submit" class="btn-primary">ثبت</button>
            <a href="/admin/academy/requests" class="btn-secondary">انصراف</a>
        </div>
    </EditForm>
</div>
@code {
    [Inject] IAcademyActivityRequestService Service { get; set; }
    [Inject] IAcademyActivitySessionService Sessions { get; set; }
    [Inject] IAcademyStudentService Students { get; set; }
    [Inject] NavigationManager Nav { get; set; }
    CreateAcademyActivityRequestDto model = new();
    List<AcademyActivitySessionDto> sessions = new();
    List<AcademyStudentDto> students = new();
    string message = ""; bool ok;
    protected override async Task OnInitializedAsync()
    {
        sessions = await Sessions.GetAllAsync() ?? new();
        students = await Students.GetAllAsync(status: "Active") ?? new();
    }
    private async Task Submit()
    {
        var r = await Service.CreateAsync(model);
        ok = r.Ok; message = r.Ok ? "ثبت شد." : (r.Error ?? "خطا");
        if (r.Ok) Nav.NavigateTo("/admin/academy/requests");
    }
}
