@page "/admin/academy/requests"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <h1 class="page-title">درخواست‌های فعالیت</h1>
        <div style="display:flex;gap:8px;">
            <a href="/admin/academy" class="btn-secondary">بازگشت</a>
            @if (Auth?.CanCreate("Academy") == true)
            {
                <a href="/admin/academy/requests/create" class="btn-primary" style="display:inline-block;padding:10px 20px;background:#dc2626;color:#fff;text-decoration:none;border-radius:8px;">ثبت درخواست</a>
            }
        </div>
    </div>
    @if (!string.IsNullOrEmpty(message)) { <div class="alert @(message.Contains("موفق")||message.Contains("شد")?"alert-success":"alert-danger")" style="padding:12px;border-radius:8px;margin-bottom:16px;">@message</div> }
    @if (loading) { <p>در حال بارگذاری...</p> }
    else if (!items.Any()) { <p class="text-muted">درخواستی نیست.</p> }
    else
    {
        <div class="table__box"><table class="table">
            <thead><tr class="title-row"><th>دانش‌آموز</th><th>فعالیت</th><th>جلسه</th><th>وضعیت</th><th>عملیات</th></tr></thead>
            <tbody>
            @foreach (var x in items)
            {
                <tr>
                    <td>@x.StudentName<br/><small>@x.StudentPhone</small></td>
                    <td>@x.ActivityTitle</td>
                    <td>@x.StartsAt.ToString("yyyy/MM/dd HH:mm")</td>
                    <td>@x.Status</td>
                    <td>
                        @if (x.Status == AcademyConstants.RequestStatus.Pending && Auth?.CanUpdate("Academy") == true)
                        {
                            <button type="button" class="btn-edit" style="margin-left:6px;" @onclick="() => Review(x.Id, AcademyConstants.RequestStatus.Approved)">تأیید</button>
                            <button type="button" class="btn-delete" @onclick="() => Review(x.Id, AcademyConstants.RequestStatus.Rejected)">رد</button>
                        }
                        else { <span>—</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</div>
@code {
    [CascadingParameter] private MyShop.Web.Services.AdminAuthState Auth { get; set; }
    [Inject] IAcademyActivityRequestService Service { get; set; }
    [Inject] NavigationManager Nav { get; set; }
    List<AcademyActivityRequestDto> items = new();
    int? sessionId; bool loading = true; string message = "";
    protected override async Task OnInitializedAsync()
    {
        var q = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (q.TryGetValue("sessionId", out var s) && int.TryParse(s, out var sid)) sessionId = sid;
        try { items = await Service.GetAllAsync(sessionId: sessionId); }
        catch { message = "اسکریپت Phase5 را اجرا کنید."; }
        loading = false;
    }
    private async Task Review(int id, string status)
    {
        var r = await Service.ReviewAsync(new ReviewAcademyActivityRequestDto { Id = id, Status = status });
        message = r.Ok ? $"وضعیت به {status} تغییر کرد." : (r.Error ?? "خطا");
        items = await Service.GetAllAsync(sessionId: sessionId);
    }
}
