@page "/admin/academy/activities/edit/{Id:int}"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@using MyShop.Web.Services
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding:24px;">
    <h1 class="page-title">ویرایش فعالیت</h1>
    @if (loading) { <p>در حال بارگذاری...</p> }
    else if (model == null) { <p>یافت نشد.</p> }
    else
    {
        @if (!string.IsNullOrEmpty(message)) { <div class="alert @(ok?"alert-success":"alert-danger")" style="padding:12px;border-radius:8px;margin:16px 0;">@message</div> }
        <EditForm Model="model" OnValidSubmit="Submit">
            <div class="form-group">
                <label>دسته</label>
                <select class="form-control" @bind="model.CategoryId">
                    @foreach (var c in categories) { <option value="@c.Id">@(string.IsNullOrWhiteSpace(c.ParentName)?c.Name:$"{c.ParentName} / {c.Name}")</option> }
                </select>
            </div>
            <div class="form-group"><label>عنوان</label><InputText @bind-Value="model.Title" class="form-control" /></div>
            <div class="form-group"><label>توضیحات</label><InputTextArea @bind-Value="model.Description" class="form-control" rows="4" /></div>
            <div class="form-group"><label>ترتیب</label><InputNumber @bind-Value="model.SortOrder" class="form-control" /></div>
            <div class="form-group"><label><InputCheckbox @bind-Value="model.IsActive" /> فعال</label></div>
            <div class="form-group">
                <label>تصویر</label>
                <InputFile OnChange="OnFile" accept="image/*" />
                @if (!string.IsNullOrEmpty(model.ImageUrl)) { <img src="@model.ImageUrl" style="max-width:180px;margin-top:8px;border-radius:8px;" /> }
            </div>
            <div style="display:flex;gap:12px;margin-top:20px;">
                <button type="submit" class="btn-primary">ذخیره</button>
                <a href="/admin/academy/activities" class="btn-secondary">انصراف</a>
            </div>
        </EditForm>
    }
</div>
@code {
    [Parameter] public int Id { get; set; }
    [Inject] IAcademyActivityService Service { get; set; }
    [Inject] IAcademyActivityCategoryService Categories { get; set; }
    [Inject] AcademyUploadService Upload { get; set; }
    [Inject] NavigationManager Nav { get; set; }
    UpdateAcademyActivityDto model; List<AcademyActivityCategoryDto> categories = new();
    bool loading = true; string message = ""; bool ok;
    protected override async Task OnInitializedAsync()
    {
        categories = await Categories.GetAllAsync() ?? new();
        var item = await Service.GetByIdAsync(Id);
        if (item != null)
            model = new UpdateAcademyActivityDto { Id = item.Id, SiteId = item.SiteId, CategoryId = item.CategoryId, Title = item.Title, Description = item.Description, ImageUrl = item.ImageUrl, IsActive = item.IsActive, SortOrder = item.SortOrder };
        loading = false;
    }
    private async Task OnFile(InputFileChangeEventArgs e)
    {
        var up = await Upload.UploadActivityAsync(model.Id, e.File);
        if (up.success) model.ImageUrl = up.relativeUrl; else { ok = false; message = up.message; }
    }
    private async Task Submit()
    {
        var r = await Service.UpdateAsync(model);
        ok = r.Ok; message = r.Ok ? "ذخیره شد." : (r.Error ?? "خطا");
        if (r.Ok) Nav.NavigateTo("/admin/academy/activities");
    }
}
