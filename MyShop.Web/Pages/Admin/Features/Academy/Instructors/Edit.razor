@page "/admin/academy/instructors/edit/{Id:int}"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Academy
@using MyShop.Core.Models.Academy
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding: 24px;">
    <h1 class="page-title">ویرایش مربی</h1>
    @if (loading) { <p>در حال بارگذاری...</p> }
    else if (model == null) { <p class="text-muted">یافت نشد.</p> }
    else
    {
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(ok ? "alert-success" : "alert-danger")" style="padding: 12px; border-radius: 8px; margin: 16px 0;">@message</div>
        }
        <p style="color:#64748b; margin-bottom: 12px;">@displayName — UserId: @userId — PersonnelId: @personnelId</p>
        <EditForm Model="model" OnValidSubmit="Submit">
            <div class="form-group"><label>بیو</label><InputTextArea @bind-Value="model.Bio" class="form-control" rows="3" /></div>
            <div class="form-group"><label><InputCheckbox @bind-Value="model.IsActive" /> فعال</label></div>
            <div class="form-group"><label><InputCheckbox @bind-Value="model.MustChangePassword" /> اجبار تغییر رمز</label></div>
            <div class="form-group">
                <label>تخصص‌ها / دسته‌های فعالیت</label>
                @if (categories.Count == 0)
                {
                    <p class="text-muted">هنوز دسته‌ای تعریف نشده. از «دسته‌بندی فعالیت‌ها» اضافه کنید.</p>
                }
                else
                {
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px;margin-top:8px;">
                        @foreach (var c in categories)
                        {
                            var cid = c.Id;
                            <label style="display:flex;align-items:center;gap:8px;border:1px solid #e2e8f0;border-radius:8px;padding:8px 10px;">
                                <input type="checkbox" checked="@selected.Contains(cid)" @onchange="e => Toggle(cid, (bool)e.Value)" />
                                <span>@CategoryLabel(c)</span>
                            </label>
                        }
                    </div>
                }
            </div>
            <div style="display: flex; gap: 12px; margin-top: 20px;">
                <button type="submit" class="btn-primary">ذخیره</button>
                <a href="/admin/academy/instructors" class="btn-secondary">انصراف</a>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Inject] private IAcademyInstructorService Service { get; set; }
    [Inject] private IAcademyActivityCategoryService CategoryService { get; set; }
    [Inject] private NavigationManager Nav { get; set; }
    private UpdateAcademyInstructorDto model;
    private List<AcademyActivityCategoryDto> categories = new();
    private HashSet<int> selected = new();
    private string displayName = "";
    private int userId;
    private int personnelId;
    private bool loading = true;
    private string message = "";
    private bool ok;

    protected override async Task OnInitializedAsync()
    {
        try { categories = await CategoryService.GetAllAsync(isActive: true) ?? new(); }
        catch { categories = new(); }

        var item = await Service.GetByIdAsync(Id);
        if (item != null)
        {
            displayName = item.PersonnelFullName ?? "";
            userId = item.UserId;
            personnelId = item.PersonnelId;
            selected = new HashSet<int>(item.CategoryIds ?? new());
            model = new UpdateAcademyInstructorDto
            {
                Id = item.Id,
                SiteId = item.SiteId,
                Bio = item.Bio,
                IsActive = item.IsActive,
                MustChangePassword = item.MustChangePassword,
                CategoryIds = item.CategoryIds ?? new()
            };
        }
        loading = false;
    }

    private string CategoryLabel(AcademyActivityCategoryDto c)
        => string.IsNullOrWhiteSpace(c.ParentName) ? c.Name : $"{c.ParentName} / {c.Name}";

    private void Toggle(int id, bool on)
    {
        if (on) selected.Add(id); else selected.Remove(id);
    }

    private async Task Submit()
    {
        model.CategoryIds = selected.ToList();
        ok = await Service.UpdateAsync(model);
        message = ok ? "با موفقیت ذخیره شد." : "ذخیره ناموفق بود.";
        if (ok) Nav.NavigateTo("/admin/academy/instructors");
    }
}
