@page "/admin/products/{ProductId:int}/seo"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Commerce
@using MyShop.Core.Interfaces
@using MyShop.Core.Models.Commerce
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding:24px;">
    <h1 class="page-title">سئوی محصول #@ProductId</h1>
    @if (!on) { <p>فلگ CatalogExtensions خاموش است.</p> }
    else
    {
        @if (!string.IsNullOrEmpty(flash)) { <div style="padding:10px;margin-bottom:12px;background:@(ok?"#ecfdf5":"#fef2f2");">@flash</div> }
        <label>Meta Title</label><input class="form-control" @bind="seo.MetaTitle" />
        <label>Meta Description</label><textarea class="form-control" @bind="seo.MetaDescription"></textarea>
        <label>Canonical</label><input class="form-control" @bind="seo.CanonicalUrl" dir="ltr" />
        <label><input type="checkbox" @bind="seo.NoIndex" /> NoIndex</label>
        <label>OG Title</label><input class="form-control" @bind="seo.OpenGraphTitle" />
        <label>OG Description</label><textarea class="form-control" @bind="seo.OpenGraphDescription"></textarea>
        <button type="button" style="margin:8px 0;padding:8px 14px;background:#059669;color:#fff;border:none;border-radius:8px;" @onclick="Save">ذخیره</button>
        <p><a href="/admin/commerce/catalog">بازگشت</a></p>
    }
</div>

@code {
    [Parameter] public int ProductId { get; set; }
    [Inject] ICommerceFeatureFlags Flags { get; set; }
    [Inject] ICommerceProductSeoService Seo { get; set; }
    [Inject] ICurrentTenant Tenant { get; set; }

    bool on, ok;
    string flash;
    CommerceProductSeo seo = new();
    int? SiteId => Tenant?.HasSite == true ? Tenant.SiteId : null;

    protected override async Task OnParametersSetAsync()
    {
        on = Flags.IsEnabled(CommerceConstants.Features.CatalogExtensions);
        if (on)
        {
            try { seo = await Seo.GetAsync(ProductId, SiteId) ?? new CommerceProductSeo { ProductId = ProductId }; }
            catch (Exception ex) { flash = ex.Message; ok = false; }
        }
    }

    async Task Save()
    {
        try
        {
            seo.ProductId = ProductId;
            await Seo.SaveAsync(seo, SiteId);
            ok = true; flash = "ذخیره شد.";
        }
        catch (Exception ex) { ok = false; flash = ex.Message; }
    }
}
