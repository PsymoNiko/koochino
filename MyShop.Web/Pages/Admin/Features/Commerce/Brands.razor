@page "/admin/commerce/brands"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Commerce
@using MyShop.Core.Interfaces
@using MyShop.Core.Models.Commerce
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding:24px;">
    <h1 class="page-title">برندهای کاتالوگ</h1>
    @if (!on)
    {
        <p>فلگ CatalogExtensions خاموش است.</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(flash)) { <div style="padding:10px;margin-bottom:12px;background:@(ok?"#ecfdf5":"#fef2f2");">@flash</div> }
        <div style="background:#fff;padding:16px;border-radius:8px;margin-bottom:16px;">
            <label>نام</label><input class="form-control" @bind="form.Name" />
            <label>Slug</label><input class="form-control" @bind="form.Slug" dir="ltr" />
            <label>لوگو (URL)</label><input class="form-control" @bind="form.LogoUrl" dir="ltr" />
            <label>ترتیب</label><input class="form-control" type="number" @bind="form.SortOrder" />
            <label><input type="checkbox" @bind="form.IsActive" /> فعال</label>
            <button type="button" class="btn-primary" style="margin-top:8px;padding:8px 14px;background:#059669;color:#fff;border:none;border-radius:8px;" @onclick="Save">ذخیره</button>
        </div>
        <table class="table"><thead><tr><th>نام</th><th>Slug</th><th></th></tr></thead>
            <tbody>
            @foreach (var b in items)
            {
                <tr>
                    <td>@b.Name</td><td>@b.Slug</td>
                    <td>
                        <button type="button" @onclick="() => Edit(b)">ویرایش</button>
                        <button type="button" @onclick="() => Del(b.Id)">حذف</button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@code {
    [Inject] ICommerceFeatureFlags Flags { get; set; }
    [Inject] ICommerceBrandService BrandSvc { get; set; }
    [Inject] ICurrentTenant Tenant { get; set; }

    bool on, ok;
    string flash;
    List<CommerceBrand> items = new();
    CommerceBrand form = new() { IsActive = true };
    int? SiteId => Tenant?.HasSite == true ? Tenant.SiteId : null;

    protected override async Task OnInitializedAsync()
    {
        on = Flags.IsEnabled(CommerceConstants.Features.CatalogExtensions);
        if (on) await Reload();
    }

    async Task Reload() => items = await BrandSvc.ListAsync(SiteId) ?? new();

    void Edit(CommerceBrand b) => form = new CommerceBrand
    {
        Id = b.Id, SiteId = b.SiteId, Name = b.Name, Slug = b.Slug, Description = b.Description,
        LogoUrl = b.LogoUrl, IsActive = b.IsActive, SortOrder = b.SortOrder
    };

    async Task Save()
    {
        try
        {
            form.SiteId = SiteId;
            await BrandSvc.SaveAsync(form);
            form = new() { IsActive = true };
            ok = true; flash = "ذخیره شد.";
            await Reload();
        }
        catch (Exception ex) { ok = false; flash = ex.Message; }
    }

    async Task Del(int id)
    {
        try { await BrandSvc.DeleteAsync(id, SiteId); ok = true; flash = "حذف شد."; await Reload(); }
        catch (Exception ex) { ok = false; flash = ex.Message; }
    }
}
