@page "/admin/finance/store-billing/payments"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MyShop.Application.Interfaces.Finance
@using MyShop.Core.Models.Finance
@using System.Security.Claims
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <h1 class="page-title">پرداخت‌های صورتحساب مغازه</h1>
        <a href="/admin/finance/store-billing" class="btn-secondary">بازگشت</a>
    </div>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(ok ? "alert-success" : "alert-danger")" style="padding:12px;border-radius:8px;margin-bottom:16px;">@message</div>
    }
    @if (Auth?.CanCreate("Finance") == true)
    {
        <div style="background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:16px;margin-bottom:20px;max-width:480px;">
            <h3>ثبت پرداخت دستی</h3>
            <div class="form-group"><label>شناسه فاکتور</label><input type="number" class="form-control" @bind="invoiceId" /></div>
            <div class="form-group"><label>مبلغ</label><input type="number" class="form-control" @bind="amount" /></div>
            <div class="form-group"><label>روش</label><input class="form-control" @bind="method" /></div>
            <div class="form-group"><label>پیگیری</label><input class="form-control" @bind="reference" /></div>
            <div class="form-group"><label>یادداشت</label><input class="form-control" @bind="notes" /></div>
            <button type="button" class="btn-primary" @onclick="Save" disabled="@busy">ثبت</button>
        </div>
    }
    @if (loading) { <p>در حال بارگذاری...</p> }
    else if (!items.Any()) { <p class="text-muted">پرداختی ثبت نشده.</p> }
    else
    {
        <div class="table__box"><table class="table">
            <thead><tr class="title-row"><th>فاکتور</th><th>فروشگاه</th><th>مبلغ</th><th>روش</th><th>پیگیری</th><th>تاریخ</th></tr></thead>
            <tbody>
            @foreach (var x in items)
            {
                <tr>
                    <td><a href="/admin/finance/store-billing/invoices/@x.InvoiceId">@(x.InvoiceNumber ?? x.InvoiceId.ToString())</a></td>
                    <td>@x.StoreName</td>
                    <td>@x.Amount.ToString("N0")</td>
                    <td>@(x.Method ?? "—")</td>
                    <td>@(x.Reference ?? "—")</td>
                    <td>@PersianDateHelper.ToPersianDateTimeString(x.PaidAt)</td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</div>

@code {
    [CascadingParameter] public AdminAuthState Auth { get; set; }
    [Inject] IStoreBillingInvoiceService InvoiceSvc { get; set; }
    [Inject] AuthenticationStateProvider AuthProvider { get; set; }
    List<StoreBillingPaymentDto> items = new();
    int invoiceId;
    long amount;
    string method = "دستی", reference = "", notes = "", message = "";
    bool loading = true, busy, ok;

    protected override Task OnInitializedAsync() => Reload();

    private async Task Reload()
    {
        loading = true;
        try
        {
            var uid = Auth?.Effective?.UserId ?? 0;
            items = uid > 0
                ? await InvoiceSvc.ListPaymentsForUserAsync(uid) ?? new()
                : await InvoiceSvc.ListPaymentsAsync() ?? new();
        }
        catch { message = "اسکریپت sql/StoreBilling_Phase5_Payments.sql را اجرا کنید."; }
        loading = false;
    }

    private async Task Save()
    {
        if (Auth?.CanCreate("Finance") != true) return;
        busy = true; message = "";
        var state = await AuthProvider.GetAuthenticationStateAsync();
        int.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid);
        var r = await InvoiceSvc.RecordPaymentAsync(invoiceId, amount, method, reference, notes, uid > 0 ? uid : null);
        ok = r.Ok;
        message = r.Ok ? (r.Message ?? "ثبت شد.") : (r.Error ?? "خطا");
        if (r.Ok) await Reload();
        busy = false;
    }
}
