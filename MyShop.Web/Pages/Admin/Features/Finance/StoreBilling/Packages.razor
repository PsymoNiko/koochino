@page "/admin/finance/store-billing/packages"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Finance
@using MyShop.Core.Models.Finance
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <h1 class="page-title">پکیج‌های کارمزد</h1>
        <a href="/admin/finance/store-billing" class="btn-secondary">بازگشت</a>
    </div>
    <p style="color:#64748b;margin-bottom:16px;">لینک اختیاری به پکیج اشتراک فروشنده؛ وابستگی اجباری نیست.</p>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(ok ? "alert-success" : "alert-danger")" style="padding:12px;border-radius:8px;margin-bottom:16px;">@message</div>
    }
    @if (Auth?.CanCreate("Finance") == true || Auth?.CanUpdate("Finance") == true)
    {
        <div style="background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:16px;margin-bottom:20px;max-width:520px;">
            <h3>@(edit.Id > 0 ? "ویرایش" : "افزودن")</h3>
            <div class="form-group"><label>نام</label><input class="form-control" @bind="edit.Name" /></div>
            <div class="form-group"><label>توضیح</label><input class="form-control" @bind="edit.Description" /></div>
            <div class="form-group"><label>نرخ کارمزد (٪)</label><input type="number" step="0.01" class="form-control" @bind="edit.CommissionRate" /></div>
            <div class="form-group"><label>مهلت پرداخت (روز)</label><input type="number" class="form-control" @bind="edit.PaymentDueDays" /></div>
            <div class="form-group"><label>شناسه پکیج اشتراک (اختیاری)</label><input type="number" class="form-control" @bind="vendorPkgText" /></div>
            <div class="form-group"><label>ترتیب</label><input type="number" class="form-control" @bind="edit.SortOrder" /></div>
            <div class="form-group"><label><input type="checkbox" @bind="edit.IsActive" /> فعال</label></div>
            <button type="button" class="btn-primary" @onclick="Save">ذخیره</button>
            @if (edit.Id > 0) { <button type="button" class="btn-secondary" @onclick="Reset">انصراف</button> }
        </div>
    }
    @if (loading) { <p>در حال بارگذاری...</p> }
    else if (!items.Any()) { <p class="text-muted">پکیجی نیست. اسکریپت Phase 2 را اجرا کنید.</p> }
    else
    {
        <div class="table__box"><table class="table">
            <thead><tr class="title-row"><th>نام</th><th>نرخ</th><th>مهلت</th><th>پکیج اشتراک</th><th>وضعیت</th><th></th></tr></thead>
            <tbody>
            @foreach (var x in items)
            {
                <tr>
                    <td>@x.Name</td>
                    <td>@x.CommissionRate.ToString("0.##")٪</td>
                    <td>@x.PaymentDueDays روز</td>
                    <td>@(x.VendorPackageId?.ToString() ?? "—")</td>
                    <td>@(x.IsActive ? "فعال" : "غیرفعال")</td>
                    <td>
                        @if (Auth?.CanUpdate("Finance") == true)
                        {
                            <button type="button" class="btn-edit" @onclick="() => BeginEdit(x)">ویرایش</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</div>

@code {
    [CascadingParameter] public AdminAuthState Auth { get; set; }
    [Inject] IStoreBillingCatalogService CatalogSvc { get; set; }
    List<StoreBillingPackageDto> items = new();
    StoreBillingPackageDto edit = new() { PaymentDueDays = 10, CommissionRate = 3, IsActive = true };
    string vendorPkgText = "";
    bool loading = true, ok;
    string message = "";

    protected override Task OnInitializedAsync() => Reload();

    private async Task Reload()
    {
        loading = true;
        try { items = await CatalogSvc.ListPackagesAsync() ?? new(); }
        catch { message = "اسکریپت sql/StoreBilling_Phase2_Packages.sql را اجرا کنید."; }
        loading = false;
    }

    private void BeginEdit(StoreBillingPackageDto x)
    {
        edit = new StoreBillingPackageDto
        {
            Id = x.Id, Name = x.Name, Description = x.Description, CommissionRate = x.CommissionRate,
            PaymentDueDays = x.PaymentDueDays, VendorPackageId = x.VendorPackageId, IsActive = x.IsActive, SortOrder = x.SortOrder
        };
        vendorPkgText = x.VendorPackageId?.ToString() ?? "";
    }

    private void Reset()
    {
        edit = new StoreBillingPackageDto { PaymentDueDays = 10, CommissionRate = 3, IsActive = true };
        vendorPkgText = "";
    }

    private async Task Save()
    {
        edit.VendorPackageId = int.TryParse(vendorPkgText, out var v) && v > 0 ? v : null;
        var r = await CatalogSvc.UpsertPackageAsync(edit);
        ok = r.Ok;
        message = r.Ok ? "ذخیره شد." : (r.Error ?? "خطا");
        if (r.Ok) { Reset(); await Reload(); }
    }
}
