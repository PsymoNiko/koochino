@page "/admin/finance/create"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Finance
@using MyShop.Application.Interfaces.Companies
@using MyShop.Core.Models.Finance
@using MyShop.Core.Models.Companies
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding: 24px;">
    <h1 class="page-title">ایجاد حساب مالی</h1>
    @if (!string.IsNullOrEmpty(message)) { <div class="alert @(message.Contains("موفق") ? "alert-success" : "alert-danger")" style="padding: 12px; border-radius: 8px; margin-bottom: 16px;">@message</div> }
    <EditForm Model="@model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <div class="form-group"><label>شرکت</label><select class="form-control" value="@(model.CompanyId ?? 0)" @onchange="OnCompanyChange"><option value="0">—</option>@foreach (var c in companies) { <option value="@c.Id">@c.Name</option> }</select></div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="form-group"><label>کد حساب</label><InputText @bind-Value="model.Code" class="form-control" /></div>
            <div class="form-group"><label>نام حساب</label><InputText @bind-Value="model.Name" class="form-control" /></div>
        </div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="form-group"><label>نوع</label><InputText @bind-Value="model.Type" class="form-control" placeholder="مثلاً معین / کل" /></div>
            <div class="form-group"><label>واحد پول</label><InputText @bind-Value="model.Currency" class="form-control" placeholder="مثلاً IRR" /></div>
        </div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="form-group"><label>مانده اولیه</label><InputNumber @bind-Value="model.Balance" class="form-control" /></div>
            <div class="form-group"><label>ترتیب</label><InputNumber @bind-Value="model.SortOrder" class="form-control" /></div>
        </div>
        <div class="form-group"><label>فعال</label><InputCheckbox @bind-Value="model.IsActive" class="form-control" /></div>
        <div style="display: flex; gap: 12px; margin-top: 20px;"><button type="submit" class="btn-primary">ذخیره</button><a href="/admin/finance" class="btn-secondary">انصراف</a></div>
    </EditForm>
</div>
@code {
    [Inject] private IFinanceAccountService Service { get; set; }
    [Inject] private ICompanyService CompanyService { get; set; }
    [Inject] private NavigationManager Nav { get; set; }
    private CreateFinanceAccountDto model = new CreateFinanceAccountDto { IsActive = true };
    private List<CompanyDto> companies = new();
    private string message = "";
    protected override async Task OnInitializedAsync() => companies = await CompanyService.GetAllAsync();
    private void OnCompanyChange(ChangeEventArgs e) { model.CompanyId = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : null; }
    private async Task Submit() { message = ""; var id = await Service.CreateAsync(model); if (id > 0) { message = "حساب با موفقیت ایجاد شد."; Nav.NavigateTo("/admin/finance"); } else message = "خطا در ایجاد."; }
}
