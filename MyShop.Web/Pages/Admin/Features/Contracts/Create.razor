@page "/admin/contracts/create"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Contracts
@using MyShop.Application.Interfaces.Companies
@using MyShop.Core.Models.Contracts
@using MyShop.Core.Models.Companies
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding: 24px;">
    <h1 class="page-title">ایجاد قرارداد</h1>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(message.Contains("موفق") ? "alert-success" : "alert-danger")" style="padding: 12px; border-radius: 8px; margin-bottom: 16px;">@message</div>
    }

    <EditForm Model="@model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <div class="form-group"><label>شرکت</label><select class="form-control" value="@(model.CompanyId ?? 0)" @onchange="OnCompanyChange"><option value="0">—</option>@foreach (var c in companies) { <option value="@c.Id">@c.Name</option> }</select></div>
        <div class="form-group">
            <label>شماره قرارداد</label>
            <InputText @bind-Value="model.ContractNo" class="form-control" />
        </div>
        <div class="form-group">
            <label>عنوان</label>
            <InputText @bind-Value="model.Title" class="form-control" />
        </div>
        <div class="form-group">
            <label>طرف قرارداد</label>
            <InputText @bind-Value="model.PartyName" class="form-control" />
        </div>
        <div class="form-group">
            <label>تماس طرف قرارداد</label>
            <InputText @bind-Value="model.PartyContact" class="form-control" />
        </div>
        <div class="form-group">
            <label>تلفن</label>
            <InputText @bind-Value="model.PartyPhone" class="form-control" />
        </div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="form-group">
                <label>تاریخ شروع</label>
                <InputDate @bind-Value="model.StartDate" class="form-control" />
            </div>
            <div class="form-group">
                <label>تاریخ پایان</label>
                <InputDate @bind-Value="model.EndDate" class="form-control" />
            </div>
        </div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="form-group">
                <label>مبلغ</label>
                <InputNumber @bind-Value="model.Value" class="form-control" />
            </div>
            <div class="form-group">
                <label>واحد پول</label>
                <InputText @bind-Value="model.Currency" class="form-control" placeholder="مثلاً IRR" />
            </div>
        </div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="form-group">
                <label>وضعیت</label>
                <InputText @bind-Value="model.Status" class="form-control" placeholder="فعال / منقضی / ..." />
            </div>
            <div class="form-group">
                <label>نوع</label>
                <InputText @bind-Value="model.Type" class="form-control" />
            </div>
        </div>
        <div class="form-group">
            <label>یادآوری (روز قبل از انقضا)</label>
            <InputNumber @bind-Value="model.ReminderDays" class="form-control" />
        </div>
        <div class="form-group">
            <label>آدرس سند</label>
            <InputText @bind-Value="model.DocumentUrl" class="form-control" />
        </div>
        <div class="form-group">
            <label>توضیحات</label>
            <InputTextArea @bind-Value="model.Notes" class="form-control" rows="3" />
        </div>
        <div style="display: flex; gap: 12px; margin-top: 20px;">
            <button type="submit" class="btn-primary">ذخیره</button>
            <a href="/admin/contracts" class="btn-secondary">انصراف</a>
        </div>
    </EditForm>
</div>

@code {
    [Inject] private IContractService Service { get; set; }
    [Inject] private ICompanyService CompanyService { get; set; }
    [Inject] private NavigationManager Nav { get; set; }
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; }

    private CreateContractDto model = new CreateContractDto();
    private List<CompanyDto> companies = new();
    private string message = "";
    protected override async Task OnInitializedAsync() => companies = await CompanyService.GetAllAsync();
    private void OnCompanyChange(ChangeEventArgs e) { model.CompanyId = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : null; }

    private async Task Submit()
    {
        message = "";
        int? createdBy = null;
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst("UserId")?.Value;
        if (int.TryParse(userId, out var uid)) createdBy = uid;
        var id = await Service.CreateAsync(model, createdBy);
        if (id > 0)
        {
            message = "قرارداد با موفقیت ایجاد شد.";
            Nav.NavigateTo("/admin/contracts");
        }
        else
            message = "خطا در ایجاد قرارداد.";
    }
}
