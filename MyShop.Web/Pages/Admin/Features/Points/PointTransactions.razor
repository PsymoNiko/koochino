@page "/admin/point-transactions"
@layout AdminLayout

@using MyShop.Application.Interfaces
@using MyShop.Core.Models.Dto
@using System.Security.Claims
@using Microsoft.JSInterop
@using MyShop.Application.Interfaces.AdminAccess
@using MyShop.Core.Models.AdminAccess
@inject IPointService PointService
@inject IAdminPermissionService AdminPerms
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<div class="container-content" dir="rtl" lang="fa">
    <div class="transactions-header">
        <h2>📊 تراکنش‌های امتیاز</h2>
        <div class="filter-tabs">
            <button class="tab-btn @(filterStatus == null ? "active" : "")" @onclick="@(() => SetFilter(null))">
                همه
            </button>
            <button class="tab-btn @(filterStatus == "Pending" ? "active" : "")" @onclick="@(() => SetFilter("Pending"))">
                در انتظار تایید (@pendingCount)
            </button>
            <button class="tab-btn @(filterStatus == "Approved" ? "active" : "")" @onclick="@(() => SetFilter("Approved"))">
                تایید شده
            </button>
            <button class="tab-btn @(filterStatus == "Rejected" ? "active" : "")" @onclick="@(() => SetFilter("Rejected"))">
                رد شده
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger")">
            @message
        </div>
    }

    @if (loading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else if (transactions == null || transactions.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">📭</div>
            <p>تراکنشی یافت نشد</p>
        </div>
    }
    else
    {
        <div class="transactions-table">
            <table class="table">
                <thead>
                    <tr>
                        <th>کاربر</th>
                        <th>ماموریت</th>
                        <th>نوع</th>
                        <th>امتیاز</th>
                        <th>علت</th>
                        <th>وضعیت</th>
                        <th>تاریخ</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in transactions)
                    {
                        <tr class="@transaction.Status.ToLower()">
                            <td>
                                <div class="user-info">
                                    <strong>@transaction.UserName</strong>
                                    <small>@transaction.UserPhoneNumber</small>
                                </div>
                            </td>
                            <td>@(transaction.MissionTitle ?? "-")</td>
                            <td>@GetMissionTypeText(transaction.MissionType)</td>
                            <td><strong class="points-amount">@transaction.Points</strong></td>
                            <td>@transaction.Reason</td>
                            <td>
                                <span class="status-badge @transaction.Status.ToLower()">
                                    @transaction.StatusText
                                </span>
                            </td>
                            <td>@PersianDateHelper.ToPersianDateTimeString(transaction.CreatedAt)</td>
                            <td>
                                @if (transaction.Status == "Pending")
                                {
                                    <button class="btn-sm btn-approve" @onclick="@(() => ApproveTransaction(transaction.Id))">
                                        تایید
                                    </button>
                                    <button class="btn-sm btn-reject" @onclick="@(() => ShowRejectModal(transaction))">
                                        رد
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (showRejectModal)
    {
        <div class="modal-overlay" @onclick="HideRejectModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>رد تراکنش</h3>
                    <button class="modal-close" @onclick="HideRejectModal">×</button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>دلیل رد (اختیاری)</label>
                        <textarea class="form-control" @bind="rejectNotes" rows="3" placeholder="دلیل رد این تراکنش را وارد کنید..."></textarea>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-secondary" @onclick="HideRejectModal" disabled="@saving">انصراف</button>
                        <button type="button" class="btn-danger" @onclick="ConfirmReject" disabled="@saving">
                            @if (saving)
                            {
                                <span class="spinner-small"></span>
                            }
                            <span>رد تراکنش</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<PointTransactionDto> transactions = new();
    private PointTransactionDto selectedTransaction;
    private bool loading = true;
    private bool saving = false;
    private string filterStatus = null;
    private string message = "";
    private bool isSuccess = true;
    private bool showRejectModal = false;
    private string rejectNotes = "";
    private int pendingCount = 0;
    private int adminUserId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/Account/login-admin", true);
            return;
        }

        var uid = int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
        if (uid <= 0 || !await AdminPerms.HasAsync(uid, "Points", AdminPermissionActions.Read))
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        adminUserId = uid;
        await LoadTransactions();
    }

    private async Task LoadTransactions()
    {
        loading = true;
        try
        {
            transactions = await PointService.GetAllTransactionsAsync(0, 100, filterStatus);
            
            // محاسبه تعداد در انتظار تایید
            var pending = await PointService.GetPendingTransactionsAsync(0, 1);
            pendingCount = pending.Count;
        }
        catch
        {
            transactions = new List<PointTransactionDto>();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SetFilter(string status)
    {
        filterStatus = status;
        await LoadTransactions();
    }

    private async Task ApproveTransaction(int transactionId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "آیا از تایید این تراکنش اطمینان دارید؟"))
        {
            return;
        }

        saving = true;
        message = "";

        try
        {
            var result = await PointService.ApproveTransactionAsync(transactionId, adminUserId);
            isSuccess = result.Success;
            message = result.Message;
            
            if (isSuccess)
            {
                await LoadTransactions();
            }
        }
        catch
        {
            isSuccess = false;
            message = "خطا در تایید تراکنش";
        }
        finally
        {
            saving = false;
        }
    }

    private void ShowRejectModal(PointTransactionDto transaction)
    {
        selectedTransaction = transaction;
        rejectNotes = "";
        showRejectModal = true;
    }

    private void HideRejectModal()
    {
        showRejectModal = false;
        selectedTransaction = null;
        rejectNotes = "";
    }

    private async Task ConfirmReject()
    {
        if (selectedTransaction == null) return;

        saving = true;
        message = "";

        try
        {
            var result = await PointService.RejectTransactionAsync(selectedTransaction.Id, adminUserId, rejectNotes);
            isSuccess = result.Success;
            message = result.Message;
            
            if (isSuccess)
            {
                await LoadTransactions();
                HideRejectModal();
            }
        }
        catch
        {
            isSuccess = false;
            message = "خطا در رد تراکنش";
        }
        finally
        {
            saving = false;
        }
    }

    private string GetMissionTypeText(string missionType)
    {
        return missionType switch
        {
            "PurchaseRating" => "امتیاز به خرید",
            "StoreComment" => "نظر در فروشگاه",
            "PurchaseAmount" => "خرید مبلغ مشخص",
            "Custom" => "سفارشی",
            _ => missionType
        };
    }
}

<style>
