        margin: 0 0 16px 0;
        font-size: 24px;
        font-weight: 700;
        color: #1f2937;
    }

    .filter-tabs {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .tab-btn {
        padding: 8px 16px;
        border: 2px solid #e5e7eb;
