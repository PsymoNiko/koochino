@page "/admin/user-points"
@layout AdminLayout

@using MyShop.Application.Interfaces
@using MyShop.Core.Models
@using System.Security.Claims
@using UserPointsModel = MyShop.Core.Models.UserPoints
@using MyShop.Application.Interfaces.AdminAccess
@using MyShop.Core.Models.AdminAccess
@inject IPointService PointService
@inject IAdminPermissionService AdminPerms
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<div class="container-content" dir="rtl" lang="fa">
    <div class="points-header">
        <h2>🏆 امتیازهای کاربران</h2>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;">
            <a href="/admin/vip-tiers">سطح VIP</a>
            <a href="/admin/wallet">کیف پول</a>
            <a href="/admin/segments">سگمنت / RFM</a>
        </div>
    </div>

    @if (loading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else if (userPointsList == null || userPointsList.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">📊</div>
            <p>اطلاعاتی یافت نشد</p>
        </div>
    }
    else
    {
        <div class="points-table">
            <table class="table">
                <thead>
                    <tr>
                        <th>رتبه</th>
                        <th>کاربر</th>
                        <th>کل امتیاز</th>
                        <th>قابل استفاده</th>
                        <th>در انتظار</th>
                        <th>آخرین به‌روزرسانی</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rank = 1; }
                    @foreach (var userPoint in userPointsList)
                    {
                        <tr>
                            <td>
                                <span class="rank-badge @(rank <= 3 ? "top-" + rank : "")">
                                    @rank
                                </span>
                            </td>
                            <td>
                                <div class="user-info">
                                    <strong>@userPoint.UserName</strong>
                                    <small>@userPoint.UserPhoneNumber</small>
                                </div>
                            </td>
                            <td><strong class="points-total">@userPoint.TotalPoints</strong></td>
                            <td><span class="points-available">@userPoint.AvailablePoints</span></td>
                            <td><span class="points-pending">@userPoint.PendingPoints</span></td>
                            <td>@PersianDateHelper.ToPersianDateTimeString(userPoint.LastUpdatedAt)</td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<MyShop.Core.Models.UserPoints> userPointsList = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/Account/login-admin", true);
            return;
        }

        var uid = int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
        if (uid <= 0 || !await AdminPerms.HasAsync(uid, "Points", AdminPermissionActions.Read))
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        await LoadUserPoints();
    }

    private async Task LoadUserPoints()
    {
        loading = true;
        try
        {
            userPointsList = await PointService.GetAllUserPointsAsync(0, 100);
        }
        catch
        {
            userPointsList = new List<MyShop.Core.Models.UserPoints>();
        }
        finally
        {
            loading = false;
        }
    }
}

<style>
    .container-content {
        direction: rtl;
        text-align: right;
        padding: 20px;
    }

    .points-header {
        margin-bottom: 24px;
    }

    .points-header h2 {
        margin: 0;
        font-size: 24px;
        font-weight: 700;
        color: #1f2937;
    }

    .points-table {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .table {
        width: 100%;
        border-collapse: collapse;
    }

    .table th {
        background: #f9fafb;
        padding: 12px 16px;
        text-align: right;
        font-weight: 600;
        color: #374151;
        border-bottom: 2px solid #e5e7eb;
    }

    .table td {
        padding: 12px 16px;
        border-bottom: 1px solid #e5e7eb;
    }

    .table tr:hover {
        background: #f9fafb;
    }

    .rank-badge {
        display: inline-block;
        width: 32px;
        height: 32px;
        line-height: 32px;
        text-align: center;
        border-radius: 50%;
        font-weight: 700;
        background: #e5e7eb;
        color: #6b7280;
    }

    .rank-badge.top-1 {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: white;
    }

    .rank-badge.top-2 {
        background: linear-gradient(135deg, #94a3b8, #64748b);
        color: white;
    }

    .rank-badge.top-3 {
        background: linear-gradient(135deg, #cd7f32, #a0522d);
        color: white;
    }

    .user-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .user-info strong {
        color: #1f2937;
    }

    .user-info small {
        color: #6b7280;
        font-size: 12px;
    }

    .points-total {
        color: #059669;
        font-size: 18px;
    }

    .points-available {
        color: #10b981;
        font-weight: 600;
    }

    .points-pending {
        color: #3b82f6;
        font-weight: 600;
    }

    .loading {
        text-align: center;
        padding: 60px 20px;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #f3f4f6;
        border-top-color: #dc2626;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 12px;
    }

    .empty-icon {
        font-size: 64px;
        margin-bottom: 16px;
    }

    @@media (max-width: 768px) {
        .table {
            font-size: 12px;
        }

        .table th,
        .table td {
            padding: 8px;
        }
    }
</style>
