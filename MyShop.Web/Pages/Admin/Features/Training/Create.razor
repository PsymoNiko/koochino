@page "/admin/training/create"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using MyShop.Application.Interfaces.Training
@using MyShop.Application.Interfaces.Companies
@using MyShop.Core.Models.Training
@using MyShop.Core.Models.Companies
@attribute [Authorize(Roles = "Admin")]

<div class="container-content" dir="rtl" style="padding: 24px;">
    <h1 class="page-title">ایجاد دوره آموزشی</h1>
    @if (!string.IsNullOrEmpty(message)) { <div class="alert @(message.Contains("موفق") ? "alert-success" : "alert-danger")" style="padding: 12px; border-radius: 8px; margin-bottom: 16px;">@message</div> }
    <EditForm Model="@model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <div class="form-group"><label>شرکت</label><select class="form-control" value="@(model.CompanyId ?? 0)" @onchange="OnCompanyChange"><option value="0">—</option>@foreach (var c in companies) { <option value="@c.Id">@c.Name</option> }</select></div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="form-group"><label>کد دوره</label><InputText @bind-Value="model.Code" class="form-control" /></div>
            <div class="form-group"><label>عنوان</label><InputText @bind-Value="model.Title" class="form-control" /></div>
        </div>
        <div class="form-group"><label>توضیحات</label><InputTextArea @bind-Value="model.Description" class="form-control" rows="3" /></div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
            <div class="form-group"><label>مدت (ساعت)</label><InputNumber @bind-Value="model.DurationHours" class="form-control" /></div>
            <div class="form-group"><label>تاریخ شروع</label><InputDate @bind-Value="model.StartDate" class="form-control" /></div>
            <div class="form-group"><label>تاریخ پایان</label><InputDate @bind-Value="model.EndDate" class="form-control" /></div>
        </div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="form-group"><label>حداکثر شرکت‌کننده</label><InputNumber @bind-Value="model.MaxParticipants" class="form-control" /></div>
            <div class="form-group"><label>مکان</label><InputText @bind-Value="model.Location" class="form-control" /></div>
        </div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="form-group"><label>نام مدرس</label><InputText @bind-Value="model.InstructorName" class="form-control" /></div>
            <div class="form-group"><label>ترتیب</label><InputNumber @bind-Value="model.SortOrder" class="form-control" /></div>
        </div>
        <div class="form-group"><label>فعال</label><InputCheckbox @bind-Value="model.IsActive" class="form-control" /></div>
        <div style="display: flex; gap: 12px; margin-top: 20px;"><button type="submit" class="btn-primary">ذخیره</button><a href="/admin/training" class="btn-secondary">انصراف</a></div>
    </EditForm>
</div>
@code {
    [Inject] private ITrainingCourseService Service { get; set; }
    [Inject] private ICompanyService CompanyService { get; set; }
    [Inject] private NavigationManager Nav { get; set; }
    private CreateTrainingCourseDto model = new CreateTrainingCourseDto { IsActive = true };
    private List<CompanyDto> companies = new();
    private string message = "";
    protected override async Task OnInitializedAsync() => companies = await CompanyService.GetAllAsync();
    private void OnCompanyChange(ChangeEventArgs e) { model.CompanyId = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : null; }
    private async Task Submit() { message = ""; var id = await Service.CreateAsync(model); if (id > 0) { message = "دوره با موفقیت ایجاد شد."; Nav.NavigateTo("/admin/training"); } else message = "خطا در ایجاد."; }
}
