@page "/admin/pwa-installs"
@layout AdminLayout
@using MyShop.Application.Interfaces
@using MyShop.Core.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IPwaInstallLogService PwaInstallService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<div class="pwa-installs-container">
    <div class="page-header">
        <h2>نصب اپ (PWA) — تعداد و لاگ نصب</h2>
    </div>

    @if (loading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>در حال بارگذاری...</p>
        </div>
    }
    else
    {
        <div class="stats-cards">
            <div class="stat-card stat-card-primary">
                <div class="stat-icon">📱</div>
                <div class="stat-content">
                    <div class="stat-label">تعداد کل نصب اپ</div>
                    <div class="stat-value">@totalCount</div>
                </div>
            </div>
            <div class="stat-card stat-card-twa">
                <div class="stat-icon">🤖</div>
                <div class="stat-content">
                    <div class="stat-label">نصب TWA (اندروید)</div>
                    <div class="stat-value">@twaCount</div>
                </div>
            </div>
            <div class="stat-card stat-card-pwa">
                <div class="stat-icon">🌐</div>
                <div class="stat-content">
                    <div class="stat-label">نصب PWA (مرورگر)</div>
                    <div class="stat-value">@pwaCount</div>
                </div>
            </div>
        </div>

        <div class="log-card">
            <div class="card-header">
                <h3>لیست نصب‌ها</h3>
                <button class="refresh-btn" @onclick="LoadData">🔄 به‌روزرسانی</button>
            </div>
            <div class="card-body table-responsive">
                @if (logs == null || logs.Count == 0)
                {
                    <div class="empty-message">
                        <p>هنوز نصبی ثبت نشده است.</p>
                    </div>
                }
                else
                {
                    <table class="log-table">
                        <thead>
                            <tr>
                                <th>ردیف</th>
                                <th>تاریخ و زمان</th>
                                <th>IP</th>
                                <th>دستگاه / پلتفرم</th>
                                <th>User-Agent</th>
                                <th>صفحه (عرض×ارتفاع)</th>
                                <th>زبان</th>
                                <th>هسته CPU</th>
                                <th>حافظه (GB)</th>
                                <th>منطقه زمانی</th>
                                <th>نوع نصب</th>
                                <th>کاربر</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var row = skip + 1; }
                            @foreach (var log in logs)
                            {
                                <tr>
                                    <td>@(row++)</td>
                                    <td>@log.InstalledAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>@(log.IpAddress ?? "-")</td>
                                    <td>@(log.DeviceType ?? "-") / @(log.Platform ?? "-")</td>
                                    <td class="ua-cell" title="@log.UserAgent">@(log.UserAgent != null && log.UserAgent.Length > 50 ? log.UserAgent.Substring(0, 50) + "…" : (log.UserAgent ?? "-"))</td>
                                    <td>@(log.ScreenWidth.HasValue && log.ScreenHeight.HasValue ? $"{log.ScreenWidth}×{log.ScreenHeight}" : "-")</td>
                                    <td>@(log.Language ?? "-")</td>
                                    <td>@(log.HardwareConcurrency?.ToString() ?? "-")</td>
                                    <td>@(log.DeviceMemory?.ToString("0.#") ?? "-")</td>
                                    <td>@(log.TimeZone ?? "-")</td>
                                    <td>@GetInstallTypeLabel(log.ExtraInfo)</td>
                                    <td>@(log.UserId?.ToString() ?? "مهمان")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            @if (totalCount > pageSize)
            {
                <div class="pager">
                    @if (skip > 0)
                    {
                        <button type="button" @onclick='() => ChangePage(skip - pageSize)'>قبلی</button>
                    }
                    <span>صفحه @(skip / pageSize + 1) از @((totalCount + pageSize - 1) / pageSize)</span>
                    @if (skip + pageSize < totalCount)
                    {
                        <button type="button" @onclick='() => ChangePage(skip + pageSize)'>بعدی</button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private bool loading = true;
    private int totalCount = 0;
    private int twaCount = 0;
    private int pwaCount = 0;
    private List<PwaInstallLog> logs = new List<PwaInstallLog>();
    private int skip = 0;
    private const int pageSize = 50;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/Account/login-admin", true);
            return;
        }
        var role = authState.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
        if (role != "Admin")
        {
            Nav.NavigateTo("/Account/login-admin", true);
            return;
        }
        await LoadData();
        loading = false;
    }

    private async Task LoadData()
    {
        totalCount = await PwaInstallService.GetTotalCountAsync();
        logs = await PwaInstallService.GetListAsync(skip, pageSize);
        twaCount = 0;
        pwaCount = 0;
        foreach (var log in logs)
        {
            if (GetInstallType(log.ExtraInfo) == "twa") twaCount++;
            else pwaCount++;
        }
    }

    private static string GetInstallType(string extraInfo)
    {
        if (string.IsNullOrWhiteSpace(extraInfo)) return "pwa";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(extraInfo);
            if (doc.RootElement.TryGetProperty("installType", out var t))
            {
                var v = t.GetString();
                if (string.Equals(v, "twa", StringComparison.OrdinalIgnoreCase)) return "twa";
            }
        }
        catch { /* ignore */ }
        return "pwa";
    }

    private static string GetInstallTypeLabel(string extraInfo) =>
        GetInstallType(extraInfo) == "twa" ? "TWA اندروید" : "PWA مرورگر";

    private async Task ChangePage(int newSkip)
    {
        skip = Math.Max(0, newSkip);
        await LoadData();
    }
}

<style>
    .pwa-installs-container { padding: 20px; direction: rtl; }
    .page-header { margin-bottom: 24px; }
    .page-header h2 { font-size: 22px; font-weight: 700; color: #1f2937; }
    .stats-cards { display: flex; gap: 20px; margin-bottom: 24px; }
    .stat-card { background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 12px rgba(59,130,246,0.2); }
    .stat-card-twa { background: linear-gradient(135deg, #059669 0%, #10b981 100%); box-shadow: 0 4px 12px rgba(5,150,105,0.2); }
    .stat-card-pwa { background: linear-gradient(135deg, #6366f1 0%, #818cf8 100%); box-shadow: 0 4px 12px rgba(99,102,241,0.2); }
    .stat-icon { font-size: 36px; }
    .stat-label { color: rgba(255,255,255,0.9); font-size: 13px; margin-bottom: 4px; }
    .stat-value { color: #fff; font-size: 28px; font-weight: 700; }
    .log-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); overflow: hidden; }
    .log-card .card-header { background: #f9fafb; padding: 16px 20px; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center; }
    .log-card .card-header h3 { margin: 0; font-size: 16px; font-weight: 600; }
    .refresh-btn { background: #3b82f6; color: white; border: none; border-radius: 8px; padding: 8px 14px; font-size: 13px; cursor: pointer; }
    .refresh-btn:hover { background: #2563eb; }
    .card-body { padding: 0; overflow-x: auto; }
    .log-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .log-table th, .log-table td { padding: 10px 12px; text-align: right; border-bottom: 1px solid #eee; }
    .log-table th { background: #f3f4f6; font-weight: 600; color: #374151; }
    .log-table tbody tr:hover { background: #f9fafb; }
    .ua-cell { max-width: 220px; overflow: hidden; text-overflow: ellipsis; }
    .empty-message { padding: 40px; text-align: center; color: #6b7280; }
    .pager { padding: 12px 20px; display: flex; align-items: center; gap: 12px; border-top: 1px solid #e5e7eb; }
    .pager button { padding: 6px 12px; border: 1px solid #d1d5db; border-radius: 6px; background: #fff; cursor: pointer; }
    .pager button:hover { background: #f3f4f6; }
    .loading-container { display: flex; flex-direction: column; align-items: center; padding: 60px 20px; }
    .loading-container .spinner { width: 40px; height: 40px; border: 3px solid #e5e7eb; border-top-color: #3b82f6; border-radius: 50%; animation: spin 0.7s linear infinite; margin-bottom: 12px; }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
