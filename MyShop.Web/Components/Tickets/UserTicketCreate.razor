@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MyShop.Application.Interfaces
@using MyShop.Application.Interfaces.Tickets
@using MyShop.Core.Models.Tickets
@using MyShop.Web.Services
@using System.Security.Claims

<div class="ticket-create-page" dir="rtl" lang="fa">
    <div class="page-header">
        <h1>ثبت تیکت پشتیبانی</h1>
        <p class="subtitle">درخواست خود را برای دپارتمان مربوطه ارسال کنید</p>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(ok ? "ok" : "err")">@message</div>
    }

    @if (loading)
    {
        <p>در حال بارگذاری...</p>
    }
    else
    {
        <EditForm Model="@model" OnValidSubmit="Submit" class="ticket-form">
            <div class="form-group">
                <label>دپارتمان *</label>
                <InputSelect @bind-Value="model.DepartmentId" class="form-control">
                    <option value="">-- انتخاب کنید --</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="form-group">
                <label>موضوع *</label>
                <InputText @bind-Value="model.Subject" class="form-control" maxlength="256" />
            </div>
            <div class="form-group">
                <label>اولویت</label>
                <InputSelect @bind-Value="model.Priority" class="form-control">
                    <option value="کم">کم</option>
                    <option value="متوسط">متوسط</option>
                    <option value="زیاد">زیاد</option>
                </InputSelect>
            </div>
            <div class="form-group">
                <label>متن پیام *</label>
                <InputTextArea @bind-Value="model.Resolution" class="form-control" rows="5" placeholder="شرح مشکل یا درخواست خود را بنویسید..." />
            </div>
            <div class="form-group">
                <label>ضمیمه‌ها (اختیاری — حداکثر ۳ فایل، هر کدام تا ۲ مگابایت)</label>
                <InputFile OnChange="OnFilesSelected" multiple accept=".jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.zip" class="form-control" />
                @if (selectedFiles.Count > 0)
                {
                    <ul class="file-list">
                        @foreach (var f in selectedFiles)
                        {
                            <li>@f.Name (@FormatSize(f.Size))</li>
                        }
                    </ul>
                }
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary" disabled="@saving">@(saving ? "در حال ارسال..." : "ارسال تیکت")</button>
                <a href="@BasePath" class="btn-secondary">انصراف</a>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public string BasePath { get; set; } = "/customer/tickets";
    [Inject] private ITicketService TicketService { get; set; }
    [Inject] private IUserService UserService { get; set; }
    [Inject] private TicketAttachmentUploadService UploadService { get; set; }
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; }
    [Inject] private NavigationManager Nav { get; set; }

    private CreateTicketDto model = new CreateTicketDto { Status = "Open", Priority = "متوسط" };
    private List<TicketDepartmentItemDto> departments = new();
    private List<IBrowserFile> selectedFiles = new();
    private bool loading = true;
    private bool saving;
    private bool ok;
    private string message = "";
    private int userId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var uid = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(uid) || !int.TryParse(uid, out userId))
        {
            Nav.NavigateTo("/Account/Login", true);
            return;
        }

        model.UserId = userId;
        try
        {
            departments = await TicketService.GetDepartmentsAsync() ?? new List<TicketDepartmentItemDto>();
            var profile = await UserService.GetProfileAsync(userId);
            if (profile != null)
            {
                model.ContactName = $"{profile.FirstName} {profile.LastName}".Trim();
                model.ContactEmail = profile.Email;
                model.ContactPhone = profile.PhoneNumber;
            }
        }
        finally
        {
            loading = false;
        }
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        selectedFiles = e.GetMultipleFiles(3).ToList();
        message = "";
    }

    private static string FormatSize(long size)
    {
        if (size < 1024) return $"{size} B";
        if (size < 1024 * 1024) return $"{size / 1024.0:0.#} KB";
        return $"{size / (1024.0 * 1024.0):0.#} MB";
    }

    private async Task Submit()
    {
        message = "";
        ok = false;
        if (!model.DepartmentId.HasValue || model.DepartmentId <= 0)
        {
            message = "دپارتمان را انتخاب کنید.";
            return;
        }
        if (string.IsNullOrWhiteSpace(model.Subject))
        {
            message = "موضوع را وارد کنید.";
            return;
        }
        if (string.IsNullOrWhiteSpace(model.Resolution))
        {
            message = "متن پیام را وارد کنید.";
            return;
        }

        saving = true;
        try
        {
            model.UserId = userId;
            model.Status = "Open";
            var id = await TicketService.CreateAsync(model);
            if (id <= 0)
            {
                message = "خطا در ثبت تیکت.";
                return;
            }

            foreach (var file in selectedFiles)
            {
                var (success, url, fileName, fileSize, msg) = await UploadService.UploadAsync(id, file);
                if (!success)
                {
                    message = $"تیکت ثبت شد ولی آپلود «{file.Name}» ناموفق بود: {msg}";
                    ok = true;
                    Nav.NavigateTo($"{BasePath}/view/{id}");
                    return;
                }
                await TicketService.AddAttachmentAsync(id, null, url, fileName, fileSize, userId);
            }

            ok = true;
            message = "تیکت با موفقیت ثبت شد.";
            Nav.NavigateTo($"{BasePath}/view/{id}");
        }
        catch (Exception ex)
        {
            message = "خطا: " + ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}

<style>
    .ticket-create-page { padding: 12px 16px; max-width: 640px; margin: 0 auto; }
    .page-header { margin-bottom: 16px; }
    .page-header h1 { margin: 0 0 4px; font-size: 1.25rem; }
    .subtitle { margin: 0; color: #6b7280; font-size: 0.875rem; }
    .alert { padding: 12px; border-radius: 8px; margin-bottom: 16px; }
    .alert.ok { background: #d1fae5; color: #065f46; }
    .alert.err { background: #fee2e2; color: #b91c1c; }
    .ticket-form { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; }
    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; margin-bottom: 6px; font-weight: 600; font-size: 0.9rem; }
    .form-control { width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 0.95rem; }
    .file-list { margin: 8px 0 0; padding-right: 18px; color: #4b5563; font-size: 0.85rem; }
    .form-actions { display: flex; gap: 12px; margin-top: 18px; flex-wrap: wrap; }
    .btn-primary { background: #059669; color: #fff; border: none; padding: 10px 18px; border-radius: 8px; cursor: pointer; font-weight: 600; }
    .btn-primary:disabled { opacity: 0.6; }
    .btn-secondary { background: #f3f4f6; color: #374151; text-decoration: none; padding: 10px 18px; border-radius: 8px; }
</style>
