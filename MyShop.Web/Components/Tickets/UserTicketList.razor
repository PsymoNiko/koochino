@using Microsoft.AspNetCore.Components.Authorization
@using MyShop.Application.Interfaces.Tickets
@using MyShop.Core.Models.Tickets
@using MyShop.Core.Helpers
@using System.Security.Claims

<div class="tickets-page" dir="rtl" lang="fa">
    <div class="page-header">
        <div>
            <h1>تیکت‌های من</h1>
            <p class="subtitle">پیگیری درخواست‌های پشتیبانی شما</p>
        </div>
        <a href="@($"{BasePath}/create")" class="btn-action btn-primary">ثبت تیکت جدید</a>
    </div>

    @if (!string.IsNullOrEmpty(actionMessage))
    {
        <div class="alert @(actionOk ? "ok" : "err")">@actionMessage</div>
    }

    @if (loading)
    {
        <div class="loading">در حال بارگذاری...</div>
    }
    else if (items == null || items.Count == 0)
    {
        <div class="empty-state">
            <p>هنوز تیکتی ثبت نکرده‌اید.</p>
            <a href="@($"{BasePath}/create")" class="btn-action btn-primary">ثبت اولین تیکت</a>
        </div>
    }
    else
    {
        <div class="tickets-mobile">
            @foreach (var t in items)
            {
                <div class="ticket-card">
                    <div class="ticket-card-header">
                        <strong>@(t.TicketNo ?? $"#{t.Id}")</strong>
                        <span class="status-badge status-@t.Status">@GetStatusTitle(t.Status)</span>
                    </div>
                    <div class="ticket-row"><span>موضوع</span><span>@t.Subject</span></div>
                    <div class="ticket-row"><span>دپارتمان</span><span>@(t.DepartmentName ?? "—")</span></div>
                    <div class="ticket-row"><span>تاریخ</span><span>@PersianDateHelper.ToPersianDateTimeString(t.CreatedAt)</span></div>
                    <div class="actions">
                        <a class="btn-action btn-view" href="@($"{BasePath}/view/{t.Id}")">مشاهده</a>
                        @if (!IsClosed(t.Status))
                        {
                            <button type="button"
                                    class="btn-action btn-finish"
                                    disabled="@(closingId == t.Id)"
                                    @onclick="(() => CloseTicket(t.Id))"
                                    @onclick:stopPropagation="true">
                                @(closingId == t.Id ? "..." : "اتمام تیکت")
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string BasePath { get; set; } = "/customer/tickets";
    [Inject] private ITicketService TicketService { get; set; }
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; }
    [Inject] private NavigationManager Nav { get; set; }
    [Inject] private IJSRuntime JSRuntime { get; set; }

    private List<TicketDto> items = new();
    private bool loading = true;
    private int? closingId;
    private int userId;
    private string actionMessage = "";
    private bool actionOk;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var uid = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(uid) || !int.TryParse(uid, out userId))
        {
            Nav.NavigateTo("/Account/Login", true);
            return;
        }
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        try
        {
            items = await TicketService.GetByUserIdAsync(userId) ?? new List<TicketDto>();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CloseTicket(int ticketId)
    {
        bool confirmed;
        try
        {
            confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "آیا از اتمام این تیکت اطمینان دارید؟");
        }
        catch
        {
            confirmed = true;
        }
        if (!confirmed) return;

        closingId = ticketId;
        actionMessage = "";
        StateHasChanged();
        try
        {
            var ok = await TicketService.CloseTicketAsync(ticketId, userId);
            actionOk = ok;
            actionMessage = ok
                ? "تیکت با موفقیت به حالت اتمام درآمد."
                : "خطا در اتمام تیکت.";
            if (ok) await Load();
        }
        catch (Exception ex)
        {
            actionOk = false;
            actionMessage = "خطا: " + ex.Message;
        }
        finally
        {
            closingId = null;
        }
    }

    private static bool IsClosed(string status) =>
        string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase);

    private static string GetStatusTitle(string status) => status switch
    {
        "Open" => "در انتظار پاسخ",
        "Answered" => "پاسخ داده شده",
        "InProgress" => "پاسخ داده شده",
        "Closed" => "اتمام / بسته شده",
        _ => status ?? "—"
    };
}

<style>
    .tickets-page { padding: 12px 16px; max-width: 960px; margin: 0 auto; }
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
    .page-header h1 { margin: 0 0 4px; font-size: 1.25rem; }
    .subtitle { margin: 0; color: #6b7280; font-size: 0.875rem; }
    .alert { padding: 12px; border-radius: 8px; margin-bottom: 14px; }
    .alert.ok { background: #d1fae5; color: #065f46; }
    .alert.err { background: #fee2e2; color: #b91c1c; }
    .btn-action {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        border: none;
        cursor: pointer;
        line-height: 1.3;
        text-align: center;
        pointer-events: auto;
    }
    .btn-action:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-primary { background: #dc2626; color: #fff; }
    .btn-view { background: #2563eb; color: #fff; }
    .btn-finish { background: #6b7280; color: #fff; }
    .actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .loading, .empty-state { text-align: center; padding: 32px; color: #6b7280; }
    .table-wrap { overflow-x: auto; background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; }
    .tickets-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    .tickets-table th { background: #059669; color: #fff; padding: 12px 10px; text-align: right; }
    .tickets-table td { padding: 10px; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
    .ticket-no { font-weight: 600; }
    .status-badge { display: inline-block; padding: 4px 10px; border-radius: 8px; font-size: 0.8rem; }
    .status-Open { background: #fef3c7; color: #b45309; }
    .status-Answered, .status-InProgress { background: #d1fae5; color: #065f46; }
    .status-Closed { background: #e5e7eb; color: #374151; }
    .tickets-mobile { display: block; }
    .ticket-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 14px; margin-bottom: 12px; }
    .ticket-card-header { display: flex; justify-content: space-between; margin-bottom: 8px; }
    .ticket-row { display: flex; justify-content: space-between; gap: 8px; font-size: 0.875rem; margin-bottom: 4px; color: #374151; }
    .ticket-row span:last-child { min-width: 0; text-align: left; word-break: break-word; overflow-wrap: anywhere; }
    .ticket-card .actions { margin-top: 12px; }
    @@media (max-width: 768px) {
        .table-wrap { display: none; }
        .tickets-mobile { display: block; }
    }
</style>
