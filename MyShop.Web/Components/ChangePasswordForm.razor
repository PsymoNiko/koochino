@using MyShop.Application.Interfaces
@using System.Security.Claims
@inject IAuthService Auth
@inject AuthenticationStateProvider AuthProvider

<section class="change-password-panel" dir="rtl">
    <h2>تغییر رمز عبور</h2>
    <p class="hint">رمز فعلی را وارد کنید، سپس رمز جدید و تکرار آن را بنویسید.</p>

    @if (!string.IsNullOrEmpty(message))
    {
        <p class="@(ok ? "ok" : "err")">@message</p>
    }

    <div class="field">
        <label for="@idPrefix-old">رمز فعلی</label>
        <input id="@idPrefix-old" type="@(showOld ? "text" : "password")" autocomplete="current-password"
               @bind="oldPassword" @bind:event="oninput" />
        <button type="button" class="toggle" @onclick="() => showOld = !showOld">@(showOld ? "مخفی" : "نمایش")</button>
    </div>
    <div class="field">
        <label for="@idPrefix-new">رمز جدید</label>
        <input id="@idPrefix-new" type="@(showNew ? "text" : "password")" autocomplete="new-password"
               @bind="newPassword" @bind:event="oninput" />
        <button type="button" class="toggle" @onclick="() => showNew = !showNew">@(showNew ? "مخفی" : "نمایش")</button>
    </div>
    <div class="field">
        <label for="@idPrefix-confirm">تکرار رمز جدید</label>
        <input id="@idPrefix-confirm" type="@(showConfirm ? "text" : "password")" autocomplete="new-password"
               @bind="confirmPassword" @bind:event="oninput" />
        <button type="button" class="toggle" @onclick="() => showConfirm = !showConfirm">@(showConfirm ? "مخفی" : "نمایش")</button>
    </div>

    <button type="button" class="submit" disabled="@busy" @onclick="Submit">
        @(busy ? "در حال ذخیره..." : "تغییر رمز عبور")
    </button>
</section>

<style>
    .change-password-panel { margin-top: 28px; padding: 20px; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; max-width: 480px; }
    .change-password-panel h2 { margin: 0 0 6px; font-size: 1.15rem; }
    .change-password-panel .hint { color: #64748b; font-size: .9rem; margin-bottom: 14px; }
    .change-password-panel .field { position: relative; margin-bottom: 12px; }
    .change-password-panel label { display: block; margin-bottom: 6px; font-size: .9rem; }
    .change-password-panel input { width: 100%; padding: 10px 72px 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-family: inherit; box-sizing: border-box; }
    .change-password-panel .toggle { position: absolute; left: 8px; bottom: 8px; background: none; border: none; color: #0f766e; cursor: pointer; font-size: .8rem; }
    .change-password-panel .submit { background: #0f766e; color: #fff; border: none; padding: 10px 18px; border-radius: 8px; cursor: pointer; }
    .change-password-panel .submit:disabled { opacity: .6; cursor: not-allowed; }
    .change-password-panel .ok { color: #047857; }
    .change-password-panel .err { color: #b91c1c; }
</style>

@code {
    [Parameter] public int UserId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    string oldPassword = "";
    string newPassword = "";
    string confirmPassword = "";
    string message = "";
    bool ok;
    bool busy;
    bool showOld, showNew, showConfirm;
    readonly string idPrefix = "cp-" + Guid.NewGuid().ToString("N").Substring(0, 8);

    async Task Submit()
    {
        message = "";
        ok = false;
        if (string.IsNullOrWhiteSpace(oldPassword))
        {
            message = "رمز فعلی را وارد کنید.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newPassword) || newPassword.Length < 8)
        {
            message = "رمز جدید باید حداقل ۸ کاراکتر باشد.";
            return;
        }
        if (newPassword != confirmPassword)
        {
            message = "رمز جدید و تکرار آن یکسان نیست.";
            return;
        }

        var userId = UserId;
        if (userId <= 0)
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            int.TryParse(state.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value, out userId);
        }
        if (userId <= 0)
        {
            message = "لطفاً دوباره وارد شوید.";
            return;
        }

        busy = true;
        try
        {
            var result = await Auth.ChangePasswordAsync(userId, oldPassword, newPassword);
            ok = result.ok;
            message = result.ok ? "رمز عبور با موفقیت تغییر کرد." : (result.error ?? "خطا در تغییر رمز.");
            if (result.ok)
            {
                oldPassword = newPassword = confirmPassword = "";
                if (OnChanged.HasDelegate)
                    await OnChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            message = "خطا: " + ex.Message;
        }
        finally { busy = false; }
    }
}
