@* هوم جدید کوچینو (index3) — چرخه وفاداری + تب مشتری/مغازه‌دار. تمام متن‌ها/دکمه‌ها از ماژول «صفحات» پنل ادمین (صفحه اصلی) قابل ویرایش است. جایگزین LandingGreen در Home.razor؛ فایل LandingGreen.razor دست‌نخورده باقی مانده. *@
@using Microsoft.AspNetCore.Components.Authorization
@using MyShop.Application.Interfaces
@using MyShop.Application.Interfaces.Cms
@using MyShop.Core.Interfaces
@using MyShop.Core.Models
@using MyShop.Core.Models.Cms
@using System.Linq
@using System.Security.Claims
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStoreListCacheService StoreListCache
@inject AuthenticationStateProvider AuthProvider
@inject ISitePageContentService SitePages
@inject ICurrentTenant Tenant

<MyShop.Web.Components.SeoHead PageKey="home" TitleOverride="کوچینو | خرید حضوری هوشمند" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap');

    .kc-root {
        font-family: 'Vazirmatn', system-ui, sans-serif;
        direction: rtl; text-align: right;
        --primary: #6D28D9;
        --accent: #F97316;
        --bg: #FBFAFF;
        --ink: #241C3D;
        --muted: #6B6480;
        --card: #FFFFFF;
        --border: #EAE6F7;
        --primary-soft: #F2ECFF;
        --accent-soft: #FFF1E6;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.7;
        overflow-x: hidden;
    }
    .kc-root * { box-sizing: border-box; }
    .kc-root a { color: inherit; }
    .kc-container { max-width: 1180px; margin: 0 auto; padding: 0 20px; }

    .kc-header { position: sticky; top: 0; z-index: 50; background: rgba(251,250,255,0.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
    .kc-header-inner { max-width: 1180px; margin: 0 auto; padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .kc-logo { display: flex; align-items: center; gap: 8px; text-decoration: none; }
    .kc-logo img { width: 38px; height: 38px; border-radius: 10px; flex-shrink: 0; }
    .kc-logo-word { font-size: 22px; font-weight: 800; color: var(--primary); letter-spacing: 0.2px; }
    .kc-nav { display: flex; align-items: center; gap: 28px; list-style: none; }
    .kc-nav a { text-decoration: none; font-weight: 600; font-size: 14.5px; color: var(--ink); padding: 6px 2px; border-bottom: 2px solid transparent; cursor: pointer; }
    .kc-nav a:hover { color: var(--primary); border-color: var(--primary); }
    .kc-header-cta { display: flex; align-items: center; gap: 10px; }
    .kc-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: 12px; font-weight: 700; font-size: 14.5px; text-decoration: none; border: none; cursor: pointer; white-space: nowrap; font-family: inherit; }
    .kc-btn-primary { background: linear-gradient(135deg, var(--primary), #8B5CF6); color: #fff; box-shadow: 0 6px 16px rgba(109,40,217,0.28); }
    .kc-btn-primary:hover { transform: translateY(-1px); color: #fff; }
    .kc-btn-accent { background: linear-gradient(135deg, var(--accent), #FB923C); color: #fff; box-shadow: 0 6px 16px rgba(249,115,22,0.28); }
    .kc-btn-accent:hover { transform: translateY(-1px); color: #fff; }
    .kc-btn-outline { background: #fff; color: var(--primary); border: 1.5px solid var(--primary); }
    .kc-btn-outline:hover { background: var(--primary-soft); }
    .kc-btn-sm { padding: 8px 14px; font-size: 13.5px; border-radius: 10px; }
    .kc-header-user { background: var(--primary-soft); color: var(--primary); border: 1px solid rgba(109,40,217,0.2); }

    .kc-hero { padding: 56px 0 40px; position: relative; overflow: hidden; }
    .kc-hero::before { content: ''; position: absolute; inset: -10% -10% auto -10%; height: 480px; background: radial-gradient(60% 60% at 30% 20%, var(--primary-soft), transparent 70%), radial-gradient(50% 50% at 85% 10%, var(--accent-soft), transparent 70%); z-index: 0; }
    .kc-hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 40px; align-items: center; }
    .kc-eyebrow { display: inline-flex; align-items: center; gap: 8px; background: var(--primary-soft); color: var(--primary); font-weight: 700; font-size: 13px; padding: 7px 14px; border-radius: 999px; margin-bottom: 18px; }
    .kc-hero h1 { font-size: 40px; font-weight: 900; line-height: 1.35; margin-bottom: 16px; }
    .kc-hero h1 .kc-accent-word { background: linear-gradient(90deg, var(--primary), var(--accent)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .kc-hero p { font-size: 16.5px; color: var(--muted); max-width: 520px; margin-bottom: 28px; }
    .kc-hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 20px; }
    .kc-hero-note { font-size: 13.5px; color: var(--muted); display: flex; align-items: center; gap: 8px; }

    .kc-cycle-wrap { position: relative; z-index: 1; display: flex; justify-content: center; }
    .kc-cycle-svg { width: 100%; max-width: 420px; height: auto; }
    .kc-node-label { font-size: 12.5px; font-weight: 700; fill: var(--ink); }
    .kc-node-num { font-size: 11px; font-weight: 800; }

    .kc-bubble-section { padding: 36px 0; }
    .kc-bubble-card { max-width: 760px; margin: 0 auto; background: var(--primary-soft); border-radius: 24px; padding: 26px 32px; display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap; }
    .kc-bubble-text { font-size: 19px; font-weight: 700; }
    .kc-bubble-icon { width: 56px; height: 56px; border-radius: 16px; background: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 14px rgba(109,40,217,0.14); flex-shrink: 0; }

    .kc-section { padding: 64px 0; }
    .kc-section-head { text-align: center; max-width: 640px; margin: 0 auto 40px; }
    .kc-section-tag { display: inline-block; font-size: 12.5px; font-weight: 800; color: var(--accent); letter-spacing: 0.5px; margin-bottom: 10px; }
    .kc-section-title { font-size: 29px; font-weight: 800; margin-bottom: 10px; }
    .kc-section-sub { color: var(--muted); font-size: 15.5px; }

    .kc-what-grid { display: grid; grid-template-columns: 1fr auto 1fr; gap: 20px; align-items: center; max-width: 900px; margin: 0 auto; }
    .kc-what-card { background: var(--card); border: 1px solid var(--border); border-radius: 20px; padding: 26px; text-align: center; }
    .kc-what-icon { width: 52px; height: 52px; border-radius: 14px; margin: 0 auto 14px; display: flex; align-items: center; justify-content: center; }
    .kc-what-icon.customer { background: var(--primary-soft); }
    .kc-what-icon.store { background: var(--accent-soft); }
    .kc-what-title { font-size: 17px; font-weight: 800; margin-bottom: 8px; }
    .kc-what-text { font-size: 14px; color: var(--muted); }
    .kc-what-center { display: flex; flex-direction: column; align-items: center; gap: 6px; }
    .kc-what-center-badge { width: 78px; height: 78px; border-radius: 50%; overflow: hidden; box-shadow: 0 10px 22px rgba(109,40,217,0.3); }
    .kc-what-center-badge img { width: 100%; height: 100%; object-fit: cover; }
    .kc-what-center-word { font-weight: 800; color: var(--primary); font-size: 13px; }
    .kc-what-arrow { color: var(--muted); }

    .kc-steps-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; max-width: 1100px; margin: 0 auto; }
    .kc-step { text-align: center; }
    .kc-step-icon { width: 64px; height: 64px; border-radius: 50%; background: var(--card); border: 2px solid var(--border); display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; position: relative; font-size: 24px; }
    .kc-step:nth-child(odd) .kc-step-icon { border-color: var(--primary); }
    .kc-step:nth-child(even) .kc-step-icon { border-color: var(--accent); }
    .kc-step-num { position: absolute; top: -6px; left: -6px; width: 22px; height: 22px; border-radius: 50%; background: var(--ink); color: #fff; font-size: 11px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
    .kc-step-title { font-size: 14.5px; font-weight: 800; margin-bottom: 4px; }
    .kc-step-text { font-size: 12.5px; color: var(--muted); }

    .kc-tabs { display: flex; justify-content: center; gap: 10px; margin-bottom: 36px; }
    .kc-tab-btn { padding: 10px 22px; border-radius: 12px; border: 1.5px solid var(--border); background: #fff; font-weight: 700; font-size: 14.5px; cursor: pointer; color: var(--ink); font-family: inherit; }
    .kc-tab-btn.active.customer { background: linear-gradient(135deg, var(--primary), #8B5CF6); color: #fff; border-color: transparent; }
    .kc-tab-btn.active.store { background: linear-gradient(135deg, var(--accent), #FB923C); color: #fff; border-color: transparent; }

    .kc-panel { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: center; max-width: 1080px; margin: 0 auto; }
    .kc-panel-visual { border-radius: 26px; padding: 36px; min-height: 260px; display: flex; flex-direction: column; justify-content: center; gap: 16px; }
    .kc-panel-visual.customer { background: linear-gradient(160deg, var(--primary-soft), #fff); }
    .kc-panel-visual.store { background: linear-gradient(160deg, var(--accent-soft), #fff); }
    .kc-panel-badge { width: 64px; height: 64px; border-radius: 18px; display: flex; align-items: center; justify-content: center; }
    .kc-panel-visual.customer .kc-panel-badge { background: linear-gradient(135deg, var(--primary), #8B5CF6); }
    .kc-panel-visual.store .kc-panel-badge { background: linear-gradient(135deg, var(--accent), #FB923C); }
    .kc-panel-visual h3 { font-size: 22px; font-weight: 800; }
    .kc-panel-visual p { color: var(--muted); font-size: 14.5px; max-width: 340px; }

    .kc-benefit-list { list-style: none; display: flex; flex-direction: column; gap: 14px; margin-bottom: 26px; padding: 0; }
    .kc-benefit-item { display: flex; align-items: flex-start; gap: 12px; font-size: 15px; }
    .kc-benefit-check { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; font-size: 13px; }
    .kc-benefit-check.customer { background: var(--primary-soft); color: var(--primary); }
    .kc-benefit-check.store { background: var(--accent-soft); color: var(--accent); }
    .kc-benefit-item b { display: block; font-weight: 700; }
    .kc-benefit-item span.desc { color: var(--muted); font-size: 13.5px; }

    .kc-compare { display: grid; grid-template-columns: 1fr auto 1fr; gap: 22px; align-items: center; max-width: 920px; margin: 0 auto; }
    .kc-compare-card { border-radius: 22px; padding: 28px; text-align: center; border: 1.5px dashed var(--border); }
    .kc-compare-card.win { border: 1.5px solid var(--primary); background: var(--primary-soft); }
    .kc-compare-icon { width: 56px; height: 56px; border-radius: 16px; background: #fff; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }
    .kc-compare-title { font-weight: 800; font-size: 16px; margin-bottom: 8px; }
    .kc-compare-text { font-size: 13.5px; color: var(--muted); }
    .kc-vs { width: 44px; height: 44px; border-radius: 50%; background: var(--ink); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 13px; }

    .kc-trust-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; max-width: 1100px; margin: 0 auto; }
    .kc-trust-card { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 22px 18px; text-align: center; }
    .kc-trust-icon { width: 44px; height: 44px; border-radius: 12px; background: var(--primary-soft); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; font-size: 20px; }
    .kc-trust-title { font-weight: 800; font-size: 14.5px; margin-bottom: 4px; }
    .kc-trust-text { font-size: 12.5px; color: var(--muted); }

    .kc-feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; max-width: 1100px; margin: 0 auto; }
    .kc-feature-card { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 22px 18px; text-align: center; }
    .kc-feature-icon { width: 44px; height: 44px; border-radius: 12px; background: var(--primary-soft); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; font-size: 20px; }
    .kc-feature-title { font-weight: 800; font-size: 14.5px; margin-bottom: 4px; }
    .kc-feature-text { font-size: 12.5px; color: var(--muted); }

    .kc-stores-grid { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.25rem; }
    .kc-store-card { background: var(--card); border-radius: 18px; overflow: hidden; box-shadow: 0 6px 18px rgba(0,0,0,0.05); text-decoration: none; color: inherit; display: block; transition: transform 0.2s, box-shadow 0.2s; }
    .kc-store-card:hover { transform: translateY(-4px); box-shadow: 0 10px 24px rgba(109,40,217,0.15); }
    .kc-store-card-img { height: 150px; background: var(--primary-soft); overflow: hidden; }
    .kc-store-card-img img { width: 100%; height: 100%; object-fit: cover; }
    .kc-store-card-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
    .kc-store-card-body { padding: 1.1rem; }
    .kc-store-card-name { font-size: 1.05rem; font-weight: 700; margin: 0 0 0.4rem; color: var(--ink); }
    .kc-store-card-desc { font-size: 0.85rem; color: var(--muted); margin: 0 0 0.4rem; line-height: 1.5; }
    .kc-store-card-link { font-size: 0.85rem; color: var(--primary); font-weight: 700; }
    .kc-stores-more-wrap { text-align: center; margin-top: 1.5rem; }
    .kc-stores-loading, .kc-stores-empty { text-align: center; padding: 2rem; color: var(--muted); }

    .kc-cta { border-radius: 28px; background: linear-gradient(135deg, var(--primary) 0%, #7C3AED 55%, var(--accent) 130%); color: #fff; padding: 52px 40px; text-align: center; max-width: 1100px; margin: 0 auto; }
    .kc-cta h2 { font-size: 28px; font-weight: 800; margin-bottom: 10px; }
    .kc-cta p { opacity: 0.9; margin-bottom: 26px; font-size: 15.5px; }
    .kc-cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
    .kc-cta .kc-btn-primary { background: #fff; color: var(--primary); box-shadow: none; }
    .kc-cta .kc-btn-accent { background: rgba(255,255,255,0.15); color: #fff; border: 1.5px solid rgba(255,255,255,0.5); box-shadow: none; }

    .kc-footer { background: #1D1533; color: rgba(255,255,255,0.78); padding: 52px 0 26px; margin-top: 24px; }
    .kc-footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 36px; margin-bottom: 34px; }
    .kc-footer-brand { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
    .kc-footer-brand img { width: 32px; height: 32px; border-radius: 8px; }
    .kc-footer-brand-word { font-size: 20px; font-weight: 800; color: #fff; }
    .kc-footer h4 { color: #fff; font-size: 15px; font-weight: 700; margin-bottom: 16px; }
    .kc-footer ul { list-style: none; display: flex; flex-direction: column; gap: 10px; padding: 0; }
    .kc-footer a { text-decoration: none; font-size: 13.5px; color: rgba(255,255,255,0.72); cursor: pointer; }
    .kc-footer a:hover { color: #fff; }
    .kc-footer-install { display: flex; align-items: center; gap: 12px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); border-radius: 14px; padding: 14px 16px; margin-bottom: 28px; width: 100%; text-align: right; cursor: pointer; color: #fff; font-family: inherit; }
    .kc-footer-install-icon { width: 42px; height: 42px; border-radius: 12px; background: linear-gradient(135deg, var(--primary), var(--accent)); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .kc-footer-install-copy { flex: 1; display: flex; flex-direction: column; gap: 2px; }
    .kc-footer-install-copy strong { display: block; color: #fff; font-size: 14px; }
    .kc-footer-install-copy small { color: rgba(255,255,255,0.6); font-size: 12px; }
    .kc-footer-bottom { border-top: 1px solid rgba(255,255,255,0.12); padding-top: 20px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; font-size: 12.5px; color: rgba(255,255,255,0.5); align-items: center; }
    .kc-footer-enamad a { display: inline-block; line-height: 0; }
    .kc-footer-enamad img { display: block; cursor: pointer; }

    @@media (max-width: 900px) {
        .kc-nav { display: none; }
        .kc-hero-grid { grid-template-columns: 1fr; }
        .kc-hero h1 { font-size: 30px; }
        .kc-what-grid { grid-template-columns: 1fr; }
        .kc-what-arrow { transform: rotate(90deg); justify-self: center; }
        .kc-steps-row { grid-template-columns: repeat(2, 1fr); }
        .kc-panel { grid-template-columns: 1fr; gap: 28px; }
        .kc-compare { grid-template-columns: 1fr; }
        .kc-vs { justify-self: center; }
        .kc-trust-grid, .kc-feature-grid { grid-template-columns: repeat(2, 1fr); }
        .kc-footer-grid { grid-template-columns: 1fr; gap: 26px; }
        .kc-section-title { font-size: 24px; }
        .kc-cta { padding: 38px 22px; }
    }
</style>

<div class="kc-root" dir="rtl" lang="fa">

    <header class="kc-header">
        <div class="kc-header-inner">
            <a class="kc-logo" href="/">
                <img src="/img/weblogo-192.png" alt="@copy.BrandName" />
                <span class="kc-logo-word">@copy.BrandName</span>
            </a>
            <ul class="kc-nav">
                <li><a @onclick='() => ScrollToSection("features")' @onclick:preventDefault>@copy.FeaturesTitle</a></li>
                <li><a @onclick='() => ScrollToSection("process")' @onclick:preventDefault>@copy.ProcessTitle</a></li>
                <li><a @onclick='() => ScrollToSection("audience")' @onclick:preventDefault>@copy.TabCustomer / @copy.TabStore</a></li>
                <li><a @onclick='() => ScrollToSection("stores")' @onclick:preventDefault>@copy.StoresTitle</a></li>
                <li><a href="#" @onclick="ShowPwaInstall" @onclick:preventDefault>📱 نصب اپ</a></li>
            </ul>
            <div class="kc-header-cta">
                @if (authIsAuthenticated)
                {
                    <a href="@authPanelUrl" class="kc-btn kc-header-user kc-btn-sm">@authDisplayName</a>
                }
                else
                {
                    <a href="@copy.HeaderLoginButton.Link" class="kc-btn kc-btn-outline kc-btn-sm" style="color:@copy.HeaderLoginButton.Color;border-color:@copy.HeaderLoginButton.Color">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span>@copy.HeaderLoginButton.Text</span>
                    </a>
                }
            </div>
        </div>
    </header>

    <section class="kc-hero">
        <div class="kc-container kc-hero-grid">
            <div>
                <span class="kc-eyebrow">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 2l2.4 6.5L21 11l-6.6 2.5L12 20l-2.4-6.5L3 11l6.6-2.5L12 2Z" fill="currentColor"/></svg>
                    @copy.HeroEyebrow
                </span>
                <h1>@copy.HeroTitleLine1<br /><span class="kc-accent-word">@copy.HeroTitleAccent</span></h1>
                <p>@copy.CustomerHeroSubtitle</p>
                <div class="kc-hero-actions">
                    <a href="@copy.HeroBtnStore.Link" class="kc-btn kc-btn-accent" style="background:@copy.HeroBtnStore.Color">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M3 9l1-5h16l1 5M4 9v10a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9M4 9h16M9 21v-6h6v6" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span>@copy.HeroBtnStore.Text</span>
                    </a>
                    <a href="@copy.HeroBtnCustomer.Link" class="kc-btn kc-btn-primary" style="background:@copy.HeroBtnCustomer.Color">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M20 21a8 8 0 1 0-16 0M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span>@copy.HeroBtnCustomer.Text</span>
                    </a>
                </div>
                <div class="kc-hero-note">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4M12 3l8 4v5c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V7l8-4Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>@copy.HeroNote</span>
                </div>
            </div>

            <div class="kc-cycle-wrap">
                <svg class="kc-cycle-svg" viewBox="0 0 400 400" fill="none">
                    <defs>
                        <marker id="kc-arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                            <path d="M0,0 L10,5 L0,10 Z" fill="var(--accent)" />
                        </marker>
                        <linearGradient id="kcCenterGrad" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#6D28D9" />
                            <stop offset="1" stop-color="#F97316" />
                        </linearGradient>
                    </defs>
                    <path d="M67,157 C110.2,76.5 110.2,76.5 200,60" stroke="var(--primary)" stroke-width="2.5" stroke-dasharray="5 6" marker-end="url(#kc-arrow)" />
                    <path d="M200,60 C289.8,76.5 289.8,76.5 333,157" stroke="var(--primary)" stroke-width="2.5" stroke-dasharray="5 6" marker-end="url(#kc-arrow)" />
                    <path d="M333,157 C345.1,247.3 345.1,247.3 282,313" stroke="var(--primary)" stroke-width="2.5" stroke-dasharray="5 6" marker-end="url(#kc-arrow)" />
                    <path d="M282,313 C200,352.6 200,352.6 118,313" stroke="var(--primary)" stroke-width="2.5" stroke-dasharray="5 6" marker-end="url(#kc-arrow)" />
                    <path d="M118,313 C54.9,247.3 54.9,247.3 67,157" stroke="var(--primary)" stroke-width="2.5" stroke-dasharray="5 6" marker-end="url(#kc-arrow)" />

                    <circle cx="200" cy="200" r="58" fill="white" stroke="var(--primary)" stroke-width="1.5" />
