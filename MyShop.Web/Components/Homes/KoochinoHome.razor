@code {
    private LandingGreenCopy copy = LandingGreenCopy.GetDefault();
    private bool showCustomer = true;
    private List<Store> storeList = new List<Store>();
    private bool authIsAuthenticated;
    private string authDisplayName = "کاربر گرامی";
    private string authPanelUrl = "/";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            copy = await SitePages.GetLandingGreenAsync(Tenant?.HasSite == true ? Tenant.SiteId : null)
                   ?? LandingGreenCopy.GetDefault();
        }
        catch { copy = LandingGreenCopy.GetDefault(); }

        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            authIsAuthenticated = state?.User?.Identity?.IsAuthenticated == true;
            if (authIsAuthenticated && state?.User != null)
            {
                authDisplayName = state.User.FindFirst(ClaimTypes.GivenName)?.Value
                    ?? state.User.FindFirst(ClaimTypes.Name)?.Value
                    ?? "کاربر";
                var role = state.User.FindFirst(ClaimTypes.Role)?.Value;
                authPanelUrl = role == "Admin" ? "/admin" : role == "StoreOwner" ? "/storeowner/dashboard" : "/customer/Dashboard";
            }
        }
        catch
        {
            authIsAuthenticated = false;
            authPanelUrl = "/";
        }

        try
        {
            var top = await StoreListCache.TopSellingAsync(4);
            storeList = top ?? new List<Store>();
        }
        catch
        {
            storeList = new List<Store>();
        }
    }

    /// <summary>مختصات ۵ گره دیاگرام چرخه روی دایره (پنج‌ضلعی) — مستقل از تعداد واقعی آیتم‌ها در CMS.</summary>
    private static (int, int)[] GetCyclePositions() => new[]
    {
        (67, 157),
        (200, 60),
        (333, 157),
        (282, 313),
        (118, 313)
    };

    private void ToggleView(bool customer)
    {
        showCustomer = customer;
    }

    private async Task ScrollToSection(string id)
    {
        await InvokeAsync(StateHasChanged);
        try
        {
            await JS.InvokeVoidAsync("koochinoScrollTo", id, 72);
        }
        catch
        {
            try
            {
                await JS.InvokeVoidAsync("eval",
                    $"var el=document.getElementById('{id}');if(el){{var t=el.getBoundingClientRect().top+window.pageYOffset-72;window.scrollTo({{top:t,behavior:'smooth'}});}}");
            }
            catch { /* ignore */ }
        }
    }

    private async Task ShowPwaInstall()
    {
        try { await JS.InvokeVoidAsync("koochinoPwaInstall"); }
        catch { }
    }
}
