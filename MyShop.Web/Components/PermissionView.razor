@using Microsoft.AspNetCore.Components.Authorization
@using MyShop.Application.Interfaces.AdminAccess
@using MyShop.Core.Models.AdminAccess
@using System.Security.Claims
@inject IAdminPermissionService AdminPerms
@inject AuthenticationStateProvider AuthStateProvider

@if (_visible)
{
    @ChildContent
}

@code {
    [Parameter] public string Module { get; set; }
    [Parameter] public string Action { get; set; } = AdminPermissionActions.Read;
    [Parameter] public RenderFragment ChildContent { get; set; }

    bool _visible;

    protected override async Task OnParametersSetAsync()
    {
        _visible = false;
        if (string.IsNullOrWhiteSpace(Module))
            return;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var idStr = state.User?.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!int.TryParse(idStr, out var userId) || userId <= 0)
            return;
        _visible = await AdminPerms.HasAsync(userId, Module, Action ?? AdminPermissionActions.Read);
    }
}
