@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="html-text-editor" dir="rtl">
    <div class="hte-toolbar">
        <button type="button" title="پررنگ" @onclick='() => Exec("bold")'><b>B</b></button>
        <button type="button" title="کج" @onclick='() => Exec("italic")'><i>I</i></button>
        <button type="button" title="زیرخط" @onclick='() => Exec("underline")'><u>U</u></button>
        <button type="button" title="عنوان" @onclick='() => Exec("formatBlock", "H2")'>H2</button>
        <button type="button" title="پاراگراف" @onclick='() => Exec("formatBlock", "P")'>P</button>
        <button type="button" title="لیست" @onclick='() => Exec("insertUnorderedList")'>• لیست</button>
        <button type="button" title="لیست شماره‌دار" @onclick='() => Exec("insertOrderedList")'>1. لیست</button>
        <button type="button" title="لینک" @onclick="InsertLink">لینک</button>
        <button type="button" title="پاک کردن قالب" @onclick='() => Exec("removeFormat")'>پاک‌کردن قالب</button>
        <button type="button" class="@(sourceMode ? "active" : "")" @onclick="ToggleSource">HTML</button>
    </div>
    @if (sourceMode)
    {
        <textarea class="hte-source" rows="16" @bind="Html" @bind:event="oninput" @bind:after="NotifyChanged"></textarea>
    }
    else
    {
        <div @ref="editorRef" class="hte-surface" contenteditable="true"></div>
    }
</div>

<style>
    .html-text-editor { border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; background: #fff; }
    .hte-toolbar { display: flex; flex-wrap: wrap; gap: 4px; padding: 8px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; }
    .hte-toolbar button { border: 1px solid #e2e8f0; background: #fff; border-radius: 6px; padding: 6px 10px; cursor: pointer; font-size: .85rem; }
    .hte-toolbar button.active { background: #0f766e; color: #fff; border-color: #0f766e; }
    .hte-surface { min-height: 280px; padding: 14px 16px; outline: none; line-height: 1.85; }
    .hte-surface h2 { font-size: 1.15rem; margin: 1em 0 .4em; color: #0f766e; }
    .hte-source { width: 100%; min-height: 280px; border: 0; padding: 14px; font-family: ui-monospace, monospace; font-size: .85rem; box-sizing: border-box; }
</style>

@code {
    [Parameter] public string Html { get; set; } = "";
    [Parameter] public EventCallback<string> HtmlChanged { get; set; }

    ElementReference editorRef;
    DotNetObjectReference<HtmlTextEditor> selfRef;
    bool sourceMode;
    bool inited;
    bool fromJs;
    string lastPushed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (sourceMode) return;
        try
        {
            selfRef ??= DotNetObjectReference.Create(this);
            if (!inited)
            {
                await JS.InvokeVoidAsync("htmlEditor.init", editorRef, selfRef);
                await JS.InvokeVoidAsync("htmlEditor.setHtml", editorRef, Html ?? "");
                lastPushed = Html ?? "";
                inited = true;
                return;
            }
            if (!fromJs && Html != lastPushed)
            {
                await JS.InvokeVoidAsync("htmlEditor.setHtml", editorRef, Html ?? "");
                lastPushed = Html ?? "";
            }
            fromJs = false;
        }
        catch { }
    }

    [JSInvokable]
    public async Task OnHtmlChanged(string html)
    {
        fromJs = true;
        Html = html ?? "";
        lastPushed = Html;
        await HtmlChanged.InvokeAsync(Html);
    }

    async Task NotifyChanged()
    {
        lastPushed = Html ?? "";
        await HtmlChanged.InvokeAsync(Html);
    }

    public async Task<string> FlushAsync()
    {
        if (sourceMode)
        {
            await NotifyChanged();
            return Html ?? "";
        }
        try
        {
            var html = await JS.InvokeAsync<string>("htmlEditor.getHtml", editorRef);
            await OnHtmlChanged(html);
            return html ?? "";
        }
        catch
        {
            return Html ?? "";
        }
    }

    async Task Exec(string cmd, string value = null)
    {
        try { await JS.InvokeVoidAsync("htmlEditor.exec", cmd, value); }
        catch { }
        await FlushAsync();
    }

    async Task InsertLink()
    {
        try { await JS.InvokeVoidAsync("htmlEditor.promptLink"); }
        catch { }
        await FlushAsync();
    }

    void ToggleSource()
    {
        sourceMode = !sourceMode;
        inited = false;
        lastPushed = null;
        fromJs = false;
    }

    public async ValueTask DisposeAsync()
    {
        selfRef?.Dispose();
        await ValueTask.CompletedTask;
    }
}
