@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@using MyShop.Application.Interfaces
@using MyShop.Application.Interfaces.Ai
@using MyShop.Application.Interfaces.SupportChat
@using MyShop.Core.Interfaces
@using MyShop.Core.Models.Ai
@using MyShop.Core.Models.SupportChat
@using System.Security.Claims
@using System.Threading
@implements IAsyncDisposable
@inject IAiOrchestrator Ai
@inject ISupportChatService SupportChat
@inject ISupportAnalyticsService Analytics
@inject IUserService Users
@inject ICurrentTenant Tenant
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject SupportChatAccessTokenService ChatAccess

@if (!FloatingOnly)
{
    <div dir="rtl" class="assistant-page">
        <h2>@Title</h2>
        <p>@Subtitle</p>
        @if (SuggestedQuestions?.Count > 0)
        {
            <div class="suggested-questions">
                @foreach (var q in SuggestedQuestions)
                {
                    <button type="button" class="suggest-chip" @onclick="() => Ask(q)">@q</button>
                }
            </div>
        }
    </div>
}
@if (ShowBubble)
{
    <button type="button" class="chat-bubble @BubbleClass @PosClass" @onclick="ToggleOpen" aria-label="@HeaderTitle">
        <span class="chat-bubble-icon">💬</span>
        @if (unread > 0 && !open)
        {
            <span class="chat-unread">@(unread > 9 ? "9+" : unread.ToString())</span>
        }
    </button>
}
@if (open)
{
    <section class="chat-panel @PanelClass @PosClass @(FloatingOnly ? "floating" : "")" dir="rtl">
        <header>
            <div>
                <strong>@(humanMode ? "پشتیبانی کوچینو" : HeaderTitle)</strong>
                @if (humanMode)
                {
                    <span class="chat-mode-tag">گفتگو با ادمین</span>
                }
            </div>
            <button type="button" @onclick="() => open=false" aria-label="بستن">×</button>
        </header>
        <main>
            @if (!humanMode && EffectiveQuestions.Count > 0 && messages.Count(m => m.Role == "user") == 0)
            {
                <div class="panel-suggest">
                    @foreach (var q in EffectiveQuestions)
                    {
                        <button type="button" class="suggest-chip" @onclick="() => Ask(q)">@q</button>
                    }
                </div>
            }
            @foreach (var item in messages)
            {
                @if (item.Role == "handoff")
                {
                    <div class="system">
                        <p>@item.Text</p>
                        <button type="button" class="handoff-inline" @onclick="BeginHandoff">شروع چت آنلاین با پشتیبانی</button>
                    </div>
                }
                else
                {
                    <div class="@item.Role">@item.Text</div>
                }
            }
            @if (sending)
            {
                <div class="assistant muted">در حال نوشتن...</div>
            }
        </main>
        @if (humanMode && showCsat)
        {
            <div class="csat-box">
                <p>@csatPrompt</p>
                <div class="stars">
                    @for (var s = 1; s <= 5; s++)
                    {
                        var score = s;
                        <button type="button" class="@(csatScore==score?"on":"")" @onclick="() => csatScore = score">@score</button>
                    }
                </div>
                <input @bind="csatComment" placeholder="نظر اختیاری..." />
                <button type="button" @onclick="SubmitCsat" disabled="@(sending || csatScore < 1)">ثبت امتیاز</button>
                @if (!string.IsNullOrEmpty(csatFlash))
                {
                    <small>@csatFlash</small>
                }
            </div>
        }
        else if (humanMode && showGuestForm)
        {
            <div class="guest-form">
                <input @bind="guestName" placeholder="نام شما" />
                <input @bind="guestPhone" placeholder="موبایل (اختیاری)" dir="ltr" />
                <button type="button" @onclick="ConfirmHandoff" disabled="@sending">شروع گفتگو با پشتیبانی</button>
            </div>
        }
        else
        {
            @if (AllowHumanHandoff && !humanMode && showHandoff)
            {
                <div class="handoff-bar">
                    <button type="button" @onclick="BeginHandoff">چت آنلاین با پشتیبانی</button>
                </div>
            }
            <footer>
                @if (humanMode)
                {
                    <button type="button" class="back-ai" @onclick="BackToAi" title="بازگشت به دستیار">🤖</button>
                }
                <input @bind="input" @bind:event="oninput" @onkeydown="OnKeyDown" disabled="@sending" placeholder="@(humanMode ? "پیام برای پشتیبانی..." : "سوال خود را بنویسید...")" />
                <button type="button" @onclick="Send" disabled="@sending">ارسال</button>
            </footer>
        }
    </section>
}

<style>
    .assistant-page { max-width: 860px; margin: 32px auto; padding: 24px; }
    .suggested-questions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .suggest-chip { border: 1px solid #cbd5e1; background: #f8fafc; border-radius: 999px; padding: 8px 14px; cursor: pointer; font-size: 0.9rem; }
    .suggest-chip:hover { background: #eef2ff; border-color: #a5b4fc; }
    .panel-suggest { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
    .handoff-inline { margin-top: 8px; width: 100%; border: 0; border-radius: 10px; padding: 8px; background: #0f766e; color: #fff; cursor: pointer; font-weight: 700; }
    .chat-bubble { position: fixed; right: 16px; left: auto; bottom: 24px; width: 58px; height: 58px; border: 0; border-radius: 50%; background: #16a34a; color: #fff; font-size: 25px; box-shadow: 0 8px 24px rgba(0,0,0,.28); cursor: pointer; z-index: 1400; display: flex; align-items: center; justify-content: center; min-width: 58px; min-height: 58px; }
    .chat-bubble.pos-left { left: 16px; right: auto; }
    .chat-bubble.store { background: #2563eb; }
    .chat-unread { position: absolute; top: -2px; right: -2px; background: #dc2626; color: #fff; border-radius: 999px; font-size: 11px; min-width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; padding: 0 4px; font-weight: 700; }
    .chat-panel { position: fixed; right: 16px; left: auto; bottom: 94px; width: min(380px, calc(100vw - 32px)); height: min(520px, calc(100vh - 140px)); background: white; border: 1px solid #ddd; border-radius: 16px; box-shadow: 0 12px 36px rgba(0,0,0,.2); display: flex; flex-direction: column; overflow: hidden; z-index: 1400; }
    .chat-panel.pos-left { left: 16px; right: auto; }
    .chat-panel header { background: #15803d; color: white; padding: 12px 14px; display: flex; justify-content: space-between; align-items: center; font-weight: 700; gap: 8px; }
    .chat-panel.store header { background: #1d4ed8; }
    .chat-panel.human header { background: #0f766e; }
    .chat-mode-tag { display: block; font-size: .72rem; font-weight: 500; opacity: .9; margin-top: 2px; }
    .chat-panel header button { background: none; border: 0; color: white; font-size: 22px; cursor: pointer; }
    .chat-panel main { flex: 1; overflow: auto; padding: 12px; }
