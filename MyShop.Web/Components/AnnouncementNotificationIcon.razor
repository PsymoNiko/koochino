@code {
    private List<AnnouncementDto> announcements = new List<AnnouncementDto>();
    private int announcementCount = 0;
    private bool showPopup = false;
    private bool loading = true;
    private bool showDetailsModal = false;
    private AnnouncementDto? selectedAnnouncement = null;
    private HashSet<int> dismissedAnnouncements = new HashSet<int>();
    private ElementReference wrapperRef;
    private ElementReference iconRef;
    private string popupStyle = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAnnouncements();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in AnnouncementNotificationIcon OnInitializedAsync: {ex.Message}");
            announcements = new List<AnnouncementDto>();
            announcementCount = 0;
            loading = false;
        }
    }

    private async Task LoadAnnouncements()
    {
        loading = true;
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var role = user.FindFirst(ClaimTypes.Role)?.Value ?? "";
                
                // Map role names
                string userRole = role switch
                {
                    "Admin" => "Admin", // Admin can see all announcements
                    "ShopOwner" or "StoreOwner" => "ShopOwner",
                    "Customer" => "Customer",
                    _ => ""
                };

                if (!string.IsNullOrEmpty(userRole))
                {
                    var allAnnouncements = await AnnouncementService.GetActiveForUserAsync(userRole);
                    announcements = allAnnouncements
                        .Where(a => !dismissedAnnouncements.Contains(a.Id))
                        .ToList();
                    announcementCount = announcements.Count;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading announcements: {ex.Message}");
            announcements = new List<AnnouncementDto>();
            announcementCount = 0;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task TogglePopup()
    {
        showPopup = !showPopup;
        if (showPopup)
        {
            await LoadAnnouncements();
            await CalculatePopupPosition();
        }
    }
    
    private async Task CalculatePopupPosition()
    {
        try
        {
            await Task.Delay(10); // Wait for DOM to update
            var position = await JSRuntime.InvokeAsync<double[]>("getElementPosition", iconRef);
            if (position != null && position.Length >= 2)
            {
                var right = position[0];
                var top = position[1] + 10; // 10px below the icon
                
                // Ensure popup stays within viewport
                var viewportWidth = await JSRuntime.InvokeAsync<double>("getViewportWidth");
                var popupWidth = 380;
                
                if (right + popupWidth > viewportWidth - 20)
                {
                    right = Math.Max(20, viewportWidth - popupWidth - 20);
                }
                
                if (right < 20)
                {
                    right = 20;
                }
                
                // Ensure popup doesn't go below viewport
                var viewportHeight = await JSRuntime.InvokeAsync<double>("getViewportHeight");
                if (top + 500 > viewportHeight)
                {
                    top = Math.Max(60, viewportHeight - 520);
                }
                
                popupStyle = $"right: {right}px; top: {top}px;";
                StateHasChanged();
            }
        }
        catch
        {
            // Fallback to default positioning
            popupStyle = "right: 20px; top: 60px;";
        }
    }
    
    private string GetPopupStyle()
    {
        if (string.IsNullOrEmpty(popupStyle))
        {
            return "right: 20px; top: 60px;";
        }
        return popupStyle;
    }

    private void ClosePopup()
    {
        showPopup = false;
    }

    private void DismissAnnouncement(int id)
    {
        dismissedAnnouncements.Add(id);
        announcements = announcements.Where(a => a.Id != id).ToList();
        announcementCount = announcements.Count;
        StateHasChanged();
    }

    private void ShowDetails(AnnouncementDto announcement)
    {
        selectedAnnouncement = announcement;
        showDetailsModal = true;
        showPopup = false;
    }

    private void CloseDetails()
    {
        showDetailsModal = false;
        selectedAnnouncement = null;
    }

    private string GetColorValue(string alertColor)
    {
        return alertColor switch
        {
            "Info" => "#3b82f6",
            "Success" => "#10b981",
            "Warning" => "#f59e0b",
            "Danger" => "#ef4444",
            _ => alertColor.StartsWith("#") ? alertColor : "#6b7280"
        };
    }

    private string TruncateMessage(string message, int maxLength)
    {
        if (string.IsNullOrEmpty(message))
            return "";
        
        // Remove HTML tags for truncation
        var plainText = System.Text.RegularExpressions.Regex.Replace(message, "<.*?>", "");
        
        if (plainText.Length <= maxLength)
            return message;
        
        return plainText.Substring(0, maxLength) + "...";
    }
}
