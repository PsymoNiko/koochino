@using MyShop.Application.Interfaces
@using MyShop.Core.Models.Dto
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using System.Linq
@using System

@inject IAnnouncementService AnnouncementService
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JSRuntime

<div class="notification-wrapper" @ref="wrapperRef">
    <a class="notification__icon" @onclick="TogglePopup" @ref="iconRef" style="cursor: pointer; position: relative;">
        @if (announcementCount > 0)
        {
            <span class="notification-badge">@announcementCount</span>
        }
    </a>
    
    @if (showPopup)
    {
        <div class="notification-popup" style="@GetPopupStyle()" @onclick:stopPropagation="true">
            <div class="notification-popup-header">
                <h4>اعلانات (@announcementCount)</h4>
                <button class="popup-close" @onclick="ClosePopup">✕</button>
            </div>
            <div class="notification-popup-body">
                @if (loading)
                {
                    <div class="loading-text">در حال بارگذاری...</div>
                }
                else if (announcements == null || !announcements.Any())
                {
                    <div class="empty-notifications">
                        <span>موردی برای نمایش وجود ندارد</span>
                    </div>
                }
                else
                {
                    @foreach (var announcement in announcements)
                    {
                        <div class="notification-item" style="border-left: 3px solid @GetColorValue(announcement.AlertColor)">
                            <div class="notification-item-header">
                                <strong>@announcement.Title</strong>
                                <button class="item-close" @onclick="() => DismissAnnouncement(announcement.Id)">✕</button>
                            </div>
                            <div class="notification-item-message" @onclick="@(() => ShowDetails(announcement))">
                                @((MarkupString)HtmlSanitize.Sanitize(TruncateMessage(announcement.Message, 100)))
                            </div>
                            <div class="notification-item-footer">
                                <small>@PersianDateHelper.ToPersianDateTimeString(announcement.EndDateTime)</small>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="notification-overlay" @onclick="ClosePopup"></div>
    }
</div>

@if (showDetailsModal && selectedAnnouncement != null)
{
    <div class="announcement-modal-overlay" @onclick="CloseDetails">
        <div class="announcement-modal-content" @onclick:stopPropagation="true">
            <div class="announcement-modal-header">
                <h3>@selectedAnnouncement.Title</h3>
                <button class="announcement-modal-close" @onclick="CloseDetails">✕</button>
            </div>
            <div class="announcement-modal-body">
                <div class="announcement-modal-message">
                    @((MarkupString)HtmlSanitize.Sanitize(selectedAnnouncement.Message))
                </div>
                <div class="announcement-modal-info">
                    <p><strong>مخاطب:</strong> @selectedAnnouncement.TargetAudienceName</p>
                    <p><strong>تاریخ شروع:</strong> @PersianDateHelper.ToPersianDateTimeString(selectedAnnouncement.StartDateTime)</p>
                    <p><strong>تاریخ پایان:</strong> @PersianDateHelper.ToPersianDateTimeString(selectedAnnouncement.EndDateTime)</p>
                </div>
            </div>
        </div>
    </div>
}

